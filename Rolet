async def callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query
    if not q:
        return

    uid = q.from_user.id
    data = q.data or ""

    # Participant buttons
    if data.startswith(("join:", "leave:")):
        action, gid_text = data.split(":", 1)
        if not gid_text.isdigit():
            await q.answer("طلب غير صالح.", show_alert=True)
            return

        gid = int(gid_text)
        g = get_giveaway(gid)

        if not g or g["status"] != "open":
            await q.answer("التسجيل مغلق.", show_alert=True)
            return

        if q.from_user.is_bot:
            await q.answer("حسابات البوتات لا تشارك.", show_alert=True)
            return

        with database() as con:
            con.execute("BEGIN IMMEDIATE")
            current = con.execute(
                "SELECT status FROM giveaways WHERE id=?", (gid,)
            ).fetchone()

            if not current or current["status"] != "open":
                await q.answer("التسجيل مغلق.", show_alert=True)
                return

            if action == "join":
                con.execute(
                    """INSERT INTO participants
                       (giveaway_id, user_id, username, full_name, joined_at, excluded)
                       VALUES (?, ?, ?, ?, ?, 0)
                       ON CONFLICT(giveaway_id, user_id) DO UPDATE SET
                         username=excluded.username,
                         full_name=excluded.full_name,
                         joined_at=excluded.joined_at,
                         excluded=0""",
                    (
                        gid, uid, q.from_user.username,
                        q.from_user.full_name, now(),
                    ),
                )
                audit(con, uid, "join", gid)
                answer = "تم تسجيل مشاركتك 🎟"
            else:
                con.execute(
                    "DELETE FROM participants WHERE giveaway_id=? AND user_id=?",
                    (gid, uid),
                )
                audit(con, uid, "leave", gid)
                answer = "تم إلغاء مشاركتك."

        await q.answer(answer, show_alert=True)
        await refresh_post(context, gid)
        return

    # Administrative buttons
    if data.startswith(("close:", "draw:")):
        action, gid_text = data.split(":", 1)

        if not gid_text.isdigit():
            await q.answer("طلب غير صالح.", show_alert=True)
            return

        gid = int(gid_text)
        g = get_giveaway(gid)

        if not can_manage(uid, g):
            await q.answer("هذا الزر مخصص لمدير السحب.", show_alert=True)
            return

        await q.answer()

        if action == "close":
            changed = await close_giveaway(context, gid, uid)
            await q.message.reply_text(
                "تم إغلاق التسجيل." if changed
                else "التسجيل مغلق مسبقًا أو السحب غير نشط."
            )
        else:
            result = perform_draw(gid, uid)
            if isinstance(result, str):
                await q.message.reply_text(result)
                return

            await refresh_post(context, gid)
            message = format_winners(gid, result)
            await q.message.reply_text(message, parse_mode="HTML")

            g = get_giveaway(gid)
            if g and g["chat_id"]:
                try:
                    await context.bot.send_message(
                        chat_id=g["chat_id"],
                        text=message,
                        parse_mode="HTML",
                    )
                except TelegramError as exc:
                    log.warning("Could not publish results: %s", exc)
        return

    await q.answer()

    if data == "new":
        if not is_admin(uid):
            await q.answer("هذه الميزة للمشرفين فقط.", show_alert=True)
            return
        flows[uid] = {"step": "title"}
        await q.message.reply_text("أرسل عنوان الجائزة أو السحب:")

    elif data == "admins":
        if not is_owner(uid):
            await q.answer("للمالك فقط.", show_alert=True)
            return
        await q.message.reply_text(
            "إدارة المشرفين:\n"
            "/addadmin USER_ID\n"
            "/deladmin USER_ID"
        )

    elif data == "mine":
        with database() as con:
            rows = con.execute(
                """SELECT id, title, status, winner_count
                   FROM giveaways WHERE creator_id=?
                   ORDER BY id DESC LIMIT 20""",
                (uid,),
            ).fetchall()

        if not rows:
            await q.message.reply_text("لا توجد سحوبات مسجلة.")
        else:
            lines = ["📋 <b>سحوباتك</b>"]
            for r in rows:
                lines.append(
                    f"#{r['id']} — {html.escape(r['title'])} "
                    f"| {r['status']} | الفائزون: {r['winner_count']}"
                )
            await q.message.reply_text(
                "\n".join(lines), parse_mode="HTML"
            )

    elif data == "stats":
        with database() as con:
            total = con.execute(
                "SELECT COUNT(*) FROM giveaways"
            ).fetchone()[0]
            opened = con.execute(
                "SELECT COUNT(*) FROM giveaways WHERE status='open'"
            ).fetchone()[0]
            entries = con.execute(
                "SELECT COUNT(*) FROM participants"
            ).fetchone()[0]
            winners = con.execute(
                "SELECT COUNT(*) FROM winners"
            ).fetchone()[0]

        await q.message.reply_text(
            f"📊 الإحصائيات\n"
            f"السحوبات: {total}\n"
            f"المفتوحة: {opened}\n"
            f"سجلات المشاركات: {entries}\n"
            f"الفائزون المسجلون: {winners}"
        )

    elif data == "history":
        with database() as con:
            rows = con.execute(
                """SELECT id, title FROM giveaways
                   WHERE status='drawn' ORDER BY drawn_at DESC LIMIT 10"""
            ).fetchall()

        if not rows:
            await q.message.reply_text("لا توجد نتائج حتى الآن.")
        else:
            lines = ["📜 <b>آخر النتائج</b>"]
            with database() as con:
                for r in rows:
                    lines.append(
                        f"\n🎡 #{r['id']} — {html.escape(r['title'])}"
                    )
                    winners = con.execute(
                        """SELECT full_name, username, place
                           FROM winners WHERE giveaway_id=?
                           ORDER BY place""",
                        (r["id"],),
                    ).fetchall()
                    for w in winners:
                        name = html.escape(w["full_name"])
                        if w["username"]:
                            name += f" (@{html.escape(w['username'])})"
                        lines.append(f"{w['place']}. {name}")

            await q.message.reply_text(
                "\n".join(lines), parse_mode="HTML"
            )


# =========================================================
# Creation wizard (private chat)
# =========================================================

async def flow_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.effective_user or not update.effective_message:
        return

    uid = update.effective_user.id
    message = update.effective_message

    if message.chat.type != ChatType.PRIVATE:
        return

    flow = flows.get(uid)
    if not flow:
        return

    if not is_admin(uid):
        flows.pop(uid, None)
        await message.reply_text("ليس لديك صلاحية.")
        return

    text = (message.text or "").strip()
    step = flow.get("step")

    if step == "title":
        if not text or len(text) > MAX_TITLE_LENGTH:
            await message.reply_text(
                f"العنوان يجب أن يكون بين 1 و{MAX_TITLE_LENGTH} حرفًا."
            )
            return

        flow["title"] = text
        flow["step"] = "winners"
        await message.reply_text("كم عدد الفائزين؟ (1-100)")

    elif step == "winners":
        if not text.isdigit() or not 1 <= int(text) <= MAX_WINNERS:
            await message.reply_text("أرسل رقمًا من 1 إلى 100.")
            return

        flow["winner_count"] = int(text)
        flow["step"] = "duration"
        await message.reply_text(
            "مدة التسجيل بالدقائق (0 = بدون مؤقت):"
        )

    elif step == "duration":
        if not text.isdigit() or int(text) > MAX_DURATION_MINUTES:
            await message.reply_text(
                f"أرسل عددًا بين 0 و{MAX_DURATION_MINUTES}."
            )
            return

        flow["duration"] = int(text) * 60
        flow["step"] = "exclude_previous"
        await message.reply_text(
            "استبعاد الفائزين السابقين؟ أرسل نعم أو لا."
        )

    elif step == "exclude_previous":
        answer = text.casefold()
        if answer not in ("نعم", "لا", "yes", "no"):
            await message.reply_text("أرسل نعم أو لا.")
            return

        flow["exclude_previous"] = int(answer in ("نعم", "yes"))
        flow["step"] = "destination"
        await message.reply_text(
            "أرسل @username للقناة العامة أو chat ID للقناة/المجموعة.\n"
            "مثال: @my_channel\n"
            "يجب أن يكون البوت مشرفًا في القناة."
        )

    elif step == "destination":
        target = text
        if target.startswith("@"):
            if len(target) < 2 or not target[1:].replace("_", "").isalnum():
                await message.reply_text("اسم قناة غير صالح.")
                return
        else:
            try:
                target = int(target)
            except ValueError:
                await message.reply_text(
                    "أرسل @username أو chat ID رقميًا."
                )
                return

        flow["target"] = target
        flow["step"] = "confirm"
        await message.reply_text(
            "تأكيد السحب:\n"
            f"🎁 {flow['title']}\n"
            f"🏆 عدد الفائزين: {flow['winner_count']}\n"
            f"⏳ المدة: {flow['duration'] // 60} دقيقة\n"
            f"📍 الوجهة: {target}\n\n"
            "أرسل نعم للنشر أو لا للإلغاء."
        )

    elif step == "confirm":
        if text.casefold() not in ("نعم", "yes"):
            flows.pop(uid, None)
            await message.reply_text("تم إلغاء إنشاء السحب.")
            return

        target = flow["target"]
        duration = flow["duration"]
        ends_at = now() + duration if duration else None

        with database() as con:
            cur = con.execute(
                """INSERT INTO giveaways
                   (creator_id, title, winner_count, duration_seconds,
                    exclude_previous, status, created_at, ends_at)
                   VALUES (?, ?, ?, ?, ?, 'draft', ?, ?)""",
                (
                    uid, flow["title"], flow["winner_count"], duration,
                    flow["exclude_previous"], now(), ends_at,
                ),
            )
            gid = cur.lastrowid
            audit(con, uid, "create", gid, str(target))

        try:
            sent = await context.bot.send_message(
                chat_id=target,
                text=post_text(gid),
                parse_mode="HTML",
                reply_markup=post_keyboard(gid, "open"),
            )

            with database() as con:
                con.execute(
                    """UPDATE giveaways
                       SET chat_id=?, chat_title=?, message_id=?, status='open'
                       WHERE id=? AND status='draft'""",
                    (
                        sent.chat_id,
                        sent.chat.title or sent.chat.username or str(sent.chat_id),
                        sent.message_id,
                        gid,
                    ),
                )
                audit(con, uid, "publish", gid)

            await refresh_post(context, gid)

            if duration:
                context.job_queue.run_once(
                    timer_close,
                    when=duration,
                    data={"gid": gid},
                    name=f"giveaway-{gid}",
                )

            await message.reply_text(
                f"✅ تم نشر السحب #{gid}.\n"
                f"إغلاق التسجيل: /close {gid}\n"
                f"سحب الفائزين: /draw {gid}",
                reply_markup=main_keyboard(uid),
            )

        except TelegramError as exc:
            with database() as con:
                con.execute(
                    "UPDATE giveaways SET status='draft' WHERE id=?",
                    (gid,),
                )
                audit(con, uid, "publish_failed", gid, str(exc)[:250])

            log.warning("Publishing failed: %s", exc)
            await message.reply_text(
                "تعذر نشر السحب. تحقق من آيدي الوجهة وصلاحيات البوت "
                "وأن البوت يستطيع الوصول إلى القناة."
            )
        finally:
            flows.pop(uid, None)


# =========================================================
# Application startup
# =========================================================

async def post_init(app: Application):
    await restore_timers(app)
    log.info("Timers restored.")


async def error_handler(update: object, context: ContextTypes.DEFAULT_TYPE):
    log.error("Unhandled exception: %s", context.error)


def main():
    if not TOKEN:
        raise SystemExit(
            "BOT_TOKEN غير موجود. عيّن التوكن في متغير البيئة أولًا."
        )

    init_db()

    app = (
        Application.builder()
        .token(TOKEN)
        .post_init(post_init)
        .build()
    )

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("cancel", cancel))
    app.add_handler(CommandHandler("close", close_command))
    app.add_handler(CommandHandler("draw", draw_command))
    app.add_handler(CommandHandler("exclude", exclude_command))
    app.add_handler(CommandHandler("addadmin", addadmin_command))
    app.add_handler(CommandHandler("deladmin", deladmin_command))
    app.add_handler(CallbackQueryHandler(callback))
    app.add_handler(
        MessageHandler(filters.TEXT & ~filters.COMMAND, flow_message)
    )
    app.add_error_handler(error_handler)

    log.info("Roulette bot started. Owner ID: %s", OWNER_ID)
    app.run_polling()


if __name__ == "__main__":
    main()

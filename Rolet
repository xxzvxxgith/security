    async def join_roulette(self, update: Update, context: ContextTypes.DEFAULT_TYPE, roulette_id: str):
        user = update.callback_query.from_user
        roulettes = await data_manager.get_roulettes()
        if roulette_id not in roulettes:
            await update.callback_query.answer("❌ الروليت غير موجود", show_alert=True)
            return
        r = roulettes[roulette_id]
        if r.get('state') != RouletteState.ACTIVE.value:
            await update.callback_query.answer("⛔ المشاركة متوقفة", show_alert=True)
            return
        if str(user.id) in r.get('participants', []):
            await update.callback_query.answer("✅ أنت مشارك بالفعل", show_alert=True)
            return
        
        r['participants'].append(str(user.id))
        r['participant_names'][str(user.id)] = get_display_name(user)
        roulettes[roulette_id] = r
        await data_manager.save_roulettes(roulettes)
        await update.callback_query.answer("✅ تم تسجيل مشاركتك!", show_alert=False)
        await self.update_roulette_message(context.bot, roulette_id)
    
    async def set_reminder(self, update: Update, context: ContextTypes.DEFAULT_TYPE, roulette_id: str):
        user = update.callback_query.from_user
        roulettes = await data_manager.get_roulettes()
        if roulette_id not in roulettes:
            return
        r = roulettes[roulette_id]
        if str(user.id) not in r.get('reminders', []):
            r.setdefault('reminders', []).append(str(user.id))
            roulettes[roulette_id] = r
            await data_manager.save_roulettes(roulettes)
        await update.callback_query.answer("🔔 سيتم إشعارك إذا فزت!", show_alert=False)
    
    async def toggle_roulette(self, update: Update, context: ContextTypes.DEFAULT_TYPE, roulette_id: str):
        user = update.callback_query.from_user
        roulettes = await data_manager.get_roulettes()
        if roulette_id not in roulettes:
            return
        r = roulettes[roulette_id]
        if str(user.id) != str(r.get('creator_id')):
            return
        r['state'] = RouletteState.PAUSED.value if r['state'] == RouletteState.ACTIVE.value else RouletteState.ACTIVE.value
        roulettes[roulette_id] = r
        await data_manager.save_roulettes(roulettes)
        await update.callback_query.answer("تم التحديث", show_alert=False)
        await self.update_roulette_message(context.bot, roulette_id)
    
    async def start_draw(self, update: Update, context: ContextTypes.DEFAULT_TYPE, roulette_id: str):
        user = update.callback_query.from_user
        roulettes = await data_manager.get_roulettes()
        if roulette_id not in roulettes:
            return
        r = roulettes[roulette_id]
        if str(user.id) != str(r.get('creator_id')) or not r.get('participants'):
            return
        
        winners = random.sample(r['participants'], min(1, len(r['participants'])))
        r['winners'] = winners
        r['state'] = RouletteState.FINISHED.value
        roulettes[roulette_id] = r
        await data_manager.save_roulettes(roulettes)
        await update.callback_query.answer("✅ تم السحب!", show_alert=False)
        await self.update_roulette_message(context.bot, roulette_id)
    

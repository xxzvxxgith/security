def generate_user_report(user_id):
    """إنشاء تقرير المستخدم"""
    user_info = get_user_info(user_id)
    user_stats = get_user_stats(user_id)
    ranking = get_user_ranking(user_id)
    
    if not user_info:
        return None
    
    username, first_name, joined_date, _, _ = user_info
    
    report = {
        "user_id": user_id,
        "username": username,
        "name": first_name,
        "joined_date": joined_date,
        "stats": user_stats,
        "ranking": ranking
    }
    
    return report

def generate_roulette_report(roulette_id):
    """إنشاء تقرير الروليت"""
    roulette = db.fetch_one(
        "SELECT message_text, winners_count, created_date, status, participants_count, countdown_seconds FROM roulettes WHERE id = ?",
        (roulette_id,)
    )
    
    if not roulette:
        return None
    
    participants = db.fetch_all(
        "SELECT COUNT(*) FROM participants WHERE roulette_id = ?",
        (roulette_id,)
    )
    
    winners = db.fetch_all(
        "SELECT first_name FROM participants WHERE roulette_id = ? ORDER BY join_time DESC LIMIT ?",
        (roulette_id, roulette[1])
    )
    
    report = {
        "roulette_id": roulette_id,
        "title": roulette[0],
        "winners_count": roulette[1],
        "created_date": roulette[2],
        "status": roulette[3],
        "participants_count": participants[0][0] if participants else 0,
        "countdown": roulette[5],
        "winners": [w[0] for w in winners] if winners else []
    }
    
    return report


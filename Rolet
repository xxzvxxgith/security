def get_html_text(message):
    if not message.text:
        return ""
    
    if not message.entities:
        return message.text
        
    text = message.text
    entities = sorted(message.entities, key=lambda e: e.offset, reverse=True)
    
    for entity in entities:
        offset = entity.offset
        length = entity.length
        
        start_tag = ""
        end_tag = ""
        
        if entity.type == 'bold':
            start_tag = "<b>"
            end_tag = "</b>"
        elif entity.type == 'italic':
            start_tag = "<i>"
            end_tag = "</i>"
        elif entity.type == 'underline':
            start_tag = "<u>"
            end_tag = "</u>"
        elif entity.type == 'strikethrough':
            start_tag = "<s>"
            end_tag = "</s>"
        elif entity.type == 'code':
            start_tag = "<code>"
            end_tag = "</code>"
        elif entity.type == 'pre':
            start_tag = "<pre>"
            end_tag = "</pre>"
        elif entity.type == 'text_link':
            start_tag = f'<a href="{entity.url}">'
            end_tag = "</a>"
        elif entity.type == 'spoiler':
             start_tag = '<span class="tg-spoiler">'
             end_tag = '</span>'
        
        if start_tag:
            before = text[:offset]
            content = text[offset:offset+length]
            after = text[offset+length:]
            
            text = f"{before}{start_tag}{content}{end_tag}{after}"
            
    return text


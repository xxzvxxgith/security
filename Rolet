@dp.callback_query(F.data == "broadcast:yes")
async def broadcast_execute(call: CallbackQuery, state: FSMContext):
    if not await is_admin(call.from_user.id):
        return await call.answer("غير مصرح.", show_alert=True)
    data = await state.get_data()
    source_chat = data.get("source_chat_id")
    source_message = data.get("source_message_id")
    if not source_chat or not source_message:
        await state.clear()
        return await call.answer("انتهت جلسة الإذاعة. أعد المحاولة.", show_alert=True)

    await state.clear()
    async with await db() as con:
        cur = await con.execute("SELECT user_id FROM users WHERE is_banned=0")
        recipients = [r["user_id"] for r in await cur.fetchall()]
        cur = await con.execute(
            "INSERT INTO broadcasts(created_at,started_by,total,status) VALUES(?,?,?,'running')",
            (now_iso(), call.from_user.id, len(recipients))
        )
        broadcast_id = cur.lastrowid
        await con.commit()

    await call.answer("بدأت الإذاعة.")
    status = await call.message.edit_text(
        f"📢 بدأت الإذاعة إلى <b>{len(recipients)}</b> مستخدم.\n\n"
        "سيظهر ملخص النتائج بعد الانتهاء."
    )
    success = failed = 0
    for uid in recipients:
        try:
            await bot.copy_message(
                chat_id=uid,
                from_chat_id=source_chat,
                message_id=source_message
            )
            success += 1
        except TelegramRetryAfter as e:
            await asyncio.sleep(e.retry_after + 0.5)
            try:
                await bot.copy_message(chat_id=uid, from_chat_id=source_chat, message_id=source_message)
                success += 1
            except TelegramAPIError:
                failed += 1
        except TelegramAPIError:
            failed += 1
        if (success + failed) % 25 == 0:
            try:
                await status.edit_text(
                    f"📢 الإذاعة قيد التنفيذ...\n"
                    f"✅ نجح: {success}\n❌ فشل: {failed}\n"
                    f"📊 الإجمالي: {len(recipients)}"
                )
            except TelegramAPIError:
                pass
        await asyncio.sleep(BROADCAST_DELAY)

    async with await db() as con:
        await con.execute(
            "UPDATE broadcasts SET success=?,failed=?,status='completed' WHERE id=?",
            (success, failed, broadcast_id)
        )
        await con.commit()
    await log_admin(call.from_user.id, "broadcast", f"id={broadcast_id},success={success},failed={failed}")
    try:
        await status.edit_text(
            "✅ <b>انتهت الإذاعة</b>\n\n"
            f"👥 المستهدفون: <b>{len(recipients)}</b>\n"
            f"✅ تم الإرسال: <b>{success}</b>\n"
            f"❌ تعذر الإرسال: <b>{failed}</b>",
            reply_markup=back_keyboard("admin")
        )
    except TelegramAPIError:
        pass



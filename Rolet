def add_condition_channel_to_roulette(roulette_id, channel_id, channel_name):
    """إضافة قناة شرط للروليت"""
    return db.execute(
        "INSERT INTO roulette_condition_channels (roulette_id, channel_id, channel_name) VALUES (?, ?, ?)",
        (roulette_id, channel_id, channel_name)
    )

def get_roulette_condition_channels(roulette_id):
    """الحصول على قنوات الشرط للروليت"""
    return db.fetch_all(
        "SELECT channel_id, channel_name FROM roulette_condition_channels WHERE roulette_id = ?",
        (roulette_id,)
    )

def remove_condition_channel_from_roulette(roulette_id, channel_id):
    """إزالة قناة شرط من الروليت"""
    return db.execute(
        "DELETE FROM roulette_condition_channels WHERE roulette_id = ? AND channel_id = ?",
        (roulette_id, channel_id)
    )

def check_user_subscription_all_channels(user_id, roulette_id):
    """التحقق من اشتراك المستخدم في جميع قنوات الشرط"""
    # الحصول على جميع قنوات الشرط للروليت
    channels = get_roulette_condition_channels(roulette_id)
    
    if not channels:
        return True, []  # لا توجد قنوات شرط
    
    missing_channels = []
    
    for channel_id, channel_name in channels:
        if not is_user_subscribed_to_channel(user_id, channel_id):
            missing_channels.append((channel_id, channel_name))
    
    if missing_channels:
        return False, missing_channels
    else:
        return True, []

def update_participant_channel_status(participant_id, roulette_id, channel_id, is_subscribed):
    """تحديث حالة اشتراك المشارك في قناة محددة"""
    return db.execute(
        "INSERT OR REPLACE INTO participant_channels_status (participant_id, roulette_id, channel_id, is_subscribed, checked_at) VALUES (?, ?, ?, ?, ?)",
        (participant_id, roulette_id, channel_id, is_subscribed, datetime.now().isoformat())
    )

def get_participant_channel_status(participant_id, roulette_id):
    """الحصول على حالة اشتراك المشارك في جميع القنوات"""
    return db.fetch_all(
        "SELECT channel_id, is_subscribed, checked_at FROM participant_channels_status WHERE participant_id = ? AND roulette_id = ?",
        (participant_id, roulette_id)
    )


@bot.callback_query_handler(func=lambda call: call.data.startswith("start:"))
def start_roulette(call):
    user_id = call.from_user.id
    roulette_key = call.data.split(":")[1]
    message = call.message
    chat_id = message.chat.id
    
    roulette = db.fetch_one(
        "SELECT id, creator_id, winners_count, status, channel_id, countdown_seconds FROM roulettes WHERE roulette_key = ?",
        (roulette_key,)
    )
    
    if not roulette:
        bot.answer_callback_query(call.id, "❌ الروليت غير موجودة", show_alert=True)
        return
    
    roulette_id, creator_id, winners_count, status, channel_id, countdown_seconds = roulette
    
    if countdown_seconds is None:
        countdown_seconds = 10
    
    if status != "active":
        bot.answer_callback_query(call.id, "❌ الروليت ليست نشطة", show_alert=True)
        return
    
    # التحقق من الصلاحيات: المالك أو أي أدمن في القناة
    is_allowed = False
    if user_id == creator_id:
        is_allowed = True
    else:
        try:
            # التحقق مما إذا كان المستخدم أدمن في القناة
            chat_member = bot.get_chat_member(channel_id, user_id)
            if chat_member.status in ['administrator', 'creator']:
                is_allowed = True
        except:
            pass
            
    if not is_allowed:
        bot.answer_callback_query(call.id, "❌ يجب أن تكون أدمن أو مالك الروليت للبدء", show_alert=True)
        return
    
    bot.answer_callback_query(call.id, "✅ تم بدء الروليت")
    
    db.execute("UPDATE roulettes SET status = ? WHERE id = ?", ("counting", roulette_id))
    
    countdown_message = bot.send_message(chat_id, f"⏱️ <b>العد: {countdown_seconds}</b>")
    countdown_msg_id = countdown_message.message_id
    
    for i in range(countdown_seconds - 1, -1, -1):
        time.sleep(1)
        try:
            bot.edit_message_text(f"⏱️ <b>العد: {i}</b>",
                                chat_id, countdown_msg_id)
        except:
            pass
    
    participants = db.fetch_all(
        "SELECT user_id, username, first_name FROM participants WHERE roulette_id = ?",
        (roulette_id,)
    )
    
    if len(participants) < winners_count:
        try:
            bot.delete_message(chat_id, countdown_msg_id)
        except:
            pass
        
        bot.send_message(chat_id,
                       f"<b>❌ عدد غير كافٍ</b>\n"
                       f"<b>المشاركون:</b> {len(participants)}\n"

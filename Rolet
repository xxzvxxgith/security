async def show_history(message):
    with database() as con:
        rows = con.execute(
            "SELECT id,title FROM giveaways WHERE status='drawn' ORDER BY drawn_at DESC LIMIT 10"
        ).fetchall()
        results = []
        for row in rows:
            winners = con.execute(
                "SELECT full_name,username,place FROM winners WHERE giveaway_id=? ORDER BY place",
                (row["id"],),
            ).fetchall()
            results.append((row, winners))
    if not results:
        await message.reply_text("لا توجد نتائج حتى الآن.")
        return
    lines = ["🏆 <b>آخر نتائج الروليت</b>\n"]
    for row, winners in results:
        lines.append(f"\n🎡 <b>#{row['id']}</b> — {html.escape(row['title'])}")
        for winner in winners:
            name = html.escape(winner["full_name"])
            if winner["username"]:
                name += f" (@{html.escape(winner['username'])})"
            lines.append(f"{winner['place']}. {name}")
    await message.reply_text("\n".join(lines), parse_mode="HTML")


async def callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    if not query:
        return
    data = query.data or ""
    uid = query.from_user.id
    try:
        if data.startswith(("join:", "leave:")):
            action, gid_text = data.split(":", 1)
            if not gid_text.isdigit():
                await query.answer("طلب غير صالح.", show_alert=True)
                return
            gid = int(gid_text)
            giveaway = get_giveaway(gid)
            if not giveaway or giveaway["status"] != "open":
                await query.answer("التسجيل مغلق.", show_alert=True)
                return
            if query.from_user.is_bot:
                await query.answer("حسابات البوتات لا تشارك.", show_alert=True)
                return
            with database() as con:
                con.execute("BEGIN IMMEDIATE")
                current = con.execute("SELECT status FROM giveaways WHERE id=?", (gid,)).fetchone()
                if not current or current["status"] != "open":
                    await query.answer("التسجيل مغلق.", show_alert=True)
                    return
                if action == "join":
                    # Preserve original joined_at on repeat presses; update only profile/exclusion.
                    con.execute(
                        """INSERT INTO participants(giveaway_id,user_id,username,full_name,joined_at,excluded)
                           VALUES(?,?,?,?,?,0)
                           ON CONFLICT(giveaway_id,user_id) DO UPDATE SET
                           username=excluded.username,full_name=excluded.full_name,excluded=0""",
                        (gid, uid, query.from_user.username, query.from_user.full_name, now()),
                    )
                    audit(con, uid, "join", gid)
                    answer = "تم تسجيل مشاركتك 🎟"
                else:
                    con.execute(
                        "DELETE FROM participants WHERE giveaway_id=? AND user_id=?",
                        (gid, uid),
                    )
                    audit(con, uid, "leave", gid)
                    answer = "تم إلغاء مشاركتك."
            await query.answer(answer, show_alert=True)
            await refresh_post(context, gid)
            return

        if data.startswith(("close:", "draw:")):
            action, gid_text = data.split(":", 1)
            if not gid_text.isdigit():
                await query.answer("طلب غير صالح.", show_alert=True)
                return
            gid = int(gid_text)
            giveaway = get_giveaway(gid)
            if not can_manage(uid, giveaway):
                await query.answer("هذا الزر مخصص لمدير السحب.", show_alert=True)
                return
            await query.answer()
            if action == "close":
                changed = await close_giveaway(context, gid, uid)
                await query.message.reply_text(
                    "تم إغلاق التسجيل." if changed else "التسجيل مغلق مسبقاً أو غير نشط."
                )
                return
            result = perform_draw(gid, uid)
            if isinstance(result, str):
                await query.message.reply_text(result)
                return
            await publish_results(context, gid, result, query.message)
            return

        await query.answer()
    except TelegramError as exc:
        log.warning("خطأ Telegram في الزر: %s", exc)
    except Exception:
        log.exception("فشل تنفيذ زر المشاركة")


async def flow_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.effective_user or not update.effective_message:
        return
    message = update.effective_message
    uid = update.effective_user.id
    if message.chat.type != ChatType.PRIVATE:
        return
    text = (message.text or "").strip()

    if text == MENU_CANCEL:
        context.user_data.pop("flow", None)
        await message.reply_text("تم إلغاء العملية.", reply_markup=main_keyboard(uid))
        return
    if text == MENU_HOME:
        context.user_data.pop("flow", None)
        await message.reply_text("القائمة الرئيسية:", reply_markup=main_keyboard(uid))
        return
    if text == MENU_CREATE:
        if not is_admin(uid):
            await message.reply_text(
                "إنشاء السحوبات متاح للمالك والمشرفين فقط.",
                reply_markup=main_keyboard(uid),
            )
            return
        context.user_data["flow"] = {"step": "title"}
        await message.reply_text("🎁 أرسل عنوان الجائزة أو السحب:")
        return
    if text == MENU_MINE:
        await show_mine(message, uid)
        return
    if text == MENU_STATS:
        await show_stats(message)
        return
    if text == MENU_HISTORY:
        await show_history(message)
        return
    if text == MENU_ADMINS:
        if not is_owner(uid):
            await message.reply_text("هذه الميزة للمالك فقط.")
            return
        await message.reply_text(
            "🛡 إدارة المشرفين\n\nإضافة مشرف:\n/addadmin USER_ID\n\nحذف مشرف:\n/deladmin USER_ID"
        )
        return

    flow = context.user_data.get("flow")
    if not flow:
        return
    if not is_admin(uid):
        context.user_data.pop("flow", None)
        await message.reply_text("ليس لديك صلاحية.")
        return

    step = flow["step"]
    if step == "title":
        if not text or len(text) > MAX_TITLE_LENGTH:
            await message.reply_text(f"العنوان يجب أن يكون بين 1 و{MAX_TITLE_LENGTH} حرفاً.")
            return
        flow["title"] = text
        flow["step"] = "winners"
        await message.reply_text(f"🏆 كم عدد الفائزين؟ أرسل رقماً من 1 إلى {MAX_WINNERS}.")
        return
    if step == "winners":
        if not text.isdigit() or not 1 <= int(text) <= MAX_WINNERS:
            await message.reply_text(f"أرسل رقماً من 1 إلى {MAX_WINNERS}.")
            return
        flow["winner_count"] = int(text)
        flow["step"] = "duration"
        await message.reply_text("⏳ مدة التسجيل بالدقائق. أرسل 0 للتسجيل دون مؤقت.")
        return
    if step == "duration":
        if not text.isdigit() or int(text) > MAX_DURATION_MINUTES:
            await message.reply_text(f"أرسل رقماً من 0 إلى {MAX_DURATION_MINUTES}.")
            return
        flow["duration"] = int(text) * 60
        flow["step"] = "exclude_previous"
        await message.reply_text("هل تريد استبعاد الفائزين السابقين؟ أرسل نعم أو لا.")
        return
    if step == "exclude_previous":
        answer = text.casefold()
        if answer not in ("نعم", "لا", "yes", "no"):
            await message.reply_text("أرسل نعم أو لا.")
            return
        flow["exclude_previous"] = int(answer in ("نعم", "yes"))
        flow["step"] = "destination"
        await message.reply_text(
            "📍 أرسل @اسم_القناة أو المعرّف الرقمي للقناة/المجموعة. "
            "أضف البوت إلى الوجهة وامنحه صلاحية النشر."
        )
        return
    if step == "destination":
        if text.startswith("@") and len(text) > 1:
            target = text
        else:
            try:
                target = int(text)
            except ValueError:
                await message.reply_text("أرسل @username أو معرّفاً رقمياً صالحاً.")
                return
        flow["target"] = target
        flow["step"] = "confirm"
        await message.reply_text(
            "📋 <b>تأكيد السحب</b>\n\n"
            f"🎁 {html.escape(flow['title'])}\n"
            f"🏆 عدد الفائزين: {flow['winner_count']}\n"
            f"⏳ المدة: {flow['duration'] // 60} دقيقة\n"
            f"📍 الوجهة: <code>{html.escape(str(target))}</code>\n\n"
            "أرسل نعم للنشر أو لا للإلغاء.",
            parse_mode="HTML",
        )
        return
    if step == "confirm":
        if text.casefold() not in ("نعم", "yes"):
            context.user_data.pop("flow", None)
            await message.reply_text("تم إلغاء إنشاء السحب.", reply_markup=main_keyboard(uid))
            return
        target = flow["target"]
        duration = flow["duration"]
        ends_at = now() + duration if duration else None
        with database() as con:
            cur = con.execute(
                """INSERT INTO giveaways
                   (creator_id,title,winner_count,duration_seconds,exclude_previous,status,created_at,ends_at)
                   VALUES(?,?,?,?,?,'draft',?,?)""",
                (uid, flow["title"], flow["winner_count"], duration, flow["exclude_previous"], now(), ends_at),
            )
            gid = cur.lastrowid
            audit(con, uid, "create", gid, str(target))
        try:
            sent = await context.bot.send_message(
                chat_id=target,
                text=post_text(gid),
                parse_mode="HTML",
                reply_markup=post_keyboard(gid, "open", manager=True),
            )
            with database() as con:
                con.execute(
                    """UPDATE giveaways SET chat_id=?,chat_title=?,message_id=?,status='open'
                       WHERE id=? AND status='draft'""",
                    (
                        sent.chat_id,
                        sent.chat.title or sent.chat.username or str(sent.chat_id),
                        sent.message_id,
                        gid,
                    ),
                )
                audit(con, uid, "publish", gid)
            await refresh_post(context, gid)
            if duration:
                if context.job_queue is None:
                    log.error("JobQueue غير متاحة؛ لم يتم جدولة إغلاق السحب.")
                    await message.reply_text(
                        "تم نشر السحب، لكن المؤقت غير متاح. ثبّت python-telegram-bot[job-queue].",
                        reply_markup=main_keyboard(uid),
                    )
                else:
                    context.job_queue.run_once(
                        timer_close,
                        when=duration,
                        data={"gid": gid},
                        name=f"giveaway-{gid}",
                    )
                    await message.reply_text(
                        f"✅ تم نشر السحب #{gid} بنجاح.\nإغلاق التسجيل: /close {gid}\nسحب الفائزين: /draw {gid}",
                        reply_markup=main_keyboard(uid),
                    )
            else:
                await message.reply_text(
                    f"✅ تم نشر السحب #{gid} بنجاح.\nإغلاق التسجيل: /close {gid}\nسحب الفائزين: /draw {gid}",
                    reply_markup=main_keyboard(uid),
                )
        except TelegramError as exc:
            log.exception("فشل نشر السحب")
            with database() as con:
                con.execute(
                    "UPDATE giveaways SET status='draft',chat_id=NULL,message_id=NULL WHERE id=?",
                    (gid,),
                )
                audit(con, uid, "publish_failed", gid, str(exc)[:250])
            await message.reply_text(
                "تعذر النشر. تحقق من الوجهة وصلاحيات البوت والاتصال بتيليجرام.",
                reply_markup=main_keyboard(uid),
            )
        finally:
            context.user_data.pop("flow", None)


# -------------------- DIAGNOSTICS / STARTUP --------------------
async def debug_updates(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message
    if msg and msg.text:
        log.info(
            "وصل تحديث نصي: user_id=%s chat_id=%s text=%r",
            update.effective_user.id if update.effective_user else None,
            update.effective_chat.id if update.effective_chat else None,
            msg.text[:100],
        )


async def error_handler(update: object, context: ContextTypes.DEFAULT_TYPE):
    error = context.error
    if isinstance(error, Conflict):
        log.error("Conflict: توجد نسخة أخرى من البوت تستخدم getUpdates. أوقف النسخ الأخرى.")
    elif isinstance(error, InvalidToken):
        log.error("رمز BOT_TOKEN غير صحيح. لا ترسل الرمز في المحادثة.")
    else:
        log.error("خطأ غير معالج أثناء استقبال تحديث: %r", error, exc_info=error)


async def post_init(app: Application):
    try:
        me = await app.bot.get_me()
        log.info("تم الاتصال بتيليجرام: @%s (id=%s)", me.username, me.id)
    except TelegramError:
        log.exception("فشل الاتصال بواجهة Telegram API")
        raise
    await restore_timers(app)
    log.info("تم تهيئة البوت بنجاح.")


def main():
    if not TOKEN:
        raise SystemExit(
            "لم يتم العثور على BOT_TOKEN.\n"
            "في Termux نفّذ: export BOT_TOKEN='توكن_البوت' ثم أعد التشغيل."
        )
    init_db()
    app = Application.builder().token(TOKEN).post_init(post_init).build()
    app.add_handler(CommandHandler("start", start), group=0)
    app.add_handler(CommandHandler("cancel", cancel), group=0)
    app.add_handler(CommandHandler("close", close_command), group=0)
    app.add_handler(CommandHandler("draw", draw_command), group=0)
    app.add_handler(CommandHandler("exclude", exclude_command), group=0)
    app.add_handler(CommandHandler("addadmin", addadmin_command), group=0)
    app.add_handler(CommandHandler("deladmin", deladmin_command), group=0)
    app.add_handler(CallbackQueryHandler(callback), group=0)
    # Generic text logger is in a later group, so it logs messages not consumed by commands.
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, flow_message), group=0)
    app.add_handler(MessageHandler(filters.ALL, debug_updates), group=1)
    app.add_error_handler(error_handler)
    log.info("بدء تشغيل بوت الروليت. Owner ID: %s", OWNER_ID)
    # Poll only message/callback updates; do not discard queued updates.
    app.run_polling(drop_pending_updates=False)


if __name__ == "__main__":
    main()

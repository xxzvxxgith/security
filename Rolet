            user_states[user_id]["message_id"] = sent.message_id
        
        return
    
    # معالجة معرف القناة
    channel_id = None
    channel_name = None
    
    if message.forward_from_chat:
        channel_id = str(message.forward_from_chat.id)
        channel_name = message.forward_from_chat.title

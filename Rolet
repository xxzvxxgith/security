@dp.message(UserStates.waiting_greeting)
async def receive_greeting(message: Message, state: FSMContext):
    data = await state.get_data()
    receiver_id = int(data.get("receiver_id", 0))
    if not receiver_id:
        await state.clear()
        return await message.answer("انتهت جلسة إرسال المعايدة. افتح رابط الشجرة من جديد.")
    if await get_setting("greetings_open", "1") != "1":
        await state.clear()
        return await message.answer("⛔ استقبال المعايدات متوقف حالياً.")
    if message.from_user.id == receiver_id:
        await state.clear()
        return await message.answer("لا يمكنك إرسال معايدة إلى شجرتك الخاصة.")
    if not message.text:
        return await message.answer("حالياً أرسل المعايدة كنص فقط ✍️")
    text = message.text.strip()
    if not text or len(text) > MAX_MESSAGE_LENGTH:
        return await message.answer(f"اكتب معايدة بين 1 و{MAX_MESSAGE_LENGTH} حرف.")
    receiver = await get_user(receiver_id)
    if not receiver:
        await state.clear()
        return await message.answer("هذه الشجرة لم تعد متاحة.")
    sender_name = message.from_user.full_name or "صديق مجهول"
    async with await db() as con:
        await con.execute(
            "INSERT INTO greetings(receiver_id,sender_id,sender_name,message_text,year,created_at) "
            "VALUES(?,?,?,?,?,?)",
            (receiver_id, message.from_user.id, sender_name, text, current_year(), now_iso())
        )
        await con.commit()

    await state.clear()
    try:
        await bot.send_message(
            receiver_id,
            "💌 <b>وصلتك معايدة جديدة!</b>\n\n"
            f"👤 المرسل: {html_escape(sender_name)}\n"
            f"📝 المعايدة:\n{html_escape(text)}\n\n"
            f"🗓️ السنة: {current_year()}",
            reply_markup=InlineKeyboardMarkup(inline_keyboard=[
                [InlineKeyboardButton(text="💌 عرض معايداتي", callback_data="inbox:0")]
            ])
        )
    except TelegramForbiddenError:
        pass
    await message.answer(
        "🎉 <b>تم إرسال معايدتك بنجاح!</b>\n\n"
        "وصلت رسالتك إلى صاحب الشجرة. قد تُراجع الرسائل عند الإبلاغ أو الاشتباه بإساءة الاستخدام.",
        reply_markup=InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="🏠 القائمة الرئيسية", callback_data="home")]
        ])
    )



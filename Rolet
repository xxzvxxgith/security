    user_id = call.from_user.id
    
    reminder = db.fetch_one("SELECT enabled FROM reminders WHERE user_id = ?", (user_id,))
    if reminder:
        new_status = 0 if reminder[0] == 1 else 1
        db.execute("UPDATE reminders SET enabled = ? WHERE user_id = ?", (new_status, user_id))
    else:
        db.execute("INSERT INTO reminders (user_id, enabled) VALUES (?, ?)", (user_id, 1))
    
    bot.answer_callback_query(call.id, "✅ تم تحديث الإعدادات", show_alert=False)

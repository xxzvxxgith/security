async def exclude_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    if not is_admin(uid): await update.effective_message.reply_text("ليس لديك صلاحية."); return
    if len(context.args)!=2 or not all(x.isdigit() for x in context.args):
        await update.effective_message.reply_text("الاستخدام: /exclude USER_ID GIVEAWAY_ID"); return
    user_id,gid = map(int,context.args)
    g = get_giveaway(gid)
    if not can_manage(uid,g) or g["status"]!="open":
        await update.effective_message.reply_text("لا يمكن استبعاد مشارك من هذا السحب."); return
    with database() as con:
        cur=con.execute("UPDATE participants SET excluded=1 WHERE giveaway_id=? AND user_id=?",(gid,user_id))
        if cur.rowcount: audit(con,uid,"exclude",gid,str(user_id))
    if cur.rowcount:
        await refresh_post(context,gid); await update.effective_message.reply_text("تم استبعاد المشارك.")
    else: await update.effective_message.reply_text("المشارك غير موجود.")

async def show_mine(message, uid):
    with database() as con:
        rows=con.execute("SELECT id,title,status,winner_count FROM giveaways WHERE creator_id=? ORDER BY id DESC LIMIT 20",(uid,)).fetchall()
    if not rows: await message.reply_text("لا توجد سحوبات مسجلة."); return
    lines=["📋 <b>سحوباتك</b>\n"]
    for r in rows:
        lines.append(f"🎡 #{r['id']} — {html.escape(r['title'])}\nالحالة: {html.escape(r['status'])} | الفائزون: {r['winner_count']}\n/close {r['id']} | /draw {r['id']}\n")
    await message.reply_text("\n".join(lines),parse_mode="HTML")

async def show_stats(message):
    with database() as con:
        total=con.execute("SELECT COUNT(*) FROM giveaways").fetchone()[0]
        opened=con.execute("SELECT COUNT(*) FROM giveaways WHERE status='open'").fetchone()[0]
        entries=con.execute("SELECT COUNT(*) FROM participants WHERE excluded=0").fetchone()[0]
        winners=con.execute("SELECT COUNT(*) FROM winners").fetchone()[0]
    await message.reply_text(f"📊 <b>إحصائيات البوت</b>\n\n🎡 جميع السحوبات: {total}\n🟢 السحوبات المفتوحة: {opened}\n👥 المشاركات الفعالة: {entries}\n🏆 سجلات الفائزين: {winners}",parse_mode="HTML")

async def show_history(message):
    with database() as con:
        rows=con.execute("SELECT id,title FROM giveaways WHERE status='drawn' ORDER BY drawn_at DESC LIMIT 10").fetchall()
        results=[]
        for r in rows:
            ws=con.execute("SELECT full_name,username,place FROM winners WHERE giveaway_id=? ORDER BY place",(r["id"],)).fetchall()
            results.append((r,ws))
    if not results: await message.reply_text("لا توجد نتائج حتى الآن."); return
    lines=["🏆 <b>آخر نتائج الروليت</b>\n"]
    for r,ws in results:
        lines.append(f"\n🎡 <b>#{r['id']}</b> — {html.escape(r['title'])}")
        for w in ws:
            name=html.escape(w["full_name"])
            if w["username"]: name+=f" (@{html.escape(w['username'])})"
            lines.append(f"{w['place']}. {name}")
    await message.reply_text("\n".join(lines),parse_mode="HTML")

async def callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q=update.callback_query
    if not q: return
    data=q.data or ""; uid=q.from_user.id
    try:
        if not data.startswith(("join:","leave:")):
            await q.answer(); return
        action,gid_text=data.split(":",1)
        if not gid_text.isdigit(): await q.answer("طلب غير صالح.",show_alert=True); return
        gid=int(gid_text); g=get_giveaway(gid)
        if not g or g["status"]!="open": await q.answer("التسجيل مغلق.",show_alert=True); return
        if q.from_user.is_bot: await q.answer("حسابات البوتات لا تشارك.",show_alert=True); return
        with database() as con:
            con.execute("BEGIN IMMEDIATE")
            current=con.execute("SELECT status FROM giveaways WHERE id=?",(gid,)).fetchone()
            if not current or current["status"]!="open":
                await q.answer("التسجيل مغلق.",show_alert=True); return
            if action=="join":
                con.execute("""INSERT INTO participants(giveaway_id,user_id,username,full_name,joined_at,excluded)
                    VALUES(?,?,?,?,?,0) ON CONFLICT(giveaway_id,user_id) DO UPDATE SET
                    username=excluded.username,full_name=excluded.full_name,joined_at=excluded.joined_at,excluded=0""",
                    (gid,uid,q.from_user.username,q.from_user.full_name,now()))
                audit(con,uid,"join",gid); answer="تم تسجيل مشاركتك 🎟"
            else:
                con.execute("DELETE FROM participants WHERE giveaway_id=? AND user_id=?",(gid,uid))
                audit(con,uid,"leave",gid); answer="تم إلغاء مشاركتك."
        await q.answer(answer,show_alert=True)
        await refresh_post(context,gid)
    except TelegramError as exc: log.warning("خطأ Telegram في الزر: %s",exc)
    except Exception: log.exception("فشل تنفيذ زر المشاركة")

async def flow_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.effective_user or not update.effective_message: return
    message=update.effective_message; uid=update.effective_user.id
    if message.chat.type!=ChatType.PRIVATE: return
    text=(message.text or "").strip()
    if text in (MENU_CANCEL,MENU_HOME):
        flows.pop(uid,None)
        await message.reply_text("تم إلغاء العملية." if text==MENU_CANCEL else "القائمة الرئيسية:",reply_markup=main_keyboard(uid)); return
    if text==MENU_CREATE:
        if not is_admin(uid): await message.reply_text("إنشاء السحوبات متاح للمالك والمشرفين فقط.",reply_markup=main_keyboard(uid)); return
        flows[uid]={"step":"title"}; await message.reply_text("🎁 أرسل عنوان الجائزة أو السحب:"); return
    if text==MENU_MINE: await show_mine(message,uid); return
    if text==MENU_STATS: await show_stats(message); return
    if text==MENU_HISTORY: await show_history(message); return
    if text==MENU_ADMINS:
        if not is_owner(uid): await message.reply_text("هذه الميزة للمالك فقط."); return
        await message.reply_text("🛡 إدارة المشرفين\nإضافة: /addadmin USER_ID\nحذف: /deladmin USER_ID"); return
    f=flows.get(uid)
    if not f: return
    if not is_admin(uid): flows.pop(uid,None); await message.reply_text("ليس لديك صلاحية."); return
    step=f["step"]
    if step=="title":
        if not text or len(text)>MAX_TITLE_LENGTH: await message.reply_text(f"العنوان يجب أن يكون بين 1 و{MAX_TITLE_LENGTH} حرفاً."); return
        f["title"]=text; f["step"]="winners"; await message.reply_text("🏆 كم عدد الفائزين؟ أرسل رقماً من 1 إلى 100."); return
    if step=="winners":
        if not text.isdigit() or not 1<=int(text)<=MAX_WINNERS: await message.reply_text("أرسل رقماً من 1 إلى 100."); return
        f["winner_count"]=int(text); f["step"]="duration"; await message.reply_text("⏳ مدة التسجيل بالدقائق. أرسل 0 للتسجيل دون مؤقت."); return
    if step=="duration":
        if not text.isdigit() or int(text)>MAX_DURATION_MINUTES: await message.reply_text(f"أرسل رقماً من 0 إلى {MAX_DURATION_MINUTES}."); return
        f["duration"]=int(text)*60; f["step"]="exclude_previous"; await message.reply_text("استبعاد الفائزين السابقين؟ أرسل نعم أو لا."); return
    if step=="exclude_previous":
        ans=text.casefold()
        if ans not in ("نعم","لا","yes","no"): await message.reply_text("أرسل نعم أو لا."); return
        f["exclude_previous"]=int(ans in ("نعم","yes")); f["step"]="destination"
        await message.reply_text("📍 أرسل @اسم_القناة أو المعرّف الرقمي للقناة/المجموعة. أضف البوت إليها وامنحه صلاحية النشر."); return
    if step=="destination":
        if text.startswith("@") and len(text)>1: target=text
        else:
            try: target=int(text)
            except ValueError: await message.reply_text("أرسل @username أو معرّفاً رقمياً صالحاً."); return
        f["target"]=target; f["step"]="confirm"
        await message.reply_text("📋 <b>تأكيد السحب</b>\n\n"
            f"🎁 {html.escape(f['title'])}\n🏆 عدد الفائزين: {f['winner_count']}\n"
            f"⏳ المدة: {f['duration']//60} دقيقة\n📍 الوجهة: <code>{html.escape(str(target))}</code>\n\nأرسل نعم للنشر أو لا للإلغاء.",parse_mode="HTML"); return
    if step=="confirm":
        if text.casefold() not in ("نعم","yes"):
            flows.pop(uid,None); await message.reply_text("تم إلغاء إنشاء السحب.",reply_markup=main_keyboard(uid)); return
        target=f["target"]; duration=f["duration"]; ends=now()+duration if duration else None
        with database() as con:
            cur=con.execute("""INSERT INTO giveaways(creator_id,title,winner_count,duration_seconds,exclude_previous,status,created_at,ends_at)
                VALUES(?,?,?,?,?,'draft',?,?)""",(uid,f["title"],f["winner_count"],duration,f["exclude_previous"],now(),ends))
            gid=cur.lastrowid; audit(con,uid,"create",gid,str(target))
        try:
            sent=await context.bot.send_message(chat_id=target,text=post_text(gid),parse_mode="HTML",reply_markup=post_keyboard(gid,"open"))
            with database() as con:
                con.execute("UPDATE giveaways SET chat_id=?,chat_title=?,message_id=?,status='open' WHERE id=?",
                    (sent.chat_id,sent.chat.title or sent.chat.username or str(sent.chat_id),sent.message_id,gid))
                audit(con,uid,"publish",gid)
            await refresh_post(context,gid)
            if duration: context.job_queue.run_once(timer_close,when=duration,data={"gid":gid},name=f"giveaway-{gid}")
            await message.reply_text(f"✅ تم نشر السحب #{gid} بنجاح.\nإغلاق التسجيل: /close {gid}\nسحب الفائزين: /draw {gid}",reply_markup=main_keyboard(uid))
        except TelegramError as exc:
            log.exception("فشل نشر السحب")
            with database() as con:
                con.execute("UPDATE giveaways SET status='draft',chat_id=NULL,message_id=NULL WHERE id=?",(gid,))
                audit(con,uid,"publish_failed",gid,str(exc)[:250])
            await message.reply_text("تعذر النشر. تحقق من الوجهة وصلاحيات البوت والاتصال بتيليجرام.",reply_markup=main_keyboard(uid))
        finally: flows.pop(uid,None)

async def error_handler(update: object, context: ContextTypes.DEFAULT_TYPE):
    log.error("خطأ غير معالج أثناء استقبال تحديث: %r",context.error,exc_info=context.error)

async def post_init(app: Application):
    await restore_timers(app)
    log.info("تم تهيئة البوت بنجاح.")

def main():
    if not TOKEN:
        raise SystemExit("لم يتم العثور على BOT_TOKEN.\nفي Termux نفّذ: export BOT_TOKEN='توكن_البوت' ثم أعد التشغيل.")
    init_db()
    app=Application.builder().token(TOKEN).post_init(post_init).build()
    app.add_handler(CommandHandler("start",start))
    app.add_handler(CommandHandler("cancel",cancel))
    app.add_handler(CommandHandler("close",close_command))
    app.add_handler(CommandHandler("draw",draw_command))
    app.add_handler(CommandHandler("exclude",exclude_command))
    app.add_handler(CommandHandler("addadmin",addadmin_command))
    app.add_handler(CommandHandler("deladmin",deladmin_command))
    app.add_handler(CallbackQueryHandler(callback))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND,flow_message))
    app.add_error_handler(error_handler)
    log.info("بدأ تشغيل بوت الروليت. Owner ID: %s",OWNER_ID)
    app.run_polling(drop_pending_updates=False)

if __name__=="__main__":
    main()

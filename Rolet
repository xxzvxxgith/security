def perform_draw(gid, actor_id):
    with database() as con:
        con.execute("BEGIN IMMEDIATE")

        g = con.execute(
            "SELECT * FROM giveaways WHERE id=?", (gid,)
        ).fetchone()

        if not g:
            return "السحب غير موجود."

        if g["status"] not in ("open", "closed"):
            return "تم السحب مسبقاً أو أن السحب غير جاهز."

        if not can_manage(actor_id, g):
            return "ليس لديك صلاحية إدارة هذا السحب."

        people = con.execute(
            """SELECT user_id, username, full_name
               FROM participants
               WHERE giveaway_id=? AND excluded=0""",
            (gid,),
        ).fetchall()

        if g["exclude_previous"]:
            previous = {
                row["user_id"]
                for row in con.execute(
                    "SELECT user_id FROM previous_winners"
                ).fetchall()
            }
            people = [
                p for p in people if p["user_id"] not in previous
            ]

        if not people:
            return "لا يوجد مشاركون مؤهلون للسحب."

        picks = secrets.SystemRandom().sample(
            list(people),
            min(g["winner_count"], len(people)),
        )

        drawn_at = now()

        con.execute(
            """UPDATE giveaways
               SET status='drawn',
                   closed_at=COALESCE(closed_at, ?),
                   drawn_at=?
               WHERE id=?""",
            (drawn_at, drawn_at, gid),
        )

        for place, p in enumerate(picks, start=1):
            con.execute(
                """INSERT INTO winners
                   (giveaway_id, user_id, username, full_name,
                    place, drawn_at)
                   VALUES (?, ?, ?, ?, ?, ?)""",
                (
                    gid, p["user_id"], p["username"],
                    p["full_name"], place, drawn_at,
                ),
            )

            con.execute(
                """INSERT INTO previous_winners(user_id, last_won_at)
                   VALUES (?, ?)
                   ON CONFLICT(user_id) DO UPDATE
                   SET last_won_at=excluded.last_won_at""",
                (p["user_id"], drawn_at),
            )

        audit(con, actor_id, "draw", gid, f"winners={len(picks)}")

        return picks


def format_winners(gid, picks):
    g = get_giveaway(gid)

    lines = [
        f"🏆 <b>نتائج الروليت #{gid}</b>",
        f"🎁 {html.escape(g['title'])}",
        "",
    ]

    for place, p in enumerate(picks, start=1):
        name = html.escape(p["full_name"])

        if p["username"]:
            name += f" (@{html.escape(p['username'])})"

        lines.append(
            f"{place}. {name} — <code>{p['user_id']}</code>"
        )

    lines.append(f"\n👥 عدد الفائزين: {len(picks)}")

    return "\n".join(lines)


async def publish_results(context, gid, picks, reply_message=None):
    await refresh_post(context, gid)

    message = format_winners(gid, picks)

    if reply_message:
        await reply_message.reply_text(
            message,
            parse_mode="HTML",
        )

    g = get_giveaway(gid)

    if g and g["chat_id"]:
        try:
            await context.bot.send_message(
                chat_id=g["chat_id"],
                text=message,
                parse_mode="HTML",
            )
        except TelegramError as exc:
            log.warning("Publishing results failed: %s", exc)



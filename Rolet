        return await cur.fetchone()


def make_code(length=10):
    alphabet = string.ascii_letters + string.digits
    return "".join(secrets.choice(alphabet) for _ in range(length))


async def ensure_user(tg_user, referred_by=None):
    user_id = tg_user.id
    existing = await get_user(user_id)
    code = existing["unique_code"] if existing else make_code()
    async with await db() as con:
        await con.execute("""
            INSERT INTO users(user_id,username,full_name,unique_code,joined_at,last_seen,referred_by)
            VALUES(?,?,?,?,?,?,?)
            ON CONFLICT(user_id) DO UPDATE SET
                username=excluded.username,
                full_name=excluded.full_name,
                last_seen=excluded.last_seen
        """, (
            user_id, tg_user.username, tg_user.full_name, code,
            now_iso(), now_iso(), referred_by if not existing else None
        ))
        await con.commit()
    return await get_user(user_id)


async def user_is_banned(user_id: int) -> bool:
    row = await get_user(user_id)
    return bool(row and row["is_banned"])



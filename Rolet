# أولاً: إضافة جدول جديد في قاعدة البيانات لتخزين قنوات الشرط للروليتات
def add_multi_channel_support():
    """إضافة دعم القنوات المتعددة في قاعدة البيانات"""
    with db_lock:
        conn = sqlite3.connect(db.db_name, check_same_thread=False)
        cursor = conn.cursor()
        
        # جدول لقنوات الشرط الخاصة بكل روليت
        cursor.execute('''CREATE TABLE IF NOT EXISTS roulette_condition_channels
            (id INTEGER PRIMARY KEY AUTOINCREMENT,
             roulette_id INTEGER,
             channel_id TEXT,
             channel_name TEXT,
             FOREIGN KEY (roulette_id) REFERENCES roulettes(id))''')
        
        # جدول لتتبع قنوات الشرط لكل مشارك
        cursor.execute('''CREATE TABLE IF NOT EXISTS participant_channels_status
            (id INTEGER PRIMARY KEY AUTOINCREMENT,
             participant_id INTEGER,
             roulette_id INTEGER,
             channel_id TEXT,
             is_subscribed INTEGER DEFAULT 0,
             checked_at TEXT,
             FOREIGN KEY (participant_id) REFERENCES participants(id),
             FOREIGN KEY (roulette_id) REFERENCES roulettes(id))''')
        
        conn.commit()
        conn.close()

# استدعاء الدالة لإنشاء الجداول
add_multi_channel_support()


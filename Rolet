def audit(con, actor, action, gid=None, details=None):
    con.execute(
        "INSERT INTO audit_log(actor_id,action,giveaway_id,details,created_at) VALUES(?,?,?,?,?)",
        (actor, action, gid, details, now()),
    )


def get_giveaway(gid):
    with database() as con:
        return con.execute("SELECT * FROM giveaways WHERE id=?", (gid,)).fetchone()


def is_owner(uid):
    return uid == OWNER_ID


def is_admin(uid):
    if is_owner(uid):
        return True
    with database() as con:
        return con.execute("SELECT 1 FROM admins WHERE user_id=?", (uid,)).fetchone() is not None


def can_manage(uid, giveaway):
    return bool(
        giveaway
        and (is_owner(uid) or (is_admin(uid) and giveaway["creator_id"] == uid))
    )


def participant_count(gid):
    with database() as con:
        return con.execute(
            "SELECT COUNT(*) FROM participants WHERE giveaway_id=? AND excluded=0",
            (gid,),
        ).fetchone()[0]



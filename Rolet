@bot.callback_query_handler(func=lambda call: call.data.startswith("verify:"))
def verify_participant(call):
    user_id = call.from_user.id
    parts = call.data.split(":")
    roulette_key = parts[1]
    selected_emoji = parts[2]
    correct_emoji = parts[3]
    
    roulette = db.fetch_one("SELECT id, status FROM roulettes WHERE roulette_key = ?", (roulette_key,))
    
    if not roulette:
        bot.answer_callback_query(call.id, "❌ حدث خطأ", show_alert=True)
        return
    
    roulette_id, status = roulette
    
    if status != "active":
        bot.answer_callback_query(call.id, "❌ انتهت الروليت أو بدأت بالفعل", show_alert=True)
        return
    
    # Check if user is subscribed to the condition channel
    roulette_data = db.fetch_one("SELECT condition_channel FROM roulettes WHERE id = ?", (roulette_id,))
    if roulette_data:
        condition_channel = roulette_data[0]
        if not is_user_subscribed_to_channel(user_id, condition_channel):
            channel_obj = None
            try:
                channel_obj = bot.get_chat(condition_channel)
                link = f"https://t.me/{channel_obj.username}" if channel_obj.username else condition_channel
            except:
                link = condition_channel
                
            bot.answer_callback_query(call.id, "❌ يجب الاشتراك في قناة الشرط أولاً!", show_alert=True)
            bot.send_message(user_id, 
                           f"<b>⚠️ عذراً، يجب عليك الاشتراك في القناة التالية للمشاركة:</b>\n"
                           f"📢 {link}\n\n"
                           f"<i>بعد الاشتراك، حاول الضغط على زر المشاركة مرة أخرى</i>")
            return

    if selected_emoji != correct_emoji:
        bot.answer_callback_query(call.id, "❌ إجابة خاطئة، حاول مرة أخرى", show_alert=True)
        
        emojis = ["🎯", "⚽", "🎮"]
        correct_emoji_new = random.choice(emojis)
        other_emojis = [e for e in emojis if e != correct_emoji_new]
        random.shuffle(other_emojis)
        
        keyboard = types.InlineKeyboardMarkup()
        buttons = [types.InlineKeyboardButton(emoji,
                                             callback_data=f"verify:{roulette_key}:{emoji}:{correct_emoji_new}")
                   for emoji in [correct_emoji_new] + other_emojis]
        keyboard.row(*buttons)
        
        bot.edit_message_text(f"<b>🔐 تحقق من الهوية</b>\n\n"
                            f"<b>اختر الرمز التالي:</b> <code>{correct_emoji_new}</code>\n\n"
                            f"<b>حاول مرة أخرى</b>",
                            user_id, call.message.message_id,
                            reply_markup=keyboard)
        return
    
    bot.answer_callback_query(call.id, "✅ إجابة صحيحة!")
    

async def refresh_post(context, gid):
    g = get_giveaway(gid)
    if not g or not g["chat_id"] or not g["message_id"]:
        return

    try:
        await context.bot.edit_message_text(
            chat_id=g["chat_id"],
            message_id=g["message_id"],
            text=post_text(gid),
            parse_mode="HTML",
            reply_markup=post_keyboard(gid, g["status"]),
        )
    except TelegramError as exc:
        log.warning("Could not update post for giveaway %s: %s", gid, exc)



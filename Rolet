@bot.message_handler(func=lambda message: user_states.get(message.from_user.id, {}).get("state") == "create_roulette_condition_channels")
def handle_condition_channels(message):
    """معالجة إضافة قنوات الشرط المتعددة"""
    user_id = message.from_user.id
    text = message.text.strip()
    message_id = user_states.get(user_id, {}).get("message_id")
    
    # التحقق من الأمر /done
    if text.lower() == "/done":
        # التحقق من وجود قنوات على الأقل
        condition_channels = user_states[user_id].get("condition_channels", [])
        
        if not condition_channels:
            error_msg = (
                "<b>❌ يجب إضافة قناة شرط واحدة على الأقل</b>\n\n"
                "الرجاء إرسال معرف قناة واحدة على الأقل"
            )
            if message_id:
                try:
                    bot.edit_message_text(error_msg, user_id, message_id)
                except:
                    bot.send_message(user_id, error_msg)
            else:
                bot.send_message(user_id, error_msg)
            return
        
        # الانتقال إلى الخطوة التالية (إرسال نص الروليت)
        user_states[user_id]["state"] = "create_roulette_text"

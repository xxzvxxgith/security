def handle_broadcast(message):
    user_id = message.from_user.id
    if user_id != ADMIN_ID:
        return
    
    users = db.fetch_all("SELECT user_id FROM users WHERE blocked = 0")
    
    sent = 0
    failed = 0
    
    keyboard = types.InlineKeyboardMarkup()
    keyboard.add(types.InlineKeyboardButton("🔙 عودة", callback_data="back_to_admin"))
    
    message_id = message.message_id
    from_chat_id = message.chat.id
    reply_markup = message.reply_markup
    
    for user in users:
        try:
            # استخدام copy_message لنسخ الرسالة كما هي (نص، صورة، فيديو، ملف، ملصق..)
            # مع الحفاظ على التنسيق والأزرار إذا وجدت
            bot.copy_message(user[0], from_chat_id, message_id, reply_markup=reply_markup)
            sent += 1
            time.sleep(0.01)  # تأخير صغير لتجنب حد التقييد
        except Exception as e:
            failed += 1
    
    result_msg = (f"<b>✅ تم البث بنجاح!</b>\n\n"
                 f"<b>━━━━━━━━━━━━━━━━━━━━━━</b>\n\n"
                 f"<b>📤 تم الإرسال لـ:</b> {sent} مستخدم\n"

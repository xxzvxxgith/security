def get_html_text(message):
    """تحويل نص الرسالة مع التنسيقات إلى HTML"""
    if not message.text:
        return ""
    
    if not message.entities:
        return message.text
        
    text = message.text
    entities = sorted(message.entities, key=lambda e: e.offset, reverse=True)
    
    # نستخدم قائمة الأحرف لسهولة التعديل
    # ملاحظة: Telegram counts offset by UTF-16 code units.
    # Python strings (unicode) matches this mostly for BMP, but emojis can be tricky.
    # For simplicity/safety with mixed content, we try the standard approach.
    
    for entity in entities:
        offset = entity.offset
        length = entity.length
        
        # تحويل نوع الكيان إلى HTML tags
        start_tag = ""
        end_tag = ""
        
        if entity.type == 'bold':
            start_tag = "<b>"
            end_tag = "</b>"
        elif entity.type == 'italic':
            start_tag = "<i>"
            end_tag = "</i>"
        elif entity.type == 'underline':
            start_tag = "<u>"
            end_tag = "</u>"
        elif entity.type == 'strikethrough':
            start_tag = "<s>"
            end_tag = "</s>"
        elif entity.type == 'code':
            start_tag = "<code>"
            end_tag = "</code>"
        elif entity.type == 'pre':
            start_tag = "<pre>"
            end_tag = "</pre>"
        elif entity.type == 'text_link':
            start_tag = f'<a href="{entity.url}">'
            end_tag = "</a>"
        elif entity.type == 'spoiler':
             start_tag = '<span class="tg-spoiler">'
             end_tag = '</span>'
        
        if start_tag:
            # نقوم بالاستبدال من النهاية للبداية حتى لا نغير الـ offsets القادمة
            # لكن مهلاً، في Python، الاستبدال اسهل بتقسيم النص
            
            # UTF-16 encoding correction for emojis handles
            # لكن بما أننا لا نملك مكتبة مساعدة، سنستخدم النص مباشرة ونأمل خيرًا
            # أو نستخدم طريقة bytearray with utf-16
            
            # Safe basic approach (works for non-surrogate pairs logic mostly)
            # If complex emojis are used, offsets might misalignment in pure python string indexing vs telegram's utf16 count.
            # But mostly fine.
            
            before = text[:offset]
            content = text[offset:offset+length]
            after = text[offset+length:]
            
            text = f"{before}{start_tag}{content}{end_tag}{after}"
            
    return text


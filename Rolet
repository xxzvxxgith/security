    async def handle_message(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        message = update.message
        if not message: return
        
        if message.chat.type in ['group', 'supergroup'] and message.text and message.text.strip() == '← تفعيل روليت':
            try:
                bot_member = await context.bot.get_chat_member(message.chat.id, context.bot.id)
                if bot_member.status not in ['administrator', 'creator']:
                    await message.reply_text("❗ الرجاء ترقية البوت إلى مشرف أولاً لكي يعمل.")
                    return
                
                channels = await data_manager.get_bound_channels()
                channels.setdefault(str(message.from_user.id), {})[str(message.chat.id)] = {
                    'title': message.chat.title,
                    'username': message.chat.username,
                    'added_at': datetime.now().isoformat()
                }
                await data_manager.save_bound_channels(channels)
                await message.reply_text("✅ تم تفعيل المجموعة بنجاح! يمكنك الآن استخدامها في السحوبات.")
            except Exception as e:
                await message.reply_text("❗ حدث خطأ أثناء التفعيل.")
            return

        if message.forward_origin and isinstance(message.forward_origin, MessageOriginChannel):
            user_id = message.from_user.id
            state = self.user_states.get(user_id)
            temp = await data_manager.get_temp(user_id)
            if state == 'awaiting_channel_forward' or temp.get('state') == 'awaiting_channel_forward':
                await self.handle_channel_forward(update, context)
                return

        if update.effective_chat.type == 'private':
            user = message.from_user
            user_id = user.id
            
            if await self.is_banned(user_id):
                return
            
            state = self.user_states.get(user_id)
            temp = await data_manager.get_temp(user_id)
            
            if state == 'awaiting_qr_text':
                qr_settings = temp.get('qr_settings', {})
                qr_settings['text'] = message.text or ""
                temp['qr_settings'] = qr_settings
                self.user_states.pop(user_id, None)
                await data_manager.save_temp(user_id, temp)
                await message.reply_text("✅ تم حفظ كليشة اللعبة بنجاح!", reply_markup=Keyboards.back_button("qr_settings"))
            elif state == 'awaiting_qr_vote':
                qr_settings = temp.get('qr_settings', {})
                qr_settings['vote_cond'] = message.text or ""
                temp['qr_settings'] = qr_settings
                self.user_states.pop(user_id, None)
                await data_manager.save_temp(user_id, temp)
                await message.reply_text("✅ تم تحديث شرط التصويت!", reply_markup=Keyboards.back_button("qr_settings"))
            elif state == 'awaiting_qr_interact':
                qr_settings = temp.get('qr_settings', {})
                qr_settings['interact_cond'] = message.text or ""
                temp['qr_settings'] = qr_settings
                self.user_states.pop(user_id, None)
                await data_manager.save_temp(user_id, temp)
                await message.reply_text("✅ تم تحديث شرط التفاعل!", reply_markup=Keyboards.back_button("qr_settings"))
            else:
                await message.reply_text("❓ استخدم /start للبدء", reply_markup=Keyboards.back_button())
    
    async def handle_channel_forward(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        message = update.message
        user_id = message.from_user.id
        

        if not message.forward_origin or not isinstance(message.forward_origin, MessageOriginChannel):
            await message.reply_text("❗ يرجى توجيه رسالة صحيحة من القناة.")
            return
        
        channel = message.forward_origin.chat
        try:
            bot_member = await context.bot.get_chat_member(channel.id, context.bot.id)
            if bot_member.status not in ['administrator', 'creator']:
                await message.reply_text("❗ البوت ليس مشرفاً في هذه القناة. أضفه كمشرف أولاً.")
                return
        except Exception as e:
            logger.error(f"Error checking membership: {e}")
            await message.reply_text("❗ لا يمكن التحقق من صلاحيات البوت. تأكد من إضافته كمشرف.")
            return
        
        channels = await data_manager.get_bound_channels()
        channels.setdefault(str(user_id), {})[str(channel.id)] = {
            'title': channel.title,
            'username': channel.username,
            'added_at': datetime.now().isoformat()
        }
        await data_manager.save_bound_channels(channels)
        self.user_states.pop(user_id, None)
        await data_manager.delete_temp(user_id)
        
        await message.reply_text(
            f"✅ تم تسجيل القناة بنجاح: {channel.title}",
            reply_markup=Keyboards.back_button("start_roulette")
        )


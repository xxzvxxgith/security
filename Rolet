async def close_giveaway(context, gid, actor_id=None):
    with database() as con:
        con.execute("BEGIN IMMEDIATE")
        row = con.execute(
            "SELECT * FROM giveaways WHERE id=?", (gid,)
        ).fetchone()

        if not row or row["status"] != "open":
            return False

        con.execute(
            """UPDATE giveaways
               SET status='closed', closed_at=?
               WHERE id=? AND status='open'""",
            (now(), gid),
        )
        audit(con, actor_id or OWNER_ID, "close", gid)

    await refresh_post(context, gid)
    return True


async def timer_close(context):
    gid = context.job.data["gid"]
    changed = await close_giveaway(context, gid)

    if changed:
        g = get_giveaway(gid)
        if g:
            try:
                await context.bot.send_message(
                    chat_id=g["creator_id"],
                    text=(
                        f"⏰ انتهى وقت التسجيل للسحب #{gid}.\n"
                        f"يمكنك سحب الفائزين عبر /draw {gid}"
                    ),
                )
            except TelegramError:
                pass


async def restore_timers(app):
    # Recreate timers after process restarts.
    with database() as con:
        rows = con.execute(
            "SELECT id, ends_at FROM giveaways WHERE status='open'"
        ).fetchall()

    for row in rows:
        if row["ends_at"] is None:
            continue
        remaining = max(0, row["ends_at"] - now())
        app.job_queue.run_once(
            timer_close,
            when=remaining,
            data={"gid": row["id"]},
            name=f"giveaway-{row['id']}",
        )



async def db():
    conn = await aiosqlite.connect(DB_PATH)
    conn.row_factory = aiosqlite.Row
    await conn.execute("PRAGMA foreign_keys = ON")
    await conn.execute("PRAGMA journal_mode = WAL")
    return conn


async def init_db():
    async with await db() as con:
        await con.executescript("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            full_name TEXT NOT NULL,
            unique_code TEXT UNIQUE NOT NULL,
            joined_at TEXT NOT NULL,
            last_seen TEXT NOT NULL,
            referred_by INTEGER,
            is_banned INTEGER NOT NULL DEFAULT 0
        );

        CREATE TABLE IF NOT EXISTS greetings (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            receiver_id INTEGER NOT NULL,
            sender_id INTEGER,
            sender_name TEXT NOT NULL,
            message_text TEXT NOT NULL,
            year INTEGER NOT NULL,
            created_at TEXT NOT NULL,
            FOREIGN KEY(receiver_id) REFERENCES users(user_id)
        );

        CREATE TABLE IF NOT EXISTS visits (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            owner_id INTEGER NOT NULL,
            visitor_id INTEGER NOT NULL,
            first_seen TEXT NOT NULL,
            UNIQUE(owner_id, visitor_id)
        );

        CREATE TABLE IF NOT EXISTS admins (
            user_id INTEGER PRIMARY KEY,
            added_at TEXT NOT NULL,
            added_by INTEGER NOT NULL
        );

        CREATE TABLE IF NOT EXISTS required_channels (
            channel_id TEXT PRIMARY KEY,
            channel_title TEXT,
            invite_url TEXT NOT NULL
        );

        CREATE TABLE IF NOT EXISTS settings (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL
        );

        CREATE TABLE IF NOT EXISTS broadcasts (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            created_at TEXT NOT NULL,
            started_by INTEGER NOT NULL,
            total INTEGER NOT NULL DEFAULT 0,
            success INTEGER NOT NULL DEFAULT 0,
            failed INTEGER NOT NULL DEFAULT 0,
            status TEXT NOT NULL DEFAULT 'running'
        );

        CREATE TABLE IF NOT EXISTS admin_logs (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            admin_id INTEGER NOT NULL,
            action TEXT NOT NULL,
            details TEXT,
            created_at TEXT NOT NULL
        );

        CREATE INDEX IF NOT EXISTS idx_greetings_receiver_year
            ON greetings(receiver_id, year, id);
        CREATE INDEX IF NOT EXISTS idx_visits_owner
            ON visits(owner_id);
        """)
        await con.execute(
            "INSERT OR IGNORE INTO settings(key,value) VALUES('greetings_open','1')"
        )
        await con.commit()



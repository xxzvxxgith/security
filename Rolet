@bot.message_handler(content_types=['text'])
def handle_text_message(message):
    user_id = message.from_user.id
    
    if user_id not in user_states:
        return
    
    state = user_states.get(user_id, {}).get("state")
    
    if state == "link_channel":
        handle_link_channel(message)
    elif state == "create_roulette_winners":
        handle_winners_count(message)
    elif state == "create_roulette_condition_channel":
        handle_condition_channel(message)
    elif state == "create_roulette_text":
        handle_roulette_text(message)
    elif state == "create_roulette_countdown":
        handle_roulette_countdown(message)
    elif state == "broadcast":
        handle_broadcast(message)
    elif state == "send_to_user_id":
        handle_send_to_user_id(message)
    elif state == "send_to_user_message":
        handle_send_to_user_message(message)
    elif state == "add_channel":
        handle_add_channel(message)
    elif state == "delete_channel":
        handle_delete_channel(message)
    elif state == "block_user":
        handle_block_user(message)
    elif state == "unblock_user":
        handle_unblock_user(message)
    elif state == "search_user":
        handle_search_user(message)
    elif state == "add_required_channel":
        handle_add_required_channel(message)

def handle_link_channel(message):
    user_id = message.from_user.id
    channel_id = None
    channel_name = None
    
    if message.forward_from_chat:
        channel_id = str(message.forward_from_chat.id)
        channel_name = message.forward_from_chat.title
    elif message.text and message.text.startswith("@"):
        channel_id = message.text
        channel_name = message.text[1:]
    elif message.text and "t.me" in message.text:
        parts = message.text.replace("https://", "").replace("http://", "").split("/")
        channel_id = "@" + parts[-1]
        channel_name = parts[-1]
    
    if channel_id:
        try:
            member = bot.get_chat_member(channel_id, bot.get_me().id)
            if member.status in ['administrator', 'creator']:
                # التحقق إذا كان المستخدم قد ربط القناة بالفعل
                existing = db.fetch_one("SELECT channel_id FROM channels WHERE channel_id = ? AND owner_id = ?",
                                      (channel_id, user_id))
                
                if existing:
                    bot.send_message(user_id, "<b>❌ القناة مرتبطة بحسابك بالفعل</b>")
                else:
                    # إضافة القناة (مسموح بتكرار القناة لمستخدمين مختلفين بسبب المفتاح المركب)
                    db.execute("INSERT INTO channels VALUES (?, ?, ?, ?)",
                             (channel_id, channel_name, user_id, datetime.now().isoformat()))
                    bot.send_message(user_id,
                                   f"<b>✅ تم!</b>\n"
                                   f"<b>📢</b> {channel_name}")
                    
                    keyboard = create_user_channels_keyboard(user_id)
                    bot.send_message(user_id, "<b>📢 قنواتك:</b>",
                                   reply_markup=keyboard)

def run_bot_with_retry():
    retry_count = 0
    max_retries = 3
    consecutive_409_errors = 0
    
    while retry_count < max_retries:
        try:
            print("[INFO] Starting bot polling...")
            bot.infinity_polling(timeout=15, long_polling_timeout=15, interval=0)
            break
            
        except KeyboardInterrupt:
            print("\n[INFO] Bot stopped by user")
            try:
                bot.stop_polling()
            except:
                pass
            break
            
        except Exception as e:
            error_msg = str(e)
            
            # Handle Error 409 - Multiple instances
            if "409" in error_msg and "Conflict" in error_msg:
                consecutive_409_errors += 1
                retry_count += 1
                
                print(f"\n[ERROR 409] Conflict detected (attempt {retry_count}/{max_retries})")
                print(f"[INFO] Consecutive 409 errors: {consecutive_409_errors}")
                
                # Stop current polling attempt
                try:
                    bot.stop_polling()
                except:
                    pass
                
                # Wait longer on each retry
                wait_time = 60 + (retry_count * 30)  # 60s, 90s, 120s
                print(f"[INFO] Waiting {wait_time} seconds before retry...")
                time.sleep(wait_time)
                
                if retry_count < max_retries:
                    print("[INFO] Attempting to reconnect...")
                    continue
                else:
                    print("[ERROR] Max retries reached. Please check for other bot instances.")
                    break
            else:
                # Other errors
                consecutive_409_errors = 0
                logger.error(f"[ERROR] {error_msg}")
                print(f"[ERROR] {error_msg}")
                
                # Try once more for non-409 errors
                if retry_count < max_retries - 1:
                    retry_count += 1
                    print(f"[INFO] Retrying ({retry_count}/{max_retries})...")
                    time.sleep(10)
                    continue
                else:
                    print("[ERROR] Failed to recover from error.")
                    break


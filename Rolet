    async def show_my_roulettes(self, update: Update, context: ContextTypes.DEFAULT_TYPE, filter_type: str = None):
        user_id = update.callback_query.from_user.id
        temp = await data_manager.get_temp(user_id)
        
        if filter_type is None:
            current_filter = temp.get('my_roulettes_filter', 'all')
        else:
            current_filter = filter_type

        temp['my_roulettes_filter'] = current_filter
        await data_manager.save_temp(user_id, temp)

        filter_names = {
            'all': ('كل السحوبات', 'الكل'),
            'active': ('النشطة فقط', 'النشطة'),
            'finished': ('المنتهية فقط', 'المنتهية')
        }
        
        filter_text, filter_btn = filter_names.get(current_filter, filter_names['all'])
        
        roulettes_data = await data_manager.get_roulettes()
        user_roulettes = []
        for r_id, r in roulettes_data.items():
            if str(r.get('creator_id')) == str(user_id):
                if current_filter == 'active' and r.get('state') not in [RouletteState.ACTIVE.value, RouletteState.PAUSED.value]:
                    continue
                if current_filter == 'finished' and r.get('state') != RouletteState.FINISHED.value:
                    continue
                user_roulettes.append(r)

        text = f"🎁 <b>سحوباتي</b>\n\n"
        if not user_roulettes:
            text += f"لا توجد سحوبات ضمن فلتر «{filter_text}»."
        else:
            text += f"<b>قائمة السحوبات ({filter_text}):</b>\n\n"
            for i, r in enumerate(user_roulettes, 1):
                status_icon = "🟢" if r.get('state') == RouletteState.ACTIVE.value else "🔴"
                safe_text = html.escape(r.get('text', '')[:20])
                text += f"{i}. {status_icon} {safe_text}...\n"

        keyboard = [
            [InlineKeyboardButton(f"فلتر: {filter_btn}", callback_data="cycle_roulette_filter", style="success")],
            [InlineKeyboardButton("🔙 رجوع", callback_data="back_main", style="danger")]
        ]
        
        try:
            await update.callback_query.edit_message_text(
                text,
                parse_mode=ParseMode.HTML,
                reply_markup=InlineKeyboardMarkup(keyboard)
            )
        except BadRequest as e:
            if "Message is not modified" in str(e):
                pass
            else:
                raise e

    async def cycle_roulette_filter(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        user_id = update.callback_query.from_user.id
        temp = await data_manager.get_temp(user_id)
        current = temp.get('my_roulettes_filter', 'all')
        
        if current == 'all':
            next_filter = 'active'
        elif current == 'active':
            next_filter = 'finished'
        else:
            next_filter = 'all'
            
        await self.show_my_roulettes(update, context, filter_type=next_filter)

    async def show_stats(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        user_id = update.callback_query.from_user.id
        roulettes = await data_manager.get_roulettes()
        channels_data = await data_manager.get_bound_channels()
        
        created_count = sum(1 for r in roulettes.values() if str(r.get('creator_id')) == str(user_id))
        participated_count = sum(1 for r in roulettes.values() if str(user_id) in r.get('participants', []))
        won_count = sum(1 for r in roulettes.values() if str(user_id) in r.get('winners', []))
        
        channel_stats = {}
        channel_titles = {}
        for uid, ch_dict in channels_data.items():
            for ch_id, ch_info in ch_dict.items():
                channel_titles[str(ch_id)] = ch_info.get('title', f"قناة {ch_id}")

        for r in roulettes.values():
            ch_id = str(r.get('channel_id'))
            if ch_id:
                if ch_id not in channel_stats:
                    channel_stats[ch_id] = {
                        'title': channel_titles.get(ch_id, f"قناة {ch_id}"),
                        'participations': 0
                    }
                channel_stats[ch_id]['participations'] += len(r.get('participants', []))

        sorted_channels = sorted(channel_stats.values(), key=lambda x: x['participations'], reverse=True)[:10]
        
        text = (

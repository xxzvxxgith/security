@contextmanager
def database():
    con = sqlite3.connect(DB_PATH, timeout=20)
    con.row_factory = sqlite3.Row
    try:
        con.execute("PRAGMA foreign_keys=ON")
        con.execute("PRAGMA busy_timeout=20000")
        yield con
        con.commit()
    except Exception:
        con.rollback()
        raise
    finally:
        con.close()


def now():
    return int(time.time())


def init_db():
    with database() as con:
        con.execute("PRAGMA journal_mode=WAL")
        con.executescript("""
        CREATE TABLE IF NOT EXISTS admins (
            user_id INTEGER PRIMARY KEY,
            added_at INTEGER NOT NULL,
            added_by INTEGER NOT NULL
        );

        CREATE TABLE IF NOT EXISTS giveaways (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            creator_id INTEGER NOT NULL,
            chat_id INTEGER,
            chat_title TEXT,
            message_id INTEGER,
            title TEXT NOT NULL,
            winner_count INTEGER NOT NULL,
            duration_seconds INTEGER NOT NULL,
            exclude_previous INTEGER NOT NULL DEFAULT 0,
            status TEXT NOT NULL DEFAULT 'draft',
            created_at INTEGER NOT NULL,
            ends_at INTEGER,
            closed_at INTEGER,
            drawn_at INTEGER
        );

        CREATE TABLE IF NOT EXISTS participants (
            giveaway_id INTEGER NOT NULL
                REFERENCES giveaways(id) ON DELETE CASCADE,
            user_id INTEGER NOT NULL,
            username TEXT,
            full_name TEXT NOT NULL,
            joined_at INTEGER NOT NULL,
            excluded INTEGER NOT NULL DEFAULT 0,
            PRIMARY KEY (giveaway_id, user_id)
        );

        CREATE TABLE IF NOT EXISTS winners (
            giveaway_id INTEGER NOT NULL
                REFERENCES giveaways(id) ON DELETE CASCADE,
            user_id INTEGER NOT NULL,
            username TEXT,
            full_name TEXT NOT NULL,
            place INTEGER NOT NULL,
            drawn_at INTEGER NOT NULL,
            PRIMARY KEY (giveaway_id, user_id),
            UNIQUE (giveaway_id, place)
        );

        CREATE TABLE IF NOT EXISTS previous_winners (
            user_id INTEGER PRIMARY KEY,
            last_won_at INTEGER NOT NULL
        );

        CREATE TABLE IF NOT EXISTS audit_log (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            actor_id INTEGER NOT NULL,
            action TEXT NOT NULL,
            giveaway_id INTEGER,
            details TEXT,
            created_at INTEGER NOT NULL
        );

        CREATE INDEX IF NOT EXISTS idx_giveaway_status
            ON giveaways(status);

        CREATE INDEX IF NOT EXISTS idx_participants_giveaway
            ON participants(giveaway_id);
        """)


def audit(con, actor, action, gid=None, details=None):
    con.execute(
        """INSERT INTO audit_log
           (actor_id, action, giveaway_id, details, created_at)
           VALUES (?, ?, ?, ?, ?)""",
        (actor, action, gid, details, now()),
    )


def get_giveaway(gid):
    with database() as con:
        return con.execute(
            "SELECT * FROM giveaways WHERE id=?", (gid,)
        ).fetchone()


def is_owner(user_id):
    return user_id == OWNER_ID


def is_admin(user_id):
    if is_owner(user_id):
        return True
    with database() as con:
        return con.execute(
            "SELECT 1 FROM admins WHERE user_id=?", (user_id,)
        ).fetchone() is not None


def can_manage(user_id, giveaway):
    return (
        giveaway is not None
        and (
            is_owner(user_id)
            or (
                is_admin(user_id)
                and giveaway["creator_id"] == user_id
            )
        )
    )


def participant_count(gid):
    with database() as con:
        return con.execute(
            """SELECT COUNT(*) FROM participants
               WHERE giveaway_id=? AND excluded=0""",
            (gid,),
        ).fetchone()[0]



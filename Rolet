    async def handle_callback(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        query = update.callback_query
        user = query.from_user
        data = query.data
        
        await query.answer()
        if await self.is_banned(user.id):
            return
        
        handlers = {
            'back_main': self.back_to_main,
            'check_forced': self.check_forced_callback,
            'start_roulette': self.start_roulette,
            'create_contest': self.show_contest_menu,
            'contest_like': self.start_roulette,
            'contest_deserve': self.start_roulette,
            'quick_roulette': self.show_quick_roulette_menu,
            'qr_create': self.start_roulette,
            'qr_settings': self.show_quick_roulette_settings,
            'qr_toggle_names': self.toggle_qr_names,
            'qr_edit_text': self.prompt_qr_text,
            'qr_vote_cond': self.prompt_qr_vote,
            'qr_interact_cond': self.prompt_qr_interact,
            'qr_reset_defaults': self.reset_qr_defaults,
            'add_channel': self.start_add_channel,
            'add_group': self.start_add_group,
            'view_channels': self.view_my_channels,
            'delete_channel_menu': self.delete_channel_menu,
            'my_roulettes': self.show_my_roulettes,
            'cycle_roulette_filter': self.cycle_roulette_filter,
            'my_stats': self.show_stats,
            'reminders_info': self.reminders_info,
            'terms': self.show_terms,
            'bot_support': self.show_support,
            'pay_5_stars': self.pay_stars_callback,
            'admin_panel': self.show_admin_panel,
            'admin_stats': self.show_admin_stats,
            'admin_forced': self.manage_forced_channels,
            'admin_banned': self.manage_banned,
            'admin_broadcast': self.start_broadcast,
            'admin_settings': self.show_settings,
        }
        
        if data in handlers:
            await handlers[data](update, context)
            return
        
        if data.startswith('join_'):
            await self.join_roulette(update, context, data[5:])
        elif data.startswith('remind_'):
            await self.set_reminder(update, context, data[7:])
        elif data.startswith('toggle_'):
            await self.toggle_roulette(update, context, data[7:])
        elif data.startswith('draw_'):
            await self.start_draw(update, context, data[5:])
        elif data.startswith('participants_'):
            await self.view_participants(update, context, data[13:])
        elif data.startswith('del_ch_'):
            await self.delete_channel(update, context, data[7:])
        elif data.startswith('sel_ch_'):
            await self.handle_selected_channel(update, context, data[7:])
    

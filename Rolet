@bot.callback_query_handler(func=lambda call: call.data == "toggle_notifications")
def toggle_notifications(call):
    user_id = call.from_user.id
    
    existing = db.fetch_one("SELECT enabled FROM reminders WHERE user_id = ?", (user_id,))
    
    if existing:
        new_status = 1 - existing[0]
        db.execute("UPDATE reminders SET enabled = ? WHERE user_id = ?", (new_status, user_id))
    else:
        db.execute("INSERT INTO reminders VALUES (?, 1, ?)", (user_id, datetime.now().isoformat()))
        new_status = 1
    
    status_text = "🟢 مفعلة الآن" if new_status else "🔴 معطلة الآن"

@bot.callback_query_handler(func=lambda call: call.data.startswith("remove_participant:"))
def remove_participant(call):
    user_id = call.from_user.id
    parts = call.data.split(":")
    roulette_key = parts[1]
    participant_id = int(parts[2])
    
    # Verify that the user is the creator
    roulette = db.fetch_one(
        "SELECT id, creator_id, participants_count FROM roulettes WHERE roulette_key = ?",
        (roulette_key,)
    )
    
    if not roulette:
        bot.answer_callback_query(call.id, "❌ الروليت غير موجودة", show_alert=True)
        return
    
    roulette_id, creator_id, participants_count = roulette
    
    if user_id != creator_id:
        bot.answer_callback_query(call.id, "❌ أنت لست منشئ الروليت", show_alert=True)
        return
    
    # Remove participant
    db.execute(
        "DELETE FROM participants WHERE user_id = ? AND roulette_id = ?",
        (participant_id, roulette_id)
    )
    
    # Update participants count
    new_count = max(0, participants_count - 1)
    db.execute(
        "UPDATE roulettes SET participants_count = ? WHERE id = ?",
        (new_count, roulette_id)
    )
    
    bot.answer_callback_query(call.id, "✅ تم طرد المشارك", show_alert=True)
    
    # Notify the removed participant
    try:
        bot.send_message(
            participant_id,
            f"<b>❌ تم طردك من الروليت</b>\n\n"
            f"<b>━━━━━━━━━━━━━━━━━━━━━━</b>\n\n"
            f"<i>منشئ الروليت قام بطردك من المشاركة</i>\n\n"

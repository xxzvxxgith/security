@dp.message(Command("send"))
async def send_command(message: Message, state: FSMContext):
    """اختياري: /send CODE لبدء كتابة معايدة لشجرة."""
    parts = (message.text or "").split(maxsplit=1)
    if len(parts) != 2:
        return await message.answer("استخدم /send CODE الموجود في رابط الشجرة.")
    target = await get_user_by_code(parts[1].strip())
    if not target:
        return await message.answer("رابط الشجرة غير صحيح.")
    if target["user_id"] == message.from_user.id:
        return await message.answer("هذه شجرتك أنت.")
    if not await subscription_gate(message=message):
        return
    if await get_setting("greetings_open", "1") != "1":
        return await message.answer("استقبال المعايدات متوقف حالياً.")
    await state.set_state(UserStates.waiting_greeting)
    await state.update_data(receiver_id=int(target["user_id"]))
    await message.answer(
        f"🎄 أنت تكتب الآن معايدة إلى شجرة <b>{html_escape(target['full_name'])}</b>.\n\n"
        "اكتب معايدتك برسالة واحدة.\n"
        "ملاحظة: ستصل رسالتك إلى صاحب الشجرة، وقد تُراجع عند الإبلاغ أو الاشتباه بإساءة الاستخدام."
    )


# ============================= معالج رابط /start CODE الفعلي =============================

# تسجيل معالج خاص قبل الإقلاع: نستخدمه لالتقاط /start مع payload.
# عند وجود كود شجرة، نبدأ حالة كتابة المعايدة؛ وإلا نعرض الرئيسية.
@dp.message(CommandStart())
async def start_deeplink_handler(message: Message, state: FSMContext):
    # هذا المعالج الإضافي يتجاوز المعالج السابق عند ترتيب التسجيل؛
    # نعيد تنفيذ السلوك هنا لضمان دعم Deep Linking.
    await state.clear()
    user = message.from_user
    if await user_is_banned(user.id):
        return await message.answer("🚫 حسابك محظور من استخدام البوت.")
    if not await subscription_gate(message=message):
        return
    args = (message.text or "").split(maxsplit=1)
    payload = args[1].strip() if len(args) > 1 else ""
    if payload and payload != "home":
        target = await get_user_by_code(payload)
        if not target:
            await ensure_user(user)
            return await message.answer("رابط الشجرة غير صحيح أو لم يعد متاحاً.", reply_markup=main_keyboard())
        if int(target["user_id"]) == user.id:
            await ensure_user(user)
            return await message.answer("🎄 هذه شجرتك الخاصة! لا يمكنك إرسال معايدة لنفسك.", reply_markup=main_keyboard())
        await ensure_user(user, int(target["user_id"]))
        async with await db() as con:
            await con.execute(
                "INSERT OR IGNORE INTO visits(owner_id,visitor_id,first_seen) VALUES(?,?,?)",
                (int(target["user_id"]), user.id, now_iso())
            )
            await con.commit()
        if await get_setting("greetings_open", "1") != "1":
            return await message.answer("⛔ استقبال المعايدات متوقف حالياً.")
        await state.set_state(UserStates.waiting_greeting)
        await state.update_data(receiver_id=int(target["user_id"]))
        return await message.answer(
            f"🎄 <b>أهلاً بك!</b>\nأنت تكتب معايدة إلى شجرة <b>{html_escape(target['full_name'])}</b>.\n\n"
            "✍️ اكتب معايدتك الآن برسالة واحدة.\n"
            "🔐 تنبيه: ستصل رسالتك إلى صاحب الشجرة، وقد تُراجع عند الإبلاغ أو الاشتباه بإساءة الاستخدام."
        )
    await ensure_user(user)
    count, _, _, _ = await get_counts(user.id)
    await message.answer(
        f"🎄 <b>أهلاً بك في NewYear</b>\n\n"
        f"مرحباً {html_escape(user.first_name)} ✨\n"
        f"💌 معايداتك الحالية: <b>{count}</b>\n"
        f"🗓️ السنة الحالية: <b>{current_year()}</b>\n\nاختر من القائمة:",
        reply_markup=main_keyboard()
    )



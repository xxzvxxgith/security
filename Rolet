class DataManager:
    """مدير البيانات المركزي - يضمن حفظ وتحميل البيانات بأمان"""
    
    def __init__(self):
        self._lock = asyncio.Lock()
        self._cache: Dict[str, Any] = {}
        self._init_files()
    
    def _init_files(self):
        defaults = {
            USERS_FILE: {},
            ROULETTES_FILE: {},
            BOUND_CHANNELS_FILE: {},
            BANNED_USERS_FILE: {},
            TEMP_FILE: {},
            SETTINGS_FILE: {
                'bot_active': True,
                'forced_channels': {},
                'maintenance_msg': 'البوت متوقف للصيانة حالياً 🔧',
                'admin_ids': [],
                'referral_points': 2,
                'daily_gift_points': 5,
                'roulette_min_bet': 5,
                'roulette_max_bet': 500
            }
        }
        for filepath, default in defaults.items():
            if not os.path.exists(filepath):
                with open(filepath, 'w', encoding='utf-8') as f:
                    json.dump(default, f, ensure_ascii=False, indent=2)
    
    def _read(self, filepath: str) -> Dict:
        try:
            with open(filepath, 'r', encoding='utf-8') as f:
                return json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            return {}
    
    def _write(self, filepath: str, data: Dict) -> bool:
        try:
            temp_path = f"{filepath}.tmp"
            with open(temp_path, 'w', encoding='utf-8') as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
            os.replace(temp_path, filepath)
            return True
        except Exception as e:
            logger.error(f"خطأ في الكتابة: {e}")
            return False
    
    async def get_users(self) -> Dict:
        async with self._lock:
            return self._read(USERS_FILE)
    
    async def save_users(self, data: Dict) -> bool:
        async with self._lock:
            return self._write(USERS_FILE, data)
    
    async def get_roulettes(self) -> Dict:
        async with self._lock:
            return self._read(ROULETTES_FILE)
    
    async def save_roulettes(self, data: Dict) -> bool:
        async with self._lock:
            return self._write(ROULETTES_FILE, data)
    
    async def get_bound_channels(self) -> Dict:
        async with self._lock:
            return self._read(BOUND_CHANNELS_FILE)
    
    async def save_bound_channels(self, data: Dict) -> bool:
        async with self._lock:
            return self._write(BOUND_CHANNELS_FILE, data)
    
    async def get_banned(self) -> Dict:
        async with self._lock:
            return self._read(BANNED_USERS_FILE)
    
    async def save_banned(self, data: Dict) -> bool:
        async with self._lock:
            return self._write(BANNED_USERS_FILE, data)
    
    async def get_settings(self) -> Dict:
        async with self._lock:
            return self._read(SETTINGS_FILE)
    
    async def save_settings(self, data: Dict) -> bool:
        async with self._lock:
            return self._write(SETTINGS_FILE, data)
    
    async def get_temp(self, user_id: int) -> Dict:
        async with self._lock:
            data = self._read(TEMP_FILE)
            return data.get(str(user_id), {})
    
    async def save_temp(self, user_id: int, temp_data: Dict) -> bool:
        async with self._lock:
            data = self._read(TEMP_FILE)
            data[str(user_id)] = temp_data
            return self._write(TEMP_FILE, data)
    
    async def delete_temp(self, user_id: int) -> bool:
        async with self._lock:
            data = self._read(TEMP_FILE)
            if str(user_id) in data:
                del data[str(user_id)]
            return self._write(TEMP_FILE, data)


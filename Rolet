async def close_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    if not is_admin(uid):
        await update.effective_message.reply_text("ليس لديك صلاحية.")
        return
    if not context.args or not context.args[0].isdigit():
        await update.effective_message.reply_text("الاستخدام: /close رقم_السحب")
        return
    gid = int(context.args[0])
    g = get_giveaway(gid)
    if not can_manage(uid, g):
        await update.effective_message.reply_text("السحب غير موجود أو ليس لديك صلاحية إدارته.")
        return
    changed = await close_giveaway(context, gid, uid)
    await update.effective_message.reply_text(
        "تم إغلاق التسجيل." if changed else "التسجيل مغلق مسبقاً أو غير نشط."
    )


async def draw_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    if not is_admin(uid):
        await update.effective_message.reply_text("ليس لديك صلاحية.")
        return
    if not context.args or not context.args[0].isdigit():
        await update.effective_message.reply_text("الاستخدام: /draw رقم_السحب")
        return
    gid = int(context.args[0])
    result = perform_draw(gid, uid)
    if isinstance(result, str):
        await update.effective_message.reply_text(result)
        return
    await publish_results(context, gid, result, update.effective_message)



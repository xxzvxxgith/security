# 🔄 UPDATED ROULETTE MESSAGE FUNCTION
# ═══════════════════════════════════════════════════════════════════════════════

def update_roulette_message(roulette_id, channel_id, participants_count):
    """تحديث رسالة الروليت في القناة"""
    try:
        # الحصول على معلومات الروليت
        roulette = db.fetch_one(
            "SELECT message_id, message_text, winners_count, countdown_seconds FROM roulettes WHERE id = ?",
            (roulette_id,)
        )
        
        if not roulette:
            return
        
        message_id, message_text, winners_count, countdown = roulette
        
        # الحصول على قنوات الشرط
        channels = get_roulette_condition_channels(roulette_id)
        
        # بناء النص المحدث
        updated_text = f"🎰 {message_text}\n\n"
        updated_text += f"<b>📋 شروط الاشتراك:</b>\n"
        
        for i, (ch_id, ch_name) in enumerate(channels, 1):
            channel_mention = f"@{ch_id[1:]}" if ch_id.startswith("@") else ch_id
            updated_text += f"{i}. 🔗 {channel_mention}\n"
        
        updated_text += f"\n<b>🏆 عدد الفائزين:</b> {winners_count}\n"
        updated_text += f"<b>📊 المشاركون: {participants_count}</b>\n"
        updated_text += f"<b>⏱️ وقت العد:</b> {countdown} ثانية\n\n"
        updated_text += f'<a href="{get_bot_link()}">🎰 Roulette RedFox</a>'
        
        # تحديث الرسالة في القناة
        bot.edit_message_text(updated_text, channel_id, message_id)
        
    except Exception as e:
        logger.error(f"Error updating roulette message: {e}")


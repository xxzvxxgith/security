async def exclude_command(update:Update,context:ContextTypes.DEFAULT_TYPE):
    uid=update.effective_user.id
    if not is_admin(uid): await update.effective_message.reply_text('ليس لديك صلاحية.'); return
    if len(context.args)!=2 or not all(x.isdigit() for x in context.args): await update.effective_message.reply_text('الاستخدام: /exclude USER_ID GIVEAWAY_ID'); return
    user_id,gid=map(int,context.args)
    with database() as c:
        c.execute('BEGIN IMMEDIATE'); g=c.execute('SELECT * FROM giveaways WHERE id=?',(gid,)).fetchone()
        if not can_manage(uid,g) or g['status']!='open': await update.effective_message.reply_text('لا يمكن استبعاد مشارك من هذا السحب.'); return
        cur=c.execute('UPDATE participants SET excluded=1 WHERE giveaway_id=? AND user_id=?',(gid,user_id))
        if cur.rowcount: audit(c,uid,'exclude',gid,str(user_id))
    if cur.rowcount: await refresh_post(context,gid); await update.effective_message.reply_text('تم استبعاد المشارك.')
    else: await update.effective_message.reply_text('المشارك غير موجود.')
async def show_mine(message,uid):
    with database() as c: rows=c.execute('SELECT id,title,status,winner_count FROM giveaways WHERE creator_id=? ORDER BY id DESC LIMIT 20',(uid,)).fetchall()
    if not rows: await message.reply_text('لا توجد سحوبات مسجلة.'); return
    lines=['📋 <b>سحوباتك</b>\n']
    for r in rows: lines.append(f"🎡 #{r['id']} — {html.escape(r['title'])}\nالحالة: {html.escape(r['status'])} | الفائزون: {r['winner_count']}\n/close {r['id']} | /draw {r['id']}\n")
    await message.reply_text('\n'.join(lines),parse_mode='HTML')
async def show_stats(message):
    with database() as c:
        total=c.execute('SELECT COUNT(*) FROM giveaways').fetchone()[0]; opened=c.execute("SELECT COUNT(*) FROM giveaways WHERE status='open'").fetchone()[0]; entries=c.execute('SELECT COUNT(*) FROM participants WHERE excluded=0').fetchone()[0]; winners=c.execute('SELECT COUNT(*) FROM winners').fetchone()[0]
    await message.reply_text(f'📊 <b>إحصائيات البوت</b>\n\n🎡 جميع السحوبات: {total}\n🟢 السحوبات المفتوحة: {opened}\n👥 المشاركات الفعالة: {entries}\n🏆 سجلات الفائزين: {winners}',parse_mode='HTML')
async def show_history(message):
    with database() as c:
        rows=c.execute("SELECT id,title FROM giveaways WHERE status='drawn' ORDER BY drawn_at DESC LIMIT 10").fetchall(); results=[]
        for r in rows: results.append((r,c.execute('SELECT full_name,username,place FROM winners WHERE giveaway_id=? ORDER BY place',(r['id'],)).fetchall()))
    if not results: await message.reply_text('لا توجد نتائج حتى الآن.'); return
    lines=['🏆 <b>آخر نتائج الروليت</b>\n']
    for r,ws in results:
        lines.append(f"\n🎡 <b>#{r['id']}</b> — {html.escape(r['title'])}")
        for w in ws:
            name=html.escape(w['full_name'])
            if w['username']: name+=f" (@{html.escape(w['username'])})"
            lines.append(f"{w['place']}. {name}")
    await message.reply_text('\n'.join(lines),parse_mode='HTML')

async def callback(update:Update,context:ContextTypes.DEFAULT_TYPE):
    q=update.callback_query
    if not q: return
    uid=q.from_user.id; data=q.data or ''; alert=None; reply=None
    try:
        if ':' not in data: await q.answer('طلب غير صالح.',show_alert=True); return
        action,gid_text=data.split(':',1)
        if not gid_text.isdigit(): await q.answer('طلب غير صالح.',show_alert=True); return
        gid=int(gid_text); g=get_giveaway(gid)
        if action in ('join','leave'):
            if q.from_user.is_bot: await q.answer('حسابات البوتات لا تشارك.',show_alert=True); return
            with database() as c:
                c.execute('BEGIN IMMEDIATE'); current=c.execute('SELECT * FROM giveaways WHERE id=?',(gid,)).fetchone()
                if not current or current['status']!='open' or (current['ends_at'] and now()>=current['ends_at']):
                    if current and current['status']=='open' and current['ends_at'] and now()>=current['ends_at']:
                        c.execute("UPDATE giveaways SET status='closed',closed_at=? WHERE id=? AND status='open'",(now(),gid)); audit(c,OWNER_ID,'auto_close',gid)
                    alert='انتهى التسجيل أو أن السحب مغلق.'
                elif action=='join':
                    old=c.execute('SELECT excluded FROM participants WHERE giveaway_id=? AND user_id=?',(gid,uid)).fetchone()
                    c.execute('INSERT INTO participants(giveaway_id,user_id,username,full_name,joined_at,excluded) VALUES(?,?,?,?,?,0) ON CONFLICT(giveaway_id,user_id) DO UPDATE SET username=excluded.username,full_name=excluded.full_name,joined_at=excluded.joined_at,excluded=0',(gid,uid,q.from_user.username,q.from_user.full_name,now()))
                    audit(c,uid,'join',gid); alert='تم تسجيل مشاركتك 🎟' if not old else 'تم تحديث مشاركتك.'
                else:
                    cur=c.execute('DELETE FROM participants WHERE giveaway_id=? AND user_id=?',(gid,uid)); audit(c,uid,'leave',gid); alert='تم إلغاء مشاركتك.' if cur.rowcount else 'أنت غير مسجل في هذا السحب.'
            await q.answer(alert,show_alert=True); await refresh_post(context,gid); return
        if action in ('close','draw'):
            if not can_manage(uid,g): await q.answer('هذا الزر مخصص لمدير السحب.',show_alert=True); return
            await q.answer()
            if action=='close':
                changed=await close_giveaway(context,gid,uid); reply='تم إغلاق التسجيل.' if changed else 'التسجيل مغلق مسبقاً أو غير نشط.'
                await q.message.reply_text(reply); return
            result=perform_draw(gid,uid)
            if isinstance(result,str): await q.message.reply_text(result); return
            await publish_results(context,gid,result,q.message); return
        await q.answer('زر غير معروف.',show_alert=True)
    except TelegramError as e: log.warning('Telegram callback error: %s',e)
    except Exception: log.exception('Callback failed')

async def flow_message(update:Update,context:ContextTypes.DEFAULT_TYPE):
    if not update.effective_user or not update.effective_message or update.effective_chat.type!=ChatType.PRIVATE: return
    uid=update.effective_user.id; m=update.effective_message; text=(m.text or '').strip()
    if text==MENU_CANCEL: flows.pop(uid,None); await m.reply_text('تم إلغاء العملية.',reply_markup=main_keyboard(uid)); return
    if text in ('/start','🏠 القائمة الرئيسية'): flows.pop(uid,None); await m.reply_text('القائمة الرئيسية:',reply_markup=main_keyboard(uid)); return
    if text==MENU_CREATE:
        if not is_admin(uid): await m.reply_text('هذه الميزة للمشرفين فقط.',reply_markup=main_keyboard(uid)); return
        flows[uid]={'step':'title'}; await m.reply_text('🎁 أرسل عنوان الجائزة أو السحب:'); return
    if text==MENU_MINE: await show_mine(m,uid); return
    if text==MENU_STATS: await show_stats(m); return
    if text==MENU_HISTORY: await show_history(m); return
    if text==MENU_ADMINS:
        if is_owner(uid): await m.reply_text('🛡 إدارة المشرفين\n/addadmin USER_ID لإضافة مشرف\n/deladmin USER_ID لحذفه')
        else: await m.reply_text('هذه الميزة للمالك فقط.')
        return
    f=flows.get(uid)
    if not f: return
    if not is_admin(uid): flows.pop(uid,None); await m.reply_text('ليس لديك صلاحية.'); return
    step=f.get('step')
    if step=='title':
        if not text or len(text)>MAX_TITLE_LENGTH: await m.reply_text(f'العنوان يجب أن يكون بين 1 و{MAX_TITLE_LENGTH} حرفاً.'); return
        f.update(title=text,step='winners'); await m.reply_text('🏆 كم عدد الفائزين؟ أرسل رقماً من 1 إلى 100.'); return
    if step=='winners':
        if not text.isdigit() or not 1<=int(text)<=MAX_WINNERS: await m.reply_text('أرسل رقماً من 1 إلى 100.'); return
        f.update(winner_count=int(text),step='duration'); await m.reply_text('⏳ مدة التسجيل بالدقائق (0 دون مؤقت):'); return
    if step=='duration':
        if not text.isdigit() or int(text)>MAX_DURATION_MINUTES: await m.reply_text(f'أرسل رقماً من 0 إلى {MAX_DURATION_MINUTES}.'); return
        f.update(duration=int(text)*60,step='exclude_previous'); await m.reply_text('هل تريد استبعاد الفائزين السابقين؟ أرسل نعم أو لا.'); return
    if step=='exclude_previous':
        if text.casefold() not in ('نعم','لا','yes','no'): await m.reply_text('أرسل نعم أو لا.'); return
        f.update(exclude_previous=int(text.casefold() in ('نعم','yes')),step='destination'); await m.reply_text('📍 أرسل @اسم_القناة أو معرّف القناة/المجموعة الرقمي، وتأكد من صلاحيات البوت.'); return
    if step=='destination':
        if text.startswith('@') and 2<len(text)<=64 and text[1:].replace('_','').isalnum(): target=text
        else:
            try: target=int(text)
            except ValueError: await m.reply_text('أرسل @username أو معرّفاً رقمياً صالحاً.'); return
        f.update(target=target,step='confirm'); await m.reply_text(f"📋 تأكيد السحب\n\n🎁 {html.escape(f['title'])}\n🏆 الفائزون: {f['winner_count']}\n⏳ المدة: {f['duration']//60} دقيقة\n📍 الوجهة: <code>{html.escape(str(target))}</code>\n\nأرسل نعم للنشر أو لا للإلغاء.",parse_mode='HTML'); return
    if step=='confirm':
        if text.casefold() not in ('نعم','yes'): flows.pop(uid,None); await m.reply_text('تم إلغاء إنشاء السحب.',reply_markup=main_keyboard(uid)); return
        target=f['target']; duration=f['duration']; ends=now()+duration if duration else None
        with database() as c:
            cur=c.execute("INSERT INTO giveaways(creator_id,title,winner_count,duration_seconds,exclude_previous,status,created_at,ends_at) VALUES(?,?,?,?,?,'draft',?,?)",(uid,f['title'],f['winner_count'],duration,f['exclude_previous'],now(),ends)); gid=cur.lastrowid; audit(c,uid,'create',gid,str(target))
        try:
            sent=await context.bot.send_message(chat_id=target,text=post_text(gid),parse_mode='HTML',reply_markup=post_keyboard(gid,'open'))
            with database() as c:
                c.execute("UPDATE giveaways SET chat_id=?,chat_title=?,message_id=?,status='open' WHERE id=? AND status='draft'",(sent.chat_id,sent.chat.title or sent.chat.username or str(sent.chat_id),sent.message_id,gid)); audit(c,uid,'publish',gid)
            await refresh_post(context,gid)
            if ends: schedule_close(context.application,gid,ends)
            await m.reply_text(f'✅ تم نشر السحب #{gid} بنجاح.\n/close {gid}\n/draw {gid}',reply_markup=main_keyboard(uid))
        except TelegramError as e:
            log.warning('Publishing failed: %s',e)
            with database() as c: c.execute("UPDATE giveaways SET status='draft' WHERE id=?",(gid,)); audit(c,uid,'publish_failed',gid,str(e)[:250])
            await m.reply_text('تعذر النشر. تحقق من الوجهة وصلاحيات البوت.',reply_markup=main_keyboard(uid))
        finally: flows.pop(uid,None)

async def post_init(app:Application): await restore_timers(app); log.info('Timers restored')
async def error_handler(update:object,context:ContextTypes.DEFAULT_TYPE): log.error('Unhandled update exception',exc_info=context.error)
def main():
    if not TOKEN: raise SystemExit('BOT_TOKEN غير موجود. عيّن رمز البوت في متغير البيئة.')
    init_db(); app=Application.builder().token(TOKEN).post_init(post_init).build()
    app.add_handler(CommandHandler('start',start)); app.add_handler(CommandHandler('cancel',cancel)); app.add_handler(CommandHandler('close',close_command)); app.add_handler(CommandHandler('draw',draw_command)); app.add_handler(CommandHandler('exclude',exclude_command)); app.add_handler(CommandHandler('addadmin',addadmin_command)); app.add_handler(CommandHandler('deladmin',deladmin_command)); app.add_handler(CallbackQueryHandler(callback)); app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND,flow_message)); app.add_error_handler(error_handler)
    log.info('Roulette bot started. Owner ID: %s',OWNER_ID); app.run_polling()
if __name__=='__main__': main()

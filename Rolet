class Database:
    def __init__(self, db_name="rroulette_bot.db"):
        self.db_name = db_name
        self.init_db()
    
    def init_db(self):
        with db_lock:
            conn = sqlite3.connect(self.db_name, check_same_thread=False)
            cursor = conn.cursor()
            
            cursor.execute('''CREATE TABLE IF NOT EXISTS users
                (user_id INTEGER PRIMARY KEY, username TEXT, first_name TEXT, joined_date TEXT,
                 total_participations INTEGER DEFAULT 0, total_wins INTEGER DEFAULT 0,
                 blocked INTEGER DEFAULT 0, balance INTEGER DEFAULT 0)''')
            
            cursor.execute('''CREATE TABLE IF NOT EXISTS channels
                (channel_id TEXT, channel_name TEXT, owner_id INTEGER, join_date TEXT,
                 PRIMARY KEY (channel_id, owner_id))''')
            
            cursor.execute('''CREATE TABLE IF NOT EXISTS required_channels
                (channel_id TEXT PRIMARY KEY, channel_name TEXT, added_date TEXT)''')
            
            cursor.execute('''CREATE TABLE IF NOT EXISTS roulettes
                (id INTEGER PRIMARY KEY AUTOINCREMENT, roulette_key TEXT UNIQUE,
                 creator_id INTEGER, channel_id TEXT, condition_channel TEXT,
                 winners_count INTEGER, message_text TEXT, message_id INTEGER,
                 participants_count INTEGER, status TEXT, created_date TEXT, winners TEXT,
                 prize_text TEXT, end_date TEXT, channel_name TEXT, countdown_seconds INTEGER DEFAULT 10)''')
            
            cursor.execute('''CREATE TABLE IF NOT EXISTS participants
                (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, roulette_id INTEGER,
                 username TEXT, first_name TEXT, join_time TEXT)''')
            
            cursor.execute('''CREATE TABLE IF NOT EXISTS reminders
                (user_id INTEGER PRIMARY KEY, enabled INTEGER, last_reminder TEXT)''')
            
            cursor.execute('''CREATE TABLE IF NOT EXISTS settings
                (key TEXT PRIMARY KEY, value TEXT)''')
            
            cursor.execute('''CREATE TABLE IF NOT EXISTS user_stats
                (user_id INTEGER PRIMARY KEY, participations INTEGER DEFAULT 0,
                 wins INTEGER DEFAULT 0, last_participation TEXT, total_prize_value REAL DEFAULT 0)''')
            
            cursor.execute('''CREATE TABLE IF NOT EXISTS roulette_history
                (id INTEGER PRIMARY KEY AUTOINCREMENT, roulette_id INTEGER, winners TEXT,
                 finish_date TEXT, channel_id TEXT, creator_id INTEGER)''')
            
            cursor.execute('''CREATE TABLE IF NOT EXISTS notifications
                (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, message TEXT,
                 created_date TEXT, is_read INTEGER DEFAULT 0)''')
            
            cursor.execute('''CREATE TABLE IF NOT EXISTS roulette_condition_channels
                (id INTEGER PRIMARY KEY AUTOINCREMENT,
                 roulette_id INTEGER,
                 channel_id TEXT,
                 channel_name TEXT,
                 FOREIGN KEY (roulette_id) REFERENCES roulettes(id))''')
            
            cursor.execute('''CREATE TABLE IF NOT EXISTS participant_channels_status
                (id INTEGER PRIMARY KEY AUTOINCREMENT,
                 participant_id INTEGER,
                 roulette_id INTEGER,
                 channel_id TEXT,
                 is_subscribed INTEGER DEFAULT 0,
                 checked_at TEXT,
                 FOREIGN KEY (participant_id) REFERENCES participants(id),
                 FOREIGN KEY (roulette_id) REFERENCES roulettes(id))''')
            
            try:
                cursor.execute("ALTER TABLE users ADD COLUMN blocked INTEGER DEFAULT 0")
            except:
                pass
            try:
                cursor.execute("ALTER TABLE roulettes ADD COLUMN roulette_key TEXT UNIQUE")
            except:
                pass
            try:
                cursor.execute("ALTER TABLE roulettes ADD COLUMN countdown_seconds INTEGER DEFAULT 10")
            except:
                pass
            
            cursor.execute('''INSERT OR IGNORE INTO settings (key, value) VALUES (?, ?)''',
                         ("mandatory_subscription", "1"))
            cursor.execute('''INSERT OR IGNORE INTO settings (key, value) VALUES (?, ?)''',
                         ("bot_status", "active"))
            cursor.execute('''INSERT OR IGNORE INTO settings (key, value) VALUES (?, ?)''',
                         ("maintenance_mode", "0"))
            
            conn.commit()
            conn.close()
    
    def execute(self, query, params=()):
        try:
            with db_lock:
                conn = sqlite3.connect(self.db_name, check_same_thread=False)
                cursor = conn.cursor()
                cursor.execute(query, params)
                conn.commit()
                conn.close()
                return True
        except Exception as e:
            logger.error(f"Database execute error: {e}")
            return False
    
    def fetch_one(self, query, params=()):
        try:
            with db_lock:
                conn = sqlite3.connect(self.db_name, check_same_thread=False)
                cursor = conn.cursor()
                cursor.execute(query, params)
                result = cursor.fetchone()
                conn.close()
                return result
        except Exception as e:
            logger.error(f"Database fetch_one error: {e}")
            return None
    
    def fetch_all(self, query, params=()):
        try:
            with db_lock:
                conn = sqlite3.connect(self.db_name, check_same_thread=False)
                cursor = conn.cursor()
                cursor.execute(query, params)
                result = cursor.fetchall()
                conn.close()
                return result
        except Exception as e:
            logger.error(f"Database fetch_all error: {e}")
            return []


        if not roulette_key:
            bot.send_message(user_id, "<b>❌ الروليت غير متوفرة</b>")
            return
        
        roulette = db.fetch_one(
            "SELECT id, condition_channel, status, creator_id FROM roulettes WHERE roulette_key = ?",
            (roulette_key,)
        )
        
        if not roulette:
            bot.send_message(user_id, "<b>❌ الروليت غير متوفرة</b>")
            return
        
        roulette_id, condition_channel, status, creator_id = roulette
        
        if status != "active":
            bot.send_message(user_id, "<b>❌ انتهت الروليت بالفعل</b>")

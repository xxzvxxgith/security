async def show_greetings(call: CallbackQuery, year=None, page=0):
    user_id = call.from_user.id
    offset = page * PAGE_SIZE
    async with await db() as con:
        if year is None:
            cur = await con.execute(
                "SELECT * FROM greetings WHERE receiver_id=? ORDER BY id DESC LIMIT ? OFFSET ?",
                (user_id, PAGE_SIZE, offset)
            )
            count_cur = await con.execute(
                "SELECT COUNT(*) n FROM greetings WHERE receiver_id=?", (user_id,)
            )
        else:
            cur = await con.execute(
                "SELECT * FROM greetings WHERE receiver_id=? AND year=? ORDER BY id DESC LIMIT ? OFFSET ?",
                (user_id, year, PAGE_SIZE, offset)
            )
            count_cur = await con.execute(
                "SELECT COUNT(*) n FROM greetings WHERE receiver_id=? AND year=?", (user_id, year)
            )
        rows = await cur.fetchall()
        total = (await count_cur.fetchone())["n"]

    if not rows:
        return await call.message.edit_text(
            "💌 لا توجد معايدات في هذا القسم بعد.",
            reply_markup=back_keyboard("home")
        )

    lines = [f"💌 <b>{'معايداتي' if year is None else 'أرشيف ' + str(year)}</b>\n"]
    delete_rows = []
    for r in rows:
        stamp = html_escape(r["created_at"][:16].replace("T", " "))
        sender = html_escape(r["sender_name"])
        body = html_escape(r["message_text"])
        lines.append(
            f"━━━━━━━━━━━━\n"
            f"👤 <b>{sender}</b>\n"
            f"🗓️ {stamp}\n"
            f"{body}\n"
            f"🆔 <code>{r['id']}</code>"
        )
        delete_rows.append([InlineKeyboardButton(text=f"🗑 حذف المعايدة #{r['id']}", callback_data=f"greet_del:{r['id']}:{year if year is not None else 'all'}:{page}")])

    pages = max(1, (total + PAGE_SIZE - 1) // PAGE_SIZE)
    nav = []
    if page > 0:
        nav.append(InlineKeyboardButton(text="⬅️ السابق", callback_data=f"page:{year if year is not None else 'all'}:{page-1}"))
    nav.append(InlineKeyboardButton(text=f"{page+1}/{pages}", callback_data="noop"))
    if (page + 1) * PAGE_SIZE < total:
        nav.append(InlineKeyboardButton(text="التالي ➡️", callback_data=f"page:{year if year is not None else 'all'}:{page+1}"))
    rows_kb = delete_rows + [nav]
    rows_kb.append([InlineKeyboardButton(text="⬅️ رجوع", callback_data="archive" if year is not None else "home")])
    await call.message.edit_text("\n".join(lines), reply_markup=InlineKeyboardMarkup(inline_keyboard=rows_kb))



# -------------------- CLOSE / TIMER --------------------
async def close_giveaway(context, gid, actor_id=None):
    with database() as con:
        con.execute("BEGIN IMMEDIATE")
        row = con.execute("SELECT * FROM giveaways WHERE id=?", (gid,)).fetchone()
        if not row or row["status"] != "open":
            return False
        con.execute(
            "UPDATE giveaways SET status='closed',closed_at=? WHERE id=? AND status='open'",
            (now(), gid),
        )
        audit(con, actor_id or OWNER_ID, "close", gid)
    await refresh_post(context, gid)
    return True


async def timer_close(context):
    gid = context.job.data["gid"]
    if await close_giveaway(context, gid):
        g = get_giveaway(gid)
        if g:
            try:
                await context.bot.send_message(
                    chat_id=g["creator_id"],
                    text=f"⏰ انتهى التسجيل في السحب #{gid}.\nاستخدم /draw {gid} لسحب الفائزين.",
                )
            except TelegramError as exc:
                log.warning("تعذر إرسال تنبيه انتهاء السحب: %s", exc)


async def restore_timers(app):
    with database() as con:
        rows = con.execute("SELECT id,ends_at FROM giveaways WHERE status='open'").fetchall()
    if app.job_queue is None:
        log.error("JobQueue غير متاحة. ثبّت: pip install 'python-telegram-bot[job-queue]'")
        return
    for row in rows:
        if row["ends_at"] is not None:
            app.job_queue.run_once(
                timer_close,
                when=max(0, row["ends_at"] - now()),
                data={"gid": row["id"]},
                name=f"giveaway-{row['id']}",
            )
    log.info("تم استرجاع مؤقتات السحوبات.")


# -------------------- DRAWING --------------------
def perform_draw(gid, actor_id):
    with database() as con:
        con.execute("BEGIN IMMEDIATE")
        g = con.execute("SELECT * FROM giveaways WHERE id=?", (gid,)).fetchone()
        if not g:
            return "السحب غير موجود."
        if g["status"] not in ("open", "closed"):
            return "تم السحب مسبقاً أو أن السحب غير جاهز."
        if not can_manage(actor_id, g):
            return "ليس لديك صلاحية إدارة هذا السحب."
        people = con.execute(
            "SELECT user_id,username,full_name FROM participants WHERE giveaway_id=? AND excluded=0",
            (gid,),
        ).fetchall()
        if g["exclude_previous"]:
            previous = {
                r["user_id"] for r in con.execute("SELECT user_id FROM previous_winners").fetchall()
            }
            people = [p for p in people if p["user_id"] not in previous]
        if not people:
            return "لا يوجد مشاركون مؤهلون للسحب."
        picks = secrets.SystemRandom().sample(list(people), min(g["winner_count"], len(people)))
        stamp = now()
        con.execute(
            "UPDATE giveaways SET status='drawn',closed_at=COALESCE(closed_at,?),drawn_at=? WHERE id=?",
            (stamp, stamp, gid),
        )
        for place, person in enumerate(picks, 1):
            con.execute(
                "INSERT INTO winners(giveaway_id,user_id,username,full_name,place,drawn_at) VALUES(?,?,?,?,?,?)",
                (gid, person["user_id"], person["username"], person["full_name"], place, stamp),
            )
            con.execute(
                """INSERT INTO previous_winners(user_id,last_won_at) VALUES(?,?)
                   ON CONFLICT(user_id) DO UPDATE SET last_won_at=excluded.last_won_at""",
                (person["user_id"], stamp),
            )
        audit(con, actor_id, "draw", gid, f"winners={len(picks)}")
        return picks


def format_winners(gid, picks):
    g = get_giveaway(gid)
    lines = [f"🏆 <b>نتائج الروليت #{gid}</b>", f"🎁 {html.escape(g['title'])}", ""]
    for place, person in enumerate(picks, 1):
        name = html.escape(person["full_name"])
        if person["username"]:
            name += f" (@{html.escape(person['username'])})"
        lines.append(f"{place}. {name} — <code>{person['user_id']}</code>")
    lines.append(f"\n👥 عدد الفائزين: {len(picks)}")
    return "\n".join(lines)


async def publish_results(context, gid, picks, reply_message=None):
    await refresh_post(context, gid)
    result_text = format_winners(gid, picks)
    if reply_message:
        await reply_message.reply_text(result_text, parse_mode="HTML")
    g = get_giveaway(gid)
    if g and g["chat_id"]:
        try:
            await context.bot.send_message(chat_id=g["chat_id"], text=result_text, parse_mode="HTML")
        except TelegramError as exc:
            log.warning("تعذر نشر النتائج: %s", exc)



def get_display_name(user) -> str:
    if user.first_name:
        return user.first_name
    if user.username:
        return f"@{user.username}"
    return f"User_{user.id}"

def generate_id(length: int = 8) -> str:
    return ''.join(random.choices(string.ascii_lowercase + string.digits, k=length))


class RouletteMasterBot:
    def __init__(self):
        self.app: Optional[Application] = None
        self.active_timers: Dict[str, asyncio.Task] = {}
        self.user_states: Dict[int, str] = {}
    
    def build_app(self) -> Application:
        self.app = Application.builder().token(BOT_TOKEN).build()
        
        self.app.add_handler(CommandHandler("start", self.cmd_start))
        self.app.add_handler(CommandHandler("admin", self.cmd_admin))
        self.app.add_handler(CommandHandler("cancel", self.cmd_cancel))
        self.app.add_handler(CommandHandler("help", self.cmd_help))

        self.app.add_error_handler(self.error_handler)
        
        self.app.add_handler(CallbackQueryHandler(self.handle_callback))
        self.app.add_handler(PreCheckoutQueryHandler(self.precheckout_callback))
        self.app.add_handler(MessageHandler(filters.SUCCESSFUL_PAYMENT, self.successful_payment_callback))
        
        self.app.add_handler(MessageHandler(
            filters.ALL & ~filters.COMMAND,
            self.handle_message
        ))
        
        self.app.post_init = self.post_init
        return self.app
    
    async def error_handler(self, update: object, context: ContextTypes.DEFAULT_TYPE) -> None:
        """معالج الأخطاء لمنع توقف البوت"""
        logger.error(f"حدث خطأ: {context.error}")
    
    async def post_init(self, app: Application):
        commands = [
            BotCommand("start", "بدء البوت"),
            BotCommand("admin", "لوحة الأدمن"),
            BotCommand("help", "المساعدة"),
            BotCommand("cancel", "إلغاء العملية"),
        ]
        await app.bot.set_my_commands(commands)
        logger.info("✅ البوت جاهز للعمل")
    
    def run(self):
        app = self.build_app()
        logger.info("🚀 بدء تشغيل البوت...")
        app.run_polling(drop_pending_updates=True)
    
    async def is_admin(self, user_id: int) -> bool:
        if user_id == OWNER_ID:
            return True
        settings = await data_manager.get_settings()
        return user_id in settings.get('admin_ids', [])
    
    async def is_banned(self, user_id: int) -> bool:
        banned = await data_manager.get_banned()
        return str(user_id) in banned.get('global', [])
    
    async def is_bot_active(self) -> bool:
        settings = await data_manager.get_settings()
        return settings.get('bot_active', True)
    
    async def check_membership(self, bot, channel_id: int, user_id: int) -> bool:
        try:
            member = await bot.get_chat_member(channel_id, user_id)
            return member.status in ['member', 'administrator', 'creator']
        except (BadRequest, Forbidden):
            return False
    
    async def check_forced_channels(self, bot, user_id: int) -> Tuple[bool, List[str]]:
        settings = await data_manager.get_settings()
        forced = settings.get('forced_channels', {})
        if not forced:
            return True, []
        missing = []
        for ch_id, ch_data in forced.items():
            if not await self.check_membership(bot, int(ch_id), user_id):
                missing.append(ch_data.get('link', ch_id))
        return len(missing) == 0, missing
    
    async def register_user(self, bot, user) -> bool:
        users = await data_manager.get_users()
        user_id = str(user.id)
        if user_id in users:
            users[user_id]['last_seen'] = datetime.now().isoformat()
            users[user_id]['name'] = get_display_name(user)
            await data_manager.save_users(users)
            return False
        
        users[user_id] = {
            'id': user.id,
            'username': user.username,
            'name': get_display_name(user),
            'join_date': datetime.now().isoformat(),
            'last_seen': datetime.now().isoformat(),
            'referral_code': f"REF{user.id}",
            'referrals': 0,
            'roulettes_created': 0,
            'roulettes_won': 0,
            'points': 0
        }
        await data_manager.save_users(users)
        return True
    
    async def cmd_start(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        user = update.effective_user

        if update.effective_chat.type != 'private':
            return
            
        if await self.is_banned(user.id):
            await update.message.reply_text("🚫 تم حظرك من استخدام البوت")
            return
        if not await self.is_bot_active() and not await self.is_admin(user.id):
            await update.message.reply_text(Texts.BOT_MAINTENANCE)
            return
        
        joined, missing = await self.check_forced_channels(context.bot, user.id)
        if not joined:
            text = Texts.FORCED_CHANNELS_PROMPT + "\n"
            keyboard = [[InlineKeyboardButton("📢 اشترك", url=link, style="primary")] for link in missing]
            keyboard.append([InlineKeyboardButton("✅ تحققت", callback_data="check_forced", style="success")])
            await update.message.reply_text(text, reply_markup=InlineKeyboardMarkup(keyboard))
            return
        
        await self.register_user(context.bot, user)
        is_admin = await self.is_admin(user.id)
        await update.message.reply_text(
            Texts.WELCOME.format(name=get_display_name(user)),
            parse_mode=ParseMode.HTML,
            reply_markup=Keyboards.main_menu(user.id, is_admin)
        )
    
    async def cmd_admin(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        if update.effective_chat.type != 'private': return
        if not await self.is_admin(update.effective_user.id):
            return
        await update.message.reply_text("⚙️ لوحة الأدمن", reply_markup=Keyboards.admin_panel())
    
    async def cmd_cancel(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        if update.effective_chat.type != 'private': return
        user_id = update.effective_user.id
        self.user_states.pop(user_id, None)
        await data_manager.delete_temp(user_id)
        await update.message.reply_text("✅ تم الإلغاء", reply_markup=Keyboards.back_button())
    
    async def cmd_help(self, update: Update, context: ContextTypes.DEFAULT_TYPE):
        if update.effective_chat.type != 'private': return

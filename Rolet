def perform_draw(gid, actor_id):
    # BEGIN IMMEDIATE serializes competing draw attempts.
    with database() as con:
        con.execute("BEGIN IMMEDIATE")
        g = con.execute(
            "SELECT * FROM giveaways WHERE id=?", (gid,)
        ).fetchone()

        if not g:
            return "السحب غير موجود."

        if g["status"] not in ("open", "closed"):
            return "تم سحب الفائزين مسبقًا أو السحب غير جاهز."

        if not is_owner(actor_id) and g["creator_id"] != actor_id:
            return "ليس لديك صلاحية سحب الفائزين."

        people = con.execute(
            """SELECT p.user_id, p.username, p.full_name
               FROM participants p
               WHERE p.giveaway_id=? AND p.excluded=0""",
            (gid,),
        ).fetchall()

        if g["exclude_previous"]:
            previous = {
                r["user_id"]
                for r in con.execute(
                    "SELECT user_id FROM previous_winners"
                ).fetchall()
            }
            people = [p for p in people if p["user_id"] not in previous]

        if not people:
            return "لا يوجد مشاركون مؤهلون للسحب."

        picks = secrets.SystemRandom().sample(
            list(people), min(g["winner_count"], len(people))
        )
        drawn_at = now()

        con.execute(
            """UPDATE giveaways
               SET status='drawn', closed_at=COALESCE(closed_at, ?),
                   drawn_at=?
               WHERE id=?""",
            (drawn_at, drawn_at, gid),
        )

        for place, p in enumerate(picks, start=1):
            con.execute(
                """INSERT INTO winners
                   (giveaway_id, user_id, username, full_name, place, drawn_at)
                   VALUES (?, ?, ?, ?, ?, ?)""",
                (
                    gid, p["user_id"], p["username"],
                    p["full_name"], place, drawn_at,
                ),
            )
            con.execute(
                """INSERT INTO previous_winners(user_id, last_won_at)
                   VALUES (?, ?)
                   ON CONFLICT(user_id) DO UPDATE
                   SET last_won_at=excluded.last_won_at""",
                (p["user_id"], drawn_at),
            )

        audit(con, actor_id, "draw", gid, f"winners={len(picks)}")
        return picks


def format_winners(gid, picks):
    g = get_giveaway(gid)
    lines = [
        f"🏆 <b>نتائج الروليت #{gid}</b>",
        f"🎁 {html.escape(g['title'])}",
        "",
    ]
    for place, p in enumerate(picks, start=1):
        name = html.escape(p["full_name"])
        if p["username"]:
            name += f" (@{html.escape(p['username'])})"
        lines.append(f"{place}. {name} — <code>{p['user_id']}</code>")
    lines.append(f"\n👥 عدد الفائزين: {len(picks)}")
    return "\n".join(lines)


async def exclude_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    if not is_admin(uid):
        await update.effective_message.reply_text("ليس لديك صلاحية.")
        return

    if len(context.args) != 2 or not all(x.isdigit() for x in context.args):
        await update.effective_message.reply_text(
            "الاستخدام: /exclude USER_ID GIVEAWAY_ID"
        )
        return

    user_id, gid = map(int, context.args)
    g = get_giveaway(gid)
    if not can_manage(uid, g) or g["status"] != "open":
        await update.effective_message.reply_text(
            "لا يمكن استبعاد مشارك من هذا السحب."
        )
        return

    with database() as con:
        cur = con.execute(
            """UPDATE participants SET excluded=1
               WHERE giveaway_id=? AND user_id=?""",
            (gid, user_id),
        )
        if cur.rowcount:
            audit(con, uid, "exclude", gid, str(user_id))

    if cur.rowcount:
        await refresh_post(context, gid)
        await update.effective_message.reply_text("تم استبعاد المشارك.")
    else:
        await update.effective_message.reply_text("المشارك غير موجود.")



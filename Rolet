# ============================= الاشتراك الإجباري =============================

async def get_channels():
    async with await db() as con:
        cur = await con.execute("SELECT * FROM required_channels ORDER BY channel_title")
        return await cur.fetchall()


async def check_subscription(user_id: int):
    channels = await get_channels()
    if not channels:
        return True, []
    missing = []
    for channel in channels:
        try:
            member = await bot.get_chat_member(channel["channel_id"], user_id)
            if member.status in (ChatMemberStatus.LEFT, ChatMemberStatus.KICKED):
                missing.append(channel)
        except TelegramAPIError:
            # لا نسمح بالتجاوز إذا تعذر التحقق؛ نوضح المشكلة للمستخدم.
            missing.append(channel)
    return len(missing) == 0, missing


async def subscription_gate(message: Message = None, callback: CallbackQuery = None):
    user = message.from_user if message else callback.from_user
    ok, missing = await check_subscription(user.id)
    if ok:
        return True

    rows = []
    for ch in missing:
        rows.append([InlineKeyboardButton(
            text=f"📢 الاشتراك في {ch['channel_title'] or 'القناة'}",
            url=ch["invite_url"]
        )])
    rows.append([InlineKeyboardButton(text="✅ تحققت من الاشتراك", callback_data="check_sub")])
    text = "🔒 <b>الاشتراك مطلوب لاستخدام البوت</b>\n\nاشترك في القنوات التالية ثم اضغط «تحققت من الاشتراك»."
    if message:
        await message.answer(text, reply_markup=InlineKeyboardMarkup(inline_keyboard=rows))
    else:
        await callback.message.edit_text(text, reply_markup=InlineKeyboardMarkup(inline_keyboard=rows))
        await callback.answer()
    return False



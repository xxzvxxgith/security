@bot.callback_query_handler(func=lambda call: call.data.startswith("verify:"))
def verify_participant_multi_channel(call):
    """التحقق من المشارك مع دعم القنوات المتعددة"""
    user_id = call.from_user.id
    parts = call.data.split(":")
    roulette_key = parts[1]
    selected_emoji = parts[2]
    correct_emoji = parts[3]
    
    # الحصول على معلومات الروليت
    roulette = db.fetch_one(
        "SELECT id, status FROM roulettes WHERE roulette_key = ?",
        (roulette_key,)
    )
    
    if not roulette:
        bot.answer_callback_query(call.id, "❌ الروليت غير موجودة", show_alert=True)
        return
    
    roulette_id, status = roulette
    
    if status != "active":
        bot.answer_callback_query(call.id, "❌ انتهت الروليت", show_alert=True)
        return
    
    # التحقق من صحة الرمز
    if selected_emoji != correct_emoji:
        bot.answer_callback_query(call.id, "❌ إجابة خاطئة، حاول مرة أخرى", show_alert=True)
        
        # إنشاء رمز تحقق جديد
        emojis = ["🎯", "⚽", "🎮", "🏀", "🎾", "⚾", "🏈", "🎳", "🏓", "🎲"]
        correct_emoji_new = random.choice(emojis)
        other_emojis = [e for e in emojis if e != correct_emoji_new]
        random.shuffle(other_emojis)
        
        keyboard = types.InlineKeyboardMarkup()
        buttons = [types.InlineKeyboardButton(emoji,
                     callback_data=f"verify:{roulette_key}:{emoji}:{correct_emoji_new}")
                   for emoji in [correct_emoji_new] + other_emojis]
        keyboard.row(*buttons[:3])
        keyboard.row(*buttons[3:6])
        
        bot.edit_message_text(
            f"<b>🔐 تحقق من الهوية</b>\n\n"
            f"<b>اختر الرمز التالي:</b> <code>{correct_emoji_new}</code>\n\n"
            f"<b>حاول مرة أخرى</b>",
            user_id, call.message.message_id,
            reply_markup=keyboard
        )
        return
    
    bot.answer_callback_query(call.id, "✅ إجابة صحيحة!")
    
    # التحقق من اشتراك المستخدم في جميع القنوات
    is_subscribed, missing_channels = check_user_subscription_all_channels(user_id, roulette_id)
    
    if not is_subscribed:
        # بناء رسالة القنوات المفقودة
        missing_message = (
            "<b>❌ يجب الاشتراك في جميع القنوات أولاً</b>\n\n"
            "<b>━━━━━━━━━━━━━━━━━━━━━━</b>\n\n"
            "<b>القنوات المطلوبة:</b>\n"
        )
        
        for i, (ch_id, ch_name) in enumerate(missing_channels, 1):
            channel_link = f"https://t.me/{ch_id[1:]}" if ch_id.startswith("@") else ch_id
            missing_message += f"{i}. <a href=\"{channel_link}\">{ch_name}</a>\n"
        
        missing_message += (
            f"\n<b>━━━━━━━━━━━━━━━━━━━━━━</b>\n\n"
            f"<i>بعد الاشتراك في جميع القنوات، حاول مرة أخرى</i>"
        )
        
        # إرسال زر للتحقق مرة أخرى
        keyboard = types.InlineKeyboardMarkup()
        keyboard.add(types.InlineKeyboardButton("🔄 تحقق من الاشتراكات", 
                     callback_data=f"check_subscription:{roulette_key}"))
        
        bot.edit_message_text(missing_message, user_id, call.message.message_id, reply_markup=keyboard)
        return
    
    # التحقق من عدم مشاركة المستخدم مسبقاً
    existing = db.fetch_one(
        "SELECT id FROM participants WHERE user_id = ? AND roulette_id = ?",
        (user_id, roulette_id)
    )
    
    if existing:
        bot.send_message(user_id, "<b>⚠️ أنت مشترك بالفعل في هذه الروليت</b>")
        return
    
    # تسجيل المشارك
    username = call.from_user.username or "NoUsername"
    first_name = call.from_user.first_name or "User"
    
    db.execute(
        "INSERT INTO participants VALUES (NULL, ?, ?, ?, ?, ?)",
        (user_id, roulette_id, username, first_name, datetime.now().isoformat())
    )
    
    # الحصول على معرف المشارك
    participant_id = db.fetch_one("SELECT last_insert_rowid()")[0]
    
    # تحديث إحصائيات المستخدم
    update_user_stats(user_id, participations=1)
    
    # تحديث عدد المشاركين في الروليت
    count = db.fetch_one("SELECT participants_count FROM roulettes WHERE id = ?", (roulette_id,))[0]
    new_count = count + 1
    db.execute("UPDATE roulettes SET participants_count = ? WHERE id = ?",
             (new_count, roulette_id))
    
    # تسجيل حالة اشتراك المشارك في جميع القنوات
    channels = get_roulette_condition_channels(roulette_id)
    for ch_id, ch_name in channels:
        update_participant_channel_status(participant_id, roulette_id, ch_id, 1)
    
    # إرسال إشعار للمنشئ
    try:
        creator_id = db.fetch_one("SELECT creator_id FROM roulettes WHERE id = ?", (roulette_id,))[0]
        channel_info = db.fetch_one("SELECT channel_id FROM roulettes WHERE id = ?", (roulette_id,))[0]
        
        participant_message = (
            f"<b>✅ مشارك جديد!</b>\n\n"
            f"👤 <b>الاسم:</b> {first_name}\n"
            f"🔗 <b>اليوزر:</b> @{username}\n"
            f"🆔 <b>المعرف:</b> <code>{user_id}</code>\n"
            f"📊 <b>إجمالي المشاركين:</b> {new_count}\n"
            f"✅ <b>الحالة:</b> مشترك في جميع القنوات"
        )
        
        keyboard = types.InlineKeyboardMarkup()
        keyboard.add(
            types.InlineKeyboardButton("👁️ عرض المعلومات", 
                 callback_data=f"view_participant:{roulette_key}:{user_id}"),
            types.InlineKeyboardButton("🚫 طرد المشارك", 
                 callback_data=f"remove_participant:{roulette_key}:{user_id}")
        )
        
        bot.send_message(creator_id, participant_message, reply_markup=keyboard)
        
        # تحديث رسالة الروليت في القناة
        update_roulette_message(roulette_id, channel_info, new_count)
        
    except Exception as e:
        logger.error(f"Error notifying creator: {e}")
    
    # إرسال تأكيد للمشارك
    confirmation_message = (
        "<b>✅ تم التسجيل بنجاح!</b>\n\n"
        "<b>━━━━━━━━━━━━━━━━━━━━━━</b>\n\n"
        "🎉 <b>تمت إضافتك إلى الروليت</b>\n\n"
        "✅ <b>أنت مشترك في جميع القنوات المطلوبة</b>\n"
        "🔔 <b>سيتم إخطارك عند إعلان الفائزين</b>\n\n"
        "<b>━━━━━━━━━━━━━━━━━━━━━━</b>\n\n"
        "💡 <i>حظاً موفقاً في الروليت!</i>"
    )
    
    bot.edit_message_text(confirmation_message, user_id, call.message.message_id)


@contextmanager
def database():
    con = sqlite3.connect(DB_PATH, timeout=30)
    con.row_factory = sqlite3.Row
    try:
        con.execute('PRAGMA foreign_keys=ON')
        con.execute('PRAGMA busy_timeout=30000')
        yield con
        con.commit()
    except Exception:
        con.rollback(); raise
    finally: con.close()

def now(): return int(time.time())
def init_db():
    with database() as c:
        c.execute('PRAGMA journal_mode=WAL')
        c.executescript('''
        CREATE TABLE IF NOT EXISTS admins(user_id INTEGER PRIMARY KEY, added_at INTEGER NOT NULL, added_by INTEGER NOT NULL);
        CREATE TABLE IF NOT EXISTS giveaways(id INTEGER PRIMARY KEY AUTOINCREMENT, creator_id INTEGER NOT NULL, chat_id INTEGER, chat_title TEXT, message_id INTEGER, title TEXT NOT NULL, winner_count INTEGER NOT NULL, duration_seconds INTEGER NOT NULL, exclude_previous INTEGER NOT NULL DEFAULT 0, status TEXT NOT NULL DEFAULT 'draft', created_at INTEGER NOT NULL, ends_at INTEGER, closed_at INTEGER, drawn_at INTEGER);
        CREATE TABLE IF NOT EXISTS participants(giveaway_id INTEGER NOT NULL REFERENCES giveaways(id) ON DELETE CASCADE, user_id INTEGER NOT NULL, username TEXT, full_name TEXT NOT NULL, joined_at INTEGER NOT NULL, excluded INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(giveaway_id,user_id));
        CREATE TABLE IF NOT EXISTS winners(giveaway_id INTEGER NOT NULL REFERENCES giveaways(id) ON DELETE CASCADE, user_id INTEGER NOT NULL, username TEXT, full_name TEXT NOT NULL, place INTEGER NOT NULL, drawn_at INTEGER NOT NULL, PRIMARY KEY(giveaway_id,user_id), UNIQUE(giveaway_id,place));
        CREATE TABLE IF NOT EXISTS previous_winners(user_id INTEGER PRIMARY KEY,last_won_at INTEGER NOT NULL);
        CREATE TABLE IF NOT EXISTS audit_log(id INTEGER PRIMARY KEY AUTOINCREMENT,actor_id INTEGER NOT NULL,action TEXT NOT NULL,giveaway_id INTEGER,details TEXT,created_at INTEGER NOT NULL);
        CREATE INDEX IF NOT EXISTS idx_giveaway_status ON giveaways(status);
        CREATE INDEX IF NOT EXISTS idx_participants_giveaway ON participants(giveaway_id);
        ''')
def audit(c, actor, action, gid=None, details=None):
    c.execute('INSERT INTO audit_log(actor_id,action,giveaway_id,details,created_at) VALUES(?,?,?,?,?)',(actor,action,gid,details,now()))
def get_giveaway(gid):
    with database() as c: return c.execute('SELECT * FROM giveaways WHERE id=?',(gid,)).fetchone()
def is_owner(uid): return uid == OWNER_ID
def is_admin(uid):
    if is_owner(uid): return True
    with database() as c: return c.execute('SELECT 1 FROM admins WHERE user_id=?',(uid,)).fetchone() is not None
def can_manage(uid,g): return bool(g and (is_owner(uid) or (is_admin(uid) and g['creator_id']==uid)))
def participant_count(gid):
    with database() as c: return c.execute('SELECT COUNT(*) FROM participants WHERE giveaway_id=? AND excluded=0',(gid,)).fetchone()[0]
def main_keyboard(uid):
    rows=[[KeyboardButton(MENU_CREATE)],[KeyboardButton(MENU_MINE),KeyboardButton(MENU_STATS)],[KeyboardButton(MENU_HISTORY)]]
    if is_owner(uid): rows.append([KeyboardButton(MENU_ADMINS)])
    rows.append([KeyboardButton(MENU_CANCEL)])
    return ReplyKeyboardMarkup(rows,resize_keyboard=True,is_persistent=True,input_field_placeholder='اختر عملية من القائمة')
def post_keyboard(gid,status):
    rows=[]
    if status=='open': rows.append([InlineKeyboardButton('🎟 انضمام',callback_data=f'join:{gid}'),InlineKeyboardButton('🚪 مغادرة',callback_data=f'leave:{gid}')])
    if status in ('open','closed'): rows.append([InlineKeyboardButton('🔒 إغلاق التسجيل',callback_data=f'close:{gid}'),InlineKeyboardButton('🏆 سحب الفائزين',callback_data=f'draw:{gid}')])
    return InlineKeyboardMarkup(rows) if rows else None
def post_text(gid):
    g=get_giveaway(gid)
    if not g: return 'هذا السحب غير موجود.'
    states={'draft':'مسودة','open':'🟢 التسجيل مفتوح','closed':'🔒 التسجيل مغلق','drawn':'🏆 انتهى السحب'}
    end_line=''
    if g['ends_at']:
        end=datetime.fromtimestamp(g['ends_at'],timezone.utc).strftime('%Y-%m-%d %H:%M UTC')
        end_line=f'\n⏳ نهاية التسجيل: <code>{end}</code>'
    return f"🎡 <b>روليت #{gid}</b>\n\n🎁 <b>{html.escape(g['title'])}</b>\n🏆 عدد الفائزين: <b>{g['winner_count']}</b>\n👥 المشاركون: <b>{participant_count(gid)}</b>\n📌 الحالة: <b>{states.get(g['status'],g['status'])}</b>{end_line}\n\nاستخدم الأزرار أدناه للمشاركة."
async def refresh_post(context,gid):
    g=get_giveaway(gid)
    if not g or g['chat_id'] is None or g['message_id'] is None: return
    try: await context.bot.edit_message_text(chat_id=g['chat_id'],message_id=g['message_id'],text=post_text(gid),parse_mode='HTML',reply_markup=post_keyboard(gid,g['status']))
    except BadRequest as e:
        if 'message is not modified' not in str(e).lower(): log.warning('Post update failed for %s: %s',gid,e)
    except TelegramError as e: log.warning('Post update failed for %s: %s',gid,e)
def cancel_job(app,gid):
    for job in app.job_queue.get_jobs_by_name(f'giveaway-{gid}'): job.schedule_removal()
def schedule_close(app,gid,ends_at):
    cancel_job(app,gid)
    app.job_queue.run_once(timer_close,max(0,ends_at-now()),data={'gid':gid},name=f'giveaway-{gid}')
async def close_giveaway(context,gid,actor_id=None):
    with database() as c:
        c.execute('BEGIN IMMEDIATE')
        row=c.execute('SELECT status FROM giveaways WHERE id=?',(gid,)).fetchone()
        if not row or row['status']!='open': return False
        c.execute("UPDATE giveaways SET status='closed',closed_at=? WHERE id=? AND status='open'",(now(),gid))
        audit(c,actor_id or OWNER_ID,'close',gid)
    cancel_job(context.application,gid)
    await refresh_post(context,gid)
    return True
async def timer_close(context):
    gid=context.job.data['gid']; g=get_giveaway(gid)
    if not g or g['status']!='open': return
    if g['ends_at'] and now()<g['ends_at']:
        schedule_close(context.application,gid,g['ends_at']); return
    if await close_giveaway(context,gid):
        g=get_giveaway(gid)
        try: await context.bot.send_message(g['creator_id'],f'⏰ انتهى التسجيل في السحب #{gid}. استخدم /draw {gid} لسحب الفائزين.')
        except TelegramError: pass
async def restore_timers(app):
    with database() as c: rows=c.execute("SELECT id,ends_at FROM giveaways WHERE status='open' AND ends_at IS NOT NULL").fetchall()
    for r in rows: schedule_close(app,r['id'],r['ends_at'])
def perform_draw(gid,actor_id):
    with database() as c:
        c.execute('BEGIN IMMEDIATE'); g=c.execute('SELECT * FROM giveaways WHERE id=?',(gid,)).fetchone()
        if not g: return 'السحب غير موجود.'
        if g['status'] not in ('open','closed'): return 'تم السحب مسبقاً أو أن السحب غير جاهز.'
        if not can_manage(actor_id,g): return 'ليس لديك صلاحية إدارة هذا السحب.'
        if g['ends_at'] and now()<g['ends_at'] and g['status']=='open': return 'لم تنتهِ مدة التسجيل بعد. أغلق التسجيل أولاً إذا أردت السحب المبكر.'
        people=c.execute('SELECT user_id,username,full_name FROM participants WHERE giveaway_id=? AND excluded=0',(gid,)).fetchall()
        if g['exclude_previous']:
            prev={r[0] for r in c.execute('SELECT user_id FROM previous_winners')}; people=[p for p in people if p['user_id'] not in prev]
        if not people: return 'لا يوجد مشاركون مؤهلون للسحب.'
        picks=secrets.SystemRandom().sample(list(people),min(g['winner_count'],len(people))); t=now()
        c.execute("UPDATE giveaways SET status='drawn',closed_at=COALESCE(closed_at,?),drawn_at=? WHERE id=?",(t,t,gid))
        for place,p in enumerate(picks,1):
            c.execute('INSERT INTO winners(giveaway_id,user_id,username,full_name,place,drawn_at) VALUES(?,?,?,?,?,?)',(gid,p['user_id'],p['username'],p['full_name'],place,t))
            c.execute('INSERT INTO previous_winners(user_id,last_won_at) VALUES(?,?) ON CONFLICT(user_id) DO UPDATE SET last_won_at=excluded.last_won_at',(p['user_id'],t))
        audit(c,actor_id,'draw',gid,f'winners={len(picks)}')
        return picks
def format_winners(gid,picks):
    g=get_giveaway(gid); lines=[f'🏆 <b>نتائج الروليت #{gid}</b>',f"🎁 {html.escape(g['title'])}",'']
    for i,p in enumerate(picks,1):
        name=html.escape(p['full_name'])
        if p['username']: name+=f" (@{html.escape(p['username'])})"
        lines.append(f"{i}. {name} — <code>{p['user_id']}</code>")
    lines.append(f'\n👥 عدد الفائزين: {len(picks)}'); return '\n'.join(lines)
async def publish_results(context,gid,picks,reply_message=None):
    cancel_job(context.application,gid); await refresh_post(context,gid); message=format_winners(gid,picks)
    if reply_message:
        try: await reply_message.reply_text(message,parse_mode='HTML')
        except TelegramError: pass
    g=get_giveaway(gid)
    if g and g['chat_id'] is not None:
        try: await context.bot.send_message(g['chat_id'],message,parse_mode='HTML')
        except TelegramError as e: log.warning('Publishing results failed: %s',e)


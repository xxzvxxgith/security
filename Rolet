    user = message.from_user
    if await user_is_banned(user.id):
        return await message.answer("🚫 حسابك محظور من استخدام البوت.")
    if not await subscription_gate(message=message):
        return

    args = (message.text or "").split(maxsplit=1)
    referral_owner = None
    if len(args) > 1:
        payload = args[1].strip()
        if payload and payload != "home":
            target = await get_user_by_code(payload)
            if target and int(target["user_id"]) != user.id:
                referral_owner = int(target["user_id"])

    await ensure_user(user, referral_owner)
    if referral_owner:
        async with await db() as con:
            await con.execute(
                "INSERT OR IGNORE INTO visits(owner_id,visitor_id,first_seen) VALUES(?,?,?)",
                (referral_owner, user.id, now_iso())
            )
            await con.commit()

    me = await bot.get_me()
    profile = await get_user(user.id)
    count, _, _, _ = await get_counts(user.id)
    text = (
        f"🎄 <b>أهلاً بك في NewYear</b>\n\n"
        f"مرحباً {html_escape(user.first_name)} ✨\n"
        f"هنا تصنع شجرتك الخاصة وتستقبل أجمل معايدات أصدقائك.\n\n"
        f"💌 معايداتك الحالية: <b>{count}</b>\n"
        f"🗓️ السنة الحالية: <b>{current_year()}</b>\n\n"
        f"اختر ما تريد من القائمة:"
    )
    await message.answer(text, reply_markup=main_keyboard())



def calculate_roulette_progress(roulette_id):
    """حساب تقدم الروليت"""
    roulette = db.fetch_one("SELECT winners_count FROM roulettes WHERE id = ?", (roulette_id,))
    participants = db.fetch_all("SELECT COUNT(*) FROM participants WHERE roulette_id = ?", (roulette_id,))
    
    if roulette and participants:
        winners_needed = roulette[0]
        total_participants = participants[0][0]
        percentage = (total_participants / max(winners_needed, 1)) * 100
        return min(percentage, 100)
    return 0

def format_countdown_display(seconds):
    """تنسيق عرض العد التنازلي"""
    if seconds > 60:
        minutes = seconds // 60
        secs = seconds % 60
        return f"{minutes}:{secs:02d}"
    return f"00:{seconds:02d}"


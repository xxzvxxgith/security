    async def update_roulette_message(self, bot, roulette_id: str):
        roulettes = await data_manager.get_roulettes()
        if roulette_id not in roulettes:
            return
        r = roulettes[roulette_id]
        text = f"{r.get('text', '')}\n\n👥 المشاركين: {len(r.get('participants', []))}"
        if r.get('winners'):
            text += "\n🏆 <b>الفائزون:</b>\n"
            names = r.get('participant_names', {})
            for w_id in r['winners']:
                text += f"• {names.get(w_id, w_id)}\n"
        
        try:
            await bot.edit_message_text(
                chat_id=r['channel_id'],
                message_id=r['message_id'],
                text=text,
                parse_mode=ParseMode.HTML,
                reply_markup=Keyboards.roulette_control(roulette_id, r['state'] == RouletteState.ACTIVE.value, True)
            )
        except BadRequest:
            pass


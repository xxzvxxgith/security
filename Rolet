def handle_search_user(message):
    user_id = message.from_user.id
    if user_id != ADMIN_ID:
        return
    
    search_query = message.text.strip()
    
    # البحث بالمعرف أو اليوزر
    user = None
    if search_query.isdigit():
        user = db.fetch_one("SELECT user_id, username, first_name, joined_date, blocked FROM users WHERE user_id = ?", 
                           (int(search_query),))
    else:
        user = db.fetch_one("SELECT user_id, username, first_name, joined_date, blocked FROM users WHERE username = ? OR first_name = ?",
                           (search_query.replace("@", ""), search_query))
    
    keyboard = types.InlineKeyboardMarkup()
    
    if not user:
        keyboard.add(types.InlineKeyboardButton("🔙 عودة", callback_data="back_to_admin"))

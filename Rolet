async def get_counts(user_id: int):
    async with await db() as con:
        cur = await con.execute("SELECT COUNT(*) n FROM greetings WHERE receiver_id=?", (user_id,))
        greetings = (await cur.fetchone())["n"]
        cur = await con.execute("SELECT COUNT(*) n FROM visits WHERE owner_id=?", (user_id,))
        visits = (await cur.fetchone())["n"]
        cur = await con.execute(
            "SELECT COUNT(*) n FROM users WHERE referred_by=?", (user_id,)
        )
        joined = (await cur.fetchone())["n"]
        cur = await con.execute(
            "SELECT COUNT(*) n FROM greetings WHERE receiver_id=? AND created_at>=?",
            (user_id, (now_local().replace(hour=0, minute=0, second=0, microsecond=0)).isoformat())
        )
        today = (await cur.fetchone())["n"]
    return greetings, visits, joined, today


def tree_link(bot_username: str, code: str):
    return f"https://t.me/{bot_username}?start={code}"


def countdown_text():
    now = now_local()
    target = datetime(now.year + 1, 1, 1, 0, 0, 0, tzinfo=LOCAL_TZ)
    delta = target - now
    seconds = max(0, int(delta.total_seconds()))
    days, rem = divmod(seconds, 86400)
    hours, rem = divmod(rem, 3600)
    minutes, secs = divmod(rem, 60)
    return (
        f"⏳ <b>العد التنازلي لرأس السنة {now.year + 1}</b>\n\n"
        f"🎉 باقي:\n"
        f"📅 <b>{days:,}</b> يوم\n"
        f"🕒 <b>{hours:02}</b> ساعة\n"
        f"⏱ <b>{minutes:02}</b> دقيقة\n"
        f"⚡ <b>{secs:02}</b> ثانية\n\n"
        f"<i>التوقيت: {now.strftime('%Y-%m-%d %H:%M:%S')} ({TIMEZONE_NAME})</i>"
    )



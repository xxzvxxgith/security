def handle_view_roulette_channels(message):
    """معالجة عرض قنوات الروليت"""
    if message.from_user.id != ADMIN_ID:
        return
    
    roulette_key = message.text.strip()
    
    # البحث عن الروليت
    roulette = db.fetch_one(
        "SELECT id FROM roulettes WHERE roulette_key = ?",
        (roulette_key,)
    )
    
    if not roulette:
        bot.send_message(ADMIN_ID, "<b>❌ لم يتم العثور على الروليت</b>")
        user_states[ADMIN_ID] = {}
        return
    
    roulette_id = roulette[0]
    
    # الحصول على قنوات الشرط
    channels = get_roulette_condition_channels(roulette_id)
    
    if not channels:
        bot.send_message(ADMIN_ID, f"<b>📋 الروليت: {roulette_key}</b>\n\nلا توجد قنوات شرط")
    else:
        message_text = f"<b>📋 قنوات شرط الروليت: {roulette_key}</b>\n\n"
        
        for i, (ch_id, ch_name) in enumerate(channels, 1):
            message_text += f"{i}. {ch_name}\n   <code>{ch_id}</code>\n\n"
        
        message_text += f"<b>الإجمالي:</b> {len(channels)} قناة"
        
        bot.send_message(ADMIN_ID, message_text)
    
    user_states[ADMIN_ID] = {}


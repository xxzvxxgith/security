                    f"<b>الحالة:</b> {status_icon} {status_text}\n\n"
                    f"<b>━━━━━━━━━━━━━━━━━━━━━━</b>\n\n"
                    f"<b>📊 الإحصائيات:</b>\n"
                    f"🎰 المشاركات: {stats['participations']}\n"
                    f"🏆 الفوز: {stats['wins']}\n"
                    f"💰 الجائزة: {stats['prize_value']}")
        

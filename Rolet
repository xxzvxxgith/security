    with database() as con:
        rows = con.execute(
            """SELECT id, title FROM giveaways
               WHERE status='drawn'
               ORDER BY drawn_at DESC LIMIT 10"""
        ).fetchall()

        results = []

        for r in rows:
            winners = con.execute(
                """SELECT full_name, username, place
                   FROM winners WHERE giveaway_id=?
                   ORDER BY place""",
                (r["id"],),
            ).fetchall()

            results.append((r, winners))

    if not results:
        await message.reply_text("لا توجد نتائج حتى الآن.")
        return

    lines = ["🏆 <b>آخر نتائج الروليت</b>\n"]

    for r, winners in results:
        lines.append(
            f"\n🎡 <b>#{r['id']}</b> — {html.escape(r['title'])}"
        )

        for w in winners:
            name = html.escape(w["full_name"])

            if w["username"]:
                name += f" (@{html.escape(w['username'])})"

            lines.append(f"{w['place']}. {name}")

    await message.reply_text(
        "\n".join(lines),
        parse_mode="HTML",
    )



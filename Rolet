def handle_roulette_countdown(message):
    user_id = message.from_user.id
    message_id = user_states.get(user_id, {}).get("message_id")
    
    try:
        countdown = int(message.text) if message.text.isdigit() else 30
        if countdown < 10:
            countdown = 10
        elif countdown > 300:
            countdown = 300
    except:
        countdown = 30
    
    winners_count = user_states[user_id].get("winners_count")
    channel_id = user_states[user_id].get("channel_id")
    condition_channels = user_states[user_id].get("condition_channels", [])
    message_text = user_states[user_id].get("message_text")
    
    if not all([winners_count, channel_id, condition_channels, message_text]):
        error_message = "<b>❌ خطأ في البيانات</b>"
        if message_id:
            try:
                bot.edit_message_text(error_message, user_id, message_id)
            except:
                bot.send_message(user_id, error_message)
        else:
            bot.send_message(user_id, error_message)
        user_states[user_id] = {}
        return
    
    roulette_key = generate_roulette_key()
    bot_link = get_bot_link()
    
    roulette_text = f"🎰 {message_text}\n\n"
    roulette_text += f"<b>📋 شروط الاشتراك:</b>\n"
    
    for i, (ch_id, ch_name) in enumerate(condition_channels, 1):
        channel_mention = f"@{ch_id[1:]}" if ch_id.startswith("@") else ch_id
        roulette_text += f"{i}. 🔗 {channel_mention}\n"
    
    roulette_text += f"\n<b>🏆 عدد الفائزين:</b> {winners_count}\n"
    roulette_text += f"<b>📊 المشاركون: 0</b>\n"
    roulette_text += f"<b>⏱️ وقت العد:</b> {countdown} ثانية\n\n"
    roulette_text += f'<a href="{bot_link}">🎰 Roulette RedFox</a>'
    
    keyboard = types.InlineKeyboardMarkup()
    deeplink = f"https://t.me/{BOT_USERNAME}?start=verify_{roulette_key}"
    reminder_deeplink = f"https://t.me/{BOT_USERNAME}?start=remind_{roulette_key}"
    
    keyboard.row(
        types.InlineKeyboardButton("🎲 المشاركة", url=deeplink),
        types.InlineKeyboardButton("🔔 التذكير", url=reminder_deeplink)
    )
    keyboard.row(
        types.InlineKeyboardButton("⏸️ إيقاف", callback_data=f"pause:{roulette_key}"),
        types.InlineKeyboardButton("▶️ بدء", callback_data=f"start:{roulette_key}")
    )
    
    try:
        sent_message = bot.send_message(channel_id, roulette_text, reply_markup=keyboard)
        message_id_roulette = sent_message.message_id
        
        db.execute(
            "INSERT INTO roulettes (roulette_key, creator_id, channel_id, condition_channel, winners_count, message_text, message_id, participants_count, status, created_date, winners, prize_text, end_date, channel_name, countdown_seconds) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
            (roulette_key, user_id, channel_id, condition_channels[0][0], winners_count, 
             message_text, message_id_roulette, 0, "active", datetime.now().isoformat(), "", "", None, "", countdown)
        )
        
        roulette_id = db.fetch_one("SELECT last_insert_rowid()")[0]
        
        for ch_id, ch_name in condition_channels:

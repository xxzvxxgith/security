async def callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query

    if not q:
        return

    uid = q.from_user.id
    data = q.data or ""

    try:
        # Answer each callback exactly once.
        await q.answer()

        if data.startswith(("join:", "leave:")):
            action, gid_text = data.split(":", 1)

            if not gid_text.isdigit():
                await q.answer("طلب غير صالح.", show_alert=True)
                return

            gid = int(gid_text)
            g = get_giveaway(gid)

            if not g or g["status"] != "open":
                await q.answer("التسجيل مغلق.", show_alert=True)
                return

            if q.from_user.is_bot:
                await q.answer(
                    "حسابات البوتات لا تشارك.",
                    show_alert=True,
                )
                return

            with database() as con:
                con.execute("BEGIN IMMEDIATE")

                current = con.execute(
                    "SELECT status FROM giveaways WHERE id=?",
                    (gid,),
                ).fetchone()

                if not current or current["status"] != "open":
                    await q.answer(
                        "التسجيل مغلق.",
                        show_alert=True,
                    )
                    return

                if action == "join":
                    con.execute(
                        """INSERT INTO participants
                           (giveaway_id, user_id, username, full_name,
                            joined_at, excluded)
                           VALUES (?, ?, ?, ?, ?, 0)
                           ON CONFLICT(giveaway_id, user_id)
                           DO UPDATE SET
                               username=excluded.username,
                               full_name=excluded.full_name,
                               joined_at=excluded.joined_at,
                               excluded=0""",
                        (
                            gid,
                            uid,
                            q.from_user.username,
                            q.from_user.full_name,
                            now(),
                        ),
                    )
                    audit(con, uid, "join", gid)
                    answer = "تم تسجيل مشاركتك 🎟"

                else:
                    con.execute(
                        """DELETE FROM participants
                           WHERE giveaway_id=? AND user_id=?""",
                        (gid, uid),
                    )
                    audit(con, uid, "leave", gid)
                    answer = "تم إلغاء مشاركتك."

            # The callback has already been answered.
            await q.message.reply_text(answer)
            await refresh_post(context, gid)
            return

        if data.startswith(("close:", "draw:")):
            action, gid_text = data.split(":", 1)

            if not gid_text.isdigit():
                await q.message.reply_text("طلب غير صالح.")
                return

            gid = int(gid_text)
            g = get_giveaway(gid)

            if not can_manage(uid, g):
                await q.message.reply_text(
                    "هذا الزر مخصص لمدير السحب."
                )
                return

            if action == "close":
                changed = await close_giveaway(context, gid, uid)

                await q.message.reply_text(
                    "تم إغلاق التسجيل."
                    if changed else "التسجيل مغلق مسبقاً أو غير نشط."
                )
                return

            result = perform_draw(gid, uid)

            if isinstance(result, str):
                await q.message.reply_text(result)
                return

            await publish_results(context, gid, result, q.message)
            return

    except TelegramError as exc:
        log.warning("Telegram callback error: %s", exc)

    except Exception:
        log.exception("Callback failed")


# =====================================================
# PRIVATE CHAT CREATION WIZARD
# =====================================================

async def flow_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not update.effective_user or not update.effective_message:
        return

    uid = update.effective_user.id
    message = update.effective_message

    if message.chat.type != ChatType.PRIVATE:
        return

    text = (message.text or "").strip()

    # Main menu remains usable even during a wizard.
    if text == MENU_CANCEL:
        flows.pop(uid, None)
        await message.reply_text(
            "تم إلغاء العملية.",
            reply_markup=main_keyboard(uid),
        )
        return

    if text in (MENU_HOME, "/start"):
        flows.pop(uid, None)
        await message.reply_text(
            "القائمة الرئيسية:",
            reply_markup=main_keyboard(uid),
        )
        return

    if text == MENU_CREATE:
        if not is_admin(uid):
            await message.reply_text(
                "هذه الميزة للمشرفين فقط.",
                reply_markup=main_keyboard(uid),
            )
            return

        flows[uid] = {"step": "title"}
        await message.reply_text(
            "🎁 أرسل عنوان الجائزة أو السحب:"
        )
        return

    if text == MENU_MINE:
        await show_mine(message, uid)
        return

    if text == MENU_STATS:
        await show_stats(message)
        return

    if text == MENU_HISTORY:
        await show_history(message)
        return

    if text == MENU_ADMINS:
        if not is_owner(uid):
            await message.reply_text("هذه الميزة للمالك فقط.")
            return

        await message.reply_text(
            "🛡 إدارة المشرفين\n\n"
            "لإضافة مشرف:\n/addadmin USER_ID\n\n"
            "لحذف مشرف:\n/deladmin USER_ID"
        )
        return

    flow = flows.get(uid)

    if not flow:
        return

    if not is_admin(uid):
        flows.pop(uid, None)
        await message.reply_text("ليس لديك صلاحية.")
        return

    step = flow.get("step")

    if step == "title":
        if not text or len(text) > MAX_TITLE_LENGTH:
            await message.reply_text(
                f"العنوان يجب أن يكون بين 1 و{MAX_TITLE_LENGTH} حرفاً."
            )
            return

        flow["title"] = text
        flow["step"] = "winners"

        await message.reply_text("🏆 كم عدد الفائزين؟ أرسل رقماً من 1 إلى 100.")
        return

    if step == "winners":
        if not text.isdigit() or not 1 <= int(text) <= MAX_WINNERS:
            await message.reply_text("أرسل رقماً من 1 إلى 100.")
            return

        flow["winner_count"] = int(text)
        flow["step"] = "duration"

        await message.reply_text(
            "⏳ مدة التسجيل بالدقائق.\n"
            "أرسل 0 إذا أردت التسجيل دون مؤقت."
        )
        return

    if step == "duration":
        if not text.isdigit() or int(text) > MAX_DURATION_MINUTES:
            await message.reply_text(
                f"أرسل رقماً من 0 إلى {MAX_DURATION_MINUTES}."
            )
            return

        flow["duration"] = int(text) * 60
        flow["step"] = "exclude_previous"

        await message.reply_text(
            "هل تريد استبعاد الفائزين السابقين؟\n"
            "أرسل نعم أو لا."
        )
        return

    if step == "exclude_previous":
        answer = text.casefold()

        if answer not in ("نعم", "لا", "yes", "no"):
            await message.reply_text("أرسل نعم أو لا.")
            return

        flow["exclude_previous"] = int(
            answer in ("نعم", "yes")
        )
        flow["step"] = "destination"

        await message.reply_text(
            "📍 أرسل اسم القناة العامة مثل @my_channel، "
            "أو معرّف القناة/المجموعة الرقمي.\n\n"
            "تأكد من إضافة البوت ومنحه صلاحية نشر الرسائل."
        )
        return

    if step == "destination":
        if text.startswith("@"):
            username = text[1:]

            if (
                not username
                or len(username) > 64
                or not username.replace("_", "").isalnum()
            ):
                await message.reply_text("اسم القناة غير صالح.")
                return

            target = text

        else:
            try:
                target = int(text)
            except ValueError:
                await message.reply_text(
                    "أرسل @username أو معرّفاً رقمياً صالحاً."
                )
                return

        flow["target"] = target
        flow["step"] = "confirm"

        await message.reply_text(
            "📋 <b>تأكيد السحب</b>\n\n"
            f"🎁 {html.escape(flow['title'])}\n"
            f"🏆 عدد الفائزين: {flow['winner_count']}\n"
            f"⏳ المدة: {flow['duration'] // 60} دقيقة\n"
            f"📍 الوجهة: <code>{html.escape(str(target))}</code>\n\n"
            "أرسل نعم للنشر أو لا للإلغاء.",
            parse_mode="HTML",
        )
        return

    if step == "confirm":
        if text.casefold() not in ("نعم", "yes"):
            flows.pop(uid, None)
            await message.reply_text(
                "تم إلغاء إنشاء السحب.",
                reply_markup=main_keyboard(uid),
            )
            return

        target = flow["target"]
        duration = flow["duration"]
        ends_at = now() + duration if duration else None

        with database() as con:
            cur = con.execute(
                """INSERT INTO giveaways
                   (creator_id, title, winner_count, duration_seconds,
                    exclude_previous, status, created_at, ends_at)
                   VALUES (?, ?, ?, ?, ?, 'draft', ?, ?)""",
                (
                    uid,
                    flow["title"],
                    flow["winner_count"],
                    duration,
                    flow["exclude_previous"],
                    now(),
                    ends_at,
                ),
            )
            gid = cur.lastrowid
            audit(con, uid, "create", gid, str(target))

        try:
            sent = await context.bot.send_message(
                chat_id=target,
                text=post_text(gid),
                parse_mode="HTML",
                reply_markup=post_keyboard(gid, "open"),
            )

            with database() as con:
                con.execute(
                    """UPDATE giveaways
                       SET chat_id=?, chat_title=?, message_id=?,
                           status='open'
                       WHERE id=? AND status='draft'""",
                    (
                        sent.chat_id,
                        sent.chat.title or sent.chat.username
                        or str(sent.chat_id),
                        sent.message_id,
                        gid,
                    ),
                )

                audit(con, uid, "publish", gid)

            await refresh_post(context, gid)

            if duration:
                context.job_queue.run_once(
                    timer_close,
                    when=duration,
                    data={"gid": gid},
                    name=f"giveaway-{gid}",
                )

            await message.reply_text(
                f"✅ تم نشر السحب #{gid} بنجاح.\n\n"
                f"إغلاق التسجيل: /close {gid}\n"
                f"سحب الفائزين: /draw {gid}",
                reply_markup=main_keyboard(uid),
            )

        except TelegramError as exc:
            log.warning("Publishing failed: %s", exc)

            with database() as con:
                con.execute(
                    "UPDATE giveaways SET status='draft' WHERE id=?",
                    (gid,),
                )
                audit(
                    con, uid, "publish_failed", gid,
                    str(exc)[:250],
                )

            await message.reply_text(
                "تعذر النشر. تحقق من معرّف الوجهة وصلاحيات البوت "
                "وإمكانية وصوله إلى القناة أو المجموعة.",
                reply_markup=main_keyboard(uid),
            )

        finally:
            flows.pop(uid, None)


# =====================================================
# ERROR HANDLER AND STARTUP
# =====================================================

async def post_init(app: Application):
    await restore_timers(app)
    log.info("Timers restored.")


async def error_handler(
    update: object,
    context: ContextTypes.DEFAULT_TYPE,
):
    log.error(
        "Unhandled exception while processing update",
        exc_info=context.error,
    )


def main():
    if not TOKEN:
        raise SystemExit(
            "BOT_TOKEN غير موجود. عيّن رمز البوت في متغير البيئة."
        )

    init_db()

    app = (
        Application.builder()
        .token(TOKEN)
        .post_init(post_init)
        .build()
    )

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("cancel", cancel))
    app.add_handler(CommandHandler("close", close_command))
    app.add_handler(CommandHandler("draw", draw_command))
    app.add_handler(CommandHandler("exclude", exclude_command))
    app.add_handler(CommandHandler("addadmin", addadmin_command))
    app.add_handler(CommandHandler("deladmin", deladmin_command))

    app.add_handler(CallbackQueryHandler(callback))

    app.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            flow_message,
        )
    )

    app.add_error_handler(error_handler)

    log.info("Roulette bot started. Owner ID: %s", OWNER_ID)

    app.run_polling()


if __name__ == "__main__":
    main()

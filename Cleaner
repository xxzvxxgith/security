def recent_count(chat_id=None):
    cutoff = int(time.time()) - CLEAN_HOURS * 3600

    with db() as con:
        if chat_id is None:
            row = con.execute("""
                SELECT COUNT(*)
                FROM tracked_messages
                WHERE message_date>=?
            """, (cutoff,)).fetchone()
        else:
            row = con.execute("""
                SELECT COUNT(*)
                FROM tracked_messages
                WHERE chat_id=? AND message_date>=?
            """, (chat_id, cutoff)).fetchone()

    return row[0]


def cleaner_status(chat_id=None):
    enabled = setting("enabled", "1") == "1"

db = sqlite3.connect(DB_PATH, check_same_thread=False)
db.row_factory = sqlite3.Row


def init_db():
    db.executescript("""
    PRAGMA journal_mode=WAL;

    CREATE TABLE IF NOT EXISTS groups (
        chat_id INTEGER PRIMARY KEY,
        title TEXT DEFAULT '',
        enabled INTEGER DEFAULT 1,
        delete_notice TEXT DEFAULT 'عذراً، ممنوع إرسال هذا النوع من المحتوى هنا.'
    );

    CREATE TABLE IF NOT EXISTS moderation (
        chat_id INTEGER NOT NULL,
        kind TEXT NOT NULL,
        enabled INTEGER DEFAULT 0,
        PRIMARY KEY (chat_id, kind)
    );

    CREATE TABLE IF NOT EXISTS bot_admins (
        user_id INTEGER PRIMARY KEY
    );
    """)
    for admin_id in DEFAULT_ADMINS:
        db.execute(
            "INSERT OR IGNORE INTO bot_admins(user_id) VALUES(?)",
            (admin_id,),
        )
    db.commit()


def execute(query, params=()):
    cur = db.execute(query, params)
    db.commit()
    return cur


def fetchone(query, params=()):
    return db.execute(query, params).fetchone()


def fetchall(query, params=()):
    return db.execute(query, params).fetchall()


def is_admin(user_id):
    return user_id == OWNER_ID or bool(
        fetchone("SELECT 1 FROM bot_admins WHERE user_id=?", (user_id,))
    )


def ensure_group(chat_id, title=""):
    execute("""
        INSERT INTO groups(chat_id,title)
        VALUES(?,?)
        ON CONFLICT(chat_id) DO UPDATE SET title=excluded.title
    """, (chat_id, title or ""))

    for kind in MODERATION_TYPES:
        execute("""
            INSERT OR IGNORE INTO moderation(chat_id,kind,enabled)
            VALUES(?,?,?)
        """, (chat_id, kind, 0))


def group_enabled(chat_id):
    row = fetchone("SELECT enabled FROM groups WHERE chat_id=?", (chat_id,))
    return bool(row and row["enabled"])


def moderation_enabled(chat_id, kind):
    row = fetchone(
        "SELECT enabled FROM moderation WHERE chat_id=? AND kind=?",
        (chat_id, kind),
    )
    return bool(row and row["enabled"])


def set_moderation(chat_id, kind, enabled):
    if kind not in MODERATION_TYPES:
        return
    ensure_group(chat_id)
    execute("""
        INSERT INTO moderation(chat_id,kind,enabled) VALUES(?,?,?)
        ON CONFLICT(chat_id,kind) DO UPDATE SET enabled=excluded.enabled
    """, (chat_id, kind, int(enabled)))



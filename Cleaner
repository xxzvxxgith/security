def db():
    con = sqlite3.connect(DB_PATH, timeout=30)
    con.row_factory = sqlite3.Row
    return con


def init_db():
    with db() as con:
        con.executescript("""
        CREATE TABLE IF NOT EXISTS bot_admins(
            user_id INTEGER PRIMARY KEY
        );
        CREATE TABLE IF NOT EXISTS groups(
            chat_id INTEGER PRIMARY KEY,
            title TEXT DEFAULT '',
            enabled INTEGER DEFAULT 1,
            replies_enabled INTEGER DEFAULT 1,
            delete_message TEXT DEFAULT 'ممنوع إرسال الردود',
            delete_links INTEGER DEFAULT 0,
            delete_photos INTEGER DEFAULT 0,
            delete_videos INTEGER DEFAULT 0,
            delete_stickers INTEGER DEFAULT 0,
            delete_gifs INTEGER DEFAULT 0,
            delete_audio INTEGER DEFAULT 0,
            delete_files INTEGER DEFAULT 0,
            delete_forwarded INTEGER DEFAULT 0,
            subscription_enabled INTEGER DEFAULT 0,
            subscription_channel TEXT DEFAULT '',
            subscription_link TEXT DEFAULT ''
        );
        CREATE TABLE IF NOT EXISTS users(
            chat_id INTEGER,
            user_id INTEGER,
            name TEXT DEFAULT '',
            messages INTEGER DEFAULT 0,
            PRIMARY KEY(chat_id,user_id)
        );
        CREATE TABLE IF NOT EXISTS tracked_messages(
            chat_id INTEGER,
            message_id INTEGER,
            user_id INTEGER,
            message_date INTEGER,
            kind TEXT DEFAULT 'text',
            PRIMARY KEY(chat_id,message_id)
        );
        CREATE TABLE IF NOT EXISTS auto_replies(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            chat_id INTEGER DEFAULT 0,
            keyword TEXT NOT NULL,
            response TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS bot_settings(
            key TEXT PRIMARY KEY,
            value TEXT DEFAULT ''
        );
        CREATE TABLE IF NOT EXISTS subscription(
            chat_id INTEGER PRIMARY KEY,
            enabled INTEGER DEFAULT 0,
            channel TEXT DEFAULT '',
            group_link TEXT DEFAULT ''
        );
        """)
        # ترقية قواعد البيانات القديمة من دون حذف البيانات.
        columns = {r["name"] for r in con.execute(
            "PRAGMA table_info(groups)"
        )}
        additions = {
            "title": "TEXT DEFAULT ''",
            "enabled": "INTEGER DEFAULT 1",
            "replies_enabled": "INTEGER DEFAULT 1",
            "delete_message": "TEXT DEFAULT 'ممنوع إرسال الردود'",
            "delete_links": "INTEGER DEFAULT 0",
            "delete_photos": "INTEGER DEFAULT 0",
            "delete_videos": "INTEGER DEFAULT 0",
            "delete_stickers": "INTEGER DEFAULT 0",
            "delete_gifs": "INTEGER DEFAULT 0",
            "delete_audio": "INTEGER DEFAULT 0",
            "delete_files": "INTEGER DEFAULT 0",
            "delete_forwarded": "INTEGER DEFAULT 0",
            "subscription_enabled": "INTEGER DEFAULT 0",
            "subscription_channel": "TEXT DEFAULT ''",
            "subscription_link": "TEXT DEFAULT ''",
        }
        for name, definition in additions.items():
            if name not in columns:
                con.execute(
                    f"ALTER TABLE groups ADD COLUMN {name} {definition}"
                )
        for admin_id in DEFAULT_ADMINS:
            con.execute(
                "INSERT OR IGNORE INTO bot_admins(user_id) VALUES(?)",
                (admin_id,)
            )
        con.execute("""
            INSERT OR IGNORE INTO bot_settings(key,value)
            VALUES('enabled','1')
        """)
        # ضمان وجود جدول الإعدادات العامة في الكودين القديمين.
        con.execute("""
            INSERT OR IGNORE INTO groups(chat_id,title)
            VALUES(0,'الإعدادات العامة')
        """)


def setting(key, default=""):
    with db() as con:
        row = con.execute(
            "SELECT value FROM bot_settings WHERE key=?", (key,)
        ).fetchone()
    return row["value"] if row else default


def set_setting(key, value):
    with db() as con:
        con.execute("""
            INSERT INTO bot_settings(key,value) VALUES(?,?)
            ON CONFLICT(key) DO UPDATE SET value=excluded.value
        """, (key, str(value)))


def is_owner(uid):
    return uid == OWNER_ID


def is_bot_admin(uid):
    if uid in DEFAULT_ADMINS:
        return True
    with db() as con:
        return con.execute(
            "SELECT 1 FROM bot_admins WHERE user_id=?", (uid,)
        ).fetchone() is not None


def ensure_group(chat_id, title=""):
    with db() as con:
        con.execute("""
            INSERT OR IGNORE INTO groups(chat_id,title) VALUES(?,?)
        """, (chat_id, title))
        if title:
            con.execute(
                "UPDATE groups SET title=? WHERE chat_id=?",
                (title, chat_id)
            )


def get_group(chat_id):
    with db() as con:
        row = con.execute(
            "SELECT * FROM groups WHERE chat_id=?", (chat_id,)
        ).fetchone()
    return dict(row) if row else {}


def update_group(chat_id, field, value):
    allowed = {
        "title", "enabled", "replies_enabled", "delete_message",
        "delete_links", "delete_photos", "delete_videos",
        "delete_stickers", "delete_gifs", "delete_audio",
        "delete_files", "delete_forwarded", "subscription_enabled",
        "subscription_channel", "subscription_link"
    }
    if field not in allowed:
        return
    ensure_group(chat_id)
    with db() as con:
        con.execute(
            f"UPDATE groups SET {field}=? WHERE chat_id=?",
            (value, chat_id)
        )


async def is_group_admin(update, context):
    user = update.effective_user
    chat = update.effective_chat
    if not user or not chat:
        return False
    if is_owner(user.id):
        return True
    if chat.type == ChatType.PRIVATE:
        return is_bot_admin(user.id)
    try:
        member = await context.bot.get_chat_member(chat.id, user.id)
        return member.status in (
            ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER
        )
    except TelegramError:
        return False


async def bot_can_delete(chat_id, context):
    try:
        me = await context.bot.get_chat_member(chat_id, context.bot.id)
        return (
            me.status == ChatMemberStatus.OWNER
            or (
                me.status == ChatMemberStatus.ADMINISTRATOR
                and bool(getattr(me, "can_delete_messages", False))
            )
        )
    except TelegramError:
        return False


async def safe_delete(chat_id, message_id, context):
    try:
        await context.bot.delete_message(chat_id, message_id)
        return True
    except TelegramError as exc:
        log.debug("تعذر حذف الرسالة %s: %s", message_id, exc)
        return False



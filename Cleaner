async def private_pending(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.effective_message
    user = update.effective_user
    chat = update.effective_chat
    if not message or not message.text or chat.type != ChatType.PRIVATE:
        return
    if not user or not is_bot_admin(user.id):
        return

    state = context.user_data.get("pending")
    if not state:
        return
    action = state.get("action")
    value = message.text.strip()

    if action == "reply_keyword":
        context.user_data["pending"] = {
            "action": "reply_response", "keyword": value
        }
        await message.reply_text("أرسل الرد الذي تريد أن يرسله البوت.")
        return

    if action == "reply_response":
        keyword = state["keyword"]
        with db() as con:
            con.execute("""
                INSERT INTO auto_replies(chat_id,keyword,response)
                VALUES(0,?,?)
                ON CONFLICT(id) DO NOTHING
            """, (keyword, value))
            # استبدال الرد العام الموجود للكلمة نفسها.
            con.execute("""
                DELETE FROM auto_replies
                WHERE chat_id=0 AND keyword=? AND id NOT IN (
                    SELECT MAX(id) FROM auto_replies
                    WHERE chat_id=0 AND keyword=?
                )
            """, (keyword, keyword))
        context.user_data.pop("pending", None)
        await message.reply_text(
            f"✅ تم حفظ الرد للكلمة: {html.escape(keyword)}",
            parse_mode="HTML", reply_markup=home_kb()
        )
        return

    if action == "delete_text":
        update_group(state["chat_id"], "delete_message", value)
        context.user_data.pop("pending", None)
        await message.reply_text(
            "✅ تم حفظ كليشة الحذف.",
            reply_markup=home_kb()
        )
        return

    if action == "sub_chat":
        try:
            chat_id = int(value)
        except ValueError:
            await message.reply_text("آيدي غير صحيح. أرسل أرقام آيدي الكروب.")
            return
        ensure_group(chat_id)
        context.user_data["pending"] = {
            "action": "sub_channel", "chat_id": chat_id
        }
        await message.reply_text("أرسل يوزر القناة أو آيديها.")
        return

    if action == "sub_channel":
        chat_id = state["chat_id"]
        update_group(chat_id, "subscription_channel", value)
        context.user_data["pending"] = {
            "action": "sub_link", "chat_id": chat_id
        }
        await message.reply_text("أرسل رابط القناة أو الاشتراك.")
        return

    if action == "sub_link":
        chat_id = state["chat_id"]
        update_group(chat_id, "subscription_link", value)
        update_group(chat_id, "subscription_enabled", 1)
        context.user_data.pop("pending", None)
        await message.reply_text(
            "✅ تم حفظ إعدادات الاشتراك وتفعيلها.",
            reply_markup=home_kb()
        )
        return

    if action == "admin_add":
        if not is_owner(user.id):
            context.user_data.pop("pending", None)
            return
        try:
            uid = int(value)
        except ValueError:
            try:
                info = await context.bot.get_chat(value)
                uid = info.id
            except TelegramError:
                await message.reply_text("لم أتعرف على المستخدم. أرسل آيدي صحيحاً.")
                return
        with db() as con:
            con.execute(
                "INSERT OR IGNORE INTO bot_admins(user_id) VALUES(?)",
                (uid,)
            )
        context.user_data.pop("pending", None)
        await message.reply_text(
            f"✅ تمت إضافة المشرف {uid}.", reply_markup=home_kb()
        )



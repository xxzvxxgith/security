async def get_subscription():
    return await sql(
        """SELECT enabled, channel, group_link
        FROM subscription WHERE chat_id=0""",
        mode="one",
    )


async def check_subscription(context, channel, user_id):
    """
    يرجع True إذا ثبت الاشتراك.
    يرجع False إذا ثبت عدم الاشتراك.
    يرجع None إذا تعذر التحقق؛ لا تحذف الرسالة في هذه الحالة.
    """
    try:
        target = int(channel) if str(channel).lstrip("-").isdigit() else channel
        member = await context.bot.get_chat_member(target, user_id)

        if member.status in ("creator", "administrator", "member"):
            return True

        if member.status == "restricted":
            return bool(getattr(member, "is_member", False))

        if member.status in ("left", "kicked", "banned"):
            return False

        # حالة غير معروفة: لا نفترض أن المستخدم غير مشترك.
        return None

    except TelegramError as exc:
        log.warning(
            "Subscription check failed for user %s in channel %s: %s",
            user_id, channel, exc,
        )
        return None


async def forced_subscription_guard(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    """
    يُنفّذ قبل معالجات الرسائل.
    لا يحذف رسائل المستخدم إذا فشل التحقق من عضويته.
    """
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if not message or not is_group_chat(chat) or not user or user.is_bot:
        return

    sub = await get_subscription()
    if not sub or not sub["enabled"] or not sub["channel"]:
        return

    # السماح للمشرفين العامين ومشرفي المجموعة.
    if await is_bot_admin(user.id):
        return

    if await actual_group_admin(context, chat.id, user.id):
        return

    subscribed = await check_subscription(
        context, sub["channel"], user.id
    )

    # عند فشل الفحص: لا حذف ولا رسالة منع.
    if subscribed is None:
        log.warning(
            "Fail-open: keeping message %s in group %s because "
            "subscription could not be verified.",
            message.message_id, chat.id,
        )
        return

    if subscribed:
        return

    try:
        await message.delete()
    except TelegramError:
        log.warning("Could not delete non-subscriber message.")

    try:
        link = sub["group_link"]
        if not link:
            link = "https://t.me/"

        keyboard = [[
            InlineKeyboardButton("اشترك بالقناة 🔗", url=link)
        ]]

        await context.bot.send_message(
            chat_id=chat.id,
            text=(
                "⚠️ يجب الاشتراك بالقناة أولاً حتى تتمكن من النشر.\n"
                "بعد الاشتراك، أرسل رسالتك مجدداً."
            ),
            reply_markup=InlineKeyboardMarkup(keyboard),
        )
    except TelegramError:
        log.exception("Could not send subscription prompt.")

    # يمنع بقية المعالجات من التعامل مع الرسالة المرفوضة.
    raise ApplicationHandlerStop



def contains_link(text):
    if not text:
        return False
    low = text.lower()
    return (
        "http://" in low
        or "https://" in low
        or "t.me/" in low
        or "www." in low
    )


async def track_message(update):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if not message or not chat or not user or user.is_bot:
        return

    timestamp = int(message.date.timestamp())

    ensure_group(chat.id, chat.title or "")

    with db() as con:
        con.execute("""
            INSERT OR IGNORE INTO tracked_messages
            (chat_id, message_id, user_id, message_date)
            VALUES(?, ?, ?, ?)
        """, (chat.id, message.message_id, user.id, timestamp))

        con.execute("""
            INSERT INTO users(chat_id, user_id, name, messages)
            VALUES(?, ?, ?, 1)
            ON CONFLICT(chat_id, user_id)
            DO UPDATE SET
                name=excluded.name,
                messages=users.messages+1
        """, (
            chat.id,
            user.id,
            user.full_name or str(user.id),
        ))

        # تنظيف السجلات التي تجاوزت 48 ساعة من جدول الرسائل.
        # أمر تنظيف 24 ساعة لا يحتاج سجلات أقدم من ذلك.
        con.execute("""
            DELETE FROM tracked_messages
            WHERE message_date<?
        """, (int(time.time()) - 48 * 3600,))


async def moderate_message(update, context):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if not message or not chat or chat.type == ChatType.PRIVATE:
        return

    if not user or user.is_bot:
        return

    # سجل الرسائل والإحصائيات حتى لو كانت بعض وظائف البوت متوقفة.
    await track_message(update)

    if setting("enabled", "1") != "1":
        return

    group = get_group(chat.id)
    if not group or not group.get("enabled", 1):
        return

    # لا نطبق الحذف التلقائي على المشرفين.
    try:
        member = await context.bot.get_chat_member(chat.id, user.id)
        if member.status in ("administrator", "creator"):
            return
    except TelegramError:
        pass

    # الاشتراك الإجباري
    if await subscription_gate(update, context, group):
        return

    should_delete = False

    if group.get("delete_replies") and message.reply_to_message:
        should_delete = True

    text = message.text or message.caption or ""

    if group.get("delete_links") and contains_link(text):
        should_delete = True

    if group.get("delete_photos") and message.photo:
        should_delete = True

    if group.get("delete_videos") and (
        message.video or message.video_note
    ):
        should_delete = True

    if group.get("delete_stickers") and message.sticker:
        should_delete = True

    if group.get("delete_gifs") and message.animation:
        should_delete = True

    if group.get("delete_audio") and (
        message.audio or message.voice
    ):
        should_delete = True

    if group.get("delete_files") and message.document:
        should_delete = True

    if group.get("delete_forwarded") and (
        getattr(message, "forward_origin", None)
        or getattr(message, "forward_date", None)
    ):
        should_delete = True

    if should_delete:
        await delete_message_safe(chat.id, message.message_id, context)
        return

    # الردود التلقائية: الرد العام chat_id=0 أو الخاص بالكروب.
    if message.text:
        with db() as con:
            rows = con.execute("""
                SELECT keyword, response
                FROM auto_replies
                WHERE chat_id IN (0, ?)
                ORDER BY chat_id DESC
            """, (chat.id,)).fetchall()

        lower_text = message.text.lower().strip()
        for row in rows:
            if row["keyword"].lower() == lower_text:
                try:
                    await message.reply_text(row["response"])
                except TelegramError:
                    pass
                break



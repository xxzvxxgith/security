async def show_top(chat_id, context, message=None):
    # استبعاد المشرفين الحاليين أيضاً من السجلات القديمة.
    admin_ids = set()
    try:
        admins = await context.bot.get_chat_administrators(chat_id)
        admin_ids = {item.user.id for item in admins}
    except Exception as exc:
        log.warning("تعذر جلب مشرفي الكروب للتوب العام %s: %s", chat_id, exc)
        if message:
            await message.reply_text("تعذر التحقق من قائمة المشرفين حالياً؛ لم أعرض التوب حتى لا تظهر إحصائياتهم ضمن توب الأعضاء.")
        else:
            await context.bot.send_message(chat_id, "تعذر التحقق من قائمة المشرفين حالياً؛ لم أعرض التوب حتى لا تظهر إحصائياتهم ضمن توب الأعضاء.")
        return

    with db() as con:
        all_rows = con.execute("""
            SELECT name,user_id,messages
            FROM users
            WHERE chat_id=?
            ORDER BY messages DESC
        """, (chat_id,)).fetchall()

    rows = [row for row in all_rows if row["user_id"] not in admin_ids][:10]

    if not rows:
        text = "لا توجد إحصائيات تفاعل حتى الآن."
    else:
        lines = ["🏆 <b>توب 10 المتفاعلين:</b>\n"]

        for i, row in enumerate(rows, 1):
            lines.append(
                f"{i}. {html.escape(row['name'] or 'عضو')} — "
                f"{row['messages']} رسالة"
            )

        text = "\n".join(lines)

    if message:
        await message.reply_text(text, parse_mode="HTML")
    else:
        await context.bot.send_message(
            chat_id,
            text,
            parse_mode="HTML",
        )


async def reset_top(update, context):
    chat = update.effective_chat
    message = update.effective_message

    if not chat or chat.type not in (
        ChatType.GROUP,
        ChatType.SUPERGROUP,
    ):
        await message.reply_text("هذا الأمر مخصص للكروبات.")
        return

    if not await is_group_admin(update, context):
        await message.reply_text("هذا الأمر للمشرفين فقط.")
        return

    with db() as con:
        con.execute(
            "DELETE FROM users WHERE chat_id=?",
            (chat.id,),
        )

    await message.reply_text("✅ تم تصفير توب المتفاعلين.")



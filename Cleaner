async def clean_messages(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.effective_message
    user = update.effective_user
    chat = update.effective_chat
    if not chat or chat.type not in ["group", "supergroup"]:
        return
    
    if not user or not await is_group_admin(update, context, user.id):
        await message.reply_text("❌ عذراً، أمر التنظيف مخصص للمشرفين المخولين فقط.")
        return

    cur.execute("SELECT active FROM groups WHERE chat_id=?", (chat.id,))
    row = cur.fetchone()
    if not row or row[0] == 0:
        await message.reply_text("⚠️ البوت متوقف حالياً. يرجى إرسال /تفعيل أولاً.")
        return

    await message.reply_text("🧹 جاري فحص وحذف الروابط والوسائط لآخر 24 ساعة...")

    cutoff = time.time() - 86400
    cur.execute("SELECT id, message_id FROM collected_messages WHERE chat_id=? AND timestamp >= ?", (chat.id, cutoff))
    records = cur.fetchall()

    deleted_success = 0
    not_available = 0
    failed_count = 0

    for rec_id, msg_id in records:
        try:
            await context.bot.delete_message(chat_id=chat.id, message_id=msg_id)
            deleted_success += 1
            cur.execute("DELETE FROM collected_messages WHERE id=?", (rec_id,))
            db.commit()
        except Exception as e:
            err_str = str(e).lower()
            if "message to delete not found" in err_str or "not modified" in err_str:
                not_available += 1
                cur.execute("DELETE FROM collected_messages WHERE id=?", (rec_id,))
                db.commit()
            else:
                failed_count += 1

    cur.execute("SELECT COUNT(*) FROM collected_messages WHERE chat_id=?", (chat.id,))
    total_remaining = cur.fetchone()[0]

    report = (
        f"📋 تقرير عملية التنظيف:\n\n"
        f"• تم الحذف بنجاح: {deleted_success}\n"
        f"• غير متاحة أو ممسوحة مسبقاً: {not_available}\n"
        f"• تعذر حذفها: {failed_count}\n"
        f"• المتبقي في القائمة: {total_remaining}"
    )
    await message.reply_text(report)

async def promote_mod(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.effective_message
    user = update.effective_user
    chat = update.effective_chat
    if not chat or chat.type not in ["group", "supergroup"]:
        return
    
    is_real_admin = False
    try:
        member = await context.bot.get_chat_member(chat.id, user.id)
        if member.status in [ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER]:
            is_real_admin = True
    except Exception:
        pass

    if not is_real_admin and user.id not in DEFAULT_ADMINS:
        await message.reply_text("❌ مخصص لمشرفي المجموعة الحقيقيين فقط.")
        return

    target_id = None
    if message.reply_to_message and message.reply_to_message.from_user:
        target_id = message.reply_to_message.from_user.id
    elif context.args:
        arg = context.args[0]
        if arg.isdigit():
            target_id = int(arg)
        elif arg.startswith("@"):
            cur.execute("SELECT user_id FROM users_map WHERE chat_id=? AND username=?", (chat.id, arg.lower()))
            res = cur.fetchone()
            if res:
                target_id = res[0]

    if not target_id:
        await message.reply_text("❌ رد على رسالة الشخص أو اكتب آيديه.")
        return

    cur.execute("INSERT OR IGNORE INTO cleaner_mods(chat_id, user_id) VALUES(?, ?)", (chat.id, target_id))
    db.commit()
    await message.reply_text(f"✅ تم رفع المستخدم ({target_id}) مشرفاً بنجاح.")


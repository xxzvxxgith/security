def classify_message(message):
    if not message:
        return None

    entities = (
        list(message.entities or [])
        + list(message.caption_entities or [])
    )

    if any(
        getattr(entity, "type", "") in ("url", "text_link")
        for entity in entities
    ):
        return "link"

    text = message.text or message.caption or ""
    if re.search(
        r"(?i)(https?://|www\.|t\.me/|telegram\.me/)\S+",
        text,
    ):
        return "link"

    media_types = (
        ("photo", "photo"),
        ("document", "document"),
        ("video", "video"),
        ("audio", "audio"),
        ("voice", "voice"),
        ("video_note", "video_note"),
        ("animation", "animation"),
        ("sticker", "sticker"),
        ("paid_media", "paid_media"),
    )

    for attribute, media_type in media_types:
        if getattr(message, attribute, None):
            return media_type

    return None



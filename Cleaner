async def sql(query, params=(), mode=None):
    async with db_lock:
        cur = db.execute(query, params)

        if mode == "one":
            result = cur.fetchone()
        elif mode == "all":
            result = cur.fetchall()
        else:
            result = None

        db.commit()
        cur.close()
        return result


async def ensure_group(chat_id):
    await sql(
        "INSERT OR IGNORE INTO groups(chat_id, active) VALUES(?, 1)",
        (chat_id,),
    )


async def is_active(chat_id):
    row = await sql(
        "SELECT active FROM groups WHERE chat_id=?",
        (chat_id,),
        "one",
    )
    return bool(row["active"]) if row else True


async def set_active(chat_id, active):
    await sql(
        """INSERT INTO groups(chat_id, active) VALUES(?, ?)
        ON CONFLICT(chat_id) DO UPDATE SET active=excluded.active""",
        (chat_id, int(active)),
    )


async def is_bot_admin(user_id):
    return await sql(
        "SELECT 1 FROM bot_admins WHERE user_id=?",
        (user_id,),
        "one",
    ) is not None


async def actual_group_admin(context, chat_id, user_id):
    try:
        member = await context.bot.get_chat_member(chat_id, user_id)
        return member.status in (
            ChatMemberStatus.ADMINISTRATOR,
            ChatMemberStatus.OWNER,
        )
    except TelegramError:
        return False


async def can_manage(update, context, user_id):
    chat = update.effective_chat

    if not chat:
        return False

    if await is_bot_admin(user_id):
        return True

    if await actual_group_admin(context, chat.id, user_id):
        return True

    return await sql(
        "SELECT 1 FROM cleaner_mods WHERE chat_id=? AND user_id=?",
        (chat.id, user_id),
        "one",
    ) is not None


async def can_manage_mods(update, context, user_id):
    chat = update.effective_chat

    if not chat:
        return False

    return (
        await is_bot_admin(user_id)
        or await actual_group_admin(context, chat.id, user_id)
    )


async def remember_user(chat_id, user):
    if not user or not user.username:
        return

    await sql(
        """INSERT INTO users_map(chat_id, username, user_id, updated_at)
        VALUES(?, ?, ?, ?)
        ON CONFLICT(chat_id, username)
        DO UPDATE SET user_id=excluded.user_id,
                      updated_at=excluded.updated_at""",
        (chat_id, user.username.lower(), user.id, time.time()),
    )


async def resolve_target(update, context, raw):
    raw = (raw or "").strip()

    if raw.isdigit():
        return int(raw)

    username = raw.lstrip("@").lower()

    if not username:
        return None

    row = await sql(
        "SELECT user_id FROM users_map WHERE chat_id=? AND username=?",
        (update.effective_chat.id, username),
        "one",
    )

    if row:
        return int(row["user_id"])

    try:
        chat = await context.bot.get_chat("@" + username)
        return chat.id
    except TelegramError:
        return None



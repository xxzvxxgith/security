LINK_PATTERN = re.compile(
    r"""(?ix)
    (?:
        https?://[^\s<>()]+
        |
        www\.[^\s<>()]+
        |
        t\.me/[^\s<>()]+
        |
        telegram\.me/[^\s<>()]+
        |
        tg://[^\s<>()]+
        |
        \b[a-z0-9-]+(?:\.[a-z0-9-]+)+\.[a-z]{2,}\b
    )
    """
)


def contains_link(message):
    if not message:
        return False

    entities = list(message.entities or [])
    entities.extend(message.caption_entities or [])

    for entity in entities:
        entity_type = getattr(entity.type, "value", entity.type)
        if entity_type in ("url", "text_link"):
            return True

    return bool(
        LINK_PATTERN.search(message.text or "")
        or LINK_PATTERN.search(message.caption or "")
    )


def classify_message(message):
    """يرجع نوع الميديا أو الرابط، ويرجع None للنص العادي."""

    if not message:
        return None

    if message.photo:
        return "photo"
    if message.video:
        return "video"
    if message.animation:
        return "animation"
    if message.sticker:
        return "sticker"
    if message.audio:
        return "audio"
    if message.voice:
        return "voice"
    if message.video_note:
        return "video_note"
    if message.document:
        return "document"
    if contains_link(message):
        return "link"

    return None


def is_command_message(message):
    if not message or not message.text:
        return False

    text = message.text.strip()

    if text.startswith("/"):
        return True

    return text in {
        "تنظيف",
        "تنظيف 24",
        "تنظيف24",
        "حالة",
        "توب",
        "تصفير التوب",
        "تفعيل",
        "إيقاف",
    }


def record_message(message):
    """تسجيل الرسائل المؤهلة فقط مرة واحدة لكل message_id."""

    if not message or not message.chat or not message.from_user:
        return False

    if message.from_user.is_bot:
        return False

    if message.chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return False

    if is_command_message(message):
        return False

    kind = classify_message(message)

    # النصوص العادية لا تصل إلى قاعدة البيانات.
    if kind not in ELIGIBLE_KINDS:
        return False

    chat_id = message.chat.id
    message_id = message.message_id
    user = message.from_user

    msg_date = message.date
    if msg_date.tzinfo is None:
        msg_date = msg_date.replace(tzinfo=timezone.utc)

    timestamp = int(msg_date.timestamp())
    display_name = user.full_name or user.username or str(user.id)

    with db_lock:
        try:
            cursor = db.execute("""
                INSERT OR IGNORE INTO tracked_messages
                    (chat_id, message_id, user_id,
                     message_date, kind, deleted)
                VALUES (?, ?, ?, ?, ?, 0)
            """, (
                chat_id,
                message_id,
                user.id,
                timestamp,
                kind,
            ))

            inserted = cursor.rowcount == 1

            if inserted:
                db.execute("""
                    INSERT INTO users
                        (chat_id, user_id, name, messages)
                    VALUES (?, ?, ?, 1)
                    ON CONFLICT(chat_id, user_id)
                    DO UPDATE SET
                        name = excluded.name,
                        messages = users.messages + 1
                """, (chat_id, user.id, display_name))

                if user.username:
                    db.execute("""
                        INSERT INTO users_map
                            (chat_id, username, user_id, updated_at)
                        VALUES (?, ?, ?, ?)
                        ON CONFLICT(chat_id, username)
                        DO UPDATE SET
                            user_id = excluded.user_id,
                            updated_at = excluded.updated_at
                    """, (
                        chat_id,
                        user.username.lower(),
                        user.id,
                        int(time.time()),
                    ))

            # الاحتفاظ بآخر 48 ساعة فقط.
            db.execute("""
                DELETE FROM tracked_messages
                WHERE message_date < ?
            """, (int(time.time()) - 48 * 60 * 60,))

            db.commit()
            return inserted

        except Exception:
            db.rollback()
            logger.exception(
                "فشل تسجيل الرسالة chat=%s message=%s",
                chat_id,
                message_id,
            )
            return False



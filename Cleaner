async def resolve_target(update, context, raw):
    raw = (raw or "").strip()
    if raw.isdigit():
        return int(raw)
    username = raw.lstrip("@").lower()
    row = await sql("SELECT user_id FROM users_map WHERE chat_id=? AND username=?",
                    (update.effective_chat.id, username), "one")
    if row:
        return int(row["user_id"])
    try:
        return (await context.bot.get_chat("@" + username)).id
    except TelegramError:
        return None

def classify(msg):
    """Return a category for every normal, potentially deletable group message."""
    if not msg:
        return None

    # Media types are checked before text so a caption does not turn a photo/video
    # into a plain text message. Links in captions are still recorded as media.
    for attr, kind in (
        ("photo", "photo"),
        ("video", "video"),
        ("animation", "animation"),
        ("sticker", "sticker"),
        ("document", "document"),
        ("audio", "audio"),
        ("voice", "voice"),
        ("video_note", "video_note"),
        ("paid_media", "paid_media"),
        ("contact", "contact"),
        ("location", "location"),
        ("venue", "venue"),
        ("poll", "poll"),
        ("dice", "dice"),
        ("game", "game"),
    ):
        if getattr(msg, attr, None):
            return kind

    entities = list(msg.entities or []) + list(msg.caption_entities or [])
    if any(getattr(e, "type", "") in ("url", "text_link") for e in entities):
        return "link"
    text = msg.text or msg.caption or ""
    if re.search(r"(?i)(https?://|www\.|t\.me/|telegram\.me/)\S+", text):
        return "link"
    if msg.text or msg.caption:
        return "text"
    return None


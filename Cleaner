        "حدث خطأ أثناء معالجة تحديث",
        exc_info=context.error,
    )


# =========================================================
# التشغيل
# =========================================================

def main():
    if not TOKEN:
        raise RuntimeError(
            "ما لقيت BOT_TOKEN. عيّن متغير البيئة BOT_TOKEN قبل التشغيل."
        )

    init_db()

    app = ApplicationBuilder().token(TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("help", help_command))
    app.add_handler(CommandHandler("clean", clean_command))
    app.add_handler(CommandHandler("top", top_command))
    app.add_handler(CommandHandler("status", status_command))
    app.add_handler(CommandHandler("enable", enable_command))
    app.add_handler(CommandHandler("disable", disable_command))
    app.add_handler(CommandHandler("reset_top", reset_top))

    app.add_handler(CallbackQueryHandler(panel_callback))

    # رسائل الخاص التي تنتظرها لوحة التحكم.
    app.add_handler(
        MessageHandler(
            filters.ChatType.PRIVATE & filters.TEXT & ~filters.COMMAND,
            private_pending,
        ),
        group=0,
    )

    # أوامر الكروب المكتوبة بالعربي.
    app.add_handler(
        MessageHandler(
            filters.ChatType.GROUPS & filters.TEXT & ~filters.COMMAND,
            group_text_commands,
        ),
        group=1,
    )

    # تسجيل الرسائل وتطبيق إعدادات الحذف والردود.
    app.add_handler(
        MessageHandler(
            filters.ChatType.GROUPS & ~filters.StatusUpdate.ALL,
            moderate_message,
        ),
        group=2,
    )

    app.add_error_handler(error_handler)

    logger.info("Bot started.")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()

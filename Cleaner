async def sql(query, params=(), mode=None):
    async with db_lock:
        cur = db.execute(query, params)
        if mode == "one":
            result = cur.fetchone()
        elif mode == "all":
            result = cur.fetchall()
        else:
            result = None
        db.commit()
        cur.close()
        return result



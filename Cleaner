async def private_panel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg, user, chat = update.effective_message, update.effective_user, update.effective_chat
    if not msg or not msg.text or not user or not chat or chat.type != ChatType.PRIVATE:
        return
    if not await is_bot_admin(user.id):
        return
    action = context.user_data.get("action")
    if not action:
        return
    text = msg.text.strip()
    if action in ("add_admin", "remove_admin"):
        if not text.isdigit():
            await msg.reply_text("أرسل آيدي رقمي صحيح.")
            return
        target = int(text)
        if action == "add_admin":
            await sql("INSERT OR IGNORE INTO bot_admins(user_id,added_at) VALUES(?,?)",
                      (target, time.time()))
            answer = f"تم رفع {target} مشرفاً عاماً."
        else:
            if target in OWNER_IDS:
                await msg.reply_text("لا يمكن تنزيل المالك الأساسي.")
                context.user_data.pop("action", None)
                return
            await sql("DELETE FROM bot_admins WHERE user_id=?", (target,))
            answer = f"تم تنزيل {target} من المشرفين العامين."
        context.user_data.pop("action", None)
        await msg.reply_text(answer)
    elif action == "set_sub":
        parts = text.split()
        if not parts:
            await msg.reply_text("أرسل معرف القناة والرابط.")
            return
        channel_input = parts[0]
        try:
            channel_chat = await context.bot.get_chat(
                channel_input if channel_input.startswith("@") else "@" + channel_input.lstrip("@")
            )
            channel = str(channel_chat.id)
        except TelegramError:
            if channel_input.lstrip("-").isdigit():
                channel = channel_input
            else:
                await msg.reply_text("تعذر التحقق من القناة. تحقق من المعرف وصلاحيات البوت.")
                return
        link = parts[1] if len(parts) > 1 else "https://t.me/" + channel_input.lstrip("@")
        if not link.startswith(("https://t.me/", "https://telegram.me/")):
            await msg.reply_text("الرابط يجب أن يبدأ بـ https://t.me/ أو https://telegram.me/")
            return
        await sql("""INSERT INTO subscription(chat_id,enabled,channel,group_link)
          VALUES(0,1,?,?) ON CONFLICT(chat_id) DO UPDATE SET
          enabled=1,channel=excluded.channel,group_link=excluded.group_link""", (channel, link))
        context.user_data.pop("action", None)
        await msg.reply_text(f"تم تفعيل الاشتراك الإجباري.\nالقناة: {channel}\nالرابط: {link}")


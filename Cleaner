# =========================================================
# MODERATION CLASSIFICATION
# =========================================================

URL_RE = re.compile(
    r"(?i)(https?://\S+|www\.\S+|t\.me/\S+|telegram\.me/\S+)"
    r"|(?:^|\s)@[A-Za-z0-9_]{4,}"
)


def has_link(message):
    if URL_RE.search(message.text or message.caption or ""):
        return True

    entities = list(message.entities or []) + list(message.caption_entities or [])
    for entity in entities:
        if entity.type in ("url", "text_link"):
            return True

    return False


def classify_message(message):
    """Return every moderation category matching this message."""
    found = set()

    if has_link(message):
        found.add("links")

    if message.photo:
        found.add("photos")

    if message.video:
        found.add("videos")

    if message.sticker:
        # Animated/video stickers may be classified separately too.
        found.add("stickers")

    if message.animation:
        found.add("animations")
        found.add("gifs")

    if message.voice or message.audio:
        found.add("voice")

    if message.video_note:
        found.add("video_notes")

    if message.document:
        found.add("files")

    if message.text is not None or message.caption is not None:
        found.add("text")

    if getattr(message, "forward_origin", None) is not None:
        found.add("forward")
    elif (
        getattr(message, "forward_date", None) is not None
        or getattr(message, "forward_from", None) is not None
        or getattr(message, "forward_from_chat", None) is not None
    ):
        found.add("forward")

    return found


async def silently_delete_if_restricted(update, context):
    msg = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if not msg or not chat or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return False
    if not user or user.is_bot:
        return False

    if not group_enabled(chat.id):
        return False

    # Never delete an owner's or administrator's content.
    if await is_group_admin(context.bot, chat.id, user.id):
        return False

    categories = classify_message(msg)
    if not categories:
        return False

    active = [
        kind for kind in categories
        if kind in MODERATION_TYPES and moderation_enabled(chat.id, kind)
    ]
    if not active:
        return False

    if not await bot_can_delete(context.bot, chat.id):
        # Silent moderation: no public warning message.
        log.warning(
            "Cannot delete in group %s: missing delete-message permission",
            chat.id,
        )
        return False

    try:
        await msg.delete()
        increment_usage("moderation_deleted")
        increment_usage(f"moderation_deleted_{chat.id}")
        return True
    except TelegramError as exc:
        log.warning("Delete failed in chat %s: %s", chat.id, exc)
        return False



async def track_message(update, context):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if not message or not chat or not user or user.is_bot:
        return

    if chat.type not in (
        ChatType.GROUP,
        ChatType.SUPERGROUP,
    ):
        return

    ensure_group(chat.id, chat.title or "")

    # حفظ اليوزر والآيدي حتى يمكن استهداف العضو باليوزر لاحقاً.
    with db() as con:
        con.execute("""
            INSERT INTO member_directory(chat_id,user_id,username,full_name)
            VALUES(?,?,?,?)
            ON CONFLICT(chat_id,user_id) DO UPDATE SET
                username=excluded.username,
                full_name=excluded.full_name
        """, (
            chat.id, user.id, (user.username or "").lower(),
            user.full_name or str(user.id),
        ))

    # التوبان منفصلان: رسائل الأعضاء للتوب العام فقط،
    # ورسائل المشرفين لتوب المشرفين فقط.
    is_admin = False
    role_checked = False
    try:
        member = await context.bot.get_chat_member(chat.id, user.id)
        # Telegram API status values are strings: "creator", "administrator",
        # "member", etc. Use the raw values here to avoid enum-version differences.
        is_admin = str(member.status).lower() in (
            "administrator", "creator", "owner"
        )
        role_checked = True
    except Exception as exc:
        # إذا تعذر التحقق من الرتبة، لا نضيف الرسالة لأي توب
        # حتى لا تدخل رسالة مشرف بالغلط في التوب العام.
        log.debug("تعذر التحقق من رتبة المستخدم %s: %s", user.id, exc)

    if role_checked:
        table = "admin_messages" if is_admin else "users"
        with db() as con:
            con.execute(f"""
                INSERT INTO {table}(chat_id,user_id,name,messages)
                VALUES(?,?,?,1)
                ON CONFLICT(chat_id,user_id) DO UPDATE SET
                    name=excluded.name,
                    messages={table}.messages+1
            """, (
                chat.id,
                user.id,
                user.full_name or str(user.id),
            ))

    # -----------------------------------------------------
    # ثانياً: سجل التنظيف يسجل أنواعاً محددة فقط.
    # لا تُسجل الرسائل النصية العادية.
    # -----------------------------------------------------

    if not is_trackable_message(message):
        return

    timestamp = int(message.date.timestamp())

    with db() as con:
        con.execute("""
            INSERT OR IGNORE INTO tracked_messages
            (chat_id,message_id,user_id,message_date,kind)
            VALUES(?,?,?,?,?)
        """, (
            chat.id,
            message.message_id,
            user.id,
            timestamp,
            message_kind(message),
        ))

        # الاحتفاظ بسجلات تكفي لآخر 24 ساعة مع هامش.
        retention_cutoff = (
            int(time.time()) - TRACK_RETENTION_HOURS * 3600
        )

        con.execute("""
            DELETE FROM tracked_messages
            WHERE message_date<?
        """, (retention_cutoff,))



    if not chat or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        await message.reply_text("هذا الأمر مخصص للكروبات.")
        return

    if not await is_group_admin(update, context):
        await message.reply_text("هذا الأمر مخصص لمشرفي الكروب فقط.")
        return

    try:
        administrators = await context.bot.get_chat_administrators(chat.id)
        admins = [item.user for item in administrators if not item.user.is_bot]

        if not admins:
            await message.reply_text("لا يوجد مشرفون لعرض التوب.")
            return

        with db() as con:
            rows = con.execute(
                "SELECT user_id,name,messages FROM admin_messages WHERE chat_id=?",
                (chat.id,),
            ).fetchall()

        saved = {row["user_id"]: row for row in rows}
        results = []
        for admin in admins:
            row = saved.get(admin.id)
            results.append((
                row["name"] if row and row["name"] else admin.full_name,
                row["messages"] if row else 0,
            ))

        results.sort(key=lambda item: item[1], reverse=True)
        lines = ["🏆 <b>توب مشرفي الكروب</b>", f"👥 عدد المشرفين: {len(admins)}", ""]
        for rank, (name, count) in enumerate(results, 1):
            lines.append(f"{rank}. {html.escape(name or 'مشرف')} — {count} رسالة")

        await message.reply_text("\n".join(lines), parse_mode="HTML")
    except TelegramError as exc:
        log.warning("تعذر جلب مشرفي الكروب %s: %s", chat.id, exc)

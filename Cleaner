async def search_profile(update, context, query):
    requester = update.effective_user
    query = normalize_query(query)
    if not query:
        await update.effective_message.reply_text(
            "أرسل ID أو @username للبحث."
        )
        return

    increment_usage("searches")
    result = await telethon_lookup(parse_user_id(query))

    if result and result.get("id"):
        execute("""
            INSERT INTO profiles(user_id,username,first_name,last_name,bio)
            VALUES(?,?,?,?,?)
            ON CONFLICT(user_id) DO UPDATE SET
                username=excluded.username,
                first_name=excluded.first_name,
                last_name=excluded.last_name,
                bio=excluded.bio,
                last_seen=CURRENT_TIMESTAMP
        """, (
            result["id"], result["username"], result["first_name"],
            result["last_name"], result["bio"],
        ))
        execute("""
            INSERT INTO name_history(user_id,first_name,last_name,username)
            VALUES(?,?,?,?)
        """, (
            result["id"], result["first_name"],
            result["last_name"], result["username"],
        ))
        profile_text = format_profile(result)
        log_result = "found"
    else:
        # Bot API fallback: Telegram bots cannot resolve every arbitrary ID.
        profile_text = (
            "لم أتمكن من الوصول إلى هذا الحساب.\n"
            "قد يحتاج البحث إلى اسم مستخدم عام صالح أو جلسة Telethon "
            "مصرّح بها. لا يستطيع Bot API استرجاع أي حساب عشوائي بواسطة ID."
        )
        log_result = "not_found"

    execute("""
        INSERT INTO search_logs(requester_id,query,result) VALUES(?,?,?)
    """, (requester.id, query, log_result))

    await update.effective_message.reply_text(
        profile_text, parse_mode="HTML"
    )



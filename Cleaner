def ensure_group(chat_id):
    cur.execute("INSERT OR IGNORE INTO groups(chat_id, active) VALUES(?, 1)", (chat_id,))
    db.commit()

async def is_group_admin(update: Update, context: ContextTypes.DEFAULT_TYPE, user_id: int) -> bool:
    chat_id = update.effective_chat.id
    if user_id in DEFAULT_ADMINS:
        return True
    try:
        member = await context.bot.get_chat_member(chat_id, user_id)
        if member.status in [ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER]:
            return True
    except Exception:
        pass
    
    cur.execute("SELECT 1 FROM cleaner_mods WHERE chat_id=? AND user_id=?", (chat_id, user_id))
    return cur.fetchone() is not None

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.effective_message

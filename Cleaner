async def sql(query, params=(), mode=None):
    async with db_lock:
        cur = db.execute(query, params)
        if mode == "one":
            result = cur.fetchone()
        elif mode == "all":
            result = cur.fetchall()
        else:
            result = None
        db.commit()
        cur.close()
        return result

async def is_bot_admin(uid):
    return await sql("SELECT 1 FROM bot_admins WHERE user_id=?", (uid,), "one") is not None

async def ensure_group(cid):
    await sql("INSERT OR IGNORE INTO groups(chat_id,active) VALUES(?,1)", (cid,))

async def is_active(cid):
    row = await sql("SELECT active FROM groups WHERE chat_id=?", (cid,), "one")
    return bool(row["active"]) if row else True

async def actual_group_admin(context, cid, uid):
    try:
        member = await context.bot.get_chat_member(cid, uid)
        return member.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER)
    except TelegramError:
        return False

async def can_manage(update, context, uid):
    chat = update.effective_chat
    if not chat:
        return False
    if await is_bot_admin(uid) or await actual_group_admin(context, chat.id, uid):
        return True
    return await sql("SELECT 1 FROM cleaner_mods WHERE chat_id=? AND user_id=?",
                     (chat.id, uid), "one") is not None

async def can_manage_mods(update, context, uid):
    chat = update.effective_chat
    return bool(chat and (await is_bot_admin(uid) or
                          await actual_group_admin(context, chat.id, uid)))


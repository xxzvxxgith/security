                [KeyboardButton("تعيين اشتراك إجباري 🔗"), KeyboardButton("حذف اشتراك إجباري 🗑️")],
                [KeyboardButton("تفعيل البوت بقسم 🟢"), KeyboardButton("إيقاف البوت بقسم 🛑")]
            ]
            await update.message.reply_text(
                "أهلاً بك في لوحة تحكم بوت Cleaner (الخاصة بالمشرفين):\nاختر من الأزرار أدناه للتحكم:",
                reply_markup=ReplyKeyboardMarkup(keyboard, resize_keyboard=True)
            )
        else:
            await update.message.reply_text("أهلاً بك في بوت Cleaner لتنظيف المجموعات من الروابط والوسائط.")

async def callback_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data or ""
    user_id = query.from_user.id

    if data.startswith("mod:"):
        parts = data.split(":")
        if len(parts) != 3:
            return
        chat_id, kind = int(parts[1]), parts[2]
        if kind not in MODERATION_TYPES:
            return
        if not await is_group_admin(context.bot, chat_id, user_id):
            await query.answer("هذا الخيار لمشرفي المجموعة فقط.", show_alert=True)
            return

        new_value = not moderation_enabled(chat_id, kind)
        set_moderation(chat_id, kind, new_value)
        await query.edit_message_reply_markup(
            reply_markup=moderation_keyboard(chat_id)
        )
        return

    if data.startswith("modall:"):
        _, chat_id, value = data.split(":")
        chat_id, enabled = int(chat_id), int(value)
        if not await is_group_admin(context.bot, chat_id, user_id):
            await query.answer("للمشرفين فقط.", show_alert=True)
            return
        ensure_group(chat_id)
        for kind in MODERATION_TYPES:
            set_moderation(chat_id, kind, bool(enabled))
        await query.edit_message_reply_markup(
            reply_markup=moderation_keyboard(chat_id)
        )
        return

    if data.startswith("reset_top:"):
        chat_id = int(data.split(":")[1])
        if not await is_group_admin(context.bot, chat_id, user_id):
            await query.answer("للمشرفين فقط.", show_alert=True)
            return
        execute("DELETE FROM users WHERE chat_id=?", (chat_id,))
        await query.edit_message_text("تم تصفير توب المتفاعلين.")
        return

    if data == "menu_help":
        await query.edit_message_text(
            "الأوامر:\n/start /help /id /history ID /stats /owner\n"
            "للتنظيف داخل المجموعة استخدم: /clean"

# =========================================================
# التشغيل
# =========================================================

def main():
    if not TOKEN:
        raise RuntimeError(
            "عيّن توكن البوت في متغير البيئة BOT_TOKEN."
        )

    init_db()

    app = Application.builder().token(TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("clean", clean_command))
    app.add_handler(CommandHandler("top", top_command))
    app.add_handler(CommandHandler("status", status_command))
    app.add_handler(CommandHandler("enable", enable_command))
    app.add_handler(CommandHandler("disable", disable_command))
    app.add_handler(CommandHandler("reset_top", reset_top))
    app.add_handler(CommandHandler("admin_top", admin_top_command))
    app.add_handler(CommandHandler("reset_admin_top", reset_admin_top))

    app.add_handler(
        CallbackQueryHandler(panel_callback)
    )

    # إجابات لوحة التحكم في الخاص.
    app.add_handler(
        MessageHandler(
            filters.ChatType.PRIVATE
            & filters.TEXT
            & ~filters.COMMAND,
            private_pending,
        ),
        group=0,
    )

    # أوامر النصوص في الكروبات.
    app.add_handler(
        MessageHandler(
            filters.ChatType.GROUPS & filters.TEXT,
            group_text_commands,
        ),
        group=1,
    )

    # معالجة جميع الرسائل، بما فيها الميديا.
    # هذا المعالج منفصل عن معالج الأوامر أعلاه.
    app.add_handler(
        MessageHandler(
            filters.ChatType.GROUPS
            & ~filters.StatusUpdate.ALL,
            moderate_message,
        ),
        group=2,
    )

    app.add_error_handler(error_handler)

    # تنظيف سجلات الكتم/التقييد المنتهية دورياً.
    if app.job_queue:
        app.job_queue.run_repeating(
            expire_moderations, interval=15, first=5,
            name="expire_moderations",
        )

    log.info("Cleaner started.")

    app.run_polling(
        allowed_updates=Update.ALL_TYPES
    )


if __name__ == "__main__":
    main()
 

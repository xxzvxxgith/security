async def collect(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg, chat, user = update.effective_message, update.effective_chat, update.effective_user
    if not msg or not chat or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return
    if user and user.is_bot:
        return
    await ensure_group(chat.id)
    if user:
        await remember_user(chat.id, user)

    sub = await sql("SELECT enabled,channel,group_link FROM subscription WHERE chat_id=0", mode="one")
    if sub and sub["enabled"] and user:
        privileged = await is_bot_admin(user.id) or await actual_group_admin(context, chat.id, user.id)
        if not privileged:
            subscribed = False
            try:
                target = int(sub["channel"]) if str(sub["channel"]).lstrip("-").isdigit() else sub["channel"]
                member = await context.bot.get_chat_member(target, user.id)
                subscribed = member.status in (
                    ChatMemberStatus.MEMBER, ChatMemberStatus.ADMINISTRATOR,
                    ChatMemberStatus.OWNER, ChatMemberStatus.RESTRICTED
                )
                if member.status == ChatMemberStatus.RESTRICTED and not getattr(member, "is_member", True):
                    subscribed = False
            except TelegramError:
                subscribed = False
            if not subscribed:
                try:
                    await msg.delete()
                except TelegramError:
                    pass
                try:
                    keyboard = [[InlineKeyboardButton("اشترك بالقناة 🔗", url=sub["group_link"])]]
                    await context.bot.send_message(
                        chat.id, f"يجب الاشتراك بالقناة أولاً حتى تتمكن من النشر.\n{user.mention_html()}",
                        parse_mode="HTML", reply_markup=InlineKeyboardMarkup(keyboard)
                    )
                except TelegramError:
                    log.exception("Failed to send subscription message")
                return

    if msg.text and msg.text.strip().lower() in ("تفعيل", "إيقاف", "ايقاف", "تنظيف", "حالة"):
        return
    # Slash commands are not counted as ordinary messages.
    if msg.text and msg.text.startswith("/"):
        return
    if not await is_active(chat.id):
        return
    kind = classify(msg)
    if not kind:
        return
    now = time.time()
    await sql("""INSERT OR IGNORE INTO collected_messages
       (chat_id,message_id,timestamp,user_id,media_type) VALUES(?,?,?,?,?)""",
       (chat.id, msg.message_id, now, user.id if user else None, kind))
    await sql("DELETE FROM collected_messages WHERE chat_id=? AND timestamp<?",
              (chat.id, now - DAY))

async def lambda_update_dispatch(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = (update.effective_message.text or "").split()[0].split("@", 1)[0].lstrip("/")
    handlers = {"تنظيف": clean, "تفعيل": enable, "إيقاف": disable, "ايقاف": disable, "حالة": status}
    handler = handlers.get(text)
    if handler:
        await handler(update, context)

async def error_handler(update: object, context: ContextTypes.DEFAULT_TYPE):
    if isinstance(context.error, (NetworkError, TimedOut)):
        log.warning("Temporary network error: %s", context.error)
    else:
        log.error("Unhandled bot error", exc_info=context.error)


async def subscription_gate(update, context, group):
    message = update.effective_message
    user = update.effective_user
    chat = update.effective_chat

    if not group.get("subscription_enabled") or not user:
        return False

    channel = (
        group.get("subscription_channel") or ""
    ).strip()

    link = (
        group.get("subscription_link") or ""
    ).strip()

    if not channel:
        return False

    try:
        member = await context.bot.get_chat_member(
            channel, user.id
        )

        if member.status in (
            ChatMemberStatus.MEMBER,
            ChatMemberStatus.ADMINISTRATOR,
            ChatMemberStatus.OWNER,
        ):
            return False

        # LEFT أو BANNED يعني أن المستخدم ليس مشتركاً.

    except TelegramError as exc:
        log.warning(
            "تعذر التحقق من اشتراك القناة %s: %s",
            channel,
            exc,
        )
        # لا نحذف رسالة المستخدم عند فشل التحقق.
        return False

    await safe_delete(
        chat.id,
        message.message_id,
        context,
    )

    buttons = []

    if link:
        buttons.append([
            InlineKeyboardButton(
                "📢 اشترك بالقناة",
                url=link,
            )
        ])

    try:
        await context.bot.send_message(
            chat.id,
            f"{user.mention_html()}، يجب الاشتراك بالقناة أولاً.",
            parse_mode="HTML",
            reply_markup=(
                InlineKeyboardMarkup(buttons)
                if buttons else None
            ),
        )
    except TelegramError:
        pass

    return True



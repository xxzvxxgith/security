# ==================== جمع الرسائل والاشتراك الإجباري ====================

async def collect_messages(update, context):
    message, chat, user = update.effective_message, update.effective_chat, update.effective_user
    if not message or not chat or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return
    if user and user.is_bot:
        return

    await ensure_group(chat.id)
    if user:
        await remember_user(chat.id, user)

    sub = await sql(
        "SELECT enabled, channel, group_link FROM subscription WHERE chat_id=0",
        mode="one"
    )

    if sub and sub["enabled"] and user:
        privileged = (
            await is_bot_admin(user.id)
            or await actual_group_admin(context, chat.id, user.id)
        )

        if not privileged:
            try:
                channel_value = str(sub["channel"])
                target = int(channel_value) if channel_value.lstrip("-").isdigit() else channel_value
                member = await context.bot.get_chat_member(target, user.id)
                subscribed = member.status in (
                    ChatMemberStatus.MEMBER,
                    ChatMemberStatus.ADMINISTRATOR,
                    ChatMemberStatus.OWNER,
                )
                if member.status == ChatMemberStatus.RESTRICTED:
                    subscribed = bool(getattr(member, "is_member", False))
            except TelegramError:
                # لا تحذف الرسالة إذا تعذر التأكد من عضوية الشخص.
                log.exception("تعذر التحقق من عضوية القناة؛ تركت الرسالة دون حذف.")
                return

            if not subscribed:
                try:
                    await message.delete()
                except TelegramError:
                    log.exception("تعذر حذف رسالة غير المشترك.")
                try:
                    keyboard = [[InlineKeyboardButton(
                        "اشترك بالقناة 🔗", url=sub["group_link"]
                    )]]
                    await context.bot.send_message(
                        chat.id,
                        "يجب الاشتراك بالقناة أولاً حتى تتمكن من النشر.\n"
                        + user.mention_html(),
                        parse_mode="HTML",
                        reply_markup=InlineKeyboardMarkup(keyboard),
                    )
                except TelegramError:
                    log.exception("تعذر إرسال تنبيه الاشتراك.")
                return

    if message.text:
        plain = message.text.strip().lower()
        if (
            plain in ("تفعيل", "إيقاف", "ايقاف", "تنظيف", "حالة", "مشرفيني")
            or plain.startswith(("رفع_مشرف", "تنزيل_مشرف"))
        ):
            return

    if not await is_active(chat.id):
        return

    media_type = classify_message(message)
    if not media_type:
        return

    now = time.time()
    await sql(
        """INSERT OR IGNORE INTO collected_messages
        (chat_id, message_id, timestamp, user_id, media_type)
        VALUES(?, ?, ?, ?, ?)""",
        (chat.id, message.message_id, now, user.id if user else None, media_type)
    )
    await sql(
        "DELETE FROM collected_messages WHERE chat_id=? AND timestamp<?",
        (chat.id, now - DAY)
    )



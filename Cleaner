async def panel_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    user, data = query.from_user, query.data or ""
    await query.answer()
    
    if not is_bot_admin_sync(user.id): return

    if data == "home":
        await query.edit_message_text("🤖 <b>لوحة إدارة Cleaner</b>\n\nاختر الوظيفة:", parse_mode="HTML", reply_markup=home_kb())
    elif data == "stats":
        await query.edit_message_text(f"📊 <b>الإحصائيات العامة:</b>\n• الكروبات: {db.execute('SELECT COUNT(*) FROM groups WHERE chat_id<>0').fetchone()[0]}", parse_mode="HTML", reply_markup=back_kb())
    elif data == "settings":
        await query.edit_message_text("⚙️ اختر الكروب:", reply_markup=groups_kb("setgroup"))
    elif data.startswith("setgroup:"):
        await query.edit_message_text("⚙️ الإعدادات:", reply_markup=settings_kb(int(data.split(":", 1)[1])))
    elif data.startswith("toggle:"):
        _, cid, fld = data.split(":")
        cid = int(cid)
        g = get_group(cid)
        update_group(cid, fld, 0 if g.get(fld, 0) else 1)
        await query.edit_message_reply_markup(reply_markup=settings_kb(cid))
    elif data.startswith("delete_text:"):
        context.user_data["pending"] = {"action": "delete_text", "chat_id": int(data.split(":", 1)[1])}
        await query.edit_message_text("أرسل كليشة الحذف الجديدة:", reply_markup=back_kb())
    elif data == "replies":
        await replies_menu(query)
    elif data == "reply_add":
        context.user_data["pending"] = {"action": "reply_keyword"}
        await query.edit_message_text("أرسل الكلمة المفتاحية:", reply_markup=back_kb())
    elif data.startswith("reply_del:"):
        db.execute("DELETE FROM auto_replies WHERE id=? AND chat_id=0", (int(data.split(":", 1)[1]),))
        db.commit()
        await replies_menu(query)
    elif data == "subscription":
        await subscription_menu(query)
    elif data == "admins":
        if is_owner(user.id): await admins_menu(query)
    elif data == "admin_add":
        if is_owner(user.id):
            context.user_data["pending"] = {"action": "admin_add"}
            await query.edit_message_text("أرسل آيدي المشرف:", reply_markup=back_kb())
    elif data.startswith("admin_del:"):
        if is_owner(user.id):
            db.execute("DELETE FROM bot_admins WHERE user_id=?", (int(data.split(":", 1)[1]),))
            db.commit()
            await admins_menu(query)
    elif data == "global_toggle":
        if is_owner(user.id):
            set_setting("enabled", "0" if setting("enabled", "1") == "1" else "1")
            await query.edit_message_text("✅ تم تغيير الحالة العامة.", reply_markup=home_kb())
    elif data == "topmenu":
        await query.edit_message_text("🏆 اختر الكروب:", reply_markup=groups_kb("topgroup"))
    elif data.startswith("topgroup:"):
        cid = int(data.split(":", 1)[1])
        rows = db.execute("SELECT name,messages FROM users WHERE chat_id=? ORDER BY messages DESC LIMIT 10", (cid,)).fetchall()
        lines = ["🏆 <b>توب الكروب</b>\n"] + [f"{i}. {html.escape(r['name'] or 'عضو')} — {r['messages']}" for i, r in enumerate(rows, 1)]
        await query.edit_message_text("\n".join(lines), parse_mode="HTML", reply_markup=back_kb("topmenu"))

async def private_pending(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg, user, chat = update.effective_message, update.effective_user, update.effective_chat
    if not msg or not msg.text or chat.type != ChatType.PRIVATE or not user or not is_bot_admin_sync(user.id): return
    state = context.user_data.get("pending")
    if not state: return
    act, val = state.get("action"), msg.text.strip()
    
    if act == "reply_keyword":
        context.user_data["pending"] = {"action": "reply_response", "keyword": val}
        await msg.reply_text("أرسل الرد الآن:")
    elif act == "reply_response":
        kw = state["keyword"]
        db.execute("INSERT INTO auto_replies(chat_id,keyword,response) VALUES(0,?,?)", (kw, val))
        db.commit()
        context.user_data.pop("pending", None)
        await msg.reply_text("✅ تم حفظ الرد العام.", reply_markup=home_kb())
    elif act == "delete_text":
        update_group(state["chat_id"], "delete_message", val)
        context.user_data.pop("pending", None)
        await msg.reply_text("✅ تم حفظ الكليشة.", reply_markup=home_kb())
    elif act == "admin_add" and is_owner(user.id):
        try: uid = int(val)
        except ValueError: return
        db.execute("INSERT OR IGNORE INTO bot_admins(user_id, added_at) VALUES(?,?)", (uid, time.time()))
        db.commit()
        context.user_data.pop("pending", None)
        await msg.reply_text(f"✅ تمت إضافة المشرف {uid}.", reply_markup=home_kb())

def recent_count(chat_id):
    cutoff = int(time.time()) - CLEAN_HOURS * 3600
    return db.execute("SELECT COUNT(*) FROM tracked_messages WHERE chat_id=? AND message_date>=?", (chat_id, cutoff)).fetchone()[0]

async def show_top(chat_id, context, message):
    rows = db.execute("SELECT name,messages FROM users WHERE chat_id=? ORDER BY messages DESC LIMIT 10", (chat_id,)).fetchall()
    lines = ["🏆 <b>توب 10 المتفاعلين:</b>\n"] + [f"{i}. {html.escape(r['name'] or 'عضو')} — {r['messages']} رسالة" for i, r in enumerate(rows, 1)] if rows else ["لا توجد تفاعلات مسجلة."]
    await message.reply_text("\n".join(lines), parse_mode="HTML")

async def reset_top(update, context):
    if not await is_group_admin(update, context): return
    db.execute("DELETE FROM users WHERE chat_id=?", (update.effective_chat.id,))
    db.commit()
    await update.effective_message.reply_text("✅ تم تصفير التوب.")

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    chat, user = update.effective_chat, update.effective_user
    if chat and chat.type != ChatType.PRIVATE:
        ensure_group(chat.id, chat.title or "")
        await update.effective_message.reply_text("أهلاً بك في Cleaner.")
        return
    if user and is_bot_admin_sync(user.id):
        await update.effective_message.reply_text("أهلاً بك في لوحة Cleaner.", reply_markup=home_kb())
    else:
        await update.effective_message.reply_text("أهلاً بك في بوت Cleaner.")

def main():
    asyncio.run(init_db())
    app = Application.builder().token(TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("clean", clean_24h))
    app.add_handler(CommandHandler("top", top_command := lambda u, c: show_top(u.effective_chat.id, c, u.effective_message)))
    app.add_handler(CommandHandler("status", lambda u, c: u.effective_message.reply_text(f"📊 الرسائل المسجلة (24س): {recent_count(u.effective_chat.id)}", parse_mode="HTML")))
    app.add_handler(CommandHandler("enable", lambda u, c: update_group(u.effective_chat.id, "enabled", 1)))
    app.add_handler(CommandHandler("disable", lambda u, c: update_group(u.effective_chat.id, "replies_enabled", 0)))
    app.add_handler(CommandHandler("reset_top", reset_top))
    
    app.add_handler(MessageHandler(filters.ChatType.GROUPS & filters.TEXT, group_text_commands), group=0)
    app.add_handler(MessageHandler(filters.ChatType.PRIVATE & filters.TEXT & ~filters.COMMAND, private_pending), group=1)
    app.add_handler(MessageHandler(filters.ChatType.GROUPS & ~filters.StatusUpdate.ALL, moderate_message), group=2)
    app.add_handler(CallbackQueryHandler(panel_callback))

    log.info("Cleaner started successfully.")
    app.run_polling(allowed_updates=Update.ALL_TYPES)

if __name__ == "__main__":
    main()

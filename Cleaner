async def group_text_command(update, context):
    msg = update.effective_message
    chat = update.effective_chat
    user = update.effective_user
    if not msg or not chat or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return False

    text = (msg.text or "").strip()
    if text not in ("تفعيل", "إيقاف", "حالة", "تصفير التوب",
                    "تصفير توب المتفاعلين", "تفعيل الردود", "إيقاف الردود"):
        return False

    if not await is_group_admin(context.bot, chat.id, user.id):
        await msg.reply_text("هذه الأوامر لمشرفي المجموعة فقط.")
        return True

    ensure_group(chat.id, chat.title)

    if text == "تفعيل":
        execute("UPDATE groups SET enabled=1 WHERE chat_id=?", (chat.id,))
        await msg.reply_text("تم تفعيل البوت في هذه المجموعة.")
    elif text == "إيقاف":
        execute("UPDATE groups SET enabled=0 WHERE chat_id=?", (chat.id,))
        await msg.reply_text("تم إيقاف البوت في هذه المجموعة.")
    elif text == "حالة":
        await group_status_command(update, context)
    elif text in ("تصفير التوب", "تصفير توب المتفاعلين"):
        execute("DELETE FROM users WHERE chat_id=?", (chat.id,))
        await msg.reply_text("تم تصفير التوب.")
    elif text == "تفعيل الردود":
        execute("UPDATE groups SET replies_enabled=1 WHERE chat_id=?", (chat.id,))
        await msg.reply_text("تم تفعيل الردود التلقائية.")
    elif text == "إيقاف الردود":
        execute("UPDATE groups SET replies_enabled=0 WHERE chat_id=?", (chat.id,))
        await msg.reply_text("تم إيقاف الردود التلقائية.")

    return True


async def message_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if not msg or not user:
        return

    track_bot_user(user)
    archive_profile(user)

    if chat and chat.type in (ChatType.GROUP, ChatType.SUPERGROUP):
        ensure_group(chat.id, chat.title)

        # Commands and moderation settings should remain available to group admins.
        if await group_text_command(update, context):
            return

        # Register message statistics before moderation.
        track_group_user(chat.id, user)

        # Do not run normal features while globally disabled.
        if not is_bot_enabled() or not group_enabled(chat.id):
            return

        deleted = await silently_delete_if_restricted(update, context)
        if deleted:
            return

        # Existing reply-moderation option: remove replies when enabled.
        group = fetchone(
            "SELECT delete_message FROM groups WHERE chat_id=?", (chat.id,)
        )
        if (
            group and group["delete_message"]
            and msg.reply_to_message
            and not user.is_bot
            and not await is_group_admin(context.bot, chat.id, user.id)
        ):
            if await bot_can_delete(context.bot, chat.id):
                try:
                    await msg.delete()
                except TelegramError:
                    pass
                return

        # Auto replies are separate from content moderation.
        group = fetchone(
            "SELECT replies_enabled FROM groups WHERE chat_id=?", (chat.id,)
        )
        if group and group["replies_enabled"] and msg.text:
            replies = fetchall("""
                SELECT keyword,response FROM auto_replies
                WHERE chat_id=? AND enabled=1
            """, (chat.id,))
            lowered = msg.text.lower()
            for item in replies:
                if item["keyword"].lower() in lowered:
                    await msg.reply_text(item["response"])
                    break
        return

    if chat and chat.type == ChatType.PRIVATE:
        if context.user_data.get("awaiting_search"):
            context.user_data["awaiting_search"] = False
            if not is_bot_enabled() and not is_owner(user.id):
                await msg.reply_text("البوت متوقف مؤقتًا.")
                return
            if not await check_subscription(context.bot, user.id):
                channel = get_setting("force_channel", FORCE_CHANNEL)
                await msg.reply_text(f"يجب الاشتراك بالقناة أولًا: {channel}")
                return
            await search_profile(update, context, msg.text or "")
            return

        # Private text sent without an active search is not treated as a lookup.
        if msg.text and msg.text.startswith("@"):
            if not is_bot_enabled() and not is_owner(user.id):
                await msg.reply_text("البوت متوقف مؤقتًا.")
                return
            if not await check_subscription(context.bot, user.id):
                channel = get_setting("force_channel", FORCE_CHANNEL)
                await msg.reply_text(f"يجب الاشتراك بالقناة أولًا: {channel}")
                return
            await search_profile(update, context, msg.text)



    )

async def clean(update: Update, context: ContextTypes.DEFAULT_TYPE):
    chat, user, msg = update.effective_chat, update.effective_user, update.effective_message
    if not chat or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP) or not msg:
        return
    if not user or not await can_manage(update, context, user.id):
        await msg.reply_text("أمر التنظيف للمشرفين المخولين فقط.")
        return
    if not await is_active(chat.id):
        await msg.reply_text("Cleaner متوقف. أرسل تفعيل أولاً.")
        return
    try:
        me = await context.bot.get_me()
        member = await context.bot.get_chat_member(chat.id, me.id)
        if member.status != ChatMemberStatus.OWNER and not (
            member.status == ChatMemberStatus.ADMINISTRATOR and member.can_delete_messages
        ):
            await msg.reply_text("ارفع البوت مشرفاً وفعّل صلاحية حذف الرسائل.")
            return
    except TelegramError:
        await msg.reply_text("تعذر التحقق من صلاحيات البوت.")
        return
    progress = await msg.reply_text("🧹 جارٍ حذف الرسائل المسجلة خلال آخر 24 ساعة...")
    cutoff = time.time() - DAY
    rows = await sql("SELECT id,message_id FROM collected_messages WHERE chat_id=? AND timestamp>=? ORDER BY timestamp",
                     (chat.id, cutoff), "all")
    deleted = unavailable = failed = 0
    for row in rows:
        try:
            await context.bot.delete_message(chat.id, row["message_id"])
            deleted += 1
            await sql("DELETE FROM collected_messages WHERE id=?", (row["id"],))
        except RetryAfter as exc:
            await asyncio.sleep(float(exc.retry_after) + 0.5)
            try:
                await context.bot.delete_message(chat.id, row["message_id"])
                deleted += 1
                await sql("DELETE FROM collected_messages WHERE id=?", (row["id"],))
            except TelegramError:
                failed += 1
        except TelegramError as exc:
            low = str(exc).lower()
            if "not found" in low or "can't be deleted" in low or "cannot be deleted" in low:
                unavailable += 1
                await sql("DELETE FROM collected_messages WHERE id=?", (row["id"],))
            else:
                failed += 1
        await asyncio.sleep(0.04)
    remaining = await sql("SELECT COUNT(*) AS n FROM collected_messages WHERE chat_id=? AND timestamp>=?",
                          (chat.id, cutoff), "one")
    try:
        await progress.edit_text(f"📋 تقرير التنظيف:\n• حُذفت: {deleted}\n"
                                 f"• غير متاحة/محذوفة مسبقاً: {unavailable}\n"
                                 f"• فشل حذفها: {failed}\n• المتبقي المسجّل: {remaining['n']}")
    except TelegramError:
        pass


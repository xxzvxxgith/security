# ---------------- التنظيف خلال 24 ساعة ----------------

def message_kind(message):
    if message.photo:
        return "صورة"
    if message.video:
        return "فيديو"
    if message.animation:
        return "GIF"
    if message.sticker:
        return "ملصق"
    if message.voice:
        return "رسالة صوتية"
    if message.audio:
        return "أغنية/صوت"
    if message.video_note:
        return "فيديو دائري"
    if message.document:
        return "ملف"
    if message.contact:
        return "جهة اتصال"
    if message.location or message.venue:
        return "موقع"
    text = message.text or message.caption or ""
    if contains_link(text):
        return "رابط"
    return "رسالة"


def contains_link(text):
    if not text:
        return False
    low = text.lower()
    return any(x in low for x in (
        "http://", "https://", "t.me/", "www."
    ))


async def track_message(update):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user
    if not message or not chat or not user or user.is_bot:
        return
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return

    ensure_group(chat.id, chat.title or "")
    timestamp = int(message.date.timestamp())
    with db() as con:
        con.execute("""
            INSERT OR IGNORE INTO tracked_messages
            (chat_id,message_id,user_id,message_date,kind)
            VALUES(?,?,?,?,?)
        """, (
            chat.id, message.message_id, user.id,
            timestamp, message_kind(message)
        ))
        con.execute("""
            INSERT INTO users(chat_id,user_id,name,messages)
            VALUES(?,?,?,1)
            ON CONFLICT(chat_id,user_id) DO UPDATE SET
                name=excluded.name,messages=users.messages+1
        """, (chat.id, user.id, user.full_name or str(user.id)))
        # احتفظ بسجلات تكفي لتنظيف آخر 24 ساعة مع هامش إضافي.
        con.execute(
            "DELETE FROM tracked_messages WHERE message_date<?",
            (int(time.time()) - 48 * 3600,)
        )


async def clean_24h(update, context):
    message = update.effective_message
    chat = update.effective_chat
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        await message.reply_text("هذا الأمر مخصص للكروبات.")
        return
    if not await is_group_admin(update, context):
        await message.reply_text("هذا الأمر للمشرفين فقط.")
        return
    if not await bot_can_delete(chat.id, context):
        await message.reply_text(
            "❌ ارفع البوت مشرفاً وامنحه صلاحية حذف الرسائل."
        )
        return

    cutoff = int(time.time()) - CLEAN_HOURS * 3600
    await safe_delete(chat.id, message.message_id, context)

    with db() as con:
        rows = con.execute("""
            SELECT message_id FROM tracked_messages
            WHERE chat_id=? AND message_date>=?
            ORDER BY message_id DESC
        """, (chat.id, cutoff)).fetchall()

    deleted = failed = 0
    for row in rows:
        if await safe_delete(chat.id, row["message_id"], context):
            deleted += 1
        else:
            failed += 1

    with db() as con:
        con.execute("""
            DELETE FROM tracked_messages
            WHERE chat_id=? AND message_date<?
        """, (chat.id, cutoff))

    try:
        await context.bot.send_message(
            chat.id,
            "🧹 انتهى التنظيف.\n"
            f"• المحذوف: {deleted}\n"
            f"• تعذّر حذفه: {failed}\n"
            "يشمل هذا فقط الرسائل التي سجلها البوت خلال آخر 24 ساعة."
        )
    except TelegramError:
        pass


# ---------------- الاشتراك الإجباري ----------------

async def subscription_gate(update, context, group):
    message = update.effective_message
    user = update.effective_user
    chat = update.effective_chat
    if not group.get("subscription_enabled") or not user:
        return False
    channel = (group.get("subscription_channel") or "").strip()
    link = (group.get("subscription_link") or "").strip()
    if not channel:
        return False
    try:
        member = await context.bot.get_chat_member(channel, user.id)
        if member.status in (
            ChatMemberStatus.MEMBER,
            ChatMemberStatus.ADMINISTRATOR,
            ChatMemberStatus.OWNER
        ):
            return False
    except TelegramError as exc:
        log.warning("تعذر التحقق من اشتراك القناة %s: %s", channel, exc)
        return False

    await safe_delete(chat.id, message.message_id, context)
    buttons = [[InlineKeyboardButton(
        "📢 اشترك بالقناة", url=link
    )]] if link else []
    try:
        await context.bot.send_message(
            chat.id,
            f"{user.mention_html()}، يجب الاشتراك بالقناة أولاً.",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup(buttons) if buttons else None
        )
    except TelegramError:
        pass
    return True


# ---------------- استقبال رسائل الكروبات والردود ----------------

async def moderate_message(update, context):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user
    if not message or not chat:
        return
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return
    if not user or user.is_bot:
        return

    await track_message(update)

    if setting("enabled", "1") != "1":
        return

    group = get_group(chat.id)
    if not group or not group.get("enabled", 1):
        return

    # استثناء مشرفي الكروب من الحذف والاشتراك الإجباري.
    try:
        member = await context.bot.get_chat_member(chat.id, user.id)
        if member.status in (
            ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER
        ):
            return
    except TelegramError:
        pass

    if await subscription_gate(update, context, group):
        return

    text = message.text or message.caption or ""
    delete = False

    if group.get("delete_links") and contains_link(text):
        delete = True
    if group.get("delete_photos") and message.photo:
        delete = True
    if group.get("delete_videos") and (message.video or message.video_note):
        delete = True
    if group.get("delete_stickers") and message.sticker:
        delete = True
    if group.get("delete_gifs") and message.animation:
        delete = True
    if group.get("delete_audio") and (message.audio or message.voice):
        delete = True
    if group.get("delete_files") and message.document:
        delete = True
    if group.get("delete_forwarded") and (
        getattr(message, "forward_origin", None)
        or getattr(message, "forward_date", None)
    ):
        delete = True

    # حذف الرد على رسالة عضو آخر، كما في الكود الذي أرسلته.
    if (
        group.get("replies_enabled", 1)
        and message.reply_to_message
        and message.reply_to_message.from_user
        and message.reply_to_message.from_user.id != user.id
    ):
        delete_text = group.get("delete_message") or ""
        if not delete_text or delete_text == "ممنوع إرسال الردود":
            with db() as con:
                row = con.execute(
                    "SELECT delete_message FROM groups WHERE chat_id=0"
                ).fetchone()
            if row and row["delete_message"]:
                delete_text = row["delete_message"]
        delete_text = delete_text or "ممنوع الرد"

        if await safe_delete(chat.id, message.message_id, context):
            try:
                await context.bot.send_message(
                    chat.id,
                    f"{user.mention_html()} {html.escape(delete_text)}",
                    parse_mode="HTML"
                )
            except TelegramError:
                pass
        return

    if delete:
        await safe_delete(chat.id, message.message_id, context)
        return

    # الردود العامة أو ردود الكروب، والأولوية لرد الكروب.
    if message.text:
        with db() as con:
            reply = con.execute("""
                SELECT response FROM auto_replies
                WHERE keyword=? AND chat_id IN (0,?)
                ORDER BY chat_id DESC LIMIT 1
            """, (message.text.strip(), chat.id)).fetchone()
        if reply:
            try:
                await message.reply_text(reply["response"])
            except TelegramError:
                pass


async def group_text_commands(update, context):
    message = update.effective_message
    chat = update.effective_chat
    if not message or not message.text or chat.type == ChatType.PRIVATE:
        return
    text = message.text.strip()

    if text == "تنظيف":
        await clean_24h(update, context)
    elif text == "حالة":
        await message.reply_text(
            cleaner_status(chat.id), parse_mode="HTML"
        )
    elif text == "توب":
        await show_top(chat.id, context, message)
    elif text in ("تصفير التوب", "تصفير توب المتفاعلين"):
        await reset_top(update, context)
    elif text in ("تفعيل", "/تفعيل"):
        if not await is_group_admin(update, context):
            await message.reply_text("هذا الأمر للمشرفين فقط.")
            return
        update_group(chat.id, "enabled", 1)
        update_group(chat.id, "replies_enabled", 1)
        await message.reply_text("✅ تم تفعيل البوت وحذف الردود في هذا الكروب.")

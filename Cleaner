def get_matching_reply(chat_id, text):
    if not text:
        return None

    rows = db_fetchall("""
        SELECT id, chat_id, keyword, response
        FROM auto_replies
        WHERE chat_id IN (0, ?)
        ORDER BY
            CASE WHEN chat_id = ? THEN 0 ELSE 1 END,
            id DESC
    """, (chat_id, chat_id))

    normalized_text = text.casefold()

    for row in rows:
        keyword = row["keyword"].strip()

        if keyword and keyword.casefold() in normalized_text:
            return row

    return None


async def send_auto_reply(message, context):
    if not message.text:
        return

    if not message.from_user or message.from_user.is_bot:
        return

    reply = get_matching_reply(message.chat.id, message.text)

    if not reply:
        return

    try:
        await message.reply_text(reply["response"])
    except TelegramError:
        logger.warning("تعذر إرسال رد تلقائي")



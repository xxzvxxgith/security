async def clean_messages(update, context):
    message, user, chat = update.effective_message, update.effective_user, update.effective_chat
    if not message or not chat or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return
    if not user or not await can_manage(update, context, user.id):
        await message.reply_text("❌ أمر التنظيف مخصص للمشرفين المخولين فقط.")
        return
    if not await is_active(chat.id):
        await message.reply_text("Cleaner متوقف حالياً. أرسل تفعيل أولاً.")
        return

    try:
        me = await context.bot.get_me()
        member = await context.bot.get_chat_member(chat.id, me.id)
        if not (
            member.status == ChatMemberStatus.OWNER
            or (
                member.status == ChatMemberStatus.ADMINISTRATOR
                and bool(getattr(member, "can_delete_messages", False))
            )
        ):
            await message.reply_text("ارفع البوت مشرفاً وفعّل صلاحية حذف الرسائل.")
            return
    except TelegramError:
        await message.reply_text("تعذر التحقق من صلاحيات البوت.")
        return

    progress = await message.reply_text("🧹 جارٍ تنظيف الرسائل المسجلة خلال آخر 24 ساعة...")
    cutoff = time.time() - DAY
    rows = await sql(
        """SELECT id, message_id FROM collected_messages
        WHERE chat_id=? AND timestamp>=? ORDER BY timestamp""",
        (chat.id, cutoff), "all"
    )
    deleted = unavailable = failed = 0

    for row in rows:
        try:
            await context.bot.delete_message(chat.id, row["message_id"])
            deleted += 1
            await sql("DELETE FROM collected_messages WHERE id=?", (row["id"],))
        except RetryAfter as exc:
            delay = exc.retry_after
            if isinstance(delay, timedelta):
                delay = delay.total_seconds()
            await asyncio.sleep(float(delay) + 1)
            try:
                await context.bot.delete_message(chat.id, row["message_id"])
                deleted += 1
                await sql("DELETE FROM collected_messages WHERE id=?", (row["id"],))
            except TelegramError:
                failed += 1
        except TelegramError as exc:
            err = str(exc).lower()
            if any(x in err for x in (
                "not found", "can't be deleted", "cannot be deleted",
                "message to delete not found"
            )):
                unavailable += 1
                await sql("DELETE FROM collected_messages WHERE id=?", (row["id"],))
            else:
                failed += 1
        await asyncio.sleep(0.04)

    remaining = await sql(
        "SELECT COUNT(*) AS total FROM collected_messages WHERE chat_id=? AND timestamp>=?",
        (chat.id, cutoff), "one"
    )
    try:
        await progress.edit_text(
            f"📋 تقرير التنظيف:\n\n• تم الحذف: {deleted}\n"
            f"• غير متاحة أو محذوفة مسبقاً: {unavailable}\n"
            f"• فشل حذفها: {failed}\n• المتبقي في السجل: {remaining['total']}"
        )
    except TelegramError:
        pass



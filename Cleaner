def classify_message(message):
    if not message:
        return None

    entities = list(message.entities or []) + list(message.caption_entities or [])
    if any(getattr(e, "type", "") in ("url", "text_link") for e in entities):
        return "link"

    text = message.text or message.caption or ""
    if re.search(r"(?i)(https?://|www\.|t\.me/|telegram\.me/)\S+", text):
        return "link"

    for attr, label in (
        ("photo", "photo"),
        ("document", "document"),
        ("video", "video"),
        ("audio", "audio"),
        ("voice", "voice"),
        ("video_note", "video_note"),
        ("animation", "animation"),
        ("sticker", "sticker"),
        ("paid_media", "paid_media"),
    ):
        if getattr(message, attr, None):
            return label
    return None



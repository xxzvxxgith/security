async def track_message(update):
    message, chat, user = update.effective_message, update.effective_chat, update.effective_user
    if not message or not chat or not user or user.is_bot or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP): return
    ensure_group(chat.id, chat.title or "")
    timestamp = int(message.date.timestamp())
    kind = message_kind(message)
    
    await sql("INSERT OR IGNORE INTO tracked_messages(chat_id,message_id,user_id,message_date,kind) VALUES(?,?,?,?,?)", (chat.id, message.message_id, user.id, timestamp, kind))
    await sql("INSERT INTO users(chat_id,user_id,name,messages) VALUES(?,?,?,1) ON CONFLICT(chat_id,user_id) DO UPDATE SET name=excluded.name, messages=users.messages+1", (chat.id, user.id, user.full_name or str(user.id)))
    await sql("DELETE FROM tracked_messages WHERE message_date<?", (int(time.time()) - 48 * 3600,))

async def clean_24h(update, context):
    message, chat = update.effective_message, update.effective_chat
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP): return
    if not await is_group_admin(update, context):
        await message.reply_text("هذا الأمر للمشرفين فقط.")
        return
    if not await bot_can_delete(chat.id, context):
        await message.reply_text("❌ ارفع البوت مشرفاً وامنحه صلاحية حذف الرسائل.")
        return

    cutoff = int(time.time()) - CLEAN_HOURS * 3600

    # الأنواع المستهدفة للحذف الفوري عند كتابة "تنظيف"
    target_kinds = ('صورة', 'فيديو', 'GIF', 'ملصق', 'رسالة صوتية', 'أغنية/صوت', 'فيديو دائري', 'ملف', 'رابط')

    with db() as con:
        rows = con.execute(
            "SELECT message_id FROM tracked_messages WHERE chat_id=? AND message_date>=? AND kind IN ('صورة', 'فيديو', 'GIF', 'ملصق', 'رسالة صوتية', 'أغنية/صوت', 'فيديو دائري', 'ملف', 'رابط') ORDER BY message_id DESC", 
            (chat.id, cutoff)
        ).fetchall()

    deleted = 0
    for r in rows:
        if await safe_delete(chat.id, r["message_id"], context):
            deleted += 1

    # حذف رسالة أمر "تنظيف" نفسها من الكروب فوراً
    await safe_delete(chat.id, message.message_id, context)

    with db() as con:
        con.execute("DELETE FROM tracked_messages WHERE chat_id=? AND message_date<?", (chat.id, cutoff))

    try:
        sent_msg = await context.bot.send_message(
            chat.id,
            f"🧹 **تم تنظيف الكروب بنجاح!**\n\n• تم مسح `{deleted}` عنصر (صور، فيديوهات، روابط، ملصقات، ملفات، صوتيات) من آخر 24 ساعة.",
            parse_mode="Markdown"
        )
        # حذف رسالة النجاح بعد 5 ثوانٍ ليبقى الجروب نظيفاً تماماً
        await asyncio.sleep(5)
        await safe_delete(chat.id, sent_msg.message_id, context)
    except TelegramError:
        pass


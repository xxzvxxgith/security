    user = update.effective_user
    chat = update.effective_chat

    if not message or not user or not is_group_chat(chat):
        return

    if not await can_manage_mods(update, context, user.id):
        await message.reply_text(
            "تنزيل مشرفي Cleaner متاح لمشرفي المجموعة الفعليين."
        )
        return

    target = None
    if message.reply_to_message and message.reply_to_message.from_user:
        target = message.reply_to_message.from_user.id
    elif context.args:
        target = await resolve_target(update, context, context.args[0])

    if not target:
        await message.reply_text(
            "استخدم /removecleanermod ID أو رد على رسالة الشخص بالأمر."
        )
        return

    await sql(
        "DELETE FROM cleaner_mods WHERE chat_id=? AND user_id=?",
        (chat.id, target),
    )
    await message.reply_text(f"تم تنزيل {target} من مشرفي Cleaner.")


async def list_cleaner_mods(update, context):
    message = update.effective_message
    user = update.effective_user
    chat = update.effective_chat

    if not message or not user or not is_group_chat(chat):
        return

    if not await can_manage(update, context, user.id):
        await message.reply_text("عرض القائمة مخصص للمشرفين المخولين فقط.")
        return

    rows = await sql(
        "SELECT user_id FROM cleaner_mods WHERE chat_id=? ORDER BY added_at",
        (chat.id,),
        "all",
    )

    text = "👥 مشرفو Cleaner:\n"
    text += (
        "\n".join(f"• {row['user_id']}" for row in rows)
        if rows else "لا يوجد مشرفون مضافون يدوياً."
    )
    await message.reply_text(text)


# ==================== تسجيل الرسائل ====================

async def collect_messages(update, context):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if not message or not is_group_chat(chat):
        return

    if user and user.is_bot:
        return

    await ensure_group(chat.id)

    if user:
        await remember_user(chat.id, user)

    # أوامر الإدارة العربية لا تدخل في سجل التنظيف.
    if message.text:
        plain = message.text.strip().lower()
        if plain in ("تفعيل", "إيقاف", "ايقاف", "تنظيف", "حالة"):
            return

    if not await is_active(chat.id):
        return

    media_type = classify_message(message)
    if not media_type:
        return

    now = time.time()
    await sql(
        """INSERT OR IGNORE INTO collected_messages
        (chat_id, message_id, timestamp, user_id, media_type)
        VALUES(?, ?, ?, ?, ?)""",
        (
            chat.id,
            message.message_id,
            now,
            user.id if user else None,
            media_type,
        ),
    )

    await sql(
        "DELETE FROM collected_messages WHERE chat_id=? AND timestamp<?",
        (chat.id, now - DAY),
    )


# ==================== الأخطاء والتشغيل ====================

async def error_handler(update, context):
    log.error(
        "Unhandled error: %s",
        context.error,
        exc_info=context.error,
    )


def main():
    app = Application.builder().token(TOKEN).build()

    # فحص الاشتراك قبل أوامر المجموعة وبقية معالجات الرسائل.
    app.add_handler(
        MessageHandler(filters.ALL, forced_subscription_guard),
        group=-1,
    )

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(button_callback_handler))

    app.add_handler(CommandHandler("clean", clean_messages))
    app.add_handler(CommandHandler("enable", enable_bot))
    app.add_handler(CommandHandler("disable", disable_bot))
    app.add_handler(CommandHandler("status", bot_status))

    app.add_handler(CommandHandler("addcleanermod", add_cleaner_mod))
    app.add_handler(CommandHandler("removecleanermod", remove_cleaner_mod))
    app.add_handler(CommandHandler("cleanermods", list_cleaner_mods))

    app.add_handler(
        MessageHandler(
            filters.TEXT & filters.Regex(r"^\s*تنظيف\s*$"),
            clean_messages,
        )
    )
    app.add_handler(
        MessageHandler(
            filters.TEXT & filters.Regex(r"^\s*تفعيل\s*$"),
            enable_bot,
        )
    )
    app.add_handler(
        MessageHandler(
            filters.TEXT & filters.Regex(r"^\s*(إيقاف|ايقاف)\s*$"),
            disable_bot,
        )
    )
    app.add_handler(
        MessageHandler(
            filters.TEXT & filters.Regex(r"^\s*حالة\s*$"),
            bot_status,
        )
    )

    app.add_handler(
        MessageHandler(
            filters.TEXT & filters.ChatType.PRIVATE,
            private_panel_handler,
        )
    )

    # المجموعة التالية تجمع الرسائل بعد فحص الاشتراك ومعالجة الأوامر.
    app.add_handler(
        MessageHandler(filters.ALL & ~filters.COMMAND, collect_messages),
        group=1,
    )

    app.add_error_handler(error_handler)
    log.info("Cleaner is starting...")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()

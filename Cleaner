def setting(key, default=""):
    with db() as con:
        row = con.execute(
            "SELECT value FROM bot_settings WHERE key=?",
            (key,),
        ).fetchone()

    return row["value"] if row else default


def set_setting(key, value):
    with db() as con:
        con.execute("""
            INSERT INTO bot_settings(key,value)
            VALUES(?,?)
            ON CONFLICT(key)
            DO UPDATE SET value=excluded.value
        """, (key, str(value)))


def is_owner(uid):
    return uid == OWNER_ID


def is_bot_admin(uid):
    if uid in DEFAULT_ADMINS:
        return True

    with db() as con:
        return con.execute(
            "SELECT 1 FROM bot_admins WHERE user_id=?",
            (uid,),
        ).fetchone() is not None


def ensure_group(chat_id, title=""):
    with db() as con:
        con.execute("""
            INSERT OR IGNORE INTO groups(chat_id,title)
            VALUES(?,?)
        """, (chat_id, title))

        if title:
            con.execute(
                "UPDATE groups SET title=? WHERE chat_id=?",
                (title, chat_id),
            )


def get_group(chat_id):
    with db() as con:
        row = con.execute(
            "SELECT * FROM groups WHERE chat_id=?",
            (chat_id,),
        ).fetchone()

    return dict(row) if row else {}


def update_group(chat_id, field, value):
    allowed = {
        "title",
        "enabled",
        "replies_enabled",
        "delete_message",
        "delete_links",
        "delete_photos",
        "delete_videos",
        "delete_stickers",
        "delete_gifs",
        "delete_audio",
        "delete_files",
        "delete_forwarded",
        "subscription_enabled",
        "subscription_channel",
        "subscription_link",
    }

    if field not in allowed:
        return

    ensure_group(chat_id)

    with db() as con:
        con.execute(
            f"UPDATE groups SET {field}=? WHERE chat_id=?",
            (value, chat_id),
        )



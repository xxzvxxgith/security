def mention_user(user):
    name = html.escape(
        " ".join(x for x in [user.first_name, user.last_name] if x)
        or str(user.id)
    )
    return f'<a href="tg://user?id={user.id}">{name}</a>'


async def is_group_admin(bot, chat_id, user_id):
    try:
        member = await bot.get_chat_member(chat_id, user_id)
        return member.status in (
            ChatMemberStatus.OWNER,
            ChatMemberStatus.ADMINISTRATOR,
        )
    except TelegramError:
        return False


async def bot_can_delete(bot, chat_id):
    try:
        me = await bot.get_me()
        member = await bot.get_chat_member(chat_id, me.id)
        return (
            member.status == ChatMemberStatus.ADMINISTRATOR
            and bool(getattr(member, "can_delete_messages", False))
        )
    except TelegramError:
        return False


async def check_subscription(bot, user_id):
    channel = get_setting("force_channel", FORCE_CHANNEL).strip()
    enabled = get_setting("force_subscription", "0") == "1"
    if not enabled or not channel:
        return True

    try:
        member = await bot.get_chat_member(channel, user_id)
        return member.status in (
            ChatMemberStatus.MEMBER,
            ChatMemberStatus.ADMINISTRATOR,
            ChatMemberStatus.OWNER,
        )
    except TelegramError:
        return False


def normalize_query(query):
    query = (query or "").strip()
    if query.startswith("https://t.me/"):
        query = query.split("https://t.me/", 1)[1].split("/", 1)[0]
    elif query.startswith("http://t.me/"):
        query = query.split("http://t.me/", 1)[1].split("/", 1)[0]
    if query.startswith("@"):
        query = query[1:]
    return query.strip()


def parse_user_id(query):
    query = normalize_query(query)
    return int(query) if query.isdigit() else query


def format_profile(profile):
    if not profile:
        return "لم أتمكن من العثور على حساب بهذه البيانات."

    full_name = " ".join(
        x for x in [profile.get("first_name"), profile.get("last_name")] if x
    ) or "غير متوفر"


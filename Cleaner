async def panel_callback(update, context):
    query = update.callback_query
    user = query.from_user
    data = query.data or ""

    await query.answer()

    if not is_bot_admin_sync(user.id):
        return

    if data == "home":
        await query.edit_message_text(
            "🤖 <b>لوحة إدارة Cleaner</b>\n\nاختر الوظيفة:",
            parse_mode="HTML",
            reply_markup=home_kb(),
        )

    elif data == "stats":
        count = db.execute(
            "SELECT COUNT(*) FROM groups WHERE chat_id <> 0"
        ).fetchone()[0]

        await query.edit_message_text(
            f"📊 <b>الإحصائيات العامة:</b>\n• الكروبات: {count}",
            parse_mode="HTML",
            reply_markup=back_kb(),
        )

    elif data == "settings":
        await query.edit_message_text(
            "⚙️ اختر الكروب:",
            reply_markup=groups_kb("setgroup"),
        )

    elif data.startswith("setgroup:"):
        chat_id = int(data.split(":", 1)[1])

        await query.edit_message_text(
            "⚙️ الإعدادات:",
            reply_markup=settings_kb(chat_id),
        )

    elif data.startswith("toggle:"):
        _, chat_id, field = data.split(":")
        chat_id = int(chat_id)

        group = get_group(chat_id)
        update_group(
            chat_id,
            field,
            0 if group.get(field, 0) else 1,
        )

        await query.edit_message_reply_markup(
            reply_markup=settings_kb(chat_id)
        )

    elif data.startswith("delete_text:"):
        context.user_data["pending"] = {
            "action": "delete_text",
            "chat_id": int(data.split(":", 1)[1]),
        }

        await query.edit_message_text(
            "أرسل كليشة الحذف الجديدة:",
            reply_markup=back_kb(),
        )

    elif data == "replies":
        await replies_menu(query)

    elif data == "reply_add":
        context.user_data["pending"] = {
            "action": "reply_keyword"
        }

        await query.edit_message_text(
            "أرسل الكلمة المفتاحية:",
            reply_markup=back_kb(),
        )

    elif data.startswith("reply_del:"):
        reply_id = int(data.split(":", 1)[1])

        db.execute(
            "DELETE FROM auto_replies WHERE id=? AND chat_id=0",
            (reply_id,),
        )
        db.commit()

        await replies_menu(query)

    elif data == "subscription":
        await subscription_menu(query)

    elif data == "admins":
        if is_owner(user.id):
            await admins_menu(query)

    elif data == "admin_add":
        if is_owner(user.id):
            context.user_data["pending"] = {
                "action": "admin_add"
            }

            await query.edit_message_text(
                "أرسل آيدي المشرف:",
                reply_markup=back_kb(),
            )

    elif data.startswith("admin_del:"):
        if is_owner(user.id):
            admin_id = int(data.split(":", 1)[1])

            if admin_id not in DEFAULT_ADMINS:
                db.execute(
                    "DELETE FROM bot_admins WHERE user_id=?",
                    (admin_id,),
                )
                db.commit()

            await admins_menu(query)

    elif data == "global_toggle":
        if is_owner(user.id):

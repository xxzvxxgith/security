async def is_group_admin(update, context):
    user, chat = update.effective_user, update.effective_chat
    if not user or not chat: return False
    if is_owner(user.id): return True
    if chat.type == ChatType.PRIVATE: return await is_bot_admin(user.id)
    try:
        member = await context.bot.get_chat_member(chat.id, user.id)
        return member.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER)
    except TelegramError: return False

async def is_bot_admin(uid):
    if is_bot_admin_sync(uid): return True
    return await sql("SELECT 1 FROM bot_admins WHERE user_id=?", (uid,), "one") is not None

async def bot_can_delete(chat_id, context):
    try:
        me = await context.bot.get_chat_member(chat_id, context.bot.id)
        return me.status == ChatMemberStatus.OWNER or (me.status == ChatMemberStatus.ADMINISTRATOR and bool(getattr(me, "can_delete_messages", False)))
    except TelegramError: return False

async def safe_delete(chat_id, message_id, context):
    try:
        await context.bot.delete_message(chat_id, message_id)
        return True
    except RetryAfter as exc:
        delay = exc.retry_after.total_seconds() if isinstance(exc.retry_after, timedelta) else float(exc.retry_after)
        await asyncio.sleep(delay + 1)
        try:
            await context.bot.delete_message(chat_id, message_id)
            return True
        except TelegramError: return False
    except TelegramError: return False


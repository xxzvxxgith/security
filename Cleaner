async def callback_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data or ""
    user_id = query.from_user.id

    if data.startswith("mod:"):
        parts = data.split(":")
        if len(parts) != 3:
            return
        chat_id, kind = int(parts[1]), parts[2]
        if kind not in MODERATION_TYPES:
            return
        if not await is_group_admin(context.bot, chat_id, user_id):
            await query.answer("للمشرفين فقط.", show_alert=True)
            return

        new_value = not moderation_enabled(chat_id, kind)
        set_moderation(chat_id, kind, new_value)
        await query.edit_message_reply_markup(reply_markup=moderation_keyboard(chat_id))
        return

    if data.startswith("modall:"):
        _, chat_id, value = data.split(":")
        chat_id, enabled = int(chat_id), int(value)
        if not await is_group_admin(context.bot, chat_id, user_id):
            await query.answer("للمشرفين فقط.", show_alert=True)
            return
        ensure_group(chat_id)
        for kind in MODERATION_TYPES:
            set_moderation(chat_id, kind, bool(enabled))
        await query.edit_message_reply_markup(reply_markup=moderation_keyboard(chat_id))
        return


# =========================================================
# MESSAGE MODERATOR (DELETE & MENTION)
# =========================================================

async def message_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if not msg or not chat or not user:
        return

    if chat.type in (ChatType.GROUP, ChatType.SUPERGROUP):
        ensure_group(chat.id, chat.title)

        if not group_enabled(chat.id):
            return

        # استثناء مشرفي المجموعة والمالك من الحظر والتنظيف
        if await is_group_admin(context.bot, chat.id, user.id) or is_admin(user.id):
            return

        categories = classify_message(msg)
        if not categories:
            return

        # التحقق مما إذا كان أي نوع من المحتوى مفعل حظره في هذه المجموعة
        active_violations = [
            kind for kind in categories
            if kind in MODERATION_TYPES and moderation_enabled(chat.id, kind)
        ]

        if not active_violations:
            return

        if not await bot_can_delete(context.bot, chat.id):
            return

        try:
            await msg.delete()
            
            # جلب كليشة التنبيه الخاصة بالحذف مع تاك العضو
            row = fetchone("SELECT delete_notice FROM groups WHERE chat_id=?", (chat.id,))
            notice = row["delete_notice"] if row and row["delete_notice"] else "عذراً، ممنوع إرسال هذا المحتوى هنا."
            
            warning = await context.bot.send_message(
                chat.id,
                f"{user.mention_html()}، {esc(notice)}",
                parse_mode="HTML",
            )
            
            # حذف رسالة التنبيه بعد 5 ثوانٍ لكي يبقى الجروب نظيفاً (اختياري)
            context.job_queue.run_once(delete_warning_job, 5, data=warning)

        except TelegramError as exc:
            log.warning("Failed to delete message in chat %s: %s", chat.id, exc)


async def delete_warning_job(context: ContextTypes.DEFAULT_TYPE):
    message = context.job.data
    try:
        await message.delete()
    except TelegramError:
        pass


def esc(text):
    return html.escape(str(text or ""))



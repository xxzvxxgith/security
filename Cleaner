def contains_link(text):
    return any(x in text.lower() for x in ("http://", "https://", "t.me/", "www.")) if text else False

def message_kind(message):
    if message.photo: return "صورة"
    if message.video: return "فيديو"
    if message.animation: return "GIF"
    if message.sticker: return "ملصق"
    if message.voice: return "رسالة صوتية"
    if message.audio: return "أغنية/صوت"
    if message.video_note: return "فيديو دائري"
    if message.document: return "ملف"
    if message.contact: return "جهة اتصال"
    if message.location or message.venue: return "موقع"
    return "رابط" if contains_link(message.text or message.caption or "") else "رسالة"


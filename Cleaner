async def add_cleaner_mod(update, context):
    message = update.effective_message
    user = update.effective_user
    chat = update.effective_chat

    if not message or not user or not is_group_chat(chat):
        return

    if not await can_manage_mods(update, context, user.id):
        await message.reply_text(
            "رفع مشرفي Cleaner متاح لمشرفي المجموعة الفعليين."
        )
        return

    target = None
    if message.reply_to_message and message.reply_to_message.from_user:
        target = message.reply_to_message.from_user.id
    elif context.args:
        target = await resolve_target(update, context, context.args[0])

    if not target:
        await message.reply_text(
            "استخدم /addcleanermod ID أو رد على رسالة الشخص بالأمر."
        )
        return

    await sql(
        """INSERT OR IGNORE INTO cleaner_mods
        (chat_id, user_id, added_by, added_at) VALUES(?, ?, ?, ?)""",
        (chat.id, target, user.id, time.time()),
    )
    await message.reply_text(
        f"تم رفع {target} مشرفاً في Cleaner لهذه المجموعة."
    )



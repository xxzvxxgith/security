async def resolve_target(update, context, raw):
    raw = (raw or "").strip()

    if raw.isdigit():
        return int(raw)

    username = raw.lstrip("@").lower()
    if not username:
        return None

    row = await sql(
        "SELECT user_id FROM users_map WHERE chat_id=? AND username=?",
        (update.effective_chat.id, username),
        "one",
    )
    if row:
        return int(row["user_id"])

    try:
        chat = await context.bot.get_chat("@" + username)
        return chat.id
    except TelegramError:
        return None



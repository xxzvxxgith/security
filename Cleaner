async def panel_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    user = query.from_user
    data = query.data or ""

    await query.answer()

    if not is_bot_admin(user.id):
        await query.answer("ما عندك صلاحية.", show_alert=True)
        return

    if data == "home":
        await show_home(query, user.id)

    elif data == "settings":
        with db() as con:
            rows = con.execute(
                "SELECT chat_id, title FROM groups ORDER BY title"
            ).fetchall()

        buttons = []
        for row in rows[:30]:
            title = row["title"] or str(row["chat_id"])
            buttons.append([
                InlineKeyboardButton(
                    title[:45],
                    callback_data=f"settings_group:{row['chat_id']}",
                )
            ])
        buttons.append([
            InlineKeyboardButton("⬅️ رجوع", callback_data="home")
        ])

        await query.edit_message_text(
            "⚙️ اختر الكروب لتعديل إعدادات الحذف:",
            reply_markup=InlineKeyboardMarkup(buttons),
        )

    elif data.startswith("settings_group:"):
        chat_id = int(data.split(":", 1)[1])
        await query.edit_message_text(
            f"⚙️ إعدادات الكروب: <code>{chat_id}</code>",
            parse_mode="HTML",
            reply_markup=settings_keyboard(chat_id),
        )

    elif data.startswith("toggle:"):
        _, chat_id, field = data.split(":")
        chat_id = int(chat_id)

        if field not in {
            "enabled", "delete_replies", "delete_links",
            "delete_photos", "delete_videos", "delete_stickers",
            "delete_gifs", "delete_audio", "delete_files",
            "delete_forwarded",
        }:
            await query.answer("إعداد غير معروف.", show_alert=True)
            return

        g = get_group(chat_id)
        new_value = 0 if g.get(field, 0) else 1
        update_group(chat_id, field, new_value)

        await query.edit_message_reply_markup(
            reply_markup=settings_keyboard(chat_id)
        )

    elif data == "stats":
        await query.edit_message_text(
            await get_stats_text(),
            parse_mode="HTML",
            reply_markup=back_keyboard(),
        )

    elif data == "top":
        with db() as con:
            rows = con.execute("""
                SELECT chat_id, title FROM groups ORDER BY title LIMIT 30
            """).fetchall()

        buttons = []
        for row in rows:
            buttons.append([
                InlineKeyboardButton(
                    f"🏆 {row['title'] or row['chat_id']}",
                    callback_data=f"topgroup:{row['chat_id']}",
                )
            ])
        buttons.append([
            InlineKeyboardButton("⬅️ رجوع", callback_data="home")
        ])

        await query.edit_message_text(
            "اختر الكروب لعرض التوب:",
            reply_markup=InlineKeyboardMarkup(buttons),
        )

    elif data.startswith("topgroup:"):
        chat_id = int(data.split(":", 1)[1])
        with db() as con:
            rows = con.execute("""
                SELECT name, user_id, messages FROM users
                WHERE chat_id=? ORDER BY messages DESC LIMIT 10
            """, (chat_id,)).fetchall()

        lines = ["🏆 <b>توب الكروب</b>\n"]
        if not rows:
            lines.append("لا توجد بيانات مسجلة.")
        for i, row in enumerate(rows, 1):
            lines.append(
                f"{i}. {html.escape(row['name'] or str(row['user_id']))}"
                f" — {row['messages']}"
            )

        await query.edit_message_text(
            "\n".join(lines),
            parse_mode="HTML",
            reply_markup=back_keyboard(),
        )

    elif data == "replies":
        await list_replies(query)

    elif data == "add_reply":
        await add_reply_start(query, user.id)

    elif data.startswith("delreply:"):
        reply_id = int(data.split(":", 1)[1])
        with db() as con:
            con.execute("DELETE FROM auto_replies WHERE id=?", (reply_id,))
        await list_replies(query)

    elif data == "subscription":
        await subscription_menu(query)

    elif data == "sub_add":
        pending[user.id] = {"action": "sub_chat_id"}
        await query.edit_message_text(
            "أرسل آيدي الكروب الذي تريد إعداد الاشتراك الإجباري له.",
            reply_markup=back_keyboard(),
        )

    elif data.startswith("subgroup:"):
        chat_id = int(data.split(":", 1)[1])
        g = get_group(chat_id)

        buttons = [
            [InlineKeyboardButton(
                "🔄 تفعيل / إيقاف",
                callback_data=f"subtoggle:{chat_id}",
            )],
            [InlineKeyboardButton(
                "✏️ تحديد القناة",
                callback_data=f"subchannel:{chat_id}",
            )],
            [InlineKeyboardButton(
                "🔗 تحديد رابط الاشتراك",
                callback_data=f"sublink:{chat_id}",
            )],
            [InlineKeyboardButton(
                "⬅️ رجوع", callback_data="subscription"
            )],
        ]

        await query.edit_message_text(
            f"إعدادات الاشتراك للكروب <code>{chat_id}</code>\n"
            f"الحالة: {'مفعّل' if g.get('subscription_enabled') else 'متوقف'}\n"
            f"القناة الحالية: {html.escape(g.get('subscription_channel') or 'غير محددة')}",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup(buttons),
        )

    elif data.startswith("subtoggle:"):
        chat_id = int(data.split(":", 1)[1])
        g = get_group(chat_id)
        new_value = 0 if g.get("subscription_enabled") else 1
        update_group(chat_id, "subscription_enabled", new_value)
        await query.answer(
            "تم التحديث. تأكد من إعداد القناة والرابط.",
            show_alert=True,
        )

    elif data.startswith("subchannel:"):
        chat_id = int(data.split(":", 1)[1])
        pending[user.id] = {
            "action": "sub_channel_value",
            "chat_id": chat_id,
        }
        await query.edit_message_text(
            "أرسل يوزر القناة أو آيديها.\n"
            "مثال: @channelname أو -1001234567890",
            reply_markup=back_keyboard(),
        )

    elif data.startswith("sublink:"):
        chat_id = int(data.split(":", 1)[1])
        pending[user.id] = {
            "action": "sub_link_value",
            "chat_id": chat_id,
        }
        await query.edit_message_text(
            "أرسل رابط القناة أو رابط الاشتراك.",
            reply_markup=back_keyboard(),
        )

    elif data == "admins":
        if not is_owner(user.id):
            await query.answer("هذه الوظيفة للمالك فقط.", show_alert=True)
            return
        await admins_menu(query)

    elif data == "addadmin":
        if not is_owner(user.id):
            return
        pending[user.id] = {"action": "add_admin"}
        await query.edit_message_text(
            "أرسل آيدي المستخدم الذي تريد إضافته مشرفاً.",
            reply_markup=back_keyboard(),
        )

    elif data.startswith("removeadmin:"):
        if not is_owner(user.id):
            return
        uid = int(data.split(":", 1)[1])
        with db() as con:
            con.execute(
                "DELETE FROM bot_admins WHERE user_id=? AND user_id<>?",
                (uid, OWNER_ID),
            )
        await admins_menu(query)

    elif data == "global_toggle":
        if not is_owner(user.id):
            await query.answer("المالك فقط يستطيع تغيير الحالة العامة.", show_alert=True)
            return

        new_value = "0" if setting("enabled", "1") == "1" else "1"
        set_setting("enabled", new_value)
        await show_home(query, user.id)

    else:
        await query.answer("هذا الخيار غير معروف.", show_alert=True)



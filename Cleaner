async def moderate_message(update, context):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if not message or not chat:
        return

    if chat.type not in (
        ChatType.GROUP,
        ChatType.SUPERGROUP,
    ):
        return

    if not user or user.is_bot:
        return

    # مهم:
    # التوب يحسب كل الرسائل.
    # سجل التنظيف يستقبل الأنواع المحددة فقط.
    await track_message(update, context)

    # الكتم مستقل عن إعدادات الحذف العامة: رسائل المكتوم تُحذف دائماً.
    moderation = active_moderation(chat.id, user.id)
    if moderation and moderation["kind"] == "mute":
        await safe_delete(chat.id, message.message_id, context)
        return

    if setting("enabled", "1") != "1":
        return

    group = get_group(chat.id)

    if not group or not group.get("enabled", 1):
        return

    # الردود ممنوعة على الأعضاء ومشرفي المجموعة أيضاً،
    # باستثناء مالك البوت ومالك المجموعة فقط.
    # الرد على رسالة المستخدم نفسه يبقى مسموحاً.
    is_group_owner = False
    try:
        member = await context.bot.get_chat_member(
            chat.id, user.id
        )
        is_group_owner = member.status == ChatMemberStatus.OWNER
    except TelegramError:
        member = None

    if (
        group.get("replies_enabled", 1)
        and message.reply_to_message
        and message.reply_to_message.from_user
        and message.reply_to_message.from_user.id != user.id
        and not is_owner(user.id)
        and not is_group_owner
    ):
        delete_text = (
            group.get("delete_message")
            or "ممنوع إرسال الردود"
        )

        if delete_text == "ممنوع إرسال الردود":
            with db() as con:
                row = con.execute("""
                    SELECT delete_message
                    FROM groups
                    WHERE chat_id=0
                """).fetchone()

            if row and row["delete_message"]:
                delete_text = row["delete_message"]

        if await safe_delete(
            chat.id,
            message.message_id,
            context,
        ):
            try:
                await context.bot.send_message(
                    chat.id,
                    f"{user.mention_html()} "
                    f"{html.escape(delete_text)}",
                    parse_mode="HTML",
                )
            except TelegramError:
                pass

        return

    # استثناء مشرفي الكروب من بقية أنواع الحذف والاشتراك الإجباري.
    # هذا الاستثناء يأتي بعد فحص الردود حتى تُطبّق عليهم قاعدة منع الردود.
    if member and member.status in (
        ChatMemberStatus.ADMINISTRATOR,
        ChatMemberStatus.OWNER,
    ):
        return

    if await subscription_gate(update, context, group):
        return

    text = message.text or message.caption or ""
    delete = False

    if group.get("delete_links") and message_has_link(message):
        delete = True

    if group.get("delete_photos") and message.photo:
        delete = True

    if group.get("delete_videos") and (
        message.video or message.video_note
    ):
        delete = True

    if group.get("delete_stickers") and message.sticker:
        delete = True

    if group.get("delete_gifs") and message.animation:
        delete = True

    if group.get("delete_audio") and (
        message.audio or message.voice
    ):
        delete = True

    if group.get("delete_files") and message.document:
        delete = True

    if group.get("delete_forwarded") and (
        getattr(message, "forward_origin", None)
        or getattr(message, "forward_date", None)
    ):
        delete = True


    if delete:
        await safe_delete(
            chat.id,
            message.message_id,
            context,
        )
        return

    # الردود العامة أو الخاصة بالكروب.
    if message.text:
        with db() as con:
            reply = con.execute("""
                SELECT response
                FROM auto_replies
                WHERE keyword=? AND chat_id IN (0,?)
                ORDER BY chat_id DESC
                LIMIT 1
            """, (
                message.text.strip(),
                chat.id,
            )).fetchone()

        if reply:
            try:
                await message.reply_text(reply["response"])
            except TelegramError:
                pass



async def is_group_admin(bot, chat_id, user_id):
    try:
        member = await bot.get_chat_member(chat_id, user_id)
        return member.status in (
            ChatMemberStatus.OWNER,
            ChatMemberStatus.ADMINISTRATOR,
        )
    except TelegramError:
        return False


async def bot_can_delete(bot, chat_id):
    try:
        me = await bot.get_me()
        member = await bot.get_chat_member(chat_id, me.id)
        return (
            member.status == ChatMemberStatus.ADMINISTRATOR
            and bool(getattr(member, "can_delete_messages", False))
        )
    except TelegramError:
        return False


URL_RE = re.compile(
    r"(?i)(https?://\S+|www\.\S+|t\.me/\S+|telegram\.me/\S+)"
    r"|(?:^|\s)@[A-Za-z0-9_]{4,}"
)


def has_link(message):
    if URL_RE.search(message.text or message.caption or ""):
        return True
    entities = list(message.entities or []) + list(message.caption_entities or [])
    for entity in entities:
        if entity.type in ("url", "text_link"):
            return True
    return False


def classify_message(message):
    found = set()

    if has_link(message):
        found.add("links")
    if message.photo:
        found.add("photos")
    if message.video:
        found.add("videos")
    if message.sticker:
        found.add("stickers")
    if message.animation or message.video_note:
        found.add("gifs")
    if message.voice or message.audio:
        found.add("voice")
    if message.document:
        found.add("files")
    if message.reply_to_message:
        found.add("replies")
    if getattr(message, "forward_origin", None) is not None or getattr(message, "forward_date", None) is not None:
        found.add("forward")

    return found



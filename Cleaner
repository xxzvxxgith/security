async def track_and_moderate(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    message = update.effective_message

    if not message or not message.chat:
        return

    if message.chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return

    ensure_group(message.chat.id, message.chat.title or "")

    if not message.from_user or message.from_user.is_bot:
        return

    # لا نسجّل أو نعدّ الأوامر.
    if is_command_message(message):
        return

    # الاشتراك أولاً: الرسائل المخالفة للاشتراك لا تُحتسب.
    subscribed = await subscription_check(message, context)
    if not subscribed:
        return

    # تسجيل الرسالة المؤهلة مرة واحدة.
    record_message(message)

    # الإحصائيات تبقى فعالة حتى عند تعطيل الإشراف العام.
    if get_setting("global_enabled", "1") != "1":
        return

    await moderate_message(message, context)



async def clean_24h_command(update, context):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if not message or not chat or not user:
        return

    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        await message.reply_text("استخدم التنظيف داخل المجموعة.")
        return

    if not await is_cleaner_mod(context.bot, chat.id, user.id):
        await message.reply_text("ما عندك صلاحية تنظيف المجموعة.")
        return

    if not await bot_can_delete_messages(context.bot, chat.id):
        await message.reply_text(
            "البوت يحتاج صلاحية حذف الرسائل حتى ينفذ التنظيف."
        )
        return

    lock = clean_locks.setdefault(chat.id, asyncio.Lock())

    async with lock:
        cutoff = int(time.time() - 24 * 60 * 60)

        rows = db_fetchall("""
            SELECT message_id
            FROM tracked_messages
            WHERE chat_id = ?
              AND message_date >= ?
              AND deleted = 0
            ORDER BY message_date ASC
        """, (chat.id, cutoff))

        deleted_count = 0
        failed_count = 0

        for row in rows:
            message_id = int(row["message_id"])

            success = await safe_delete_message(
                context.bot,
                chat.id,
                message_id,
            )

            if success:
                deleted_count += 1
                db_execute("""
                    UPDATE tracked_messages
                    SET deleted = 1
                    WHERE chat_id = ? AND message_id = ?
                """, (chat.id, message_id))
            else:
                failed_count += 1

        # حذف أمر التنظيف نفسه إذا أمكن، لكنه ليس ضمن السجلات.
        await safe_delete_message(
            context.bot,
            chat.id,
            message.message_id,
        )

        try:
            await context.bot.send_message(
                chat_id=chat.id,
                text=(
                    "🧹 اكتمل تنظيف الرسائل المؤهلة خلال آخر 24 ساعة.\n"
                    f"تم الحذف: {deleted_count}\n"
                    f"تعذر حذفها: {failed_count}\n\n"
                    "لم يشمل التنظيف الرسائل النصية العادية غير المسجلة."
                ),
            )
        except TelegramError:
            pass



async def mod_action(update, context, action, raw=None):
    message, user, chat = update.effective_message, update.effective_user, update.effective_chat
    if not message or not user or not chat or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return
    if not await can_manage_mods(update, context, user.id):
        await message.reply_text("إدارة مشرفي Cleaner متاحة لمشرفي المجموعة الفعليين.")
        return

    if message.reply_to_message and message.reply_to_message.from_user:
        target = message.reply_to_message.from_user.id
    else:
        target = await resolve_target(update, context, raw)

    if not target:
        await message.reply_text("اكتب آيدي المستخدم أو رد على رسالته بالأمر.")
        return

    if action == "add":
        await sql(
            """INSERT OR IGNORE INTO cleaner_mods(chat_id, user_id, added_by, added_at)
            VALUES(?, ?, ?, ?)""",
            (chat.id, target, user.id, time.time())
        )
        await message.reply_text(f"تم رفع {target} مشرفاً في Cleaner لهذه المجموعة.")
    else:
        await sql("DELETE FROM cleaner_mods WHERE chat_id=? AND user_id=?", (chat.id, target))
        await message.reply_text(f"تم تنزيل {target} من مشرفي Cleaner.")


async def add_cleaner_mod(update, context):
    raw = context.args[0] if context.args else None
    await mod_action(update, context, "add", raw)


async def remove_cleaner_mod(update, context):

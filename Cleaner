def init_db():
    global db

    os.makedirs(
        os.path.dirname(os.path.abspath(DB_PATH)),
        exist_ok=True,
    )

    db = sqlite3.connect(
        DB_PATH,
        check_same_thread=False,
        timeout=30,
    )
    db.row_factory = sqlite3.Row

    with db_lock:
        db.execute("PRAGMA journal_mode=WAL")
        db.execute("PRAGMA foreign_keys=ON")
        db.execute("PRAGMA busy_timeout=30000")

        db.execute("""
            CREATE TABLE IF NOT EXISTS groups (
                group_id INTEGER PRIMARY KEY,
                title TEXT DEFAULT ''
            )
        """)

        columns = {
            row["name"]
            for row in db.execute(
                "PRAGMA table_info(groups)"
            ).fetchall()
        }

        for name, definition in GROUP_COLUMNS.items():
            if name not in columns:
                db.execute(
                    f"ALTER TABLE groups ADD COLUMN {name} {definition}"
                )

        db.execute("""
            CREATE TABLE IF NOT EXISTS users (
                chat_id INTEGER NOT NULL,
                user_id INTEGER NOT NULL,
                name TEXT DEFAULT '',
                messages INTEGER NOT NULL DEFAULT 0,
                PRIMARY KEY (chat_id, user_id)
            )
        """)

        db.execute("""
            CREATE TABLE IF NOT EXISTS tracked_messages (
                chat_id INTEGER NOT NULL,
                message_id INTEGER NOT NULL,
                user_id INTEGER NOT NULL,
                message_date INTEGER NOT NULL,
                kind TEXT NOT NULL,
                deleted INTEGER NOT NULL DEFAULT 0,
                PRIMARY KEY (chat_id, message_id)
            )
        """)

        tracked_columns = {
            row["name"]
            for row in db.execute(
                "PRAGMA table_info(tracked_messages)"
            ).fetchall()
        }

        if "kind" not in tracked_columns:
            db.execute("""
                ALTER TABLE tracked_messages
                ADD COLUMN kind TEXT NOT NULL DEFAULT 'unknown'
            """)

        if "deleted" not in tracked_columns:
            db.execute("""
                ALTER TABLE tracked_messages
                ADD COLUMN deleted INTEGER NOT NULL DEFAULT 0
            """)

        # لا نسمح للسجلات القديمة المجهولة أو النصية بالدخول
        # في إحصائيات الميديا والروابط.
        placeholders = ",".join("?" for _ in ELIGIBLE_KINDS)
        db.execute(
            f"DELETE FROM tracked_messages WHERE kind NOT IN ({placeholders})",
            ELIGIBLE_KINDS,
        )

        db.execute("""
            CREATE INDEX IF NOT EXISTS idx_tracked_recent
            ON tracked_messages(chat_id, message_date)
        """)

        db.execute("""
            CREATE TABLE IF NOT EXISTS users_map (
                chat_id INTEGER NOT NULL,
                username TEXT NOT NULL,
                user_id INTEGER NOT NULL,
                updated_at INTEGER NOT NULL,
                PRIMARY KEY (chat_id, username)
            )
        """)

        db.execute("""
            CREATE TABLE IF NOT EXISTS bot_admins (
                user_id INTEGER PRIMARY KEY,
                added_by INTEGER NOT NULL DEFAULT 0,
                added_at INTEGER NOT NULL DEFAULT 0
            )
        """)

        db.execute("""
            CREATE TABLE IF NOT EXISTS cleaner_mods (
                chat_id INTEGER NOT NULL,
                user_id INTEGER NOT NULL,
                added_by INTEGER NOT NULL DEFAULT 0,
                PRIMARY KEY (chat_id, user_id)
            )
        """)

        db.execute("""
            CREATE TABLE IF NOT EXISTS auto_replies (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                chat_id INTEGER NOT NULL DEFAULT 0,
                keyword TEXT NOT NULL,
                response TEXT NOT NULL
            )
        """)

        db.execute("""
            CREATE TABLE IF NOT EXISTS bot_settings (
                key TEXT PRIMARY KEY,
                value TEXT NOT NULL
            )
        """)

        db.execute("""
            CREATE TABLE IF NOT EXISTS subscription (
                id INTEGER PRIMARY KEY CHECK (id = 1),
                channel TEXT DEFAULT '',
                link TEXT DEFAULT '',
                enabled INTEGER NOT NULL DEFAULT 0
            )
        """)

        db.execute("""
            INSERT OR IGNORE INTO subscription
                (id, channel, link, enabled)
            VALUES (1, '', '', 0)
        """)

        db.execute("""
            INSERT OR IGNORE INTO bot_settings (key, value)
            VALUES ('global_enabled', '1')
        """)

        for user_id in DEFAULT_ADMINS:
            db.execute("""
                INSERT OR IGNORE INTO bot_admins
                    (user_id, added_by, added_at)
                VALUES (?, ?, ?)
            """, (user_id, OWNER_ID, int(time.time())))

        # إعادة بناء عدادات التوب من سجلات الميديا والروابط فقط.
        # هذا يمنع بقاء أعداد نصية قديمة في جدول users.
        db.execute("DELETE FROM users")
        db.execute("""
            INSERT INTO users (chat_id, user_id, name, messages)
            SELECT
                tm.chat_id,
                tm.user_id,
                COALESCE(
                    (SELECT um.username
                     FROM users_map um
                     WHERE um.chat_id = tm.chat_id
                       AND um.user_id = tm.user_id
                     LIMIT 1),
                    CAST(tm.user_id AS TEXT)
                ),
                COUNT(*)
            FROM tracked_messages tm
            GROUP BY tm.chat_id, tm.user_id
        """)

        db.execute("""
            DELETE FROM tracked_messages
            WHERE message_date < ?
        """, (int(time.time()) - 48 * 60 * 60,))

        db.commit()


def db_fetchone(query, params=()):
    with db_lock:
        return db.execute(query, params).fetchone()


def db_fetchall(query, params=()):
    with db_lock:
        return db.execute(query, params).fetchall()


def db_execute(query, params=()):
    with db_lock:
        cursor = db.execute(query, params)
        db.commit()
        return cursor.rowcount


def get_setting(key, default=None):
    row = db_fetchone(
        "SELECT value FROM bot_settings WHERE key = ?",
        (key,),
    )
    return row["value"] if row else default


def set_setting(key, value):
    db_execute("""
        INSERT INTO bot_settings (key, value)
        VALUES (?, ?)
        ON CONFLICT(key)
        DO UPDATE SET value = excluded.value
    """, (key, str(value)))


def ensure_group(chat_id, title=""):
    with db_lock:
        db.execute("""
            INSERT INTO groups (group_id, title)
            VALUES (?, ?)
            ON CONFLICT(group_id)
            DO UPDATE SET
                title = CASE
                    WHEN excluded.title != ''
                    THEN excluded.title
                    ELSE groups.title
                END
        """, (chat_id, title or ""))
        db.commit()


def get_group(chat_id):
    return db_fetchone(
        "SELECT * FROM groups WHERE group_id = ?",
        (chat_id,),
    )


def set_group_field(chat_id, field, value):

def is_group_chat(chat):
    return bool(
        chat and chat.type in (ChatType.GROUP, ChatType.SUPERGROUP)
    )


def is_admin_status(status):
    return status in ("creator", "administrator")


async def actual_group_admin(context, chat_id, user_id):
    try:
        member = await context.bot.get_chat_member(chat_id, user_id)
        return is_admin_status(member.status)
    except TelegramError:
        log.warning("Could not verify group admin %s in %s", user_id, chat_id)
        return False



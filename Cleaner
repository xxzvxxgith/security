def main():
    app = Application.builder().token(TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(button_callback_handler))

    app.add_handler(CommandHandler("clean", clean_messages))
    app.add_handler(CommandHandler("enable", enable_bot))
    app.add_handler(CommandHandler("disable", disable_bot))
    app.add_handler(CommandHandler("status", bot_status))
    app.add_handler(CommandHandler("addcleanermod", add_cleaner_mod))
    app.add_handler(CommandHandler("removecleanermod", remove_cleaner_mod))
    app.add_handler(CommandHandler("cleanermods", list_cleaner_mods))

    app.add_handler(MessageHandler(
        filters.TEXT & filters.Regex(r"^\s*تنظيف\s*$"), clean_messages
    ))
    app.add_handler(MessageHandler(
        filters.TEXT & filters.Regex(r"^\s*تفعيل\s*$"), enable_bot
    ))
    app.add_handler(MessageHandler(
        filters.TEXT & filters.Regex(r"^\s*(إيقاف|ايقاف)\s*$"), disable_bot
    ))
    app.add_handler(MessageHandler(
        filters.TEXT & filters.Regex(r"^\s*حالة\s*$"), bot_status
    ))
    app.add_handler(MessageHandler(
        filters.TEXT & filters.Regex(r"^\s*(رفع_مشرف|تنزيل_مشرف|مشرفيني)(?:\s+.*)?$"),
        arabic_mod_command
    ))

    app.add_handler(MessageHandler(
        filters.TEXT & filters.ChatType.PRIVATE, private_panel_handler
    ))
    app.add_handler(MessageHandler(
        filters.ALL & ~filters.COMMAND, collect_messages
    ))

    app.add_error_handler(error_handler)
    log.info("Cleaner is starting...")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()

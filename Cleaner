async def private_panel_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.effective_message
    user = update.effective_user
    chat = update.effective_chat

    if not chat or chat.type != "private" or not user or not await is_bot_admin(user.id):
        return

    text = message.text.strip()
    action = context.user_data.get("action")

    if action == "add_admin":
        inp = text
        target_id = None
        if inp.isdigit():
            target_id = int(inp)
        else:
            clean_u = inp.replace("@", "").lower()
            try:
                chat_info = await context.bot.get_chat(f"@{clean_u}")
                target_id = chat_info.id
            except Exception:
                pass
        
        if target_id:
            cur.execute("INSERT OR IGNORE INTO bot_admins(user_id) VALUES(?)", (target_id,))
            db.commit()
            context.user_data.pop("action", None)
            await message.reply_text(f"✅ تم رفع الآيدي ({target_id}) مشرفاً عاماً بنجاح.")
        else:
            await message.reply_text("❌ لم يتم التعرف على المستخدم، أرسل آيدي صحيح أو يوزرنيم صحيح.")
        return

    elif action == "remove_admin":
        inp = text
        target_id = None
        if inp.isdigit():
            target_id = int(inp)
        
        if target_id:
            if target_id in DEFAULT_ADMINS:
                await message.reply_text("❌ لا يمكنك تنزيل المالك الأساسي!")
                context.user_data.pop("action", None)
                return
            cur.execute("DELETE FROM bot_admins WHERE user_id=?", (target_id,))
            db.commit()
            context.user_data.pop("action", None)
            await message.reply_text(f"✅ تم تنزيل الآيدي ({target_id}) من المشرفين بنجاح.")
        else:
            await message.reply_text("❌ يرجى إرسال آيدي صحيح.")
        return

    elif action == "set_subscription":
        parts = text.split()
        if len(parts) >= 1:
            channel_name = parts[0]
            group_link = text if len(parts) > 1 else f"https://t.me/{channel_name.replace('@', '')}"
            cur.execute("""
            INSERT INTO subscription(chat_id, enabled, channel, group_link)
            VALUES(0, 1, ?, ?)
            ON CONFLICT(chat_id) DO UPDATE SET enabled=1, channel=excluded.channel, group_link=excluded.group_link
            """, (channel_name, group_link))
            db.commit()
            context.user_data.pop("action", None)
            await message.reply_text(f"✅ تم تفعيل الاشتراك الإجباري العام على القناة/الكروب: {channel_name}")
        else:
            await message.reply_text("❌ يرجى إرسال معرف القناة ورابطها بالشكل الصحيح.")
        return

    if text == "رفع مشرف 👤+":
        context.user_data["action"] = "add_admin"
        await message.reply_text("أرسل آيدي الشخص أو يوزرنيمه لرفعه مشرفاً بالبوت:")
        return
    elif text == "تنزيل مشرف 👤-":
        context.user_data["action"] = "remove_admin"
        cur.execute("SELECT user_id FROM bot_admins")
        rows = cur.fetchall()
        txt = "قائمة المشرفين الحاليين:\n\n"
        for (m_id,) in rows:
            txt += f"• آيدي: {m_id}\n"
        txt += "\nأرسل آيدي الشخص المراد تنزيله الآن:"
        await message.reply_text(txt)
        return
    elif text == "تعيين اشتراك إجباري 🔗":
        context.user_data["action"] = "set_subscription"
        await message.reply_text("أرسل معرف القناة ورابطها (مثال: @ChannelName https://t.me/ChannelName):")
        return
    elif text == "حذف اشتراك إجباري 🗑️":
        cur.execute("DELETE FROM subscription WHERE chat_id=0")
        db.commit()
        await message.reply_text("🗑 تم حذف وإلغاء الاشتراك الإجباري بنجاح.")
        return
    elif text == "تفعيل البوت بقسم 🟢":
        await message.reply_text("💡 لتفعيل البوت، أضفه إلى مجموعتك وارسل كلمة: **تفعيل**")
        return
    elif text == "إيقاف البوت بقسم 🛑":
        await message.reply_text("💡 لإيقاف البوت في مجموعة، أرسل فيها كلمة: **إيقاف**")
        return

async def enable_bot(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.effective_message
    user = update.effective_user
    chat = update.effective_chat
    if not chat or chat.type not in ["group", "supergroup"]:
        return
    if user and await is_group_admin(update, context, user.id):
        ensure_group(chat.id)
        cur.execute("UPDATE groups SET active=1 WHERE chat_id=?", (chat.id,))
        db.commit()
        await message.reply_text("✅ تم تفعيل بوت Cleaner بنجاح في هذه المجموعة.")
    else:
        await message.reply_text("❌ هذا الأمر مخصص للمشرفين فقط.")

async def disable_bot(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.effective_message
    user = update.effective_user
    chat = update.effective_chat
    if not chat or chat.type not in ["group", "supergroup"]:
        return
    if user and await is_group_admin(update, context, user.id):
        ensure_group(chat.id)
        cur.execute("UPDATE groups SET active=0 WHERE chat_id=?", (chat.id,))
        db.commit()
        await message.reply_text("🛑 تم إيقاف بوت Cleaner في هذه المجموعة.")
    else:
        await message.reply_text("❌ هذا الأمر مخصص للمشرفين فقط.")

async def bot_status(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.effective_message
    chat = update.effective_chat
    if not chat or chat.type not in ["group", "supergroup"]:
        return
    ensure_group(chat.id)
    cur.execute("SELECT active FROM groups WHERE chat_id=?", (chat.id,))
    row = cur.fetchone()
    active_status = "مفعل ✅" if (row and row[0] == 1) else "متوقف 🛑"
    
    cutoff = time.time() - 86400
    cur.execute("DELETE FROM collected_messages WHERE chat_id=? AND timestamp < ?", (chat.id, cutoff))
    db.commit()
    
    cur.execute("SELECT COUNT(*) FROM collected_messages WHERE chat_id=?", (chat.id,))
    count = cur.fetchone()[0]
    
    await message.reply_text(f"📊 حالة بوت Cleaner:\n- الحالة: {active_status}\n- الروابط والوسائط المسجلة خلال 24 ساعة: {count}")

async def clean_messages(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.effective_message
    user = update.effective_user
    chat = update.effective_chat
    if not chat or chat.type not in ["group", "supergroup"]:
        return
    
    if not user or not await is_group_admin(update, context, user.id):
        await message.reply_text("❌ عذراً، أمر التنظيف مخصص للمشرفين المخولين فقط.")
        return

    cur.execute("SELECT active FROM groups WHERE chat_id=?", (chat.id,))
    row = cur.fetchone()
    if not row or row[0] == 0:
        await message.reply_text("⚠️ البوت متوقف حالياً. أرسل /تفعيل أولاً.")
        return

    await message.reply_text("🧹 جاري فحص وحذف الروابط والوسائط لآخر 24 ساعة...")

    cutoff = time.time() - 86400
    cur.execute("SELECT id, message_id FROM collected_messages WHERE chat_id=? AND timestamp >= ?", (chat.id, cutoff))
    records = cur.fetchall()

    deleted_success = 0
    not_available = 0
    failed_count = 0

    for rec_id, msg_id in records:
        try:
            await context.bot.delete_message(chat_id=chat.id, message_id=msg_id)
            deleted_success += 1
            cur.execute("DELETE FROM collected_messages WHERE id=?", (rec_id,))
            db.commit()
        except Exception as e:
            err_str = str(e).lower()
            if "message to delete not found" in err_str or "not modified" in err_str:
                not_available += 1
                cur.execute("DELETE FROM collected_messages WHERE id=?", (rec_id,))
                db.commit()
            else:
                failed_count += 1

    cur.execute("SELECT COUNT(*) FROM collected_messages WHERE chat_id=?", (chat.id,))
    total_remaining = cur.fetchone()[0]

    report = (
        f"📋 تقرير عملية التنظيف:\n\n"
        f"• تم الحذف بنجاح: {deleted_success}\n"
        f"• غير متاحة أو ممسوحة مسبقاً: {not_available}\n"
        f"• تعذر حذفها: {failed_count}\n"
        f"• المتبقي في القائمة: {total_remaining}"
    )
    await message.reply_text(report)

async def collect_messages(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user
    if not chat or chat.type not in ["group", "supergroup"]:
        return

    ensure_group(chat.id)

    cur.execute("SELECT enabled, channel, group_link FROM subscription WHERE chat_id=0 AND enabled=1")
    sub = cur.fetchone()
    if sub and user and not await is_group_admin(update, context, user.id):
        channel = sub[1]
        g_link = sub[2] or f"https://t.me/{channel.replace('@', '')}"
        subscribed = False
        try:
            member = await context.bot.get_chat_member(channel, user.id)
            if member.status in [ChatMemberStatus.MEMBER, ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER, ChatMemberStatus.RESTRICTED]:
                subscribed = True
        except Exception:
            subscribed = False

        if not subscribed:
            try:
                await message.delete()
            except Exception:
                pass
            
            keyboard = [[InlineKeyboardButton("اشتراك بالقناة 🔗", url=g_link)]]
            await context.bot.send_message(
                chat.id,
                f"عذراً {user.mention_html()}، عليك الاشتراك بالقناة التالية لتتمكن من النشر هنا:\n{channel}",
                parse_mode="HTML",
                reply_markup=InlineKeyboardMarkup(keyboard)
            )
            return

    cur.execute("SELECT active FROM groups WHERE chat_id=?", (chat.id,))
    row = cur.fetchone()
    if not row or row[0] == 0:
        return

    if message.text:
        txt = message.text.strip()
        management_commands = ["تفعيل", "إيقاف", "ايقاف", "تنظيف", "حالة", "/start"]
        if any(txt.startswith(cmd) for cmd in management_commands):
            return

    is_media_or_link = False
    media_type = "text"

    if message.photo:
        media_type = "photo"
        is_media_or_link = True
    elif message.document:
        media_type = "document"
        is_media_or_link = True
    elif message.video:
        media_type = "video"
        is_media_or_link = True
    elif message.audio:
        media_type = "audio"
        is_media_or_link = True
    elif message.voice:
        media_type = "voice"
        is_media_or_link = True
    elif message.video_note:
        media_type = "video_note"
        is_media_or_link = True
    elif message.animation:
        media_type = "animation"
        is_media_or_link = True
    elif message.sticker:
        media_type = "sticker"
        is_media_or_link = True
    elif message.text and ("http://" in message.text or "https://" in message.text or "t.me/" in message.text):
        media_type = "link"
        is_media_or_link = True

    if not is_media_or_link:
        return

    current_time = time.time()
    
    cur.execute("""
    INSERT INTO collected_messages(chat_id, message_id, timestamp, user_id, media_type)
    VALUES(?, ?, ?, ?, ?)
    """, (chat.id, message.message_id, current_time, user.id if user else 0, media_type))
    db.commit()

    cutoff = current_time - 86400
    cur.execute("DELETE FROM collected_messages WHERE chat_id=? AND timestamp < ?", (chat.id, cutoff))
    db.commit()

def main():
    app = Application.builder().token(TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    
    app.add_handler(CommandHandler("clean", clean_messages))
    app.add_handler(MessageHandler(filters.TEXT & filters.Regex("^تنظيف$"), clean_messages))

    app.add_handler(CommandHandler("enable", enable_bot))
    app.add_handler(MessageHandler(filters.TEXT & filters.Regex("^تفعيل$"), enable_bot))

    app.add_handler(CommandHandler("disable", disable_bot))
    app.add_handler(MessageHandler(filters.TEXT & filters.Regex("^(إيقاف|ايقاف)$"), disable_bot))

    app.add_handler(CommandHandler("status", bot_status))
    app.add_handler(MessageHandler(filters.TEXT & filters.Regex("^حالة$"), bot_status))

    app.add_handler(MessageHandler(filters.TEXT & filters.ChatType.PRIVATE, private_panel_handler))

    app.add_handler(MessageHandler(filters.ALL & ~filters.COMMAND, collect_messages))

    print("Cleaner Bot is running with control panel...")
    app.run_polling()

if __name__ == "__main__":
    main()

async def clean_messages(update, context):
    message = update.effective_message
    user = update.effective_user
    chat = update.effective_chat

    if not message or not is_group_chat(chat):
        return

    if not user or not await can_manage(update, context, user.id):
        await message.reply_text("❌ أمر التنظيف مخصص للمشرفين المخولين فقط.")
        return

    if not await is_active(chat.id):
        await message.reply_text("Cleaner متوقف حالياً. أرسل تفعيل أولاً.")
        return

    try:
        me = await context.bot.get_me()
        bot_member = await context.bot.get_chat_member(chat.id, me.id)

        if not (
            bot_member.status == "creator"
            or (
                bot_member.status == "administrator"
                and getattr(bot_member, "can_delete_messages", False)
            )
        ):
            await message.reply_text(
                "ارفع البوت مشرفاً وفعّل صلاحية حذف الرسائل."
            )
            return
    except TelegramError:
        await message.reply_text("تعذر التحقق من صلاحيات البوت.")
        return

    progress = await message.reply_text(
        "🧹 جارٍ حذف الروابط والوسائط المسجلة لآخر 24 ساعة..."
    )
    cutoff = time.time() - DAY

    rows = await sql(
        """SELECT id, message_id FROM collected_messages
        WHERE chat_id=? AND timestamp>=? ORDER BY timestamp""",
        (chat.id, cutoff),
        "all",
    )

    deleted = unavailable = failed = 0

    for row in rows:
        try:
            await context.bot.delete_message(
                chat_id=chat.id,
                message_id=row["message_id"],
            )
            deleted += 1
            await sql("DELETE FROM collected_messages WHERE id=?", (row["id"],))

        except RetryAfter as exc:
            wait = exc.retry_after
            if isinstance(wait, timedelta):
                wait = wait.total_seconds()
            await asyncio.sleep(float(wait) + 1)

            try:
                await context.bot.delete_message(
                    chat_id=chat.id,
                    message_id=row["message_id"],
                )
                deleted += 1
                await sql("DELETE FROM collected_messages WHERE id=?", (row["id"],))
            except TelegramError:
                failed += 1

        except TelegramError as exc:
            err = str(exc).lower()
            if (
                "not found" in err
                or "can't be deleted" in err
                or "cannot be deleted" in err
                or "message to delete not found" in err
            ):
                unavailable += 1
                await sql("DELETE FROM collected_messages WHERE id=?", (row["id"],))
            else:
                failed += 1

        await asyncio.sleep(0.05)

    remaining = await sql(
        """SELECT COUNT(*) AS total FROM collected_messages
        WHERE chat_id=? AND timestamp>=?""",
        (chat.id, cutoff),
        "one",
    )

    try:
        await progress.edit_text(
            f"📋 تقرير التنظيف:\n\n"
            f"• تم الحذف: {deleted}\n"
            f"• غير متاحة أو محذوفة مسبقاً: {unavailable}\n"
            f"• فشل حذفها: {failed}\n"
            f"• المتبقي في السجل: {remaining['total']}"
        )
    except TelegramError:
        pass



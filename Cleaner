async def subscribed_to_channel(user_id, channel, context):
    if not channel:
        return True

    try:
        member = await context.bot.get_chat_member(channel, user_id)
        return member.status in ("member", "administrator", "creator")
    except TelegramError:
        return False


async def subscription_gate(update, context, group):
    msg = update.effective_message
    user = update.effective_user

    if not group.get("subscription_enabled"):
        return False

    channel = (group.get("subscription_channel") or "").strip()
    link = (group.get("subscription_link") or "").strip()

    if not channel:
        return False

    if await subscribed_to_channel(user.id, channel, context):
        return False

    await delete_message_safe(
        update.effective_chat.id, msg.message_id, context
    )

    buttons = []
    if link:
        buttons.append([
            InlineKeyboardButton("📢 اشترك بالقناة", url=link)
        ])

    try:
        await context.bot.send_message(
            chat_id=update.effective_chat.id,
            text=f"{user.mention_html()}، لازم تشترك بالقناة أولاً.",
            parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup(buttons) if buttons else None,
        )
    except TelegramError:
        pass

    return True



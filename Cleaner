def contains_link(text):
    if not text:
        return False

    low = text.lower()

    return any(value in low for value in (
        "http://",
        "https://",
        "t.me/",
        "www.",
    ))


def message_has_link(message):
    text = message.text or message.caption or ""

    if contains_link(text):
        return True

    # دعم الروابط المخفية وروابط النصوص في تيليجرام.
    entities = (
        list(message.entities or [])
        + list(message.caption_entities or [])
    )

    for entity in entities:
        if entity.type in ("url", "text_link"):
            return True

    return False


def message_kind(message):
    if message.photo:
        return "صورة"

    if message.video:
        return "فيديو"

    if message.animation:
        return "GIF"

    if message.sticker:
        return "ملصق"

    if message.voice:
        return "رسالة صوتية"

    if message.audio:
        return "أغنية/صوت"

    if message.video_note:
        return "فيديو دائري"

    if message.document:
        return "ملف"

    if message.contact:
        return "جهة اتصال"

    if message.location or message.venue:
        return "موقع"

    if message_has_link(message):
        return "رابط"

    return "رسالة"


def is_trackable_message(message):
    """
    True فقط للرسائل المطلوب تسجيلها للتنظيف.
    الرسائل النصية العادية لا تدخل سجل التنظيف.
    """

    return any((
        bool(message.photo),
        bool(message.video),
        bool(message.video_note),
        bool(message.animation),
        bool(message.sticker),
        bool(message.audio),
        bool(message.voice),
        bool(message.document),
        bool(message.contact),
        bool(message.location),
        bool(message.venue),
        message_has_link(message),
        bool(getattr(message, "forward_origin", None)),
        bool(getattr(message, "forward_date", None)),
    ))



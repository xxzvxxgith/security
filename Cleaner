def normalize_query(query):
    query = (query or "").strip()
    if query.startswith("https://t.me/"):
        query = query.split("https://t.me/", 1)[1].split("/", 1)[0]
    elif query.startswith("http://t.me/"):
        query = query.split("http://t.me/", 1)[1].split("/", 1)[0]
    if query.startswith("@"):
        query = query[1:]
    return query.strip()


def parse_user_id(query):
    query = normalize_query(query)
    return int(query) if query.isdigit() else query



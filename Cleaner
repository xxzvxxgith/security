async def private_pending(update, context):
    msg = update.effective_message
    user = update.effective_user
    chat = update.effective_chat

    if (
        not msg
        or not msg.text
        or not chat
        or chat.type != ChatType.PRIVATE
        or not user
        or not is_bot_admin_sync(user.id)
    ):
        return

    state = context.user_data.get("pending")

    if not state:
        return

    action = state.get("action")
    value = msg.text.strip()

    if action == "reply_keyword":
        context.user_data["pending"] = {
            "action": "reply_response",
            "keyword": value,
        }

        await msg.reply_text("أرسل الرد الآن:")

    elif action == "reply_response":
        keyword = state["keyword"]

        db.execute(
            """
            INSERT INTO auto_replies(chat_id, keyword, response)
            VALUES(0, ?, ?)
            """,
            (keyword, value),
        )
        db.commit()

        context.user_data.pop("pending", None)

        await msg.reply_text(
            "✅ تم حفظ الرد العام.",
            reply_markup=home_kb(),
        )

    elif action == "delete_text":
        update_group(
            state["chat_id"],
            "delete_message",
            value,
        )

        context.user_data.pop("pending", None)

        await msg.reply_text(
            "✅ تم حفظ الكليشة.",
            reply_markup=home_kb(),
        )

    elif action == "admin_add" and is_owner(user.id):
        try:
            admin_id = int(value)
        except ValueError:
            await msg.reply_text(
                "❌ آيدي غير صحيح. أرسل الأرقام فقط."
            )
            return

        db.execute(
            """
            INSERT OR IGNORE INTO bot_admins(user_id, added_at)
            VALUES(?, ?)
            """,
            (admin_id, time.time()),
        )
        db.commit()

        context.user_data.pop("pending", None)

        await msg.reply_text(
            f"✅ تمت إضافة المشرف {admin_id}.",
            reply_markup=home_kb(),
        )



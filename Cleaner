# =========================================================
# تنظيف آخر 24 ساعة
# =========================================================

async def clean_24h(update, context):
    message = update.effective_message
    chat = update.effective_chat

    if chat.type == ChatType.PRIVATE:
        await message.reply_text("هذا الأمر مخصص للكروبات.")
        return

    if not await is_group_admin(update, context):
        await message.reply_text("هذا الأمر للمشرفين فقط.")
        return

    if not await bot_can_delete(chat.id, context):
        await message.reply_text(
            "❌ لازم ترفع البوت مشرف وتعطيه صلاحية حذف الرسائل."
        )
        return

    cutoff = int(time.time()) - CLEAN_HOURS * 3600

    # نحذف الأمر نفسه أيضاً، إن أمكن.
    current_message_id = message.message_id
    await delete_message_safe(chat.id, current_message_id, context)

    with db() as con:
        rows = con.execute("""
            SELECT message_id
            FROM tracked_messages
            WHERE chat_id=? AND message_date>=?
            ORDER BY message_id DESC
        """, (chat.id, cutoff)).fetchall()

    deleted = 0
    failed = 0

    # نحذف الرسائل المسجلة خلال آخر 24 ساعة.
    for row in rows:
        ok = await delete_message_safe(
            chat.id, row["message_id"], context
        )
        if ok:
            deleted += 1
        else:
            failed += 1

    # نحذف السجلات القديمة من قاعدة البيانات.
    with db() as con:
        con.execute("""
            DELETE FROM tracked_messages
            WHERE chat_id=? AND message_date<?
        """, (chat.id, cutoff))

    # رسالة مؤقتة بالنتيجة. ما نستخدم مؤقتاً برمجياً.
    await context.bot.send_message(
        chat_id=chat.id,
        text=(
            "🧹 اكتملت محاولة التنظيف.\n"
            f"✅ الرسائل المحذوفة: {deleted}\n"
            f"⚠️ رسائل تعذر حذفها: {failed}\n\n"
            "التنظيف يشمل الرسائل التي سجلها البوت خلال آخر 24 ساعة فقط."
        ),
    )



async def show_top(chat_id, context, reply_target=None):
    with db() as con:
        rows = con.execute("""
            SELECT user_id, name, messages
            FROM users
            WHERE chat_id=?
            ORDER BY messages DESC
            LIMIT 10
        """, (chat_id,)).fetchall()

    if not rows:
        text = "ماكو إحصائيات تفاعل مسجلة لهذا الكروب بعد."
    else:
        lines = ["🏆 <b>توب المتفاعلين</b>\n"]
        for i, row in enumerate(rows, 1):
            name = html.escape(row["name"] or str(row["user_id"]))
            lines.append(
                f"{i}. {name} — <b>{row['messages']}</b> رسالة"
            )
        text = "\n".join(lines)

    if reply_target:
        await reply_target.reply_text(text, parse_mode="HTML")
    else:
        await context.bot.send_message(
            chat_id=chat_id, text=text, parse_mode="HTML"
        )



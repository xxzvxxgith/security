def db():
    conn = sqlite3.connect(DB_PATH, timeout=20)
    conn.row_factory = sqlite3.Row
    return conn


def init_db():
    with db() as con:
        con.executescript("""
        CREATE TABLE IF NOT EXISTS bot_admins (
            user_id INTEGER PRIMARY KEY
        );

        CREATE TABLE IF NOT EXISTS groups (
            chat_id INTEGER PRIMARY KEY,
            title TEXT DEFAULT '',
            enabled INTEGER DEFAULT 1,
            delete_replies INTEGER DEFAULT 1,
            delete_links INTEGER DEFAULT 0,
            delete_photos INTEGER DEFAULT 0,
            delete_videos INTEGER DEFAULT 0,
            delete_stickers INTEGER DEFAULT 0,
            delete_gifs INTEGER DEFAULT 0,
            delete_audio INTEGER DEFAULT 0,
            delete_files INTEGER DEFAULT 0,
            delete_forwarded INTEGER DEFAULT 0,
            subscription_enabled INTEGER DEFAULT 0,
            subscription_channel TEXT DEFAULT '',
            subscription_link TEXT DEFAULT ''
        );

        CREATE TABLE IF NOT EXISTS users (
            chat_id INTEGER,
            user_id INTEGER,
            name TEXT DEFAULT '',
            messages INTEGER DEFAULT 0,
            PRIMARY KEY(chat_id, user_id)
        );

        CREATE TABLE IF NOT EXISTS tracked_messages (
            chat_id INTEGER,
            message_id INTEGER,
            user_id INTEGER,
            message_date INTEGER,
            PRIMARY KEY(chat_id, message_id)
        );

        CREATE TABLE IF NOT EXISTS auto_replies (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            chat_id INTEGER DEFAULT 0,
            keyword TEXT NOT NULL,
            response TEXT NOT NULL
        );

        CREATE TABLE IF NOT EXISTS bot_settings (
            key TEXT PRIMARY KEY,
            value TEXT DEFAULT ''
        );

        CREATE TABLE IF NOT EXISTS search_logs (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            created_at INTEGER
        );
        """)

        con.execute(
            "INSERT OR IGNORE INTO bot_admins(user_id) VALUES(?)",
            (OWNER_ID,),
        )
        con.execute(
            "INSERT OR IGNORE INTO bot_settings(key, value) VALUES('enabled', '1')"
        )


def setting(key, default=""):
    with db() as con:
        row = con.execute(
            "SELECT value FROM bot_settings WHERE key=?",
            (key,),
        ).fetchone()
    return row["value"] if row else default


def set_setting(key, value):
    with db() as con:
        con.execute("""
            INSERT INTO bot_settings(key, value)
            VALUES(?, ?)
            ON CONFLICT(key) DO UPDATE SET value=excluded.value
        """, (key, str(value)))


def is_owner(user_id):
    return user_id == OWNER_ID


def is_bot_admin(user_id):
    if is_owner(user_id):
        return True
    with db() as con:
        return con.execute(
            "SELECT 1 FROM bot_admins WHERE user_id=?",
            (user_id,),
        ).fetchone() is not None


def ensure_group(chat_id, title=""):
    with db() as con:
        con.execute("""
            INSERT OR IGNORE INTO groups(chat_id, title)
            VALUES(?, ?)
        """, (chat_id, title))
        if title:
            con.execute(
                "UPDATE groups SET title=? WHERE chat_id=?",
                (title, chat_id),
            )


def get_group(chat_id):
    with db() as con:
        row = con.execute(
            "SELECT * FROM groups WHERE chat_id=?",
            (chat_id,),
        ).fetchone()
    return dict(row) if row else {}


def update_group(chat_id, field, value):
    allowed = {
        "enabled", "delete_replies", "delete_links",
        "delete_photos", "delete_videos", "delete_stickers",
        "delete_gifs", "delete_audio", "delete_files",
        "delete_forwarded", "subscription_enabled",
        "subscription_channel", "subscription_link",
    }
    if field not in allowed:
        return
    ensure_group(chat_id)
    with db() as con:
        con.execute(
            f"UPDATE groups SET {field}=? WHERE chat_id=?",
            (value, chat_id),
        )



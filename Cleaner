async def callback_router(update, context):
    query = update.callback_query

    if not query or not query.from_user:
        return

    user_id = query.from_user.id
    data = query.data or ""

    if not is_bot_admin(user_id):
        await query.answer(
            "ليس لديك صلاحية استخدام لوحة التحكم.",
            show_alert=True,
        )
        return

    # أزرار الرجوع تلغي حالة الإدخال المعلّقة.
    if data in ("home", "groups", "admins", "global_replies", "subscription"):
        context.user_data.pop("pending", None)

    try:
        if data == "home":
            await query.edit_message_text(
                "لوحة تحكم Cleaner Bot",
                reply_markup=home_keyboard(),
            )

        elif data == "groups":
            await query.edit_message_text(
                "اختر المجموعة:",
                reply_markup=groups_keyboard(),
            )

        elif data.startswith("settings:"):
            chat_id = int(data.split(":", 1)[1])

            if not get_group(chat_id):
                await query.answer(
                    "المجموعة غير مسجلة في قاعدة البيانات.",
                    show_alert=True,
                )
                return

            await query.edit_message_text(
                f"إعدادات المجموعة: {chat_id}",
                reply_markup=group_settings_keyboard(chat_id),
            )

        elif data.startswith("toggle:"):
            _, chat_id_text, field = data.split(":", 2)
            chat_id = int(chat_id_text)

            if field not in GROUP_COLUMNS:
                await query.answer("إعداد غير صالح.", show_alert=True)
                return

            group = get_group(chat_id)
            if not group:
                await query.answer("المجموعة غير موجودة.", show_alert=True)
                return

            value = 0 if group[field] else 1
            set_group_field(chat_id, field, value)

            await query.edit_message_text(
                f"إعدادات المجموعة: {chat_id}",
                reply_markup=group_settings_keyboard(chat_id),
            )

        elif data == "global_replies":
            await query.edit_message_text(
                "الردود التلقائية العامة:",
                reply_markup=global_replies_keyboard(),
            )

        elif data.startswith("group_replies:"):
            chat_id = int(data.split(":", 1)[1])

            if not get_group(chat_id):
                await query.answer("المجموعة غير موجودة.", show_alert=True)
                return

            await query.edit_message_text(
                f"ردود المجموعة {chat_id}:",
                reply_markup=group_replies_keyboard(chat_id),
            )

        elif data == "global_reply_add":
            context.user_data["pending"] = {
                "action": "global_reply_keyword",
            }
            await query.answer()
            await query.message.reply_text(
                "أرسل الكلمة أو العبارة التي ستُفعّل الرد.\n"
                "للإلغاء أرسل «إلغاء»."
            )
            return

        elif data.startswith("group_reply_add:"):
            chat_id = int(data.split(":", 1)[1])

            if not get_group(chat_id):
                await query.answer("المجموعة غير موجودة.", show_alert=True)
                return

            context.user_data["pending"] = {
                "action": "group_reply_keyword",
                "chat_id": chat_id,
            }

            await query.answer()
            await query.message.reply_text(
                f"أرسل الكلمة أو العبارة لردود المجموعة {chat_id}.\n"
                "للإلغاء أرسل «إلغاء»."
            )
            return

        elif data.startswith("reply_delete:"):
            _, reply_id_text, chat_id_text = data.split(":", 2)
            reply_id = int(reply_id_text)
            chat_id = int(chat_id_text)

            db_execute("""
                DELETE FROM auto_replies
                WHERE id = ? AND chat_id = ?
            """, (reply_id, chat_id))

            if chat_id == 0:
                await query.edit_message_text(
                    "الردود العامة:",
                    reply_markup=global_replies_keyboard(),
                )
            else:
                await query.edit_message_text(
                    f"ردود المجموعة {chat_id}:",
                    reply_markup=group_replies_keyboard(chat_id),
                )

        elif data == "admins":
            await query.edit_message_text(
                "إدارة مشرفي البوت:",
                reply_markup=admins_keyboard(),
            )

        elif data == "admin_add":
            if not is_owner(user_id):
                await query.answer(
                    "إضافة مشرفين متاحة لمالك البوت فقط.",
                    show_alert=True,
                )
                return

            context.user_data["pending"] = {"action": "admin_add"}
            await query.answer()
            await query.message.reply_text(
                "أرسل رقم Telegram ID للمستخدم الذي تريد إضافته.\n"
                "للإلغاء أرسل «إلغاء»."
            )
            return

        elif data.startswith("admin_delete:"):
            if not is_owner(user_id):
                await query.answer(
                    "إزالة المشرفين متاحة لمالك البوت فقط.",
                    show_alert=True,
                )
                return

            target = int(data.split(":", 1)[1])

            if target == OWNER_ID or target in DEFAULT_ADMINS:
                await query.answer(
                    "لا يمكن إزالة المالك أو المشرف الافتراضي.",
                    show_alert=True,
                )
                return

            db_execute(
                "DELETE FROM bot_admins WHERE user_id = ?",
                (target,),
            )

            await query.edit_message_text(
                "إدارة مشرفي البوت:",
                reply_markup=admins_keyboard(),
            )

        elif data == "subscription":
            sub = get_global_subscription()
            enabled = bool(sub and sub["enabled"])

            keyboard = InlineKeyboardMarkup([
                [
                    InlineKeyboardButton(
                        "إعداد قناة الاشتراك",
                        callback_data="subscription_setup",
                    )
                ],
                [
                    InlineKeyboardButton(
                        "تعطيل الاشتراك العام" if enabled
                        else "تفعيل الاشتراك العام",
                        callback_data="subscription_toggle",
                    )
                ],
                [
                    InlineKeyboardButton("رجوع", callback_data="home"),
                ],
            ])

            channel = sub["channel"] if sub else ""
            await query.edit_message_text(
                f"الاشتراك العام: {'مفعّل' if enabled else 'معطّل'}\n"
                f"القناة: {channel or 'غير محددة'}",
                reply_markup=keyboard,
            )

        elif data == "subscription_setup":
            context.user_data["pending"] = {
                "action": "sub_channel",
            }
            await query.answer()
            await query.message.reply_text(
                "أرسل اسم القناة أو رقمها.\n"
                "تأكد أن البوت مشرف في القناة.\n"
                "للإلغاء أرسل «إلغاء»."
            )
            return

        elif data == "subscription_toggle":
            sub = get_global_subscription()

            if not sub or not sub["channel"]:
                await query.answer(
                    "اضبط قناة الاشتراك أولاً.",
                    show_alert=True,
                )
                return

            db_execute("""
                UPDATE subscription
                SET enabled = CASE WHEN enabled = 1 THEN 0 ELSE 1 END
                WHERE id = 1
            """)

            sub = get_global_subscription()
            keyboard = InlineKeyboardMarkup([
                [
                    InlineKeyboardButton(
                        "إعداد قناة الاشتراك",
                        callback_data="subscription_setup",
                    )
                ],
                [
                    InlineKeyboardButton(
                        "تعطيل الاشتراك العام" if sub["enabled"]
                        else "تفعيل الاشتراك العام",
                        callback_data="subscription_toggle",
                    )
                ],
                [
                    InlineKeyboardButton("رجوع", callback_data="home"),
                ],
            ])

            await query.edit_message_text(
                f"الاشتراك العام: {'مفعّل' if sub['enabled'] else 'معطّل'}\n"
                f"القناة: {sub['channel']}",
                reply_markup=keyboard,
            )

        elif data == "global_toggle":
            enabled = get_setting("global_enabled", "1") == "1"
            set_setting("global_enabled", "0" if enabled else "1")

            current = get_setting("global_enabled", "1") == "1"

            await query.edit_message_text(
                f"الإشراف العام الآن: {'مفعّل' if current else 'معطّل'}\n"
                "الإحصائيات وتسجيل الرسائل المؤهلة يستمران بالحالتين.",
                reply_markup=InlineKeyboardMarkup([[
                    InlineKeyboardButton("رجوع", callback_data="home")
                ]]),
            )

        elif data.startswith("stats:"):
            chat_id = int(data.split(":", 1)[1])
            cutoff = int(time.time() - 24 * 60 * 60)

            rows = db_fetchall("""
                SELECT kind, COUNT(*) AS total
                FROM tracked_messages
                WHERE chat_id = ? AND message_date >= ?
                GROUP BY kind
                ORDER BY total DESC
            """, (chat_id, cutoff))

            lines = [f"إحصائيات آخر 24 ساعة للمجموعة {chat_id}:", ""]

            if rows:
                for row in rows:
                    label = MEDIA_LABELS.get(row["kind"], row["kind"])
                    lines.append(f"• {label}: {row['total']}")
            else:
                lines.append("لا توجد رسائل مؤهلة مسجلة خلال هذه المدة.")

            await query.edit_message_text(
                "\n".join(lines),
                reply_markup=InlineKeyboardMarkup([[
                    InlineKeyboardButton(
                        "رجوع للإعدادات",
                        callback_data=f"settings:{chat_id}",
                    )
                ]]),
            )

        else:
            await query.answer("هذا الزر غير معروف.", show_alert=True)
            return

        await query.answer()

    except TelegramError as exc:
        logger.warning(
            "خطأ في لوحة التحكم: %s",
            type(exc).__name__,
        )

        try:
            await query.answer(
                "تعذر تنفيذ العملية. حاول مرة أخرى.",
                show_alert=True,
            )
        except TelegramError:
            pass

    except (ValueError, KeyError) as exc:
        logger.warning(
            "بيانات زر غير صالحة: %s",
            type(exc).__name__,
        )

        try:
            await query.answer("البيانات غير صالحة.", show_alert=True)
        except TelegramError:
            pass


# =========================================================
# أوامر عربية نصية
# =========================================================

async def arabic_text_commands(update, context):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if not message or not chat or not user or not message.text:
        return

    text = message.text.strip()

    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        return

    ensure_group(chat.id, chat.title or "")

    if text in ("تنظيف", "تنظيف 24", "تنظيف24"):
        await clean_24h_command(update, context)

    elif text == "توب":
        await top_command(update, context)

    elif text == "حالة":
        await status_command(update, context)

    elif text == "تصفير التوب":
        await reset_top_command(update, context)

    elif text == "تفعيل":
        await enable_command(update, context)

    elif text == "إيقاف":
        await disable_command(update, context)


# =========================================================
# معالجة الأخطاء
# =========================================================

async def error_handler(update, context):
    error = context.error

    if error:
        logger.error(
            "حدث خطأ أثناء معالجة تحديث: %s",
            type(error).__name__,
        )


# =========================================================
# تشغيل البوت
# =========================================================

def main():
    if not TOKEN:
        raise RuntimeError(
            "لم يتم ضبط BOT_TOKEN. "
            "أضف رمز البوت إلى متغير البيئة BOT_TOKEN."
        )

    init_db()

    application = Application.builder().token(TOKEN).build()

    # أوامر المجموعات والخاصة.
    application.add_handler(CommandHandler("start", start_command))
    application.add_handler(CommandHandler("clean", clean_24h_command))
    application.add_handler(CommandHandler("top", top_command))
    application.add_handler(CommandHandler("status", status_command))
    application.add_handler(CommandHandler("enable", enable_command))
    application.add_handler(CommandHandler("disable", disable_command))
    application.add_handler(CommandHandler("reset_top", reset_top_command))
    application.add_handler(
        CommandHandler("addcleanermod", add_cleaner_mod_command)
    )
    application.add_handler(
        CommandHandler("removecleanermod", remove_cleaner_mod_command)
    )

    # أزرار لوحة التحكم.
    application.add_handler(
        CallbackQueryHandler(callback_router)
    )

    # إدخالات لوحة التحكم في الخاص.
    application.add_handler(
        MessageHandler(
            filters.ChatType.PRIVATE & filters.TEXT & ~filters.COMMAND,
            pending_private_message,
        ),
        group=0,
    )

    # الأوامر العربية النصية.
    application.add_handler(
        MessageHandler(
            filters.ChatType.GROUPS & filters.TEXT & ~filters.COMMAND,
            arabic_text_commands,
        ),
        group=1,
    )

    # المعالج الرئيسي للمجموعات.
    # يستقبل الميديا والنصوص والروابط والتعليقات.
    application.add_handler(
        MessageHandler(
            filters.ChatType.GROUPS
            & ~filters.StatusUpdate.ALL,
            track_and_moderate,
        ),
        group=2,
    )

    application.add_error_handler(error_handler)

    logger.info("Cleaner Bot is starting...")
    application.run_polling(
        allowed_updates=Update.ALL_TYPES,
    )


if __name__ == "__main__":
    main()

async def pending_private_message(update, context):
    message = update.effective_message
    user = update.effective_user

    if not message or not user or not message.text:
        return
    if not is_bot_admin(user.id):
        return

    pending = context.user_data.get("pending")
    if not pending:
        return

    text = message.text.strip()
    action = pending.get("action")

    if text.lower() in ("إلغاء", "الغاء", "/cancel"):
        context.user_data.pop("pending", None)
        await message.reply_text("تم إلغاء العملية.")
        return

    if action == "admin_add":
        if not text.isdigit():
            await message.reply_text("أرسل رقم المستخدم الصحيح.")
            return

        target = int(text)

        db_execute("""
            INSERT OR IGNORE INTO bot_admins
                (user_id, added_by, added_at)
            VALUES (?, ?, ?)
        """, (target, user.id, int(time.time())))

        context.user_data.pop("pending", None)
        await message.reply_text("تمت إضافة المشرف.")
        return

    if action in ("global_reply_keyword", "group_reply_keyword"):
        if not text or len(text) > 100:
            await message.reply_text(
                "الكلمة يجب أن تكون بين حرف واحد و100 حرف."
            )
            return

        context.user_data["pending"] = {
            **pending,
            "action": (
                "global_reply_response"
                if action == "global_reply_keyword"
                else "group_reply_response"
            ),
            "keyword": text,
        }

        await message.reply_text("أرسل نص الرد الآن.")
        return

    if action in ("global_reply_response", "group_reply_response"):
        if len(text) > 4000:
            await message.reply_text("الرد طويل جداً.")
            return

        chat_id = (
            int(pending["chat_id"])
            if action == "group_reply_response"
            else 0
        )

        db_execute("""
            INSERT INTO auto_replies (chat_id, keyword, response)
            VALUES (?, ?, ?)
        """, (chat_id, pending["keyword"], text))

        context.user_data.pop("pending", None)
        await message.reply_text("تم حفظ الرد التلقائي.")
        return

    if action == "sub_channel":
        if len(text) > 200:
            await message.reply_text("اسم القناة أو رقمها غير صالح.")
            return

        context.user_data["pending"] = {
            "action": "sub_link",
            "channel": text,
        }

        await message.reply_text(
            "أرسل رابط الاشتراك، مثال:\n"
            "https://t.me/channelname\n"
            "أرسل «بدون» إذا لم يتوفر رابط."
        )
        return

    if action == "sub_link":
        link = "" if text == "بدون" else text

        if link and not (
            link.startswith("https://t.me/")
            or link.startswith("https://telegram.me/")
        ):
            await message.reply_text("أرسل رابط Telegram صحيحاً.")
            return

        channel = pending["channel"]

        try:
            chat_obj = await context.bot.get_chat(channel)
        except TelegramError:
            await message.reply_text(
                "تعذر الوصول إلى القناة. تأكد من اسمها أو رقمها."
            )
            return

        try:
            bot_user = await context.bot.get_me()
            bot_member = await context.bot.get_chat_member(
                chat_obj.id,
                bot_user.id,
            )

            if bot_member.status not in ("administrator", "creator"):
                await message.reply_text(
                    "اجعل البوت مشرفاً في القناة أولاً."
                )
                return

        except TelegramError:
            await message.reply_text(
                "تعذر التحقق من صلاحيات البوت في القناة."
            )
            return

        db_execute("""
            UPDATE subscription
            SET channel = ?, link = ?, enabled = 1
            WHERE id = 1
        """, (str(chat_obj.id), link))

        context.user_data.pop("pending", None)
        await message.reply_text("تم إعداد الاشتراك العام وتفعيله.")



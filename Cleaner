def contains_link(text):
    if not text:
        return False

    return bool(
        re.search(
            r"(https?://|www\.|t\.me/|telegram\.me/)",
            text,
            re.IGNORECASE,
        )
    )


def message_kind(message):
    text = message.text or message.caption or ""

    # الميديا أولاً، حتى لا يُحسب رابط الوصف كعنصر مستقل
    if message.photo:
        return "صورة"

    if message.video:
        return "فيديو"

    if message.animation:
        return "متحرك"

    if message.sticker:
        return "ملصق"

    if message.audio:
        return "أغنية"

    if message.voice:
        return "صوتية"

    if message.video_note:
        return "فيديو دائري"

    if message.document:
        return "مستند"

    entities = list(message.entities or []) + list(
        message.caption_entities or []
    )

    if contains_link(text):
        return "رابط"

    if any(
        getattr(entity, "type", None) in ("url", "text_link")
        for entity in entities
    ):
        return "رابط"

    return "رسالة"



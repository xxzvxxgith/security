async def group_text_commands(update, context):
    message = update.effective_message
    chat = update.effective_chat

    if (
        not message
        or not message.text
        or not chat
        or chat.type == ChatType.PRIVATE
    ):
        return

    txt = message.text.strip()

    if txt == "تنظيف":
        await clean_24h(update, context)

    elif txt == "حالة":
        await show_media_status(message, chat.id)

    elif txt == "توب":
        await show_top(chat.id, context, message)

    elif txt in (
        "تصفير التوب",
        "تصفير توب المتفاعلين",
    ):
        await reset_top(update, context)

    elif txt in ("تفعيل", "/تفعيل"):
        if await is_group_admin(update, context):
            update_group(chat.id, "enabled", 1)
            update_group(chat.id, "replies_enabled", 1)


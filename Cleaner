async def private_pending(update, context):
    message = update.effective_message
    user = update.effective_user
    chat = update.effective_chat

    if chat.type != ChatType.PRIVATE or not message or not message.text:
        return

    if not is_bot_admin(user.id):
        return

    state = pending.get(user.id)
    if not state:
        return

    action = state.get("action")
    value = message.text.strip()

    if action == "add_reply_keyword":
        pending[user.id] = {
            "action": "add_reply_response",
            "keyword": value,
        }
        await message.reply_text(
            "هسه أرسل الرد الذي تريد أن يرسله البوت."
        )

    elif action == "add_reply_response":
        keyword = state["keyword"]
        with db() as con:
            con.execute("""
                INSERT INTO auto_replies(chat_id, keyword, response)
                VALUES(0, ?, ?)
            """, (keyword, value))
        pending.pop(user.id, None)
        await message.reply_text(
            f"✅ تم حفظ الرد للكلمة: {keyword}",
            reply_markup=main_keyboard(),
        )

    elif action == "add_admin":
        if not is_owner(user.id):
            pending.pop(user.id, None)
            return
        try:
            uid = int(value)
            with db() as con:
                con.execute(
                    "INSERT OR IGNORE INTO bot_admins(user_id) VALUES(?)",
                    (uid,),
                )
            await message.reply_text(
                f"✅ تمت إضافة المشرف {uid}.",
                reply_markup=main_keyboard(),
            )
        except ValueError:
            await message.reply_text("آيدي غير صحيح، أرسل أرقاماً فقط.")
            return
        pending.pop(user.id, None)

    elif action == "sub_chat_id":
        try:
            chat_id = int(value)
            ensure_group(chat_id)
            pending[user.id] = {
                "action": "sub_channel_value",
                "chat_id": chat_id,
            }
            await message.reply_text(
                "أرسل يوزر القناة أو آيديها، مثال @channelname."
            )
        except ValueError:
            await message.reply_text("آيدي الكروب غير صحيح.")
            return

    elif action == "sub_channel_value":
        chat_id = state["chat_id"]
        update_group(chat_id, "subscription_channel", value)
        pending[user.id] = {
            "action": "sub_link_value",
            "chat_id": chat_id,
        }
        await message.reply_text(
            "تم حفظ القناة. أرسل رابط الاشتراك."
        )

    elif action == "sub_link_value":
        chat_id = state["chat_id"]
        update_group(chat_id, "subscription_link", value)
        update_group(chat_id, "subscription_enabled", 1)
        pending.pop(user.id, None)
        await message.reply_text(
            "✅ تم إعداد الاشتراك الإجباري وتفعيله.",
            reply_markup=main_keyboard(),
        )



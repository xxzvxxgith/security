async def group_text_commands(update, context):
    message = update.effective_message
    chat = update.effective_chat

    if (
        not message
        or not message.text
        or not chat
        or chat.type == ChatType.PRIVATE
    ):
        return

    text = message.text.strip()

    parsed_moderation = parse_moderation_command(text)
    if parsed_moderation:
        await moderation_command(update, context, parsed_moderation)

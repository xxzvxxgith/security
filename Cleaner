async def collect_messages(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if (
        not message
        or not chat
        or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP)
    ):
        return

    if user and user.is_bot:
        return

    await ensure_group(chat.id)

    if user:
        await remember_user(chat.id, user)

    # الاشتراك الإجباري العام
    sub = await sql(
        "SELECT enabled, channel, group_link FROM subscription WHERE chat_id=0",
        mode="one",
    )

    if sub and sub["enabled"] and user:
        privileged = (
            await is_bot_admin(user.id)
            or await actual_group_admin(context, chat.id, user.id)
        )

        if not privileged:
            subscribed = False

            try:
                channel = sub["channel"]

                target = (
                    int(channel)
                    if str(channel).lstrip("-").isdigit()
                    else channel
                )

                member = await context.bot.get_chat_member(
                    target, user.id
                )

                subscribed = member.status in (
                    ChatMemberStatus.MEMBER,
                    ChatMemberStatus.ADMINISTRATOR,
                    ChatMemberStatus.OWNER,
                )

                if member.status == ChatMemberStatus.RESTRICTED:
                    subscribed = bool(
                        getattr(member, "is_member", False)
                    )

            except TelegramError:
                subscribed = False

            if not subscribed:
                try:
                    await message.delete()
                except TelegramError:
                    pass

                try:
                    keyboard = [[
                        InlineKeyboardButton(
                            "اشترك بالقناة 🔗",
                            url=sub["group_link"],
                        )
                    ]]

                    await context.bot.send_message(
                        chat.id,
                        "يجب الاشتراك بالقناة أولاً حتى تتمكن من النشر.\n"
                        + user.mention_html(),
                        parse_mode="HTML",
                        reply_markup=InlineKeyboardMarkup(keyboard),
                    )
                except TelegramError:
                    log.exception(
                        "Failed to send forced-subscription message"
                    )

                return

    # أوامر الإدارة لا تدخل في سجل التنظيف
    if message.text:
        plain = message.text.strip().lower()

        if plain in (
            "تفعيل", "إيقاف", "ايقاف", "تنظيف", "حالة"
        ):
            return

    if not await is_active(chat.id):
        return

    media_type = classify_message(message)

    if not media_type:
        return

    now = time.time()

    await sql(
        """INSERT OR IGNORE INTO collected_messages
        (chat_id, message_id, timestamp, user_id, media_type)
        VALUES(?, ?, ?, ?, ?)""",
        (
            chat.id,
            message.message_id,
            now,
            user.id if user else None,
            media_type,
        ),
    )

    await sql(
        "DELETE FROM collected_messages WHERE chat_id=? AND timestamp<?",
        (chat.id, now - DAY),
    )


# ==================== معالجة الأخطاء ====================

async def error_handler(update, context):
    log.error(
        "Unhandled error: %s",
        context.error,
        exc_info=context.error,
    )


# ==================== تشغيل البوت ====================

def main():
    app = Application.builder().token(TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(button_callback_handler))

    app.add_handler(CommandHandler("clean", clean_messages))
    app.add_handler(CommandHandler("enable", enable_bot))
    app.add_handler(CommandHandler("disable", disable_bot))
    app.add_handler(CommandHandler("status", bot_status))

    app.add_handler(
        CommandHandler("addcleanermod", add_cleaner_mod)
    )
    app.add_handler(
        CommandHandler("removecleanermod", remove_cleaner_mod)
    )
    app.add_handler(
        CommandHandler("cleanermods", list_cleaner_mods)
    )

    # الأوامر العربية بدون / أو @
    app.add_handler(
        MessageHandler(
            filters.TEXT & filters.Regex(r"^\s*تنظيف\s*$"),
            clean_messages,
        )
    )
    app.add_handler(
        MessageHandler(
            filters.TEXT & filters.Regex(r"^\s*تفعيل\s*$"),
            enable_bot,
        )
    )
    app.add_handler(
        MessageHandler(
            filters.TEXT & filters.Regex(r"^\s*(إيقاف|ايقاف)\s*$"),
            disable_bot,
        )
    )
    app.add_handler(
        MessageHandler(
            filters.TEXT & filters.Regex(r"^\s*حالة\s*$"),
            bot_status,
        )
    )

    app.add_handler(
        MessageHandler(
            filters.TEXT & filters.ChatType.PRIVATE,
            private_panel_handler,
        )
    )

    # جمع الروابط والوسائط بعد معالجة أوامر الإدارة
    app.add_handler(
        MessageHandler(
            filters.ALL & ~filters.COMMAND,
            collect_messages,
        )
    )

    app.add_error_handler(error_handler)

    log.info("Cleaner is starting...")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()

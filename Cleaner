async def track_message(update):
    message = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if (
        not message
        or not chat
        or not user
        or user.is_bot
        or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP)
    ):
        return

    ensure_group(chat.id, chat.title or "")

    timestamp = int(message.date.timestamp())
    kind = message_kind(message)

    await sql(
        """
        INSERT OR IGNORE INTO tracked_messages(
            chat_id, message_id, user_id, message_date, kind
        )
        VALUES(?, ?, ?, ?, ?)
        """,
        (chat.id, message.message_id, user.id, timestamp, kind),
    )

    await sql(
        """
        INSERT INTO users(chat_id, user_id, name, messages)
        VALUES(?, ?, ?, 1)
        ON CONFLICT(chat_id, user_id)
        DO UPDATE SET
            name=excluded.name,
            messages=users.messages+1
        """,
        (
            chat.id,
            user.id,
            user.full_name or str(user.id),
        ),
    )

    # إزالة السجلات الأقدم من 48 ساعة لتقليل حجم قاعدة البيانات
    await sql(
        "DELETE FROM tracked_messages WHERE message_date < ?",
        (int(time.time()) - 48 * 3600,),
    )


# ============================ التنظيف خلال 24 ساعة ============================

async def clean_24h(update, context):
    message = update.effective_message
    chat = update.effective_chat

    if not message or not chat:
        return

    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        await message.reply_text(
            "❌ استخدم أمر تنظيف داخل الكروب."
        )
        return

    if not await is_group_admin(update, context):
        await message.reply_text(
            "❌ هذا الأمر للمشرفين فقط."
        )
        return

    if not await bot_can_delete(chat.id, context):
        await message.reply_text(
            "❌ ارفع البوت مشرفاً وامنحه صلاحية حذف الرسائل."
        )
        return

    cutoff = int(time.time()) - CLEAN_HOURS * 3600

    # استعلام صحيح لجميع الأنواع المطلوبة
    placeholders = ",".join("?" for _ in CLEANABLE_KINDS)

    rows = await sql(
        f"""
        SELECT message_id
        FROM tracked_messages
        WHERE chat_id = ?
          AND message_date >= ?
          AND kind IN ({placeholders})
        ORDER BY message_date DESC
        """,
        (chat.id, cutoff, *CLEANABLE_KINDS),
        "all",
    )

    deleted = 0
    failed = 0

    # حذف كل الميديا والروابط المسجلة خلال آخر 24 ساعة
    for row in rows:
        success = await safe_delete(
            chat.id,
            row["message_id"],
            context,
        )

        if success:
            deleted += 1
        else:
            failed += 1

    # حذف أمر تنظيف نفسه
    await safe_delete(
        chat.id,
        message.message_id,
        context,
    )

    # إزالة السجلات القديمة الخاصة بهذا الكروب
    await sql(
        """
        DELETE FROM tracked_messages
        WHERE chat_id = ? AND message_date < ?
        """,
        (chat.id, cutoff),
    )

    result = (
        "🧹 تم الانتهاء من تنظيف الكروب!\n\n"
        f"✅ العناصر المحذوفة: {deleted}\n"
        f"⚠️ العناصر التي تعذّر حذفها: {failed}\n\n"
        "📦 يشمل التنظيف:\n"
        "• الصور والفيديوهات\n"
        "• الروابط\n"
        "• الملصقات والمتحركات GIF\n"
        "• الأغاني والصوتيات\n"
        "• الملفات والمستندات\n"
        "• الفيديوهات الدائرية\n\n"
        "📅 المدة: آخر 24 ساعة."
    )

    try:
        await context.bot.send_message(
            chat_id=chat.id,
            text=result,
        )
    except TelegramError:
        log.exception("تعذّر إرسال نتيجة التنظيف")



def recent_count(chat_id):
    cutoff = int(time.time()) - CLEAN_HOURS * 3600
    placeholders = ",".join("?" for _ in CLEANABLE_KINDS)

    row = db.execute(
        f"""
        SELECT COUNT(*) AS total
        FROM tracked_messages
        WHERE chat_id = ?
          AND message_date >= ?
          AND kind IN ({placeholders})
        """,
        (chat_id, cutoff, *CLEANABLE_KINDS),
    ).fetchone()

    return row["total"] if row else 0



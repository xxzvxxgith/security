async def replies_menu(query):
    with db() as con:
        rows = con.execute("""
            SELECT id,keyword,response
            FROM auto_replies
            WHERE chat_id=0
            ORDER BY id DESC
            LIMIT 40
        """).fetchall()

    rows_kb = [[("➕ إضافة رد", "reply_add")]]

    if not rows:
        text = "💬 لا توجد ردود عامة محفوظة."
    else:
        lines = ["💬 <b>الردود العامة:</b>\n"]

        for row in rows:
            lines.append(

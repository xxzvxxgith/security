def get_global_subscription():
    return db_fetchone("""
        SELECT channel, link, enabled
        FROM subscription
        WHERE id = 1
    """)


async def check_channel_membership(bot, channel, user_id):
    """
    True  = عضو
    False = ليس عضواً
    None  = تعذر التحقق من Telegram
    """
    try:
        member = await bot.get_chat_member(channel, user_id)

        if member.status in ("creator", "administrator", "member"):
            return True

        if member.status == "restricted":
            return bool(getattr(member, "is_member", False))

        return False

    except TelegramError as exc:
        logger.warning(
            "تعذر التحقق من الاشتراك: %s",
            type(exc).__name__,
        )
        return None


async def subscription_check(message, context):
    if not message.from_user or message.from_user.is_bot:
        return True

    group = get_group(message.chat.id)

    requirements = []

    # اشتراك خاص بالمجموعة.
    if (
        group
        and group["subscription_enabled"]
        and group["subscription_channel"]
    ):
        requirements.append((
            group["subscription_channel"],
            group["subscription_link"] or "",
        ))

    # الاشتراك العام.
    global_sub = get_global_subscription()

    if global_sub and global_sub["enabled"] and global_sub["channel"]:
        global_channel = global_sub["channel"]

        # لا نكرر نفس القناة مرتين.
        if not any(
            channel == global_channel
            for channel, _ in requirements
        ):
            requirements.append((
                global_channel,
                global_sub["link"] or "",
            ))

    for channel, link in requirements:
        result = await check_channel_membership(
            context.bot,
            channel,
            message.from_user.id,
        )

        if result is None:
            # لا نحذف رسالة المستخدم بسبب خطأ API مؤقت.
            now = time.time()
            last = subscription_notice_time.get(message.chat.id, 0)

            if now - last > 300:
                subscription_notice_time[message.chat.id] = now
                try:
                    await message.reply_text(
                        "تعذر التحقق من الاشتراك حالياً. "
                        "تأكدوا أن البوت مشرف في قناة الاشتراك "
                        "ويملك الصلاحيات المطلوبة."
                    )
                except TelegramError:
                    pass

            return True

        if result is False:
            await safe_delete_message(
                context.bot,
                message.chat.id,
                message.message_id,
            )

            now = time.time()
            last = subscription_notice_time.get(message.chat.id, 0)

            if now - last > 30:
                subscription_notice_time[message.chat.id] = now

                buttons = []
                if link:
                    buttons.append([
                        InlineKeyboardButton(
                            "الاشتراك بالقناة",
                            url=link,
                        )
                    ])

                try:
                    await context.bot.send_message(
                        chat_id=message.chat.id,
                        text=(
                            f"عزيزي {message.from_user.mention_html()}, "
                            "يجب الاشتراك بالقناة أولاً حتى تتمكن "
                            "من إرسال الرسائل."
                        ),
                        parse_mode="HTML",
                        reply_markup=(
                            InlineKeyboardMarkup(buttons)
                            if buttons else None
                        ),
                    )
                except TelegramError:
                    pass

            return False

    return True



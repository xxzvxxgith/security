def message_kind(message):
    if message.photo: return "صورة"
    if message.video: return "فيديو"
    if message.animation: return "GIF"
    if message.sticker: return "ملصق"
    if message.voice: return "رسالة صوتية"
    if message.audio: return "أغنية/صوت"
    if message.video_note: return "فيديو دائري"
    if message.document: return "ملف"
    if message.contact: return "جهة اتصال"
    if message.location or message.venue: return "موقع"
    return "رابط" if contains_link(message.text or message.caption or "") else "رسالة"

# ============================ التتبع والتنظيف الشامل للميديا والروابط ============================
async def track_message(update):
    message, chat, user = update.effective_message, update.effective_chat, update.effective_user
    if not message or not chat or not user or user.is_bot or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP): return
    ensure_group(chat.id, chat.title or "")
    timestamp = int(message.date.timestamp())
    kind = message_kind(message)
    
    await sql("INSERT OR IGNORE INTO tracked_messages(chat_id,message_id,user_id,message_date,kind) VALUES(?,?,?,?,?)", (chat.id, message.message_id, user.id, timestamp, kind))
    await sql("INSERT INTO users(chat_id,user_id,name,messages) VALUES(?,?,?,1) ON CONFLICT(chat_id,user_id) DO UPDATE SET name=excluded.name, messages=users.messages+1", (chat.id, user.id, user.full_name or str(user.id)))
    await sql("DELETE FROM tracked_messages WHERE message_date<?", (int(time.time()) - 48 * 3600,))

async def clean_24h(update, context):
    message, chat = update.effective_message, update.effective_chat
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP): return
    if not await is_group_admin(update, context):
        await message.reply_text("هذا الأمر للمشرفين فقط.")
        return
    if not await bot_can_delete(chat.id, context):
        await message.reply_text("❌ ارفع البوت مشرفاً وامنحه صلاحية حذف الرسائل.")
        return

    cutoff = int(time.time()) - CLEAN_HOURS * 3600

    with db() as con:
        rows = con.execute(
            "SELECT message_id FROM tracked_messages WHERE chat_id=? AND message_date>=? AND kind IN ('صورة', 'فيديو', 'GIF', 'ملصق', 'رسالة صوتية', 'أغنية/صوت', 'فيديو دائري', 'ملف', 'رابط') ORDER BY message_id DESC", 
            (chat.id, cutoff)
        ).fetchall()

    deleted = 0
    for r in rows:
        if await safe_delete(chat.id, r["message_id"], context):
            deleted += 1

    # حذف أمر "تنظيف" نفسه فوراً
    await safe_delete(chat.id, message.message_id, context)

    with db() as con:
        con.execute("DELETE FROM tracked_messages WHERE chat_id=? AND message_date<?", (chat.id, cutoff))

    try:
        sent_msg = await context.bot.send_message(
            chat.id,
            f"🧹 **تم تنظيف الكروب بنجاح!**\n\n• تم مسح `{deleted}` عنصر (صور، فيديوهات، روابط، ملصقات، ملفات، صوتيات) من آخر 24 ساعة.",
            parse_mode="Markdown"
        )
        await asyncio.sleep(4)
        await safe_delete(chat.id, sent_msg.message_id, context)
    except TelegramError:
        pass

# ============================ فحص الميديا والردود ============================
async def moderate_message(update, context):
    message, chat, user = update.effective_message, update.effective_chat, update.effective_user
    if not message or not chat or chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP) or not user or user.is_bot: return
    
    txt_check = (message.text or message.caption or "").strip()
    allowed_cmds = {"تنظيف", "/تنظيف", "حالة", "توب", "تصفير التوب", "تصفير توب المتفاعلين", "تفعيل", "/تفعيل", "إيقاف", "/إيقاف"}
    if txt_check in allowed_cmds:
        return

    await track_message(update)
    if setting("enabled", "1") != "1": return
    
    group = get_group(chat.id)
    if not group or not group.get("enabled", 1): return

    try:
        member = await context.bot.get_chat_member(chat.id, user.id)
        if member.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.OWNER):
            return
    except TelegramError:
        pass

    txt = message.text or message.caption or ""
    delete = False

    if group.get("delete_links") and contains_link(txt): delete = True
    if group.get("delete_photos") and message.photo: delete = True
    if group.get("delete_videos") and (message.video or message.video_note): delete = True
    if group.get("delete_stickers") and message.sticker: delete = True
    if group.get("delete_gifs") and message.animation: delete = True
    if group.get("delete_audio") and (message.audio or message.voice): delete = True
    if group.get("delete_files") and message.document: delete = True
    if group.get("delete_forwarded") and (getattr(message, "forward_origin", None) or getattr(message, "forward_date", None)): delete = True

    if group.get("replies_enabled", 1) and message.reply_to_message and message.reply_to_message.from_user and message.reply_to_message.from_user.id != user.id:
        d_text = group.get("delete_message") or "ممنوع الرد"
        if await safe_delete(chat.id, message.message_id, context):
            try:
                await context.bot.send_message(chat.id, f"{user.mention_html()} {html.escape(d_text)}", parse_mode="HTML")
            except TelegramError:
                pass
        return

    if delete:
        await safe_delete(chat.id, message.message_id, context)
        return

    if message.text:
        with db() as con:
            reply = con.execute("SELECT response FROM auto_replies WHERE keyword=? AND chat_id IN (0,?) ORDER BY chat_id DESC LIMIT 1", (message.text.strip(), chat.id)).fetchone()
        if reply:
            try: await message.reply_text(reply["response"])
            except TelegramError: pass

async def group_text_commands(update, context):
    message, chat = update.effective_message, update.effective_chat
    if not message or not message.text or chat.type == ChatType.PRIVATE: return
    txt = message.text.strip()
    if txt in ("تنظيف", "/تنظيف"): await clean_24h(update, context)
    elif txt == "حالة": await message.reply_text(f"📊 <b>حالة الكروب:</b>\n• الرسائل المسجلة (24س): {recent_count(chat.id)}", parse_mode="HTML")
    elif txt == "توب": await show_top(chat.id, context, message)
    elif txt in ("تصفير التوب", "تصفير توب المتفاعلين"): await reset_top(update, context)
    elif txt in ("تفعيل", "/تفعيل"):
        if await is_group_admin(update, context):
            update_group(chat.id, "enabled", 1)
            update_group(chat.id, "replies_enabled", 1)
            await message.reply_text("✅ تم تفعيل الحماية والردود.")
    elif txt in ("إيقاف", "/إيقاف"):
        if await is_group_admin(update, context):
            update_group(chat.id, "replies_enabled", 0)
            await message.reply_text("⏸ تم إيقاف حذف الردود.")


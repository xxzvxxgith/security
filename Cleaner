            f"القناة: {channel}\nالحالة: {'مفعّل' if enabled else 'متوقف'}\n\n"
            "الأوامر:\n/setchannel @channel\n/subscription on\n/subscription off"
        )
    elif data == "admin_replies":
        if not is_admin(user_id):
            return
        await query.edit_message_text(
            "إدارة الردود التلقائية:\n"
            "/addreply كلمة | الرد\n/delreply ID\n/listreplies\n"
            "تفعيل الردود في المجموعة: تفعيل الردود / إيقاف الردود"
        )
    elif data == "admin_clean":
        if not is_admin(user_id):
            return
        await query.edit_message_text(
            "افتح المجموعة ثم استخدم /clean لتغيير أنواع التنظيف."
        )
    elif data == "admin_export":
        if not is_admin(user_id):
            return
        output = io.StringIO()
        writer = csv.writer(output)
        writer.writerow(["user_id", "username", "first_name", "last_name"])
        for row in fetchall(
            "SELECT user_id,username,first_name,last_name FROM profiles"
        ):
            writer.writerow(list(row))
        data_file = io.BytesIO(output.getvalue().encode("utf-8-sig"))
        data_file.name = "profiles.csv"
        await context.bot.send_document(
            chat_id=user_id,
            document=data_file,
            caption="تصدير الأرشيف",
        )


async def addadmin_command(update, context):
    if not is_owner(update.effective_user.id):
        return
    if not context.args or not context.args[0].isdigit():
        await update.effective_message.reply_text("استخدم /addadmin USER_ID")
        return
    execute("INSERT OR IGNORE INTO bot_admins(user_id) VALUES(?)",
            (int(context.args[0]),))
    await update.effective_message.reply_text("تمت إضافة المشرف.")


async def deladmin_command(update, context):
    if not is_owner(update.effective_user.id):
        return
    if not context.args or not context.args[0].isdigit():
        await update.effective_message.reply_text("استخدم /deladmin USER_ID")
        return
    target = int(context.args[0])
    if target == OWNER_ID:
        await update.effective_message.reply_text("لا يمكن حذف المالك.")
        return
    execute("DELETE FROM bot_admins WHERE user_id=?", (target,))
    await update.effective_message.reply_text("تم حذف المشرف.")


async def setchannel_command(update, context):
    if not is_owner(update.effective_user.id):
        return
    if not context.args:
        await update.effective_message.reply_text("استخدم /setchannel @channel")
        return
    channel = context.args[0].strip()
    set_setting("force_channel", channel)
    await update.effective_message.reply_text(
        f"تم تعيين قناة الاشتراك: {html.escape(channel)}",
        parse_mode="HTML",
    )


async def subscription_command(update, context):
    if not is_owner(update.effective_user.id):
        return
    if not context.args or context.args[0].lower() not in ("on", "off"):
        await update.effective_message.reply_text(
            "استخدم /subscription on أو /subscription off"
        )
        return
    set_setting(
        "force_subscription",
        "1" if context.args[0].lower() == "on" else "0",
    )
    await update.effective_message.reply_text("تم تحديث إعداد الاشتراك الإجباري.")


async def addreply_command(update, context):
    if not is_admin(update.effective_user.id):
        return
    chat = update.effective_chat
    if chat.type not in (ChatType.GROUP, ChatType.SUPERGROUP):
        await update.effective_message.reply_text("استخدم الأمر داخل المجموعة.")
        return
    raw = " ".join(context.args)
    if "|" not in raw:
        await update.effective_message.reply_text(
            "الصيغة: /addreply كلمة | الرد"
        )
        return
    keyword, response = [x.strip() for x in raw.split("|", 1)]
    if not keyword or not response:
        await update.effective_message.reply_text("الكلمة والرد مطلوبان.")
        return
    execute(
        "INSERT INTO auto_replies(chat_id,keyword,response) VALUES(?,?,?)",
        (chat.id, keyword.lower(), response),
    )
    await update.effective_message.reply_text("تمت إضافة الرد التلقائي.")


async def delreply_command(update, context):
    if not is_admin(update.effective_user.id):
        return
    if not context.args or not context.args[0].isdigit():
        await update.effective_message.reply_text("استخدم /delreply ID")
        return
    execute("DELETE FROM auto_replies WHERE id=?", (int(context.args[0]),))
    await update.effective_message.reply_text("تم حذف الرد إن كان موجودًا.")


async def listreplies_command(update, context):
    if not is_admin(update.effective_user.id):
        return
    chat = update.effective_chat
    rows = fetchall(
        "SELECT id,keyword,response,enabled FROM auto_replies WHERE chat_id=?",
        (chat.id,),
    )
    if not rows:
        await update.effective_message.reply_text("لا توجد ردود لهذه المجموعة.")
        return
    text = "\n".join(
        f"{r['id']}. {r['keyword']} → {r['response']} "
        f"({'مفعّل' if r['enabled'] else 'متوقف'})"
        for r in rows
    )
    await update.effective_message.reply_text(text[:4000])



def get_delete_field(message):
    if message.photo:
        return "delete_photos"

    if message.video:
        return "delete_videos"

    if message.video_note:
        return "delete_videos"

    if message.animation:
        return "delete_gifs"

    if message.sticker:
        return "delete_stickers"

    if message.audio or message.voice:
        return "delete_audio"

    if message.document:
        return "delete_files"

    if contains_link(message):
        return "delete_links"

    # النص العادي فقط، دون رابط أو ميديا.
    if message.text and not classify_message(message):
        return "delete_message"

    return None


async def moderate_message(message, context):
    group = get_group(message.chat.id)

    if not group or not group["enabled"]:
        return

    # منع الرد على رسائل الآخرين، إن كان الخيار مفعلاً.
    if (
        group["replies_enabled"]
        and message.reply_to_message
        and message.from_user
        and message.reply_to_message.from_user
        and message.from_user.id
        != message.reply_to_message.from_user.id
    ):
        await safe_delete_message(
            context.bot,
            message.chat.id,
            message.message_id,
        )
        return

    # حذف الرسائل المعاد توجيهها.
    if (
        group["delete_forwarded"]
        and (
            getattr(message, "forward_origin", None)
            or getattr(message, "forward_date", None)
        )
    ):
        await safe_delete_message(
            context.bot,
            message.chat.id,
            message.message_id,
        )
        return

    field = get_delete_field(message)

    if field and group[field]:
        await safe_delete_message(
            context.bot,
            message.chat.id,
            message.message_id,
        )
        return

    await send_auto_reply(message, context)



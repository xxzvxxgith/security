async def is_group_admin(update, context):
    user = update.effective_user
    chat = update.effective_chat

    if not user or not chat:
        return False

    if is_owner(user.id):
        return True

    if chat.type == ChatType.PRIVATE:
        return is_bot_admin(user.id)

    try:
        member = await context.bot.get_chat_member(
            chat.id, user.id
        )

        return member.status in (
            ChatMemberStatus.ADMINISTRATOR,
            ChatMemberStatus.OWNER,
        )

    except TelegramError:
        return False


async def bot_can_delete(chat_id, context):
    try:
        me = await context.bot.get_chat_member(
            chat_id, context.bot.id
        )

        return (
            me.status == ChatMemberStatus.OWNER
            or (
                me.status == ChatMemberStatus.ADMINISTRATOR
                and bool(
                    getattr(me, "can_delete_messages", False)
                )
            )
        )

    except TelegramError:
        return False


async def bot_can_restrict(chat_id, context):
    try:
        me = await context.bot.get_chat_member(chat_id, context.bot.id)
        return (
            me.status == ChatMemberStatus.OWNER
            or (
                me.status == ChatMemberStatus.ADMINISTRATOR
                and bool(getattr(me, "can_restrict_members", False))
            )
        )
    except TelegramError:
        return False


async def safe_delete(chat_id, message_id, context):
    try:
        await context.bot.delete_message(
            chat_id, message_id
        )
        return True

    except TelegramError as exc:
        log.debug(
            "تعذر حذف الرسالة %s: %s",
            message_id,
            exc,
        )
        return False



# ---------- Database ----------
def init_db():
    with closing(sqlite3.connect(DB_PATH, timeout=15)) as conn:
        conn.execute("PRAGMA journal_mode=WAL")
        conn.executescript("""
        CREATE TABLE IF NOT EXISTS profiles(
          user_id INTEGER PRIMARY KEY, username TEXT, first_name TEXT NOT NULL DEFAULT '',
          last_name TEXT NOT NULL DEFAULT '', is_bot INTEGER NOT NULL DEFAULT 0,
          first_seen INTEGER NOT NULL, last_seen INTEGER NOT NULL);
        CREATE TABLE IF NOT EXISTS name_history(
          id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, username TEXT,
          first_name TEXT NOT NULL DEFAULT '', last_name TEXT NOT NULL DEFAULT '', observed_at INTEGER NOT NULL);
        CREATE INDEX IF NOT EXISTS idx_history_user ON name_history(user_id, observed_at DESC);
        CREATE TABLE IF NOT EXISTS usage(user_id INTEGER PRIMARY KEY, last_request REAL NOT NULL);
        CREATE TABLE IF NOT EXISTS bot_users(
          user_id INTEGER PRIMARY KEY, username TEXT, first_name TEXT NOT NULL DEFAULT '',
          first_seen INTEGER NOT NULL, last_seen INTEGER NOT NULL);
        """)
        conn.commit()


async def db_execute(sql, params=(), one=False, all_rows=False):
    async with db_lock:
        with closing(sqlite3.connect(DB_PATH, timeout=15)) as conn:
            conn.row_factory = sqlite3.Row
            cur = conn.execute(sql, params)
            result = cur.fetchone() if one else cur.fetchall() if all_rows else None
            conn.commit()
            return result


async def record_user(user):
    if not user:
        return
    now = int(time.time())
    await db_execute("""INSERT INTO bot_users(user_id,username,first_name,first_seen,last_seen)
      VALUES(?,?,?,?,?) ON CONFLICT(user_id) DO UPDATE SET username=excluded.username,
      first_name=excluded.first_name,last_seen=excluded.last_seen""",
      (user.id, user.username, user.first_name or "", now, now))


async def save_profile(user_id, username, first_name, last_name, is_bot=False):
    now, username = int(time.time()), (username or "").lstrip("@") or None
    first_name, last_name = first_name or "", last_name or ""
    old = await db_execute(
        "SELECT username,first_name,last_name FROM profiles WHERE user_id=?",
        (int(user_id),), one=True
    )
    changed = old is not None and (
        old["username"] != username
        or old["first_name"] != first_name
        or old["last_name"] != last_name
    )

    if old is None:
        await db_execute("""INSERT INTO profiles
          (user_id,username,first_name,last_name,is_bot,first_seen,last_seen)
          VALUES(?,?,?,?,?,?,?)""",
          (int(user_id), username, first_name, last_name, int(bool(is_bot)), now, now))
        await db_execute("""INSERT INTO name_history
          (user_id,username,first_name,last_name,observed_at)
          VALUES(?,?,?,?,?)""",
          (int(user_id), username, first_name, last_name, now))
    else:
        if changed:
            await db_execute("""INSERT INTO name_history
              (user_id,username,first_name,last_name,observed_at)
              VALUES(?,?,?,?,?)""",
              (int(user_id), username, first_name, last_name, now))
        await db_execute("""UPDATE profiles
          SET username=?,first_name=?,last_name=?,is_bot=?,last_seen=?
          WHERE user_id=?""",
          (username, first_name, last_name, int(bool(is_bot)), now, int(user_id)))


async def get_profile(user_id):
    return await db_execute(
        "SELECT * FROM profiles WHERE user_id=?",
        (int(user_id),), one=True
    )


async def get_history(user_id):
    return await db_execute("""SELECT username,first_name,last_name,observed_at
      FROM name_history WHERE user_id=?
      ORDER BY observed_at DESC LIMIT ?""",
      (int(user_id), MAX_HISTORY_RESULTS), all_rows=True)


async def cooldown_ok(user_id):
    now = time.time()
    async with db_lock:
        with closing(sqlite3.connect(DB_PATH, timeout=15)) as conn:
            row = conn.execute(
                "SELECT last_request FROM usage WHERE user_id=?",
                (int(user_id),)
            ).fetchone()

            if row and now - float(row[0]) < COOLDOWN:
                return False

            conn.execute("""INSERT INTO usage(user_id,last_request)
              VALUES(?,?) ON CONFLICT(user_id)
              DO UPDATE SET last_request=excluded.last_request""",
              (int(user_id), now))
            conn.commit()
    return True


# ---------- Optional Telethon ----------
async def start_telethon():
    global telethon_client

    if not (TG_API_ID and TG_API_HASH and TG_SESSION):
        log.info("Telethon disabled; Bot API/local archive only.")
        return

    try:
        from telethon import TelegramClient
        from telethon.sessions import StringSession

        client = TelegramClient(
            StringSession(TG_SESSION),
            int(TG_API_ID),
            TG_API_HASH,
            connection_retries=2,
            request_retries=2,
            auto_reconnect=True
        )
        await client.connect()

        if not await client.is_user_authorized():
            log.error("Telethon session is not authorized.")
            await client.disconnect()
            return

        telethon_client = client
        log.info("Telethon session connected.")

    except Exception:
        log.exception("Telethon startup failed.")
        telethon_client = None


async def lookup_mtproto(query):
    if telethon_client is None:
        return None

    try:
        target = int(query) if query.isdigit() else query.lstrip("@")
        entity = await telethon_client.get_entity(target)

        if not hasattr(entity, "first_name") or not hasattr(entity, "id"):
            return None

        return {
            "id": int(entity.id),
            "username": getattr(entity, "username", None),
            "first_name": getattr(entity, "first_name", None) or "",
            "last_name": getattr(entity, "last_name", None) or "",
            "is_bot": bool(getattr(entity, "bot", False))
        }

    except Exception as exc:
        log.info("MTProto lookup unavailable: %s", type(exc).__name__)
        return None


# ---------- UI helpers ----------
def esc(x):
    return html.escape(str(x or ""), quote=True)


def fmt_time(ts):
    if not ts:
        return "غير متوفر"
    return time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(ts))


def valid_query(raw):
    value = (raw or "").strip()

    if not value or len(value) > MAX_INPUT_LENGTH:
        return None

    if value.isdigit():
        try:
            n = int(value)
            return str(n) if 0 < n <= 9_223_372_036_854_775_807 else None
        except ValueError:
            return None

    username = value[1:] if value.startswith("@") else value

    if re.fullmatch(r"[A-Za-z][A-Za-z0-9_]{4,31}", username):
        return "@" + username

    return None



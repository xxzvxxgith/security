# ---------- Startup ----------
async def error_handler(update: object, context: ContextTypes.DEFAULT_TYPE):
    err = context.error

    if isinstance(err, RetryAfter):
        log.warning("Telegram rate limit reached")

    elif isinstance(err, (TimedOut, NetworkError)):
        log.warning("Temporary network issue: %s", type(err).__name__)

    else:
        log.error(
            "Unhandled error: %s",
            type(err).__name__ if err else "unknown",
            exc_info=err
        )


async def post_init(app: Application):
    init_db()
    await start_telethon()

    await app.bot.set_my_commands([
        BotCommand("start", "فتح القائمة الرئيسية"),
        BotCommand("help", "طريقة الاستخدام"),
        BotCommand("history", "عرض سجل الأسماء المرصودة")
    ])

    log.info("Bot initialized; owner ID=%s", OWNER_ID)


async def post_shutdown(app: Application):
    global telethon_client

    if telethon_client is not None:
        try:
            await telethon_client.disconnect()
        except Exception:
            log.exception("Telethon disconnect failed")

        telethon_client = None


def main():
    app = (
        Application.builder()
        .token(BOT_TOKEN)
        .post_init(post_init)
        .post_shutdown(post_shutdown)
        .build()
    )

    app.add_handler(CommandHandler("start", start_cmd))
    app.add_handler(CommandHandler("help", help_cmd))
    app.add_handler(CommandHandler("history", history_cmd))
    app.add_handler(CallbackQueryHandler(button_handler))
    app.add_handler(
        MessageHandler(filters.TEXT & ~filters.COMMAND, text_handler)
    )
    app.add_error_handler(error_handler)

    log.info("Starting Telegram profile lookup bot...")

    app.run_polling(
        allowed_updates=Update.ALL_TYPES,
        drop_pending_updates=False
    )


if __name__ == "__main__":
    main()

def esc(x):
    return html.escape(str(x or ""), quote=True)


def fmt_time(ts):
    if not ts:
        return "غير متوفر"
    return time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(ts))


def estimate_creation_date(user_id):
    """تقدير تقريبي لتاريخ إنشاء الحساب استناداً إلى تسلسل IDs في تيليجرام (غير رسمي)"""
    if not str(user_id).isdigit():
        return "غير متاح"
    uid = int(user_id)
    # تقريب زمني تقريبي جداً بناءً على المعرفات التاريخية
    if uid < 100_000_000:
        return "تقديري: مبكر جداً (قبل 2016)"
    elif uid < 500_000_000:
        return "تقديري: بين 2016 و 2019"
    elif uid < 1_000_000_000:
        return "تقديري: بين 2019 و 2021"
    else:
        return "تقديري: حديث (بعد 2021)"


def valid_query(raw):
    value = (raw or "").strip()
    if not value or len(value) > MAX_INPUT_LENGTH:
        return None
    if value.isdigit():
        try:
            n = int(value)
            return str(n) if 0 < n <= 9_223_372_036_854_775_807 else None
        except ValueError:
            return None
    username = value[1:] if value.startswith("@") else value
    if re.fullmatch(r"[A-Za-z][A-Za-z0-9_]{4,31}", username):
        return "@" + username
    return None



# ==================== DATABASE SETUP ====================

def init_db():
    os.makedirs(PHOTOS_DIR, exist_ok=True)
    with closing(sqlite3.connect(DB_PATH, timeout=15)) as conn:
        conn.execute("PRAGMA journal_mode=WAL")
        conn.executescript("""
        CREATE TABLE IF NOT EXISTS profiles(
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            first_name TEXT NOT NULL DEFAULT '',
            last_name TEXT NOT NULL DEFAULT '',
            is_bot INTEGER NOT NULL DEFAULT 0,
            photo_path TEXT,
            first_seen INTEGER NOT NULL,
            last_seen INTEGER NOT NULL
        );
        CREATE TABLE IF NOT EXISTS name_history(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            username TEXT,
            first_name TEXT NOT NULL DEFAULT '',
            last_name TEXT NOT NULL DEFAULT '',
            observed_at INTEGER NOT NULL
        );
        CREATE INDEX IF NOT EXISTS idx_history_user ON name_history(user_id, observed_at DESC);
        
        CREATE TABLE IF NOT EXISTS usage(
            user_id INTEGER PRIMARY KEY,
            last_request REAL NOT NULL
        );
        CREATE TABLE IF NOT EXISTS bot_users(
            user_id INTEGER PRIMARY KEY,
            username TEXT,
            first_name TEXT NOT NULL DEFAULT '',
            first_seen INTEGER NOT NULL,
            last_seen INTEGER NOT NULL
        );
        CREATE TABLE IF NOT EXISTS search_logs(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            query TEXT NOT NULL,
            success INTEGER NOT NULL,
            source TEXT,
            searched_at INTEGER NOT NULL
        );
        """)
        conn.commit()


async def db_execute(sql, params=(), one=False, all_rows=False):
    async with db_lock:
        with closing(sqlite3.connect(DB_PATH, timeout=15)) as conn:
            conn.row_factory = sqlite3.Row
            cur = conn.execute(sql, params)
            result = cur.fetchone() if one else (cur.fetchall() if all_rows else None)
            conn.commit()
            return result


async def record_user(user):
    if not user:
        return
    now = int(time.time())
    await db_execute("""
        INSERT INTO bot_users(user_id, username, first_name, first_seen, last_seen)
        VALUES(?, ?, ?, ?, ?)
        ON CONFLICT(user_id) DO UPDATE SET
            username=excluded.username,
            first_name=excluded.first_name,
            last_seen=excluded.last_seen
    """, (user.id, user.username, user.first_name or "", now, now))


async def log_search(user_id, query, success, source):
    now = int(time.time())
    await db_execute("""
        INSERT INTO search_logs(user_id, query, success, source, searched_at)
        VALUES(?, ?, ?, ?, ?)
    """, (user_id, query, int(success), source, now))


async def save_profile(user_id, username, first_name, last_name, is_bot=False, photo_path=None):
    now = int(time.time())
    username = (username or "").lstrip("@") or None
    first_name = first_name or ""
    last_name = last_name or ""

    old = await db_execute(
        "SELECT username, first_name, last_name, photo_path FROM profiles WHERE user_id=?",
        (int(user_id),), one=True
    )
    changed = old is not None and (
        old["username"] != username
        or old["first_name"] != first_name
        or old["last_name"] != last_name
    )

    final_photo = photo_path or (old["photo_path"] if old else None)

    if old is None:
        await db_execute("""
            INSERT INTO profiles(user_id, username, first_name, last_name, is_bot, photo_path, first_seen, last_seen)
            VALUES(?, ?, ?, ?, ?, ?, ?, ?)
        """, (int(user_id), username, first_name, last_name, int(bool(is_bot)), final_photo, now, now))
        await db_execute("""
            INSERT INTO name_history(user_id, username, first_name, last_name, observed_at)
            VALUES(?, ?, ?, ?, ?)
        """, (int(user_id), username, first_name, last_name, now))
    else:
        if changed:
            await db_execute("""
                INSERT INTO name_history(user_id, username, first_name, last_name, observed_at)
                VALUES(?, ?, ?, ?, ?)
            """, (int(user_id), username, first_name, last_name, now))
        await db_execute("""
            UPDATE profiles
            SET username=?, first_name=?, last_name=?, is_bot=?, photo_path=COALESCE(?, photo_path), last_seen=?
            WHERE user_id=?
        """, (username, first_name, last_name, int(bool(is_bot)), final_photo, now, int(user_id)))


async def get_profile(user_id):
    return await db_execute("SELECT * FROM profiles WHERE user_id=?", (int(user_id),), one=True)


async def get_history(user_id):
    return await db_execute("""
        SELECT username, first_name, last_name, observed_at
        FROM name_history WHERE user_id=?
        ORDER BY observed_at DESC LIMIT ?
    """, (int(user_id), MAX_HISTORY_RESULTS), all_rows=True)


async def cooldown_ok(user_id):
    now = time.time()
    async with db_lock:
        with closing(sqlite3.connect(DB_PATH, timeout=15)) as conn:
            row = conn.execute("SELECT last_request FROM usage WHERE user_id=?", (int(user_id),)).fetchone()
            if row and now - float(row[0]) < COOLDOWN:
                return False
            conn.execute("""
                INSERT INTO usage(user_id, last_request) VALUES(?, ?)
                ON CONFLICT(user_id) DO UPDATE SET last_request=excluded.last_request
            """, (int(user_id), now))
            conn.commit()
    return True


# ==================== TELETHON INTEGRATION ====================

async def start_telethon():
    global telethon_client
    if not (TG_API_ID and TG_API_HASH and TG_SESSION):
        log.info("Telethon disabled; using Bot API and local archive.")
        return
    try:
        from telethon import TelegramClient
        from telethon.sessions import StringSession
        client = TelegramClient(
            StringSession(TG_SESSION),
            int(TG_API_ID),
            TG_API_HASH,
            connection_retries=2,
            request_retries=2,
            auto_reconnect=True
        )
        await client.connect()
        if not await client.is_user_authorized():
            log.error("Telethon session is not authorized.")
            await client.disconnect()
            return
        telethon_client = client
        log.info("Telethon session connected successfully.")
    except Exception:
        log.exception("Telethon startup failed.")
        telethon_client = None


async def lookup_mtproto(query):
    if telethon_client is None:
        return None
    try:
        target = int(query) if query.isdigit() else query.lstrip("@")
        entity = await telethon_client.get_entity(target)
        if not hasattr(entity, "id"):
            return None
        
        # محاولة حفظ صورة الحساب إذا وجدت
        photo_path = None
        try:
            profile_photos = await telethon_client.get_profile_photos(entity, limit=1)
            if profile_photos:
                filename = f"{entity.id}_{int(time.time())}.jpg"
                photo_path = os.path.join(PHOTOS_DIR, filename)
                await telethon_client.download_profile_photo(entity, file=photo_path)
        except Exception:
            pass

        return {
            "id": int(entity.id),
            "username": getattr(entity, "username", None),
            "first_name": getattr(entity, "first_name", None) or "",
            "last_name": getattr(entity, "last_name", None) or "",
            "is_bot": bool(getattr(entity, "bot", False)),
            "photo_path": photo_path,
        }
    except Exception as exc:
        log.info("MTProto lookup unavailable: %s", type(exc).__name__)
        return None



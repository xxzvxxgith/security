            f"🔎 إجمالي عمليات البحث: <code>{sc['n']}</code>\n"
            f"🗄️ الحسابات المؤرشفة: <code>{pc['n']}</code>\n"
            f"🕓 سجلات الأسماء: <code>{hc['n']}</code>\n"
            f"📸 الصور المؤرشفة: <code>{photos_count}</code>"
        )
        await edit_menu(q, text, owner_keyboard())
    elif data == "export_csv":
        if user.id != OWNER_ID:
            await edit_menu(q, "⛔ غير مسموح لك بتصدير السجلات.", back_keyboard())
            return
        logs = await db_execute("SELECT user_id, query, success, source, searched_at FROM search_logs", all_rows=True)
        output = io.StringIO()
        writer = csv.writer(output)
        writer.writerow(["User ID", "Query", "Success", "Source", "Timestamp"])
        for row in logs:
            writer.writerow([row["user_id"], row["query"], row["success"], row["source"], fmt_time(row["searched_at"])])
        output.seek(0)
        await q.message.reply_document(
            document=InputFile(io.BytesIO(output.getvalue().encode('utf-8')), filename="search_logs.csv"),
            caption="📤 سجلات البحث المصدرة بنجاح."
        )


async def error_handler(update: object, context: ContextTypes.DEFAULT_TYPE):
    log.error("Unhandled error: %s", context.error)


async def post_init(app: Application):
    init_db()
    await start_telethon()
    await app.bot.set_my_commands([
        BotCommand("start", "القائمة الرئيسية"),
        BotCommand("help", "طريقة الاستخدام"),
        BotCommand("history", "سجل الأسماء المرصودة")
    ])
    log.info("Professional Lookup Bot initialized successfully. Owner ID: %s", OWNER_ID)


async def post_shutdown(app: Application):
    global telethon_client
    if telethon_client:
        try:
            await telethon_client.disconnect()
        except Exception:
            pass


def main():
    app = (
        Application.builder()
        .token(BOT_TOKEN)
        .post_init(post_init)
        .post_shutdown(post_shutdown)
        .build()
    )

    app.add_handler(CommandHandler("start", start_cmd))
    app.add_handler(CommandHandler("help", help_cmd))
    app.add_handler(CommandHandler("history", history_cmd))
    app.add_handler(CallbackQueryHandler(button_handler))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, text_handler))
    app.add_error_handler(error_handler)

    log.info("Starting bot polling...")
    app.run_polling(allowed_updates=Update.ALL_TYPES, drop_pending_updates=False)


if __name__ == "__main__":
    main()

        uid, p.get("username"), p.get("first_name"),
        p.get("last_name"), p.get("is_bot", False)
    )

    history = await get_history(uid)

    name = (
        (p.get("first_name") or "") + " " +
        (p.get("last_name") or "")
    ).strip() or "غير متوفر"

    username = (
        "@" + esc(p.get("username"))
        if p.get("username") else "غير متوفر"
    )

    lines = [
        "🔎 <b>نتيجة البحث</b>",
        "",
        f"🆔 <b>الآيدي:</b> <code>{uid}</code>",
        f"👤 <b>الاسم:</b> {esc(name)}",
        f"🔗 <b>اليوزرنيم:</b> {username}",
        f"🤖 <b>نوع الحساب:</b> {'بوت' if p.get('is_bot') else 'حساب مستخدم أو غير محدد'}",
        f"📡 <b>المصدر:</b> {esc(source)}",
        "",
        "🕓 <b>الأسماء التي رصدها البوت:</b>"
    ]

    if history:
        for item in history:
            n = (
                (item["first_name"] or "") + " " +
                (item["last_name"] or "")
            ).strip() or "اسم غير متوفر"

            u = (
                "@" + item["username"]
                if item["username"] else "بدون يوزرنيم"
            )

            lines.append(
                f"• {esc(n)} — {esc(u)}\n"
                f"  <i>{esc(fmt_time(item['observed_at']))}</i>"
            )
    else:
        lines.append("• لا توجد سجلات سابقة.")

    lines += [
        "",
        "⚠️ <i>الأرشيف يبدأ من وقت رصد البوت للحساب.</i>",
        "🔒 <i>لا يعرض أرقام الهواتف المخفية أو البيانات الخاصة.</i>"
    ]

    return "\n".join(lines)



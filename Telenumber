async def search_query(update, context, raw):
    user = update.effective_user
    msg = update.effective_message

    if not user or not msg:
        return

    await record_user(user)

    if not await cooldown_ok(user.id):
        await msg.reply_text("⏳ تمهّل شوي قبل البحث مرة ثانية.")
        return

    query = valid_query(raw)

    if not query:
        await msg.reply_text(
            "❌ الصيغة مو صحيحة. أرسل يوزرنيم صحيح أو آيدي رقمي.",
            reply_markup=back_keyboard()
        )
        return

    status = await msg.reply_text("🔎 جارٍ البحث عن المعلومات المتاحة...")

    profile = await lookup_mtproto(query)
    source = "جلسة Telethon المصرح بها"

    if profile is None and query.startswith("@"):
        try:
            chat = await context.bot.get_chat(query)

            if chat.type == ChatType.PRIVATE:
                profile = {
                    "id": int(chat.id),
                    "username": getattr(chat, "username", None),
                    "first_name": getattr(chat, "first_name", None) or "",
                    "last_name": getattr(chat, "last_name", None) or "",
                    "is_bot": bool(getattr(chat, "is_bot", False))
                }
                source = "Telegram Bot API"

        except TelegramError as exc:
            log.info("Bot API lookup unavailable: %s", type(exc).__name__)

    if profile is None and query.isdigit():
        archived = await get_profile(int(query))

        if archived:
            profile = {
                "id": int(archived["user_id"]),
                "username": archived["username"],
                "first_name": archived["first_name"],
                "last_name": archived["last_name"],
                "is_bot": bool(archived["is_bot"])
            }
            source = "الأرشيف المحلي"

    if profile is None:
        await status.edit_text(
            "ما گدرت أوصل لهذا الحساب.\n"
            "تأكد من اليوزرنيم؛ البحث بالآيدي وحده ما يضمن الوصول.",
            reply_markup=back_keyboard()
        )
        return

    try:
        result = await render_profile(profile, source)

        await status.edit_text(
            result,
            parse_mode="HTML",
            reply_markup=back_keyboard()
        )

    except TelegramError:
        log.exception("Failed to send search result")
        await msg.reply_text("صار خطأ أثناء إرسال النتيجة. جرّب مرة ثانية.")


async def text_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message
    user = update.effective_user

    if not msg or not user or msg.chat.type != ChatType.PRIVATE:
        return

    raw = (msg.text or "").strip()

    if raw:
        await search_query(update, context, raw)



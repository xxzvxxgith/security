async def search_query(update, context, raw):
    user = update.effective_user
    msg = update.effective_message
    if not user or not msg:
        return
    await record_user(user)

    if not await cooldown_ok(user.id):
        await msg.reply_text("⏳ تمهّل قليلاً قبل إجراء بحث جديد.")
        return

    query = valid_query(raw)
    if not query:
        await msg.reply_text("❌ صيغة غير صحيحة. أرسل يوزرنيم صحيح يبدأ بـ @ أو آيدي رقمي.", reply_markup=back_keyboard())
        return

    status = await msg.reply_text("🔎 جارٍ البحث واستخراج المعلومات...")

    profile = await lookup_mtproto(query)
    source = "جلسة Telethon"

    if profile is None and query.startswith("@"):
        try:
            chat = await context.bot.get_chat(query)
            if chat.type == ChatType.PRIVATE:
                profile = {
                    "id": int(chat.id),
                    "username": getattr(chat, "username", None),
                    "first_name": getattr(chat, "first_name", None) or "",
                    "last_name": getattr(chat, "last_name", None) or "",
                    "is_bot": bool(getattr(chat, "is_bot", False)),
                    "photo_path": None,
                }
                source = "Telegram Bot API"
        except TelegramError:
            pass

    if profile is None and query.isdigit():
        archived = await get_profile(int(query))
        if archived:
            profile = {
                "id": int(archived["user_id"]),
                "username": archived["username"],
                "first_name": archived["first_name"],
                "last_name": archived["last_name"],
                "is_bot": bool(archived["is_bot"]),
                "photo_path": archived["photo_path"],
            }
            source = "الأرشيف المحلي"

    success = profile is not None
    await log_search(user.id, query, success, source if success else "فشل")

    if not profile:
        await status.edit_text("❌ لم يتم العثور على أي معلومات لهذا الحساب عبر المصادر المتاحة.", reply_markup=back_keyboard())
        return

    try:
        result = await render_profile(profile, source)
        await status.edit_text(result, parse_mode="HTML", reply_markup=back_keyboard())
        
        # إرسال الصورة المؤرشفة إن وجدت
        if profile.get("photo_path") and os.path.exists(profile["photo_path"]):
            with open(profile["photo_path"], "rb") as photo_file:
                await msg.reply_photo(photo=InputFile(photo_file), caption="📸 صورة الحساب المؤرشفة")
    except TelegramError:
        await msg.reply_text("حدث خطأ أثناء عرض النتيجة.", reply_markup=back_keyboard())


